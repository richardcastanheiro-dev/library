	end)
	feature.Instance = instance
	feature._setter = function(value)
		if typeof(value) == "Color3" then
			Lib:SetValue(instance, value)
		end
	end
	registerFeature(feature)
	return feature
end

function GroupMeta:Button(first, second)
	local config = type(first) == "table" and first or (type(second) == "table" and second or {})
	local label = config.Title or config.Text or (type(first) == "string" and first) or "Botão"
	local callback = config.Callback or config.Func
	if not callback then
		if type(first) == "function" then
			callback = first
		elseif type(second) == "function" then
			callback = second
		end
	end
	return Lib:CreateButton(self.Host, label, callback)
end

