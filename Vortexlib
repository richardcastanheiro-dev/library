function Lib:SaveConfig(name)
	name = tostring(name or "default")
	local data = {}
	for id, feature in pairs(Lib.Registry) do
		local value = feature.Value
		if typeof(value) == "EnumItem" then
			value = value.Name
		elseif typeof(value) == "Color3" then
			value = { value.R, value.G, value.B }
		end
		data[id] = value
	end
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	if not ok or type(writefile) ~= "function" then
		return false
	end
	return pcall(writefile, "MikuLib_" .. name .. ".json", encoded)
end

function Lib:LoadConfig(name)
	name = tostring(name or "default")
	local file = "MikuLib_" .. name .. ".json"
	if type(isfile) ~= "function" or not isfile(file) then
		return false
	end
	local ok, content = pcall(readfile, file)
	if not ok or not content then
		return false
	end
	local decoded
	local parsed = pcall(function()
		decoded = HttpService:JSONDecode(content)
	end)
	if not parsed or type(decoded) ~= "table" then
		return false
	end
	for id, value in pairs(decoded) do
		local feature = Lib.Registry[id]
		if feature then
			if feature.Type == "Keybind" and type(value) == "string" then
				value = Enum.KeyCode[value]
			elseif feature.Type == "ColorPicker" and type(value) == "table" then
				value = Color3.new(value[1], value[2], value[3])
			end
			if value ~= nil then
				feature:Set(value)
			end
		end
	end
	return true
end

