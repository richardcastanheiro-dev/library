	local text = config.Title or config.Text or (type(first) == "string" and first) or ""
	return Lib:CreateSection(self.Host, text)
end

local function matches(current, required)
	if required == nil then
		if type(current) == "table" then
			return #current > 0
		end
		return current ~= nil and current ~= false and current ~= ""
	end
	if current == required then
		return true
	end
	if type(current) == "table" then
		for _, value in ipairs(current) do
			if value == required then
				return true
			end
		end
		return false
	end
	return tostring(current) == tostring(required)
end

function GroupMeta:EvaluateDependencies()
	if not self._deps then
		return
	end
	local visible = true
	for _, dependency in ipairs(self._deps) do
		if not matches(dependency.Feature.Value, dependency.Required) then
			visible = false
			break
		end
	end
	if self.Card then
		self.Card.Visible = visible
	end
	refreshPage(self.Page)
end

local function resolveFeature(target)
	if type(target) == "table" then
		if getmetatable(target) == FeatureMeta then
			return target
		end
		if target.Value ~= nil then
			return target
		end
		return nil
	end
	if typeof(target) == "Instance" then
		return Lib.ByInstance[target]
	end
	if type(target) == "string" then
		return Lib.Registry[target] or Options[target]
	end
	for id, value in pairs(RawOptions) do
		if value == target then
			return Lib.Registry[id]
		end
	end
	for id, value in pairs(RawOptions) do
		if tostring(value) == tostring(target) then
			return Lib.Registry[id]
		end
	end
	return nil
end

function GroupMeta:SetupDependencies(list)
	self._deps = {}
	for _, entry in ipairs(list or {}) do
		local feature = resolveFeature(entry[1])
		if feature then
			table.insert(self._deps, {
				Feature = feature,
				Required = entry[2]
			})
			local reference = self
			feature:OnChanged(function()
				reference:EvaluateDependencies()
			end)
		end
	end
	self:EvaluateDependencies()
	return self
end

function GroupMeta:AddDependencyBox()
	local parentHost = self.ParentHost or self.Host
	local card = createCard(parentHost, nil, nil)
	card.Name = "DependencyBox"
	card.Visible = false
	local dependency = createGroup(card, card, "", nil, self.Tab, parentHost)
	dependency._deps = {}
	return dependency
end

function TabMeta:GetColumns()
	if self._columns then
		return self._columns
	end
	local row = make("Frame", {
		Name = "Columns",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = nextLayoutOrder(self.Holder)
	}, self.Holder)
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top
	}, row)
	local function makeStack(name, order)
		local stack = make("Frame", {
			Name = name,
			Size = UDim2.new(0.5, -4, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			LayoutOrder = order
		}, row)
		make("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder
		}, stack)
		return stack
	end
	self._columns = {
		Row = row,
		Left = makeStack("Left", 1),
		Right = makeStack("Right", 2)
	}
	return self._columns
end

function TabMeta:Group(first, second)
	local config = type(first) == "table" and first or { Title = tostring(first or "Group") }
	if type(first) == "table" and type(second) == "table" then
		for key, value in pairs(second) do
			config[key] = value
		end
	end
	local title = config.Title or config.Text or config.Name or "Group"
	local card = createCard(self.Holder, title, config.Desc or config.Description)
	return createGroup(card, card, title, config.Desc or config.Description, self, self.Holder)
end

function TabMeta:_ColumnGroup(side, title)
	local columns = self:GetColumns()
	local host = side == "Right" and columns.Right or columns.Left
	local label = tostring(title or (side .. " Group"))
	local card = createCard(host, label, nil)
	return createGroup(card, card, label, nil, self, host)
end

function TabMeta:AddLeftGroupbox(title)
	return self:_ColumnGroup("Left", type(title) == "table" and (title.Title or title.Text) or title)
end

function TabMeta:AddRightGroupbox(title)
	return self:_ColumnGroup("Right", type(title) == "table" and (title.Title or title.Text) or title)
end

function TabMeta:Section(config)
	return self:Group(config)
end

function TabMeta:Select()
	if self.Window then
		self.Window:SelectTab(self)
	end
end

local rawCreateTab = Window.CreateTab
local rawSelectTab = Window.SelectTab
local rawCreateWindow = Lib.CreateWindow
local rawNotify = Lib.Notify
local rawSetValue = Lib.SetValue
local rawGetValue = Lib.GetValue

function Window:CreateTab(name, iconName)
	local displayName = name
	if type(name) == "table" then
		displayName = name.Name or name.Title or name.Text
	end
	local page, button = rawCreateTab(self, name, iconName)
	if not page then
		return nil
	end
	self._tabObjects = self._tabObjects or {}
	local tab = setmetatable({
		Page = page,
		Holder = page:FindFirstChild("Holder"),
		Button = button,
		Name = tostring(displayName or "Tab"),
		Window = self
	}, TabMeta)
	table.insert(self._tabObjects, tab)
	return tab
end

function Window:Tab(config)
	return self:CreateTab(config)
end

function Window:AddTab(config)
	return self:CreateTab(config)
end

function Window:SelectTab(target)
	if type(target) == "table" and target.Page then
		target = target.Page
	end
	return rawSelectTab(self, target)
end

function Window:SetToggleKey(key)
	if type(key) == "string" then
		key = Enum.KeyCode[key]
	end
	self:SetKeybind(key)
end

function Window:Dialog(config)
	return Lib:Dialog(config)
end

function Lib:CreateWindow(config)
	config = type(config) == "table" and config or {}
	local normalized = {}
	for key, value in pairs(config) do
		normalized[key] = value
	end
	normalized.Subtitle = normalized.Subtitle or normalized.SubTitle
	if normalized.Theme then
		pcall(function()
			self:SetTheme(normalized.Theme)
		end)
	end
	if type(normalized.Keybind) == "string" then
		normalized.Keybind = Enum.KeyCode[normalized.Keybind]
	end
	return rawCreateWindow(self, normalized)
end

function Lib:Notify(first, second, third)
	if type(first) == "table" then
		local config = first
		local title = config.Title or config.title or "MikuLib"
		local text = config.Description or config.description or config.Text or config.text or config.Content or second or ""
		local duration = config.Time or config.Duration or config.duration or third or 4
		return rawNotify(self, title, text, duration)
	end
	return rawNotify(self, first, second, third)
end

function Lib:SetValue(control, value)
	if type(control) == "table" and getmetatable(control) == FeatureMeta then
		control:Set(value)
		return
	end
	return rawSetValue(self, control, value)
end

function Lib:GetValue(control)
	if type(control) == "table" and getmetatable(control) == FeatureMeta then
		return control.Value
	end
	return rawGetValue(self, control)
end

local creators = {
	"CreateSection", "CreateLabel", "CreateDivider", "CreateButton", "CreateToggle",
	"CreateCheckbox", "CreateSlider", "CreateTextBox", "CreateDropdown", "CreateKeybind",
	"CreateColorPicker", "CreateIcon", "CreateIconButton"
}

for _, name in ipairs(creators) do
	local original = Lib[name]
	if type(original) == "function" then
		Lib[name] = function(self, parent, ...)
			if type(parent) == "table" and (parent.Holder or parent.Page) then
				parent = parent.Holder or parent.Page
			end
			return original(self, parent, ...)
		end
	end
end

