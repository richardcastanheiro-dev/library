function Lib:SetTheme(value)
	if type(value) == "table" then
		for key, color in pairs(value) do
			if typeof(color) == "Color3" and Theme[key] ~= nil then
				Theme[key] = color
			end
		end
		return Theme
	end
	local palette = Lib.Themes[tostring(value or "Dark")]
	if palette then
		for key, color in pairs(palette) do
			if Theme[key] ~= nil then
				Theme[key] = color
			end
		end
	end
	return Theme
end

