	local function cleanIcon(icon)
		if type(icon) == "string" then
			return (icon:gsub("^lucide%-", ""))
		end
		return icon
	end

	local function makeTab(win, page, btn, name)
		local holder = page:FindFirstChild("Holder")
		local layout = holder and holder:FindFirstChildOfClass("UIListLayout")
		if btn then
			local lbl = btn:FindFirstChild("Label")
			if lbl then
				lbl.RichText = true
			end
		end
		if layout then
			layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
				if page.Parent then
					page.CanvasSize = UDim2.fromOffset(0, math.max(layout.AbsoluteContentSize.Y + 32, page.AbsoluteSize.Y))
				end
			end)
		end
		local tab = newContainer(holder or page)
		tab.Page, tab.Button, tab.Window, tab.Name, tab.IsTab = page, btn, win, name, true
		function tab:Select()
			win:SelectTab(page)
		end
		return tab
	end

	local patched = false
	local function patchWindow(win)
		if patched then return end
		local mt = getmetatable(win)
		local cls = mt and mt.__index
		if type(cls) ~= "table" then return end
		patched = true

		local origCreateTab = cls.CreateTab
		cls.CreateTab = function(self, name, icon, ...)
			if type(name) == "table" then
				local c = name
				name = c.Title or c.Name or c.Text or "Tab"
				icon = c.Icon or c.IconName or icon
			end
			local page, btn = origCreateTab(self, tostring(name or "Tab"), cleanIcon(icon), ...)
			return makeTab(self, page, btn, name)
		end
		cls.AddTab = function(self, name, icon) return self:CreateTab(name, icon) end
		cls.MakeTab = cls.AddTab
		cls.AddKeyTab = cls.AddTab

		local origSelect = cls.SelectTab
		cls.SelectTab = function(self, target)
			if type(target) == "table" and target.Page then
				target = target.Page
			end
			return origSelect(self, target)
		end

		cls.Dialog = function(self, cfg)
			cfg = type(cfg) == "table" and cfg or {}
			return Lib:Notify(cfg.Title or "Aviso", cfg.Content or "", 5)
		end
	end

	local origCreateWindow = Lib.CreateWindow
	Lib.CreateWindow = function(self, cfg, ...)
		local mapped = {}
		if type(cfg) == "table" then
			for k, v in pairs(cfg) do
				mapped[k] = v
			end
		end
		mapped.Title = mapped.Title or mapped.Name or mapped.Text
		mapped.Subtitle = mapped.Subtitle or mapped.SubTitle or mapped.Footer
		mapped.Keybind = mapped.Keybind or mapped.ToggleKeybind or mapped.MinimizeKey
		local win = origCreateWindow(self, mapped, ...)
		patchWindow(win)
		return win
	end
	Lib.MakeWindow = function(self, cfg) return self:CreateWindow(cfg) end
	Lib.Init = function() end

	local origNotify = Lib.Notify
	Lib.Notify = function(self, a, b, c)
		if type(a) == "table" then
			local d = a.Time or a.Duration or 4
			if type(d) ~= "number" then d = 4 end
			return origNotify(self, a.Title or a.Name or "Notificação", a.Description or a.Content or a.Text or a.SubContent or "", d)
		elseif type(a) == "string" and type(b) == "number" then
			return origNotify(self, "Notificação", a, b)
		end
		return origNotify(self, a, b, c)
	end
	Lib.MakeNotification = function(self, cfg) return self:Notify(cfg) end

	Lib.Toggle = function(self, v)
		local w = self.Windows[1]
		if w then
			if v == nil then w:Toggle() else w:SetVisible(v) end
		end
	end

	local unloadCbs = {}
	Lib.OnUnload = function(_, fn) table.insert(unloadCbs, fn) end
	local origDestroyAll = Lib.DestroyAll
	Lib.DestroyAll = function(self)
		local cbs = unloadCbs
		unloadCbs = {}
		for _, f in ipairs(cbs) do
			pcall(f)
		end
		Lib.Unloaded = true
		return origDestroyAll(self)
	end
	Lib.Unload = function(self) return self:DestroyAll() end

