local function roundTo(value, decimals)
	local step = 10 ^ (tonumber(decimals) or 0)
	local number = tonumber(value) or 0
	return math.floor(number * step + 0.5) / step
end

local function normalizeList(list)
	local result = {}
	if type(list) ~= "table" then
		return result
	end
	for _, value in ipairs(list) do
		table.insert(result, value)
	end
	if #result == 0 then
		for key, value in pairs(list) do
			if type(key) == "string" then
				table.insert(result, key)
			end
		end
		table.sort(result)
	end
	return result
end

local function readConfig(first, second)
	local config = {}
	if type(first) == "table" then
		for key, value in pairs(first) do
			config[key] = value
		end
	else
		if type(second) == "table" then
			for key, value in pairs(second) do
				config[key] = value
			end
		end
		config.Text = config.Text or tostring(first)
	end
	config.Index = config.Index or config.ID or config.Id or config.Flag
	if config.Index == nil and type(first) ~= "table" then
		config.Index = tostring(first)
	end
	config.Title = config.Title or config.Text or config.Name
	return config
end

local function fireFeature(feature, value)
	feature.Value = value
	local id = feature.Id
	if id then
		Options[id] = feature
		RawOptions[id] = value
		if feature.Type == "Toggle" then
			Toggles[id] = feature
			RawToggles[id] = value
		end
	end
	local listeners = feature._listeners
	for index = 1, #listeners do
		safeCall(listeners[index], value, feature)
	end
end

local function createFeature(kind, id, default)
	return setmetatable({
		Type = kind,
		Id = id,
		Value = default,
		_listeners = {}
	}, FeatureMeta)
end

local function registerFeature(feature)
	local id = feature.Id
	if id then
		Options[id] = feature
		Lib.Registry[id] = feature
		RawOptions[id] = feature.Value
		if feature.Type == "Toggle" then
			Toggles[id] = feature
			RawToggles[id] = feature.Value
		end
	end
	if feature.Instance then
		Lib.ByInstance[feature.Instance] = feature
	end
	return feature
end

function FeatureMeta:Get()
	return self.Value
end

function FeatureMeta:Set(value)
	if self._setter then
		self._setter(value)
	else
		fireFeature(self, value)
	end
	return self
end

function FeatureMeta:OnChanged(callback)
	if type(callback) == "function" then
		table.insert(self._listeners, callback)
	end
	return callback
end

FeatureMeta.AddListener = FeatureMeta.OnChanged
FeatureMeta.Changed = FeatureMeta.OnChanged

function FeatureMeta:SetVisible(value)
	if self.Instance then
		Lib:SetVisible(self.Instance, value)
	end
end

function FeatureMeta:SetDisabled(value)
	if self.Instance then
		Lib:SetDisabled(self.Instance, value)
	end
end

function FeatureMeta:GetState()
	return self.Value
end

function FeatureMeta:Destroy()
	if self.Instance and self.Instance.Parent then
		self.Instance:Destroy()
	end
	if self.Id then
		Lib.Registry[self.Id] = nil
		RawOptions[self.Id] = nil
		RawToggles[self.Id] = nil
	end
end

local function createCard(host, title, description)
	if not host then
		return nil
	end
	local card = make("Frame", {
		Name = "Card",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.SurfaceAlt,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		LayoutOrder = nextLayoutOrder(host)
	}, host)
	corner(card, 10)
	stroke(card, Theme.Stroke, 0.45)
	make("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top
	}, card)
	make("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10)
	}, card)
	if title ~= nil and tostring(title) ~= "" then
		make("TextLabel", {
			Name = "CardTitle",
			Size = UDim2.new(1, 0, 0, 18),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = tostring(title),
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextColor3 = Theme.AccentSoft,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			LayoutOrder = 0
		}, card)
	end
	if description ~= nil and tostring(description) ~= "" then
		make("TextLabel", {
			Name = "CardDescription",
			Size = UDim2.new(1, 0, 0, 14),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = tostring(description),
			Font = Enum.Font.Gotham,
			TextSize = 10,
			TextColor3 = Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			LayoutOrder = 0
		}, card)
	end
	return card
end

local function createGroup(host, card, title, description, tab, parentHost)
	return setmetatable({
		Host = host,
		Card = card,
		Title = title,
		Description = description,
		Tab = tab,
		Page = tab and tab.Page or nil,
		ParentHost = parentHost,
		_deps = nil
	}, GroupMeta)
end

function GroupMeta:Toggle(first, second)
	local config = readConfig(first, second)
	local label = config.Title or "Toggle"
	local default = config.Default == true
	local feature = createFeature("Toggle", config.Index, default)
	local icon = nil
	if config.Icon then
		local resolved = Lib:GetCustomIcon(config.Icon)
		if resolved and resolved.Url then
			icon = resolved.Url
		end
	end
	local instance = Lib:CreateToggle(self.Host, {
		Text = label,
		Description = config.Desc or config.Description,
		Default = default,
		Icon = icon,
		Callback = function(value)
			fireFeature(feature, value)
			safeCall(config.Callback, value)
		end
	})
	feature.Instance = instance
	feature._setter = function(value)
		Lib:SetValue(instance, value == true)
	end
	registerFeature(feature)
	if config.Disabled then
		Lib:SetDisabled(instance, true)
	end
	return feature
end

function GroupMeta:Slider(first, second)
	local config = readConfig(first, second)
	local label = config.Title or "Slider"
	local minimum = tonumber(config.Min or config.Minimum) or 0
	local maximum = tonumber(config.Max or config.Maximum) or 100
	if maximum <= minimum then
		maximum = minimum + 1
	end
	local rounding = tonumber(config.Rounding) or 0
	local default = roundTo(tonumber(config.Default) or minimum, rounding)
	local feature = createFeature("Slider", config.Index, default)
	local instance = Lib:CreateSlider(self.Host, label, minimum, maximum, default, function(value)
		local result = roundTo(value, rounding)
		fireFeature(feature, result)
		safeCall(config.Callback, result)
	end)
	feature.Instance = instance
	feature._setter = function(value)
		local clamped = math.clamp(tonumber(value) or minimum, minimum, maximum)
		Lib:SetValue(instance, roundTo(clamped, rounding))
	end
	registerFeature(feature)
	return feature
end

function GroupMeta:Dropdown(first, second)
	local config = readConfig(first, second)
	local label = config.Title or "Dropdown"
	local values = normalizeList(config.Values or config.Options or config.List)
	local multi = config.Multi == true
	local default = config.Default
	if multi then
		if type(default) ~= "table" then
			default = {}
		end
	elseif default == nil then
		default = values[1]
	end
	local feature = createFeature(multi and "MultiDropdown" or "Dropdown", config.Index, default)
	local instance = Lib:CreateDropdown(self.Host, {
		Text = label,
		Values = values,
		Default = default,
		Multi = multi,
		Searchable = config.Searchable == true,
		Callback = function(value)
			fireFeature(feature, value)
			safeCall(config.Callback, value)
		end
	})
	feature.Instance = instance
	feature._setter = function(value)
		Lib:SetValue(instance, value)
	end
	feature.SetValues = function(_, list)
		values = normalizeList(list)
		if instance.SetOptions then
			instance:SetOptions(values)
		end
	end
	feature.GetValues = function()
		return values
	end
	registerFeature(feature)
	return feature
end

function GroupMeta:Input(first, second)
	local config = readConfig(first, second)
	local label = config.Title or "Input"
	local default = config.Value or config.Default or ""
	local placeholder = config.Placeholder or config.PlaceHolder or "Digite"
	local feature = createFeature("Input", config.Index, tostring(default))
	local instance = Lib:CreateTextBox(self.Host, label, placeholder, tostring(default), function(value)
		fireFeature(feature, value)
		safeCall(config.Callback, value)
	end)
	feature.Instance = instance
	feature._setter = function(value)
		Lib:SetValue(instance, tostring(value or ""))
	end
	registerFeature(feature)
	return feature
end

function GroupMeta:Keybind(first, second)
	local config = readConfig(first, second)
	local label = config.Title or "Keybind"
	local defaultKey = config.Default or config.Value or "RightShift"
	if type(defaultKey) == "string" then
		defaultKey = Enum.KeyCode[defaultKey] or Enum.KeyCode.RightShift
	end
	if typeof(defaultKey) ~= "EnumItem" then
		defaultKey = Enum.KeyCode.RightShift
	end
	local mode = tostring(config.Mode or "Toggle")
	local feature = createFeature("Keybind", config.Index, defaultKey)
	feature.Mode = mode
	local function onPress(key)
		if mode == "Hold" then
			safeCall(config.Callback, true, key)
		elseif mode ~= "Always" then
			safeCall(config.Callback, key)
		end
	end
	local instance = Lib:CreateKeybind(self.Host, label, defaultKey, onPress)
	instance:GetAttributeChangedSignal("MikuKeybind"):Connect(function()
		local name = instance:GetAttribute("MikuKeybind")
		local key = name and Enum.KeyCode[name]
		if key then
			feature.Value = key
			if feature.Id then
				RawOptions[feature.Id] = key
			end
			safeCall(config.ChangedCallback, key)
		end
	end)
	if mode == "Hold" then
		UserInputService.InputEnded:Connect(function(input)
			if input.KeyCode == feature.Value then
				safeCall(config.Callback, false)
			end
		end)
	elseif mode == "Always" then
		local held = false
		UserInputService.InputBegan:Connect(function(input, processed)
			if processed or UserInputService:GetFocusedTextBox() then
				return
			end
			if input.KeyCode == feature.Value then
				held = true
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.KeyCode == feature.Value then
				held = false
			end
		end)
		RunService.RenderStepped:Connect(function()
			if held then
				safeCall(config.Callback, feature.Value)
			end
		end)
	end
	feature.Instance = instance
	feature._setter = function(value)
		if type(value) == "string" then
			value = Enum.KeyCode[value]
		end
		if typeof(value) == "EnumItem" and value.EnumType == Enum.KeyCode then
			Lib:SetValue(instance, value)
			feature.Value = value
		end
	end
	registerFeature(feature)
	return feature
end

function GroupMeta:ColorPicker(first, second)
	local config = readConfig(first, second)
	local label = config.Title or "Color"
	local default = typeof(config.Default) == "Color3" and config.Default or Theme.Accent
