	}, panel)
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder
	}, row)
	local api = { Gui = gui, Panel = panel }
	function api:Close()
		if gui.Parent then
			gui:Destroy()
		end
	end
	function api:Open()
		if not gui.Parent then
			gui.Parent = PlayerGui
		end
	end
	for index, button in ipairs(buttons) do
		local text = type(button) == "table" and tostring(button.Title or button.Text or "OK") or tostring(button)
		local callback = type(button) == "table" and (button.Callback or button.Func) or nil
		local element = make("TextButton", {
			Name = "Button" .. index,
			Size = UDim2.fromOffset(88, 30),
			BackgroundColor3 = Theme.SurfaceHi,
			BorderSizePixel = 0,
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 12,
			TextColor3 = Theme.Text,
			AutoButtonColor = false,
			LayoutOrder = index
		}, row)
		corner(element, 8)
		stroke(element, Theme.Stroke, 0.4)
		element.MouseEnter:Connect(function()
			TweenService:Create(element, Fast, {
				BackgroundColor3 = Theme.Accent
			}):Play()
		end)
		element.MouseLeave:Connect(function()
			TweenService:Create(element, Fast, {
				BackgroundColor3 = Theme.SurfaceHi
			}):Play()
		end)
		element.MouseButton1Click:Connect(function()
			safeCall(callback)
			api:Close()
		end)
	end
	return api
end

