local function updateCanvas(scrolling)
	if not scrolling or not scrolling.Parent then
		return
	end

	local layout = scrolling:FindFirstChildOfClass("UIListLayout")
	if layout then
		scrolling.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
	end
end

local function bindCanvas(scrolling)
	local layout = scrolling and scrolling:FindFirstChildOfClass("UIListLayout")
	if layout then
		layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			updateCanvas(scrolling)
		end)
	end
end

