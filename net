function Lib:SetTheme(t)
    for k, v in pairs(t or {}) do Theme[k] = v end
    local keep = {}
    for _, e in ipairs(Lib._themed) do
        if e.inst and e.inst.Parent ~= nil then
            for _, m in ipairs(e.map) do
                pcall(function() e.inst[m[1]] = Theme[m[2]] end)
            end
            table.insert(keep, e)
        end
    end
    Lib._themed = keep
    return Theme
end

function Lib:GetTheme() return Theme end

function Lib:ApplyThemePreset(name)
    local preset = type(name) == "table" and name or Lib.ThemePresets[name]
    if not preset then return false end
    Lib:SetTheme(preset)
    return true
end

