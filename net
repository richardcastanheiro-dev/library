	local text = tostring(config.Text or "")
	local duration = math.max(0.2, tonumber(config.Duration) or 3)
	local color = config.Color or Theme.Accent

	if not notifyGui or not notifyGui.Parent then
		notifyGui = Instance.new("ScreenGui")
		notifyGui.Name = "MikuNotify"
		notifyGui.ResetOnSpawn = false
		notifyGui.IgnoreGuiInset = true
		notifyGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		notifyGui.DisplayOrder = 10000
		attachGui(notifyGui)

		notifyStack = Instance.new("Frame")
		notifyStack.Name = "Stack"
		notifyStack.AnchorPoint = Vector2.new(1, 1)
		notifyStack.Position = UDim2.new(1, -16, 1, -16)
		notifyStack.Size = UDim2.fromOffset(300, 0)
		notifyStack.AutomaticSize = Enum.AutomaticSize.Y
		notifyStack.BackgroundTransparency = 1
		notifyStack.BorderSizePixel = 0
		notifyStack.Parent = notifyGui

		local stackLayout = Instance.new("UIListLayout")
		stackLayout.FillDirection = Enum.FillDirection.Vertical
		stackLayout.SortOrder = Enum.SortOrder.LayoutOrder
		stackLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
		stackLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
		stackLayout.Padding = UDim.new(0, 8)
		stackLayout.Parent = notifyStack
	end

	local card = Instance.new("CanvasGroup")
	card.Name = "Notification"
	card.Size = UDim2.fromOffset(300, 64)
	card.BackgroundColor3 = Theme.Surface
	card.BackgroundTransparency = 0
	card.BorderSizePixel = 0
	card.GroupTransparency = 1
	card.ZIndex = 1001
	applyCorner(card, 10)
	applyStroke(card, color, 1, 0.35)
	card.Parent = notifyStack

	local colorBar = Instance.new("Frame")
	colorBar.Size = UDim2.new(0, 3, 1, -18)
	colorBar.Position = UDim2.new(0, 10, 0, 9)
	colorBar.BackgroundColor3 = color
	colorBar.BorderSizePixel = 0
	colorBar.ZIndex = 2
	applyCorner(colorBar, 2)
	colorBar.Parent = card

	local titleLabel = Instance.new("TextLabel")
	titleLabel.BackgroundTransparency = 1
	titleLabel.Size = UDim2.new(1, -38, 0, 20)
	titleLabel.Position = UDim2.new(0, 22, 0, 9)
	titleLabel.Font = Theme.FontBold
	titleLabel.TextSize = 13
	titleLabel.TextColor3 = color
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
	titleLabel.Text = title
	titleLabel.ZIndex = 2
	titleLabel.Parent = card

	local description = Instance.new("TextLabel")
	description.BackgroundTransparency = 1
	description.Size = UDim2.new(1, -38, 0, 18)
	description.Position = UDim2.new(0, 22, 0, 29)
	description.Font = Theme.Font
	description.TextSize = 12
	description.TextColor3 = Theme.TextDim
	description.TextXAlignment = Enum.TextXAlignment.Left
	description.TextTruncate = Enum.TextTruncate.AtEnd
	description.Text = text
	description.ZIndex = 2
	description.Parent = card

	local progress = Instance.new("Frame")
	progress.Size = UDim2.new(1, -20, 0, 2)
	progress.Position = UDim2.new(0, 10, 1, -5)
	progress.BackgroundColor3 = color
	progress.BorderSizePixel = 0
	progress.ZIndex = 2
	applyCorner(progress, 2)
	progress.Parent = card

	playTween(card, Ease.Normal, {
		GroupTransparency = 0
	})

	playTween(progress, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Size = UDim2.new(0, 0, 0, 2)
	})

	local closed = false

	task.delay(duration, function()
		if closed or not card.Parent then
			return
		end
		closed = true
		playTween(card, Ease.In, {
			GroupTransparency = 1
		})
		task.delay(0.24, function()
			if card.Parent then
				card:Destroy()
			end
		end)
	end)

	return card
end

function Lib:CreateWatermark(config)
	config = config or {}

	local accent = config.Accent or Theme.Accent

	local gui = Instance.new("ScreenGui")
	gui.Name = config.Name or "MikuWatermark"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = tonumber(config.DisplayOrder) or 10001
	gui:SetAttribute("MikuAccent", accent)
	attachGui(gui)

	local frame = Instance.new("Frame")
	frame.Name = "Watermark"
	if typeof(config.Size) == "UDim2" then
		frame.Size = config.Size
	else
		frame.Size = UDim2.fromOffset(math.max(120, tonumber(config.Width) or 230), math.max(26, tonumber(config.Height) or 34))
	end
	frame.AnchorPoint = config.AnchorPoint or Vector2.new(0, 0)
	frame.Position = config.Position or UDim2.fromOffset(16, 16)
	frame.BackgroundColor3 = config.BackgroundColor or Theme.Surface
	frame.BackgroundTransparency = clamp(tonumber(config.BackgroundTransparency) or 0.08, 0, 1)
	frame.BorderSizePixel = 0
	frame.Active = config.Draggable == true
	frame.Parent = gui

	applyCorner(frame, 10)
	local stroke = applyStroke(frame, accent, 1, 0.3)

	local accentBar = Instance.new("Frame")
	accentBar.Size = UDim2.new(0, 3, 1, -14)
	accentBar.Position = UDim2.new(0, 8, 0, 7)
	accentBar.BackgroundColor3 = accent
	accentBar.BorderSizePixel = 0
	accentBar.ZIndex = 2
	applyCorner(accentBar, 2)
	accentBar.Parent = frame

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.new(0, 18, 0, 0)
	label.Size = UDim2.new(1, -26, 1, 0)
	label.Font = config.Font or Theme.FontBold
	label.TextSize = tonumber(config.TextSize) or 12
	label.TextColor3 = config.TextColor or Theme.Text
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Text = tostring(config.Text or ("Miku | " .. ((LocalPlayer and LocalPlayer.Name) or "Player")))
	label.ZIndex = 2
	label.Parent = frame

	local dragCleanup
	if config.Draggable == true then
		local ok, cleanup = pcall(function()
			return Lib.newDraggable(frame, frame)
		end)
		if ok and type(cleanup) == "function" then
			dragCleanup = cleanup
		end
	end

	local destroyed = false

	local watermark = {
		Gui = gui,
		Frame = frame,
		Label = label
	}

	gui.Destroying:Connect(function()
		destroyed = true
		if dragCleanup then
			pcall(dragCleanup)
			dragCleanup = nil
		end
	end)

	function watermark:SetText(text)
		if not destroyed then
			label.Text = tostring(text or "")
		end
	end

	function watermark:SetVisible(state)
		if not destroyed then
			gui.Enabled = state and true or false
		end
	end

	function watermark:SetAccent(color)
		if destroyed or typeof(color) ~= "Color3" then
			return
		end
		accentBar.BackgroundColor3 = color
		stroke.Color = color
		gui:SetAttribute("MikuAccent", color)
	end

	function watermark:Destroy()
		if destroyed then
			return
		end
		destroyed = true
		if dragCleanup then
			pcall(dragCleanup)
			dragCleanup = nil
		end
		gui:Destroy()
	end

	return watermark
end

function Lib:DestroyAll()
	if activeDropdownClose then
		local closeDropdown = activeDropdownClose
		pcall(closeDropdown)
		activeDropdownClose = nil
	end

	for _, window in ipairs(table.clone(trackedWindows)) do
		if window and type(window.Destroy) == "function" then
			pcall(function()
				window:Destroy()
			end)
		end
	end

	table.clear(trackedWindows)

	for _, gui in ipairs(table.clone(trackedGuis)) do
		if gui and gui.Parent then
			pcall(function()
				gui:Destroy()
			end)
		end
	end

	table.clear(trackedGuis)
	notifyGui = nil
	notifyStack = nil
	Shared.MikuLibInstance = nil
end

Lib.CloseAll = Lib.DestroyAll
Lib.Destroy = Lib.DestroyAll
Lib.new = function(config)
	return Lib:CreateWindow(config)
end

return Lib
