local function wrapControl(instance, kind)
	local data = Lib.Controls[instance] or {}
	local w = { _instance = instance, _mikuInstance = instance, Kind = kind, Type = kind, Instance = instance }

	function w:Set(v) if data.SetValue then data.SetValue(v) end return self end
	function w:Get() return data.GetValue and data.GetValue() or nil end
	function w:OnChanged(fn) if data.AddListener and type(fn) == "function" then data.AddListener(fn) end return self end
	w.AddCallback = w.OnChanged
	function w:SetVisible(v) Lib:SetVisible(instance, v == true) return self end
	function w:Show() Lib:SetVisible(instance, true) return self end
	function w:Hide() Lib:SetVisible(instance, false) return self end
	function w:Visible() return instance.Visible end
	function w:SetDisabled(v) Lib:SetDisabled(instance, v == true) return self end
	function w:Disable() Lib:SetDisabled(instance, true) return self end
	function w:Enable() Lib:SetDisabled(instance, false) return self end
	function w:Fire(...) if data.Fire then data.Fire(...) end return self end
	function w:Destroy()
		if instance.Parent then instance:Destroy() end
		Lib.Controls[instance] = nil
	end
	return w
end


local function createBox(sectionInstance, page, title, windowObj)
	local box = {
		_isMikuBox = true,
		_instance = sectionInstance,
		_page = page,
		_title = title or "",
		Name = title or "",
		Instance = sectionInstance,
		Page = page,
		Window = windowObj,
	}

	local function method(fn)
		return function(a, b)
			local cfg
			if a == box then cfg = b else cfg = a end
			return fn(cfg)
		end
	end

	box.Toggle = method(function(cfg)
		if type(cfg) ~= "table" then cfg = { Title = tostring(cfg or "Toggle") } end
		local inst = Lib:CreateToggle(page, cfg)
		return wrapControl(inst, "Toggle")
	end)
	box.Button = method(function(cfg)
		if type(cfg) ~= "table" then cfg = { Title = tostring(cfg or "Button") } end
		local inst = Lib:CreateButton(page, cfg.Title or cfg.Text or "Button", cfg.Callback or cfg.OnClick)
		return wrapControl(inst, "Button")
	end)
	box.Slider = method(function(cfg)
		if type(cfg) ~= "table" then cfg = { Title = tostring(cfg or "Slider"), Min = 0, Max = 100, Default = 50 } end
		local inst = Lib:CreateSlider(page, cfg)
		return wrapControl(inst, "Slider")
	end)
	box.Dropdown = method(function(cfg)
		if type(cfg) ~= "table" then cfg = { Title = tostring(cfg or "Dropdown"), Values = {} } end
		local inst = Lib:CreateDropdown(page, cfg)
		return wrapControl(inst, "Dropdown")
	end)
	box.Input = method(function(cfg)
		if type(cfg) ~= "table" then cfg = { Title = tostring(cfg or "Input") } end
		local inst = Lib:CreateInput(page, cfg)
		return wrapControl(inst, "Input")
	end)
	box.TextBox = box.Input
	box.Keybind = method(function(cfg)
		if type(cfg) ~= "table" then cfg = { Title = tostring(cfg or "Keybind") } end
		local inst = Lib:CreateKeybind(page, cfg)
		return wrapControl(inst, "Keybind")
	end)
	box.ColorPicker = method(function(cfg)
		if type(cfg) ~= "table" then cfg = { Title = tostring(cfg or "Color") } end
		local inst = Lib:CreateColorPicker(page, cfg.Title, cfg.Default, cfg.Callback)
		return wrapControl(inst, "ColorPicker")
	end)
	box.Checkbox = method(function(cfg)
		if type(cfg) ~= "table" then cfg = { Title = tostring(cfg or "Checkbox") } end
		local inst = Lib:CreateCheckbox(page, cfg)
		return wrapControl(inst, "Checkbox")
	end)
	box.Label = method(function(cfg)
		if type(cfg) ~= "table" then cfg = { Text = tostring(cfg or "") } end
		local inst = Lib:CreateLabel(page, cfg.Text or cfg.Content or "")
		return wrapControl(inst, "Label")
	end)
	box.Paragraph = method(function(cfg)
		if type(cfg) ~= "table" then cfg = { Content = tostring(cfg or "") } end
		local inst = Lib:CreateParagraph(page, cfg)
		return wrapControl(inst, "Paragraph")
	end)
	box.Divider = method(function(_)
		local inst = Lib:CreateDivider(page)
		return wrapControl(inst, "Divider")
	end)


	box.Section = method(function(cfg)
		if type(cfg) ~= "table" then cfg = { Name = tostring(cfg or "Section") } end
		local sec = Lib:CreateSection(page, cfg.Name or cfg.Title or "Section")
		return createBox(sec, page, sec:FindFirstChildOfClass("TextLabel") and sec:FindFirstChildOfClass("TextLabel").Text or "Section", windowObj)
	end)
	box.Box = box.Section
	box.CreateBox = box.Section


	box.CreateToggle = box.Toggle; box.AddToggle = box.Toggle
	box.CreateButton = box.Button; box.AddButton = box.Button
	box.CreateSlider = box.Slider; box.AddSlider = box.Slider
	box.CreateDropdown = box.Dropdown; box.AddDropdown = box.Dropdown
	box.CreateInput = box.Input; box.AddInput = box.Input
	box.CreateTextBox = box.Input; box.AddTextBox = box.Input
	box.CreateKeybind = box.Keybind; box.AddKeybind = box.Keybind
	box.CreateColorPicker = box.ColorPicker; box.AddColorPicker = box.ColorPicker
	box.CreateCheckbox = box.Checkbox; box.AddCheckbox = box.Checkbox
	box.CreateLabel = box.Label; box.AddLabel = box.Label
	box.CreateParagraph = box.Paragraph; box.AddParagraph = box.Paragraph
	box.CreateDivider = box.Divider; box.AddDivider = box.Divider
	box.AddSection = box.Section

	-- Utility
	box.Notify = function(a, b, c, d)
		if a == box then return Lib:Notify(b, c, d) end
		return Lib:Notify(a, b, c)
	end
	box.Watermark = function(a, b) if a == box then return Lib:CreateWatermark(b) end return Lib:CreateWatermark(a) end
	box.SetVisible = function(selfOrV, mv)
		local v = selfOrV == box and mv or selfOrV
		if sectionInstance and sectionInstance.Parent then sectionInstance.Visible = v == true; refreshPage(page) end
	end
	box.Hide = function() box:SetVisible(false) end
	box.Show = function() box:SetVisible(true) end
	box.GetTitle = function() return box._title end
	box.Destroy = function()
		if sectionInstance and sectionInstance.Parent then sectionInstance:Destroy() end
		refreshPage(page)
	end

	return box
end

