function Lib:SetValue(control, value)
	control = unwrapInstance(control)
	local data = self.Controls[control]
	if data and data.SetValue then data.SetValue(value) end
end
function Lib:GetValue(control)
	control = unwrapInstance(control)
	local data = self.Controls[control]
	if data and data.GetValue then return data.GetValue() end
end
function Lib:SetVisible(control, visible)
	control = unwrapInstance(control)
	if not control or not control.Parent then return end
	local target = control
	local p = target.Parent
	while p do
		if p.Name == "Holder" or p:IsA("ScrollingFrame") then break end
		target = p; p = p.Parent
	end
	target.Visible = visible == true
	refreshPage(getPageFrom(target))
end
function Lib:SetDisabled(control, disabled)
	control = unwrapInstance(control)
	local data = self.Controls[control]
	if data and data.SetDisabled then data.SetDisabled(disabled == true)
	elseif control then control:SetAttribute("MikuDisabled", disabled == true) end
end

