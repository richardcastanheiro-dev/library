			updatePageCanvas(page)
		end
		pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshCanvas)
		page:GetPropertyChangedSignal("AbsoluteSize"):Connect(refreshCanvas)
		page.ChildAdded:Connect(function()
			task.defer(refreshCanvas)
		end)
		page.ChildRemoved:Connect(function()
			task.defer(refreshCanvas)
		end)
		page:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
			context.closeAllDropdowns()
		end)
		local tabButton = make("TextButton", {
			Name = "Tab_" .. (#tabs + 1),
