function Lib:CreateSaveManager(opts)
    opts = opts or {}
    local folder = opts.Folder or "MikuLib"
    local file = opts.File or "config.json"
    local path = folder .. "/" .. file
    local delay = opts.AutosaveDelay or 3
    local autosaveConn

    local sm = {}

    local function collect()
        local out = {}
        for _, c in ipairs(Lib.Controls) do
            if c._saveKey and c.Get then
                local ok, v = pcall(function() return c:Get() end)
                if ok and v ~= nil then out[c._saveKey] = packValue(v) end
            end
        end
        return out
    end

    local function apply(data)
        for k, v in pairs(data or {}) do
            local val = unpackValue(v)
            if val ~= nil then
                for _, c in ipairs(Lib.Controls) do
                    if c._saveKey == k and c.Set then
                        pcall(function() c:Set(val) end)
                    end
                end
            end
        end
    end

    function sm:Exists()
        if not fsOk() then return false end
        local ok, res = pcall(isfile, path)
        return ok and res == true
    end

    function sm:Save()
        if not fsOk() then return false, "executor sem file API" end
        pcall(function()
            if typeof(isfolder) == "function" and not isfolder(folder) then
                makefolder(folder)
            end
        end)
        local data = collect()
        local ok, encoded = pcall(encodeTable, data)
        if not ok then return false, encoded end
        local ok2, err = pcall(writefile, path, encoded)
        if not ok2 then return false, err end
        return true
    end

    function sm:Load()
        if not fsOk() then return false, "executor sem file API" end
        local ok, exists = pcall(isfile, path)
        if not ok or not exists then return false, "arquivo nao existe" end
        local ok2, content = pcall(readfile, path)
        if not ok2 then return false, content end
        local ok3, decoded = pcall(decodeTable, content)
        if not ok3 then return false, decoded end
        apply(decoded)
        return true
    end

    function sm:Delete()
        if not fsOk() then return false end
        return (pcall(delfile, path))
    end

    function sm:Reset()
        for _, c in ipairs(Lib.Controls) do
            if c._saveKey and c._default ~= nil then
                pcall(function() c:Set(c._default) end)
            end
        end
        return sm:Save()
    end

    function sm:EnableAutosave(v)
        if autosaveConn then autosaveConn:Disconnect() autosaveConn = nil end
        if v == false then return end
        local acc = 0
        autosaveConn = RunService.Heartbeat:Connect(function(dt)
            acc = acc + dt
            if acc >= delay then
                acc = 0
                pcall(function() sm:Save() end)
            end
        end)
    end

    function sm:Destroy()
        if autosaveConn then autosaveConn:Disconnect() autosaveConn = nil end
    end

    function sm:GetPath() return path end
    function sm:Collect() return collect() end
    function sm:Apply(data) apply(data) end

    return sm
end


function Lib:CreateKeybindHud(cfg)
    cfg = cfg or {}
    local sg = ensureGui(cfg.ScreenGuiName or "MikuKeybindHud", cfg.DisplayOrder or 10002, true)
    local width = cfg.Width or 240

    local panel = mk("Frame", {
        Name = "KeybindHud",
        Position = cfg.Position or UDim2.fromOffset(20, 20),
        Size = UDim2.fromOffset(width, 34),
        BackgroundColor3 = Theme.Surface, BorderSizePixel = 0,
        ClipsDescendants = true,
    }, sg)
    corner(10, panel)
    local st = stroke(Theme.Stroke, 1, panel)
    bindTheme(panel, { { "BackgroundColor3", "Surface" } })
    bindTheme(st, { { "Color", "Stroke" } })

    local header = mk("Frame", {
        Name = "Header", Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1,
    }, panel)

    local titleLbl = mk("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(1, -50, 1, 0), Font = Enum.Font.GothamBold, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = cfg.Title or "Keybinds", TextColor3 = Theme.AccentSoft,
    }, header)
    bindTheme(titleLbl, { { "TextColor3", "AccentSoft" } })

    local closeBtn = mk("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1,
        Text = "×", Font = Enum.Font.GothamBold, TextSize = 15,
        TextColor3 = Theme.TextDim, AutoButtonColor = false,
    }, header)

    local list = mk("Frame", {
        Name = "List", Position = UDim2.fromOffset(0, 34),
        Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1,
    }, panel)
    mk("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, list)
    mk("UIPadding", {
        PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
    }, list)

    local entries = {}
    local listening = nil
    local api = { _alive = true, Instance = panel, Entries = entries }

    local function refresh()
        local h = #entries * 30
        list.Size = UDim2.new(1, 0, 0, h)
        panel.Size = UDim2.fromOffset(width, 34 + h + (#entries > 0 and 6 or 0))
        panel.Visible = not api.Hidden
    end

    local function makeRow(entry)
        local row = mk("Frame", {
            Name = "Row", Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1,
        }, list)
        row.LayoutOrder = entry.Order

        local name = mk("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.new(1, -84, 1, 0),
            Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
            Text = entry.Name, TextColor3 = Theme.Text,
        }, row)
        bindTheme(name, { { "TextColor3", "Text" } })

        local badge = mk("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.fromOffset(76, 20), BackgroundColor3 = Theme.SurfaceHi,
            AutoButtonColor = false, Text = "", Font = Enum.Font.GothamMedium,
            TextSize = 10, TextColor3 = Theme.Text,
        }, row)
        corner(5, badge)
        bindTheme(badge, { { "BackgroundColor3", "SurfaceHi" } })

        local function render()
            badge.Text = listening == entry and "..." or (entry.Key and entry.Key.Name or "—")
            badge.TextColor3 = listening == entry and Theme.Accent or Theme.Text
        end

        badge.MouseButton1Click:Connect(function()
            listening = entry
            render()
        end)

        entry.Row = row
        entry.Badge = badge
        entry.Render = render
        entry.SetKey = function(k)
            entry.Key = k
            render()
            if entry.LinkedControl then entry.LinkedControl:Set(k) end
        end
        entry.Destroy = function()
            for i = #entries, 1, -1 do
                if entries[i] == entry then table.remove(entries, i) end
            end
            row:Destroy()
            refresh()
        end
        render()
    end

    function api:Add(name, key, cb, opts)
        opts = opts or {}
        local entry = {
            Name = name or "Bind",
            Key = key or Enum.KeyCode.RightShift,
            Callback = cb,
            DisplayOnly = opts.DisplayOnly == true,
            LinkedControl = opts.LinkedControl,
            Order = #entries + 1,
        }
        table.insert(entries, entry)
        makeRow(entry)
        refresh()
        return entry
    end

    function api:Remove(name)
        for i = #entries, 1, -1 do
            if entries[i].Name == name then
                entries[i]:Destroy()
                return true
            end
        end
        return false
    end

    function api:Clear()
        for i = #entries, 1, -1 do
            entries[i]:Destroy()
        end
        entries = {}
        refresh()
    end

    function api:SetVisible(v)
        api.Hidden = (v == false)
        panel.Visible = not api.Hidden
    end
    function api:GetVisible() return not api.Hidden end
    function api:Show() api:SetVisible(true) end
    function api:Hide() api:SetVisible(false) end
    function api:Toggle() api:SetVisible(api.Hidden) end

    function api:SetWidth(w)
        width = w
        refresh()
    end
    function api:SetTitle(v) titleLbl.Text = tostring(v) end

    function api:Destroy()
        api._alive = false
        pcall(function() conn:Disconnect() end)
        if panel and panel.Parent then panel:Destroy() end
        for i = #Lib._huds, 1, -1 do
            if Lib._huds[i] == api then table.remove(Lib._huds, i) end
        end
    end

    api.Hidden = cfg.StartHidden == true
    panel.Visible = not api.Hidden
    closeBtn.MouseButton1Click:Connect(function() api:SetVisible(false) end)

    local conn = UserInputService.InputBegan:Connect(function(input, processed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if listening then
            local entry = listening
            listening = nil
            if input.KeyCode == Enum.KeyCode.Escape then
                entry.Render()
                return
            elseif input.KeyCode == Enum.KeyCode.Backspace then
                entry.SetKey(nil)
            else
                entry.SetKey(input.KeyCode)
            end
            return
        end
        if not panel.Visible then return end
        for _, e in ipairs(entries) do
            if e.Key and e.Key == input.KeyCode and e.Callback and not e.DisplayOnly then
                task.spawn(function() safeCall(e.Callback, e.Key) end)
            end
        end
    end)

    Lib.newDraggable(panel, header)
    table.insert(Lib._huds, api)
    refresh()
    return api
end

function Lib:GetKeybindHud()
    if not Lib._defaultHud or not Lib._defaultHud._alive then
        Lib._defaultHud = Lib:CreateKeybindHud({ Title = "Keybinds", StartHidden = true })
    end
    return Lib._defaultHud
end

function Lib:ShowKeybindHud(v)
    local hud = Lib:GetKeybindHud()
    hud:SetVisible(v ~= false)
    return hud
end

function Lib:DestroyKeybindHuds()
    for i = #Lib._huds, 1, -1 do
        pcall(function() Lib._huds[i]:Destroy() end)
    end
    Lib._huds = {}
    Lib._defaultHud = nil
end

function Lib:CreateDisplayedKeybind(parent, text, defaultKey, cb)
    local kb = Lib:CreateKeybind(parent, {
        Name = text or "Keybind",
        Default = defaultKey or Enum.KeyCode.RightShift,
        Callback = cb,
    })
    local hud = Lib:GetKeybindHud()
    local entry = hud:Add(text or "Keybind", defaultKey or Enum.KeyCode.RightShift, nil, {
        DisplayOnly = true,
        LinkedControl = kb,
    })
    kb:OnChanged(function(key)
        entry.Key = key
        if entry.Render then entry.Render() end
        safeCall(cb, key)
    end)
    return kb, entry
end


