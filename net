function Lib:CreateSlider(parent, text, minimum, maximum, default, callback)
    minimum = tonumber(minimum) or 0
    maximum = tonumber(maximum) or 100

    if maximum < minimum then
        minimum, maximum = maximum, minimum
    end

    local accent = getAccent(parent)
    local unit = tostring(text or "CPS")
    local value = clamp(tonumber(default) or minimum, minimum, maximum)

    local dragging = false
    local dragInputType
    local changedConnection
    local endedConnection

    local row = Instance.new("Frame")
    row.Name = "Slider"
    row.Size = UDim2.new(1, 0, 0, 40)
    row.BackgroundTransparency = 1
    row.BorderSizePixel = 0
    row.Parent = parent

    local track = Instance.new("Frame")
    track.Name = "Track"
    track.Size = UDim2.new(1, 0, 0, 28)
    track.Position = UDim2.new(0, 0, 0.5, -14)
    track.BackgroundColor3 = Theme.SurfaceAlt
    track.BorderSizePixel = 0
    track.ClipsDescendants = true
    track.Parent = row

    applyCorner(track)

    local outline = Instance.new("UIStroke")
    outline.Color = Theme.Stroke
    outline.Thickness = 1
    outline.Transparency = 0.2
    outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    outline.Parent = track

    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 2
    fill.Parent = track
    applyCorner(fill)

    local click = Instance.new("TextButton")
    click.Name = "ClickArea"
    click.Size = UDim2.fromScale(1, 1)
    click.BackgroundTransparency = 1
    click.AutoButtonColor = false
    click.Text = ""
    click.ZIndex = 3
    click.Parent = track

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Name = "Value"
    valueLabel.Size = UDim2.fromScale(1, 1)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Font = Theme.FontBold
    valueLabel.TextSize = 13
    valueLabel.TextColor3 = Theme.Text
    valueLabel.TextXAlignment = Enum.TextXAlignment.Center
    valueLabel.TextYAlignment = Enum.TextYAlignment.Center
    valueLabel.ZIndex = 4
    valueLabel.Parent = click

    local function render()
        local alpha = 0

        if maximum ~= minimum then
            alpha = clamp((value - minimum) / (maximum - minimum), 0, 1)
        end

        fill.Size = UDim2.new(alpha, 0, 1, 0)

        local numberText
        if math.abs(value - math.floor(value)) < 0.001 then
            numberText = string.format("%.0f", value)
        else
            numberText = string.format("%.1f", value)
        end

        valueLabel.Text = numberText .. " " .. unit
    end

    local function set(newValue, fireCallback)
        local newNumber = clamp(tonumber(newValue) or minimum, minimum, maximum)
        local changed = newNumber ~= value

        value = newNumber
        render()

        if fireCallback and changed then
            invoke(callback, value)
        end
    end

    local function updateFromX(x)
        local trackWidth = track.AbsoluteSize.X
        if trackWidth <= 0 then
            return
        end

        local alpha = clamp(
            (x - track.AbsolutePosition.X) / trackWidth,
            0,
            1
        )

        set(minimum + (maximum - minimum) * alpha, true)
    end

    local function stopDragging()
        dragging = false
        dragInputType = nil

        if changedConnection then
            changedConnection:Disconnect()
            changedConnection = nil
        end

        if endedConnection then
            endedConnection:Disconnect()
            endedConnection = nil
        end
    end

    click.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        stopDragging()

        dragging = true
        dragInputType = input.UserInputType
        updateFromX(input.Position.X)

        changedConnection = UserInputService.InputChanged:Connect(function(changedInput)
            local mouseMove = dragInputType == Enum.UserInputType.MouseButton1
                and changedInput.UserInputType == Enum.UserInputType.MouseMovement

            local touchMove = dragInputType == Enum.UserInputType.Touch
                and changedInput.UserInputType == Enum.UserInputType.Touch

            if dragging and (mouseMove or touchMove) and row.Parent then
                updateFromX(changedInput.Position.X)
            end
        end)

        endedConnection = UserInputService.InputEnded:Connect(function(endedInput)
            if dragging and endedInput.UserInputType == dragInputType then
                stopDragging()
            end
        end)
    end)

    row.Destroying:Connect(stopDragging)
    render()

    return {
        Set = function(_, newValue, fireCallback)
            set(newValue, fireCallback ~= false)
        end,

        Get = function()
            return value
        end,

        Row = row,
        Fill = fill,
    }
end

