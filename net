local function createSelect(parent, cfg, multi)
    cfg = cfg or {}
    if type(cfg) == "string" then cfg = { Name = cfg } end

    local options = {}
    local function normalize(list)
        local out = {}
        for i, opt in ipairs(list or {}) do
            if type(opt) == "table" then
                out[i] = { Name = tostring(opt.Name or opt.Text or opt.Value), Value = opt.Value ~= nil and opt.Value or opt.Name }
            else
                out[i] = { Name = tostring(opt), Value = opt }
            end
        end
        return out
    end
    options = normalize(cfg.Options)

    local selected = {}      -- multi
    local current = nil      -- single

    local frame = mk("Frame", {
        Name = cfg.Name or (multi and "MultiDropdown" or "Dropdown"),
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
        ClipsDescendants = false,
    })

    local head = mk("TextButton", {
        Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Theme.SurfaceAlt,
        AutoButtonColor = false, Text = "", BorderSizePixel = 0,
    }, frame)
    corner(8, head)
    local st = stroke(Theme.Stroke, 1, head)
    bindTheme(head, { { "BackgroundColor3", "SurfaceAlt" } })
    bindTheme(st, { { "Color", "Stroke" } })

    local title = mk("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(0.5, -12, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = cfg.Name or "Selecionar", TextColor3 = Theme.Text,
    }, head)
    bindTheme(title, { { "TextColor3", "Text" } })

    local valueLbl = mk("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0, 0),
        Size = UDim2.new(0.5, -32, 1, 0), Font = Enum.Font.Gotham, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd,
        Text = cfg.Placeholder or "Nenhum", TextColor3 = Theme.TextDim,
    }, head)
    bindTheme(valueLbl, { { "TextColor3", "TextDim" } })

    local arrow = mk("TextLabel", {
        BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(18, 18),
        Font = Enum.Font.GothamBold, TextSize = 13, Text = "▾", TextColor3 = Theme.TextDim,
    }, head)

    local list = mk("Frame", {
        Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = Theme.Surface, BorderSizePixel = 0, Visible = false,
        ClipsDescendants = true,
    }, frame)
    corner(8, list)
    local lStroke = stroke(Theme.Stroke, 1, list)
    local lPad = mk("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }, list)
    local lLayout = mk("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, list)
    local lScroll = mk("ScrollingFrame", {
        Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent, CanvasSize = UDim2.new(0, 0, 0, 0),
    }, list)

    local c = newControl(cfg.Name or (multi and "MultiDropdown" or "Dropdown"), multi and "MultiDropdown" or "Dropdown", frame)
    local rows = {}
    local open = false

    local function updateLabel()
        if multi then
            local names = {}
            for _, opt in ipairs(options) do
                if selected[opt.Name] then table.insert(names, opt.Name) end
            end
            if #names == 0 then valueLbl.Text = cfg.Placeholder or "Nenhum"
            elseif #names <= 2 then valueLbl.Text = table.concat(names, ", ")
            else valueLbl.Text = tostring(#names) .. " selecionados" end
        else
            valueLbl.Text = current and tostring(current.Name) or (cfg.Placeholder or "Nenhum")
        end
    end

    local function rebuild()
        for _, r in ipairs(rows) do r:Destroy() end
        rows = {}
        for i, opt in ipairs(options) do
            local row = mk("TextButton", {
                Size = UDim2.new(1, -8, 0, 28), Position = UDim2.fromOffset(4, 0),
                BackgroundColor3 = Theme.SurfaceAlt, BackgroundTransparency = 1,
                AutoButtonColor = false, Text = "", BorderSizePixel = 0,
            })
            row.LayoutOrder = i
            row.Parent = lScroll
            corner(6, row)

            local isSel = multi and selected[opt.Name] or (current ~= nil and current.Name == opt.Name)
            local box = mk("Frame", {
                Position = UDim2.fromOffset(8, 7), Size = UDim2.fromOffset(14, 14),
                BackgroundColor3 = Theme.SurfaceHi, BorderSizePixel = 0,
            }, row)
            corner(multi and 4 or 7, box)
            local fill = mk("Frame", {
                Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Accent,
                BorderSizePixel = 0, Visible = isSel and true or false,
            }, box)
            if not multi then corner(7, fill) end

            local lbl = mk("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(30, 0),
                Size = UDim2.new(1, -36, 1, 0), Font = Enum.Font.Gotham, TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = opt.Name, TextColor3 = Theme.Text,
            }, row)
            bindTheme(lbl, { { "TextColor3", "Text" } })

            row.MouseButton1Click:Connect(function()
                if multi then
                    selected[opt.Name] = (not selected[opt.Name]) or nil
                    fill.Visible = selected[opt.Name] == true
                    updateLabel()
                    safeCall(cfg.Callback, c:Get())
                else
                    current = opt
                    for _, r in ipairs(rows) do
                        local b = r:FindFirstChildOfClass("Frame")
                        if b then
                            local f = b:FindFirstChildOfClass("Frame")
                            if f then f.Visible = false end
                        end
                    end
                    fill.Visible = true
                    updateLabel()
                    safeCall(cfg.Callback, opt.Value)
                    open = false
                    list.Visible = false
                    list.Size = UDim2.new(1, 0, 0, 0)
                    frame.Size = UDim2.new(1, 0, 0, 36)
                    arrow.Text = "▾"
                end
            end)
            table.insert(rows, row)
        end
        lScroll.CanvasSize = UDim2.new(0, 0, 0, #options * 30 + 4)
    end

    head.MouseButton1Click:Connect(function()
        open = not open
        if open and #rows ~= #options then rebuild() end
        list.Visible = open
        arrow.Text = open and "▴" or "▾"
        local h = open and math.min(#options * 30 + 10, 190) or 0
        list.Size = UDim2.new(1, 0, 0, h)
        frame.Size = UDim2.new(1, 0, 0, 36 + (open and (h + 4) or 0))
    end)

    function c:Get()
        if multi then
            local out = {}
            for _, opt in ipairs(options) do
                if selected[opt.Name] then table.insert(out, opt.Value) end
            end
            return out
        end
        return current and current.Value or nil
    end

    function c:Set(v)
        if multi then
            selected = {}
            if type(v) == "table" then
                for _, x in ipairs(v) do
                    for _, opt in ipairs(options) do
                        if tostring(opt.Name) == tostring(x) or tostring(opt.Value) == tostring(x) then
                            selected[opt.Name] = true
                        end
                    end
                end
            end
        else
            current = nil
            for _, opt in ipairs(options) do
                if tostring(opt.Name) == tostring(v) or tostring(opt.Value) == tostring(v) then current = opt end
            end
        end
        if #rows ~= #options then rebuild() else
            for i, row in ipairs(rows) do
                local opt = options[i]
                local box = row:FindFirstChildOfClass("Frame")
                local fill = box and box:FindFirstChildOfClass("Frame")
                if fill then
                    fill.Visible = multi and (selected[opt.Name] == true) or (current ~= nil and current.Name == opt.Name) or false
                end
            end
        end
        updateLabel()
    end

    function c:SetOptions(list, keep)
        options = normalize(list)
        if not keep then selected = {} current = nil end
        rebuild()
        updateLabel()
    end

    function c:OnChanged(fn) cfg.Callback = fn end

    if cfg.Default ~= nil then c:Set(cfg.Default) end
    updateLabel()
    attach(parent, frame)
    return finish(c)
end

function Lib:CreateDropdown(parent, cfg) return createSelect(parent, cfg, false) end
function Lib:CreateMultiDropdown(parent, cfg) return createSelect(parent, cfg, true) end
