    local d = Instance.new("Frame")
    d.Size = UDim2.new(1, 0, 0, 1)
    d.BackgroundColor3 = Theme.Stroke
    d.BackgroundTransparency = 0.5
    d.BorderSizePixel = 0
    d.Parent = parent
    return d
end

function Lib:CreateSection(parent, title)
    local wrap = Instance.new("Frame")
    wrap.Size = UDim2.new(1, 0, 0, 24)
    wrap.BackgroundTransparency = 1
    wrap.Parent = parent

    local accentDot = Instance.new("Frame")
    accentDot.Size = UDim2.fromOffset(4, 12)
    accentDot.Position = UDim2.new(0, 0, 0.5, -6)
    accentDot.BackgroundColor3 = Theme.Accent
    accentDot.BorderSizePixel = 0
    accentDot.Parent = wrap
    applyCorner(accentDot, 2)

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -12, 1, 0)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.Font = Theme.FontBold
    lbl.TextSize = 13
    lbl.TextColor3 = Theme.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = title
    lbl.Parent = wrap
    return wrap
end

function Lib:Notify(config)
    config = config or {}
    local title = config.Title or "Miku"
    local text  = config.Text or ""
    local dur   = config.Duration or 3
    local color = config.Color or Theme.Accent

    local gui = Instance.new("ScreenGui")
    gui.Name = "MikuNotify"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 10000
    local parentGui = (RunService:IsStudio() and LocalPlayer:WaitForChild("PlayerGui")) or CoreGui
    gui.Parent = parentGui

    local holder = Instance.new("Frame")
    holder.Size = UDim2.fromOffset(300, 60)
    holder.Position = UDim2.new(1, -320, 1, -80)
    holder.BackgroundColor3 = Theme.Surface
    holder.BorderSizePixel = 0
    holder.Parent = gui
    applyCorner(holder, 10)
    applyStroke(holder, Theme.Stroke, 1, 0.3)
    makeShadow(holder, 10, 12, 0.6)

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 1, -16)
    bar.Position = UDim2.new(0, 10, 0, 8)
    bar.BackgroundColor3 = color
    bar.BorderSizePixel = 0
    bar.Parent = holder
    applyCorner(bar, 2)

    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.Size = UDim2.new(1, -30, 0, 20)
    t.Position = UDim2.new(0, 22, 0, 10)
    t.Font = Theme.FontBold
    t.TextSize = 14
    t.TextColor3 = Theme.Text
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Text = title
    t.Parent = holder

    local d = Instance.new("TextLabel")
    d.BackgroundTransparency = 1
    d.Size = UDim2.new(1, -30, 0, 18)
    d.Position = UDim2.new(0, 22, 0, 30)
    d.Font = Theme.Font
    d.TextSize = 12
    d.TextColor3 = Theme.TextDim
    d.TextXAlignment = Enum.TextXAlignment.Left
    d.Text = text
    d.Parent = holder

    holder.Position = UDim2.new(1, 20, 1, -80)
    TweenService:Create(holder, Ease.Slow, { Position = UDim2.new(1, -320, 1, -80) }):Play()

    task.delay(dur, function()
        TweenService:Create(holder, Ease.Normal, { Position = UDim2.new(1, 20, 1, -80) }):Play()
        task.wait(0.25)
        pcall(function() gui:Destroy() end)
    end)

    return gui
end

return Lib
