function Lib:CreateSlider(parent, cfg)
    cfg = cfg or {}
    if type(cfg) == "string" then cfg = { Name = cfg } end
    local minV  = cfg.Min or cfg.Minimum or 0
    local maxV  = cfg.Max or cfg.Maximum or 100
    local step  = cfg.Step or 1
    local value = math.clamp(cfg.Default or minV, minV, maxV)

    local frame = mk("Frame", {
        Name = cfg.Name or "Slider", Size = UDim2.new(1, 0, 0, 50),
        BackgroundColor3 = Theme.SurfaceAlt, BorderSizePixel = 0,
    })
    corner(8, frame)
    local st = stroke(Theme.Stroke, 1, frame)
    bindTheme(frame, { { "BackgroundColor3", "SurfaceAlt" } })
    bindTheme(st, { { "Color", "Stroke" } })

    local title = mk("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 6),
        Size = UDim2.new(1, -80, 0, 16), Font = Enum.Font.Gotham, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = cfg.Name or "Slider", TextColor3 = Theme.Text,
    }, frame)
    bindTheme(title, { { "TextColor3", "Text" } })

    local valueLbl = mk("TextLabel", {
        BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 6), Size = UDim2.fromOffset(70, 16),
        Font = Enum.Font.GothamMedium, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        Text = fmt(value), TextColor3 = Theme.AccentSoft,
    }, frame)
    bindTheme(valueLbl, { { "TextColor3", "AccentSoft" } })

    local track = mk("Frame", {
        Position = UDim2.fromOffset(12, 30), Size = UDim2.new(1, -24, 0, 5),
        BackgroundColor3 = Theme.SurfaceHi, BorderSizePixel = 0,
    }, frame)
    corner(3, track)
    local fill = mk("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0 }, track)
    corner(3, fill)
    local knob = mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(12, 12), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
    }, track)
    corner(6, knob)

    local c = newControl(cfg.Name or "Slider", "Slider", frame)

    local function render()
        local alpha = (maxV - minV == 0) and 0 or (value - minV) / (maxV - minV)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLbl.Text = cfg.Format and cfg.Format(value) or fmt(value)
    end

    local function apply(v, silent)
        v = math.clamp(tonumber(v) or minV, minV, maxV)
        if step > 0 then v = math.floor(v / step + 0.5) * step end
        value = v
        render()
        if not silent then safeCall(cfg.Callback, value) end
    end

    local dragging = false
    local function fromMouse(x)
        local abs = track.AbsolutePosition
        local w = track.AbsoluteSize.X
        local alpha = math.clamp((x - abs.X) / math.max(w, 1), 0, 1)
        apply(minV + (maxV - minV) * alpha)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromMouse(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            fromMouse(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    function c:Get() return value end
    function c:Set(v) apply(v, true) end
    function c:SetMin(v) minV = v render() end
    function c:SetMax(v) maxV = v render() end
    function c:OnChanged(fn) cfg.Callback = fn end
    render()
    attach(parent, frame)
    return finish(c)
end

