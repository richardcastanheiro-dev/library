attachTabMethods = function(page, entry, windowObj)
	local tab = {
		_isMikuTab = true,
		_instance = page,
		_page = page,
		Name = entry.Name,
		Title = entry.Name,
		Button = entry.Button,
		Page = page,
		Entry = entry,
		Window = windowObj,
	}

	-- Tab is itself a box (short methods work directly on the tab)
	local directBox = createBox(page, page, entry.Name, windowObj)
	for k, v in pairs(directBox) do
		if tab[k] == nil then tab[k] = v end
	end
	tab._isMikuBox = true

	-- Also support creating explicit sub-boxes inside
	tab.CreateBox = function(a, b)
		local cfg = a == tab and b or a
		if type(cfg) ~= "table" then cfg = { Name = tostring(cfg or "Section") } end
		local sec = Lib:CreateSection(page, cfg.Name or cfg.Title or "Section")
		return createBox(sec, page, cfg.Name or "Section", windowObj)
	end
	tab.Box = tab.CreateBox
	tab.Section = tab.CreateBox

	tab.Select = function() windowObj:SelectTab(entry) end
	tab.SetActive = tab.Select
	tab.GetActive = function() return entry.Active end
	tab.GetTitle = function() return entry.Name end
	tab.SetTitle = function(a, b)
		local t = a == tab and b or a
		if t then entry.Label.Text = tostring(t); tab.Name = tostring(t); tab.Title = tostring(t) end
	end
	tab.Destroy = function()
		for i, e in ipairs(windowObj._tabs) do
			if e == entry then table.remove(windowObj._tabs, i); break end
		end
		if page.Parent then page:Destroy() end
		if entry.Button.Parent then entry.Button:Destroy() end
		if windowObj._activeTab == page and #windowObj._tabs > 0 then windowObj:SelectTab(windowObj._tabs[1]) end
	end

	page:SetAttribute("MikuTabName", entry.Name)
	return tab
end


