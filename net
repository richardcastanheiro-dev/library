local boxMap = {
    Toggle = "CreateToggle", Checkbox = "CreateCheckbox", Button = "CreateButton",
    Slider = "CreateSlider", Input = "CreateInput", TextBox = "CreateTextBox",
    Dropdown = "CreateDropdown", MultiDropdown = "CreateMultiDropdown",
    Keybind = "CreateKeybind", ColorPicker = "CreateColorPicker",
    Label = "CreateLabel", Paragraph = "CreateParagraph",
    Divider = "CreateDivider", Section = "CreateSection", IconButton = "CreateIconButton",
}

function Lib:Box(parent)
    local host = resolveHost(parent)
    local box = { Instance = host, Parent = host }

    for k, fnName in pairs(boxMap) do
        local fn = function(self, cfg)
            if type(cfg) == "string" then cfg = { Name = cfg } end
            return Lib[fnName](Lib, self.Instance, cfg)
        end
        box[k] = fn
        box["Create" .. k] = fn
        box["Add" .. k] = fn
    end

    box.Notify = function(self, a, b, c) return Lib:Notify(a, b, c) end
    box.NotifySuccess = function(self, a, b, c) return Lib:NotifySuccess(a, b, c) end
    box.NotifyError = function(self, a, b, c) return Lib:NotifyError(a, b, c) end
    box.Watermark = function(self, cfg) return Lib:CreateWatermark(cfg) end
    box.FPS = function(self, cfg) return Lib:CreateFPSWatermark(cfg) end
    box.Dialog = function(self, cfg) return Lib:Dialog(cfg) end
    box.Confirm = function(self, t, c, cb, cb2) return Lib:Confirm(t, c, cb, cb2) end
    box.Alert = function(self, t, c) return Lib:Alert(t, c) end
    box.Discord = function(self, text, invite) return Lib:CreateDiscordButton(host, text, invite) end
    box.Link = function(self, text, url) return Lib:CreateLinkButton(host, text, url) end
    box.SetVisible = function(self, v) host.Visible = v ~= false end
    box.Hide = function(self) host.Visible = false end
    box.Show = function(self) host.Visible = true end
    box.GetTitle = function(self) return host.Name end
    box.Destroy = function(self)
        for _, c in ipairs(host:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end
    end
    return box
end


function Lib:GetControl(name)
    for _, c in ipairs(Lib.Controls) do
        if c.Name == name then return c end
    end
end

function Lib:GetValue(name)
    local c = Lib:GetControl(name)
    if c then
        local fn = c.Get or c.GetValue
        if fn then
            local ok, v = pcall(fn, c)
            if ok then return v end
        end
    end
end

function Lib:SetValue(name, v)
    local c = Lib:GetControl(name)
    if c then
        local fn = c.Set or c.SetValue
        if fn then pcall(fn, c, v) return true end
    end
    return false
end

function Lib:SetVisible(name, v)
    local c = Lib:GetControl(name)
    if c and c.SetVisible then c:SetVisible(v) return true end
    return false
end

function Lib:SetDisabled(name, v)
    local c = Lib:GetControl(name)
    if c and c.SetDisabled then c:SetDisabled(v) return true end
    return false
end

function Lib:DestroyAll()
    for i = #Lib.Windows, 1, -1 do
        pcall(function() Lib.Windows[i]:Destroy() end)
    end
    Lib.Windows = {}
    pcall(function() Lib:DestroyKeybindHuds() end)
    if currentDialog then pcall(function() currentDialog:Close() end) currentDialog = nil end
    for _, name in ipairs({ "MikuNotify", "MikuDialog", "MikuTooltip", "MikuSplash", "MikuWatermark" }) do
        local parent = uiParent()
        local sg = parent:FindFirstChild(name)
        if sg then sg:Destroy() end
    end
    Lib.Controls = {}
    Lib._themed = {}
end

return Lib
