local function make(class, props, parent)
	local o = Instance.new(class)
	if props then for k, v in pairs(props) do o[k] = v end end
	if parent then o.Parent = parent end
	return o
end
local function corner(p, r)
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = p; return c
end
local function stroke(p, color, t)
	local s = Instance.new("UIStroke"); s.Color = color or Theme.Stroke
	s.Transparency = t or 0; s.Thickness = 1; s.Parent = p; return s
end
local function getViewport()
	local cam = workspace.CurrentCamera
	return cam and cam.ViewportSize or Vector2.new(1280, 720)
end
local function safeCall(cb, ...)
	if type(cb) ~= "function" then return end
	local ok, err = pcall(cb, ...)
	if not ok then warn("[MikuLib] " .. tostring(err)) end
end
local function getShared(create)
	local env
	local ok, v = pcall(function() return getgenv and getgenv() or _G end)
	env = (ok and type(v) == "table") and v or _G
	if type(env) ~= "table" then return nil end
	local shared = env.Shared
	if type(shared) ~= "table" and create then shared = {}; env.Shared = shared end
	return type(shared) == "table" and shared or nil
end
local function getPageFrom(obj)
	local cur = obj
	while cur do
		if cur:IsA("ScrollingFrame") and cur:GetAttribute("MikuPage") then return cur end
		cur = cur.Parent
	end
	return nil
end
local function updateCanvas(page)
	if not page or not page.Parent then return end
	local holder = page:FindFirstChild("Holder")
	local layout = holder and holder:FindFirstChildOfClass("UIListLayout")
	local h = layout and layout.AbsoluteContentSize.Y or 0
	page.CanvasSize = UDim2.fromOffset(0, math.max(h + 32, page.AbsoluteSize.Y))
end
local function refreshPage(page)
	if not page then return end
	updateCanvas(page)
	if page:GetAttribute("MikuQueued") then return end
	page:SetAttribute("MikuQueued", true)
	task.defer(function()
		if page and page.Parent then
			page:SetAttribute("MikuQueued", false); updateCanvas(page)
		end
	end)
end
local function unwrapInstance(v)
	if type(v) == "table" then return rawget(v, "_mikuInstance") or rawget(v, "_instance") or v end
	return v
end
local function resolveHost(parent)
	parent = unwrapInstance(parent)
	if not parent then return nil end
	if parent:IsA("ScrollingFrame") then return parent:FindFirstChild("Holder") or parent end
	return parent
end
local function nextOrder(host)
	local o = (host:GetAttribute("MikuLayoutOrder") or 0) + 1
	host:SetAttribute("MikuLayoutOrder", o)
	return o
end
local function prepareControl(parent, height, class)
	parent = unwrapInstance(parent)
	local host = resolveHost(parent)
	local page = getPageFrom(host)
	local obj = make(class or "Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1, BorderSizePixel = 0,
		LayoutOrder = nextOrder(host),
	}, host)
	return obj, page, host
end
local function formatValue(v)
	if v == math.floor(v) then return tostring(math.floor(v)) end
	return string.format("%.2f", v)
end
local function registerControl(inst, setters) Lib.Controls[inst] = setters; return inst end


function Lib:GetIcon(name)
	if not self.Icons or type(name) ~= "string" then return nil end
	local ok, icon = pcall(function() return self.Icons.GetAsset(name) end)
	return ok and icon or nil
end
function Lib:GetCustomIcon(value)
	if value == nil then return nil end
	if type(value) == "number" or tonumber(value) then value = "rbxassetid://" .. tostring(value) end
	value = tostring(value)
	if value:match("^rbxasset") or value:match("^https?://") then
		return { Url = value, ImageRectOffset = Vector2.zero, ImageRectSize = Vector2.zero, Custom = true }
	end
	return self:GetIcon(value)
end
function Lib:GetIconNames()
	if not self.Icons or type(self.Icons.Icons) ~= "table" then return {} end
	return self.Icons.Icons
end


function Lib.newDraggable(target, handle, isLocked)
	local dragging, startMouse, startX, startY, moveConn, endConn
	local function locked()
		if type(isLocked) == "function" then return isLocked() end
		return isLocked == true
	end
	local function stop()
		dragging = false
		if moveConn then moveConn:Disconnect(); moveConn = nil end
		if endConn then endConn:Disconnect(); endConn = nil end
	end
	local begin = handle.InputBegan:Connect(function(input)
		if locked() then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		stop(); dragging = true
		startMouse = UserInputService:GetMouseLocation()
		startX = target.Position.X.Offset; startY = target.Position.Y.Offset
		moveConn = UserInputService.InputChanged:Connect(function(changed)
			if not dragging then return end
			if changed.UserInputType ~= Enum.UserInputType.MouseMovement and changed.UserInputType ~= Enum.UserInputType.Touch then return end
			local mouse = UserInputService:GetMouseLocation()
			local viewport = getViewport()
			local size = target.AbsoluteSize
			target.Position = UDim2.fromOffset(
				math.clamp(startX + mouse.X - startMouse.X, 0, math.max(0, viewport.X - size.X)),
				math.clamp(startY + mouse.Y - startMouse.Y, 0, math.max(0, viewport.Y - size.Y))
			)
		end)
		endConn = UserInputService.InputEnded:Connect(function(changed)
			if changed.UserInputType == Enum.UserInputType.MouseButton1 or changed.UserInputType == Enum.UserInputType.Touch then stop() end
		end)
	end)
	return { Destroy = function() if begin then begin:Disconnect(); begin = nil end stop() end }
end


function Lib.newResize(target, callback)
	local handle = make("TextButton", {
		Name = "ResizeHandle", AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -4, 1, -4), Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.1,
		BorderSizePixel = 0, Text = "⤡", TextColor3 = Theme.TextDim, TextSize = 22,
		Font = Enum.Font.GothamBold, AutoButtonColor = false, Active = true,
		Selectable = false, ZIndex = 999,
	}, target)
	corner(handle, 7); stroke(handle, Theme.Accent, 0.55)
	local dragging, startMouse, startSize, moveConn, endConn
	local function stop()
		dragging = false
		if moveConn then moveConn:Disconnect(); moveConn = nil end
		if endConn then endConn:Disconnect(); endConn = nil end
	end
	handle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		stop(); dragging = true
		startMouse = UserInputService:GetMouseLocation(); startSize = target.AbsoluteSize
		moveConn = UserInputService.InputChanged:Connect(function(changed)
			if not dragging then return end
			if changed.UserInputType ~= Enum.UserInputType.MouseMovement and changed.UserInputType ~= Enum.UserInputType.Touch then return end
			local delta = UserInputService:GetMouseLocation() - startMouse
			local viewport = getViewport()
			local maxW, maxH = math.max(320, viewport.X - 40), math.max(240, viewport.Y - 40)
			local w = math.clamp(startSize.X + delta.X, math.min(360, maxW), maxW)
			local h = math.clamp(startSize.Y + delta.Y, math.min(240, maxH), maxH)
			target.Size = UDim2.fromOffset(w, h)
			if callback then callback(w, h) end
		end)
		endConn = UserInputService.InputEnded:Connect(function(changed)
			if changed.UserInputType == Enum.UserInputType.MouseButton1 or changed.UserInputType == Enum.UserInputType.Touch then stop() end
		end)
	end)
	return { Destroy = function() stop(); handle:Destroy() end }
end


local Window = {}
Window.__index = Window

function Window:Open()
	if self._destroyed or self._visible then return end
	self._visible = true; self._wrapper.Visible = true
	for _, t in ipairs(self._tweens) do pcall(function() t:Cancel() end) end
	self._rootScale.Scale = 0.94; self._root.GroupTransparency = 1
	local s = TweenService:Create(self._rootScale, TweenInfo.new(0.34, Enum.EasingStyle.Back), { Scale = 1 })
	local f = TweenService:Create(self._root, TweenInfo.new(0.22), { GroupTransparency = 0 })
	self._tweens = { s, f }; s:Play(); f:Play()
	self:ClampPosition()
	for _, entry in ipairs(self._tabs) do if entry.Page.Visible then refreshPage(entry.Page) end end
end
function Window:Close()
	if self._destroyed or (not self._visible and not self._wrapper.Visible) then return end
	self._visible = false
	for _, t in ipairs(self._tweens) do pcall(function() t:Cancel() end) end
	local f = TweenService:Create(self._root, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { GroupTransparency = 1 })
	local s = TweenService:Create(self._rootScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.92 })
	self._tweens = { f, s }; f:Play(); s:Play()
	s.Completed:Connect(function()
		if not self._destroyed and not self._visible then
			self._wrapper.Visible = false; self._rootScale.Scale = 1; self._root.GroupTransparency = 1
		end
	end)
end
function Window:SetVisible(v) if v then self:Open() else self:Close() end end
function Window:Toggle() if self._visible then self:Close() else self:Open() end end
function Window:GetVisible() return self._visible and self._wrapper.Visible end
function Window:Minimize()
	if self._destroyed then return end
	self._minimized = not self._minimized
	TweenService:Create(self._root, Normal, { Size = self._minimized and UDim2.new(1, 0, 0, 55) or UDim2.fromScale(1, 1) }):Play()
end
function Window:SetSize(w, h)
	if self._destroyed then return end
	local nw, nh
	if typeof(w) == "UDim2" then nw, nh = w.X.Offset, w.Y.Offset
	elseif typeof(w) == "Vector2" then nw, nh = w.X, w.Y
	elseif type(w) == "number" then nw, nh = w, h or self._baseSize.Y
	else return end
	local viewport = getViewport()
	nw = math.clamp(nw, math.min(360, viewport.X - 40), viewport.X - 40)
	nh = math.clamp(nh, math.min(240, viewport.Y - 40), viewport.Y - 40)
	self._baseSize = Vector2.new(nw, nh)
	self._wrapper.Size = UDim2.fromOffset(nw, nh); self:ClampPosition()
end
function Window:ClampPosition()
	if not self._wrapper then return end
	local viewport = getViewport()
	local size = self._wrapper.AbsoluteSize
	if size.X < 1 then size = Vector2.new(self._wrapper.Size.X.Offset, self._wrapper.Size.Y.Offset) end
	self._wrapper.Position = UDim2.fromOffset(
		math.clamp(self._wrapper.Position.X.Offset, 0, math.max(0, viewport.X - size.X)),
		math.clamp(self._wrapper.Position.Y.Offset, 0, math.max(0, viewport.Y - size.Y))
	)
end
function Window:SetTitle(t, s)
	if t then self._titleLabel.Text = tostring(t) end
	if s then self._subtitleLabel.Text = tostring(s) end
end
function Window:SetSubtitle(s) if s then self._subtitleLabel.Text = tostring(s) end end
function Window:SetProfile(p)
	if self._destroyed then return end
	p = type(p) == "table" and p or {}
	if p.Hidden ~= nil then self._profileCard.Visible = not p.Hidden end
	if p.Name then self._profileName.Text = tostring(p.Name) end
	if p.Tag then self._profileTag.Text = tostring(p.Tag) end
	if p.Image then self._avatar.Image = tostring(p.Image) end
end

