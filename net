function Window:SelectTab(target)
	local entry
	if type(target) == "table" and target.Button and target.Page then entry = target
	else
		for _, item in ipairs(self._tabs) do
			if item == target or item.Name == target or item.Button == target or item.Page == target
				or item.Button.Name == target or item.Page.Name == target then entry = item; break end
		end
		if not entry and type(target) == "number" then entry = self._tabs[target] end
	end
	if not entry then return end
	for _, item in ipairs(self._tabs) do
		local a = item == entry
		item.Active = a
		item.Page.Visible = a
		item.Indicator.Visible = a
		item.Label.TextColor3 = a and Theme.Text or Theme.TextDim
		item.Label.Font = a and Enum.Font.GothamBold or Enum.Font.GothamMedium
		item.Button.BackgroundColor3 = a and Theme.Accent or Theme.SurfaceAlt
		item.Button.BackgroundTransparency = a and 0.82 or 0.55
		local st = item.Button:FindFirstChildOfClass("UIStroke")
		if st then st.Color = a and Theme.Accent or Theme.Stroke; st.Transparency = a and 0.35 or 0.45 end
		local ic = item.Button:FindFirstChild("TabIcon")
		if ic then ic.ImageColor3 = a and Theme.AccentSoft or Theme.TextDim end
	end
	self._activeTab = entry.Page
	refreshPage(entry.Page)
end
function Window:GetActiveTab() return self._activeTab end

function Window:CreateTab(name, iconName)
	if self._destroyed then return end
	local obsidianMode = type(name) == "table"
	local cfg = obsidianMode and name or nil
	if cfg then iconName = cfg.Icon or cfg.IconName; name = cfg.Name or cfg.Title or "Tab" end
	name = tostring(name or "Tab")

	local page = make("ScrollingFrame", {
		Name = name .. "Page", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		BorderSizePixel = 0, CanvasSize = UDim2.fromOffset(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.None,
		ScrollingDirection = Enum.ScrollingDirection.Y, ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Accent, ScrollBarImageTransparency = 0.2,
		Visible = false, ClipsDescendants = true,
	}, self._content)
	page:SetAttribute("MikuPage", true)

	local holder = make("Frame", {
		Name = "Holder", Position = UDim2.fromOffset(18, 16),
		Size = UDim2.new(1, -36, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, BorderSizePixel = 0,
	}, page)
	make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Left, VerticalAlignment = Enum.VerticalAlignment.Top }, holder)

	local tabButton = make("TextButton", {
		Name = name .. "Tab", Size = UDim2.new(1, 0, 0, 42),
		BackgroundColor3 = Theme.SurfaceAlt, BackgroundTransparency = 0.55,
		AutoButtonColor = false, Text = "", BorderSizePixel = 0,
	}, self._tabList)
	corner(tabButton, 9); stroke(tabButton, Theme.Stroke, 0.45)

	local indicator = make("Frame", {
		Name = "Indicator", Size = UDim2.fromOffset(3, 20),
		Position = UDim2.fromOffset(0, 11), BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0, Visible = false,
	}, tabButton)
	corner(indicator, 2)

	local label = make("TextLabel", {
		Name = "Label", Position = UDim2.fromOffset(20, 0),
		Size = UDim2.new(1, -28, 1, 0), BackgroundTransparency = 1, Text = name,
		Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		BorderSizePixel = 0,
	}, tabButton)
	if iconName then
		local icon = Lib:GetCustomIcon(iconName)
		if icon then
			make("ImageLabel", {
				Name = "TabIcon", AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(18, 18),
				BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit,
				Image = icon.Url or "", ImageColor3 = Theme.TextDim,
				ImageRectOffset = icon.ImageRectOffset or Vector2.zero,
				ImageRectSize = icon.ImageRectSize or Vector2.zero,
			}, tabButton)
			label.Position = UDim2.fromOffset(36, 0)
			label.Size = UDim2.new(1, -42, 1, 0)
		end
	end

	local entry = { Name = name, Button = tabButton, Page = page, Indicator = indicator, Label = label, Active = false, Window = self }
	table.insert(self._tabs, entry)
	tabButton.MouseEnter:Connect(function() if not entry.Active then tabButton.BackgroundColor3 = Theme.SurfaceHi; tabButton.BackgroundTransparency = 0.42 end end)
	tabButton.MouseLeave:Connect(function() if not entry.Active then tabButton.BackgroundColor3 = Theme.SurfaceAlt; tabButton.BackgroundTransparency = 0.55 end end)
	tabButton.MouseButton1Click:Connect(function() if not self._destroyed then self:SelectTab(entry) end end)
	if not self._activeTab then self:SelectTab(entry) end
	refreshPage(page)

	local tabObj = attachTabMethods(page, entry, self)
	return tabObj
end

function Window:Tab(name, icon) return self:CreateTab(name, icon) end
function Window:Notify(t, txt, d) return Lib:Notify(t, txt, d) end
function Window:SetKeybind(k)
	if self._keybindConn then self._keybindConn:Disconnect(); self._keybindConn = nil end
	if k == nil or k == false then self._keybind = false; return end
	self._keybind = k
	self._keybindConn = UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == self._keybind and not UserInputService:GetFocusedTextBox() then
			if self._keybindEnabled ~= false then self:Toggle() end
		end
	end)
end
function Window:SetKeybindEnabled(v) self._keybindEnabled = v == true end
function Window:GetKeybind() return self._keybind end
function Window:Destroy()
	if self._destroyed then return end
	self._destroyed = true; self._visible = false
	if self._resizeApi then pcall(function() self._resizeApi.Destroy() end) end
	if self._dragApi then pcall(function() self._dragApi.Destroy() end) end
	if self._keybindConn then self._keybindConn:Disconnect() end
	self._tweens = {}
	for i = #Lib.Windows, 1, -1 do if Lib.Windows[i] == self then table.remove(Lib.Windows, i) end end
	local sh = getShared(false)
	if sh and sh.MikuLibInstance == self then sh.MikuLibInstance = nil end
	if self._screenGui then self._screenGui:Destroy(); self._screenGui = nil end
end

function Lib:CreateWindow(config)
	config = type(config) == "table" and config or {}
	local sh = getShared(true)
	if sh then
		local old = sh.MikuLibInstance
		if old and not sh.MikuLibKeepOldInstance and type(old.Destroy) == "function" then pcall(function() old:Destroy() end) end
	end
	local self = setmetatable({}, Window)
	self._tweens = {}; self._tabs = {}; self._visible = false; self._minimized = false; self._destroyed = false
	local viewport = getViewport()
	local w, h = 1000, 580
	if typeof(config.Size) == "UDim2" then
		w = config.Size.X.Scale > 0 and viewport.X * config.Size.X.Scale or (config.Size.X.Offset > 0 and config.Size.X.Offset or w)
		h = config.Size.Y.Scale > 0 and viewport.Y * config.Size.Y.Scale or (config.Size.Y.Offset > 0 and config.Size.Y.Offset or h)
	elseif typeof(config.Size) == "Vector2" then w, h = config.Size.X, config.Size.Y end
	if tonumber(config.Width) then w = tonumber(config.Width) end
	if tonumber(config.Height) then h = tonumber(config.Height) end
	w = math.clamp(w, math.min(360, viewport.X - 40), viewport.X - 40)
	h = math.clamp(h, math.min(240, viewport.Y - 40), viewport.Y - 40)
	self._baseSize = Vector2.new(w, h)
	local gui = make("ScreenGui", { Name = "MikuLib", DisplayOrder = config.DisplayOrder or 9999,
		IgnoreGuiInset = true, ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, PlayerGui)
	self._screenGui = gui
	local wrapper = make("Frame", {
		Name = "Window", Position = UDim2.fromOffset(math.max(0, (viewport.X - w) / 2), math.max(0, (viewport.Y - h) / 2)),
		Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, BorderSizePixel = 0,
		ClipsDescendants = false, Active = false, Visible = false,
	}, gui)
	self._wrapper = wrapper
	local root = make("CanvasGroup", { Name = "Root", Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Bg, BorderSizePixel = 0, ClipsDescendants = true }, wrapper)
	corner(root, 14); stroke(root, Theme.Stroke, 0.25)
	self._root = root
	self._rootScale = make("UIScale", { Name = "Scale", Scale = 1 }, root)

	local topBar = make("Frame", { Name = "TopBar", Size = UDim2.new(1, 0, 0, 55),
		BackgroundColor3 = Theme.Surface, BorderSizePixel = 0 }, root)
	make("Frame", { Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Stroke, BackgroundTransparency = 0.3, BorderSizePixel = 0 }, topBar)
	self._titleLabel = make("TextLabel", {
		Name = "Title", Position = UDim2.fromOffset(18, 8), Size = UDim2.new(1, -120, 0, 20),
		BackgroundTransparency = 1, Text = "MikuLib", Font = Enum.Font.GothamBold, TextSize = 15,
		TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, topBar)
	self._subtitleLabel = make("TextLabel", {
		Name = "Subtitle", Position = UDim2.fromOffset(18, 29), Size = UDim2.new(1, -120, 0, 14),
		BackgroundTransparency = 1, Text = "v" .. Lib.Version, Font = Enum.Font.GothamMedium,
		TextSize = 11, TextColor3 = Theme.TextDim, TextXAlignment = Enum.TextXAlignment.Left,
	}, topBar)

	local minB = make("TextButton", { Name = "MinButton", Position = UDim2.new(1, -72, 0.5, -14),
		Size = UDim2.fromOffset(28, 28), BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1,
		Text = "−", TextColor3 = Theme.TextDim, Font = Enum.Font.GothamBold, TextSize = 18,
		AutoButtonColor = false, ZIndex = 6 }, topBar)
	corner(minB, 7); minB.MouseButton1Click:Connect(function() self:Minimize() end)

	local closeB = make("TextButton", { Name = "CloseButton", Position = UDim2.new(1, -38, 0.5, -14),
		Size = UDim2.fromOffset(28, 28), BackgroundColor3 = Theme.Danger, BackgroundTransparency = 1,
		Text = "×", TextColor3 = Theme.TextDim, Font = Enum.Font.GothamBold, TextSize = 18,
		AutoButtonColor = false, ZIndex = 6 }, topBar)
