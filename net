        ToggleButton = toggleButton,
        Accent = accent,
        Keybind = keybind,
        Tabs = {},
        ActiveTab = nil,
        Minimized = false,
        Visible = true,
        Closed = false,
        _destroyed = false,
    }

    local closed = false
    local dragging = false
    local resizing = false
    local dragInputType
    local resizeInputType
    local dragStart
    local startCenter
    local resizeStart
    local resizeStartSize
    local resizeStartTopLeft
    local dragTargetPosition
    local visibilityTween
    local visibilityToken = 0

    local function clampWindowCenter(x, y)
        local view = getViewport()
        local size = wrapper.AbsoluteSize
        local halfWidth = size.X / 2
        local halfHeight = size.Y / 2

        local minX = math.min(halfWidth + 8, view.X / 2)
        local maxX = math.max(view.X - halfWidth - 8, view.X / 2)
        local minY = math.min(halfHeight + 8, view.Y / 2)
        local maxY = math.max(view.Y - halfHeight - 8, view.Y / 2)

        return clamp(x, minX, maxX), clamp(y, minY, maxY)
    end

    local function stopRenderLoop()
        if window._renderConnection then
            local connection = window._renderConnection
            window._renderConnection = nil
            connection:Disconnect()
        end
    end

    local function startRenderLoop()
        if closed or window._renderConnection then
            return
        end

        window._renderConnection = RunService.RenderStepped:Connect(function(deltaTime)
            if closed or not wrapper.Parent or not dragTargetPosition or resizing then
                stopRenderLoop()
                return
            end

            local targetPosition = dragTargetPosition
            local alpha = 1 - math.exp(-deltaTime * dragSmoothness)
            wrapper.Position = lerpUDim2(wrapper.Position, targetPosition, alpha)

            local position = wrapper.Position
            local closeEnough = math.abs(position.X.Offset - targetPosition.X.Offset) < 0.5
                and math.abs(position.Y.Offset - targetPosition.Y.Offset) < 0.5

            if closeEnough then
                wrapper.Position = targetPosition
                dragTargetPosition = nil
                stopRenderLoop()
            end
        end)
    end

    local function cleanupInputConnections()
        dragging = false
        resizing = false
        dragTargetPosition = nil

        stopRenderLoop()

        if window._inputChangedConnection then
            window._inputChangedConnection:Disconnect()
            window._inputChangedConnection = nil
        end

        if window._inputEndedConnection then
            window._inputEndedConnection:Disconnect()
            window._inputEndedConnection = nil
        end

        if window._keybindConnection then
            window._keybindConnection:Disconnect()
            window._keybindConnection = nil
        end
    end

    local function destroyWindow()
        if window._destroyed then
            return
        end

        window._destroyed = true
        closed = true
        window.Closed = true
        window.Visible = false
        visibilityToken = visibilityToken + 1

        if visibilityTween then
            visibilityTween:Cancel()
            visibilityTween = nil
        end

        removeTracked(trackedWindows, window)
        cleanupInputConnections()

        if Shared.MikuLibInstance == window then
            Shared.MikuLibInstance = nil
        end

        pcall(function()
            gui:Destroy()
        end)
    end

    window.Destroy = destroyWindow
    table.insert(trackedWindows, window)

    local function setWindowVisible(state)
        if closed then
            return
        end

        state = state and true or false

        if window.Visible == state then
            return
        end

        window.Visible = state
        toggleButton.Text = state and "Fechar" or "Abrir"

        visibilityToken = visibilityToken + 1
        local currentToken = visibilityToken

        if visibilityTween then
            visibilityTween:Cancel()
            visibilityTween = nil
        end

        if not state then
            dragging = false
            resizing = false
            dragInputType = nil
            resizeInputType = nil
            dragTargetPosition = nil
            stopRenderLoop()

            if activeDropdownClose then
                pcall(activeDropdownClose)
            end
        elseif not wrapper.Visible then
            wrapper.Visible = true
            wrapper.Size = UDim2.fromOffset(0, 0)
            wrapper.Rotation = -6
        end

        local targetSize

        if state then
            if window.Minimized then
                targetSize = UDim2.fromOffset(baseSize.X.Offset, 55)
            else
                targetSize = baseSize
            end
        else
            targetSize = UDim2.fromOffset(0, 0)
        end

        visibilityTween = TweenService:Create(
            wrapper,
            state and Ease.Normal or Ease.In,
            {
                Size = targetSize,
                Rotation = state and 0 or 6,
            }
        )

        local currentTween = visibilityTween

        currentTween.Completed:Connect(function(playbackState)
            if currentToken ~= visibilityToken or closed then
                return
            end

            visibilityTween = nil

            if playbackState ~= Enum.PlaybackState.Completed then
                return
            end

            if not state then
                wrapper.Visible = false
                wrapper.Size = UDim2.fromOffset(0, 0)
            else
                wrapper.Size = targetSize
            end

            wrapper.Rotation = 0
        end)

        currentTween:Play()
    end

    function window:SetVisible(state)
        setWindowVisible(state)
    end

    function window:Open()
        setWindowVisible(true)
    end

    function window:Toggle()
        setWindowVisible(not self.Visible)
    end

    function window:SetKeybind(value)
        self.Keybind = normalizeKeybind(value, false)
        return self.Keybind
    end

    window._keybindConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if closed or gameProcessed or not window.Keybind then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.Keyboard
            or input.KeyCode ~= window.Keybind then
            return
        end

        if UserInputService:GetFocusedTextBox() then
            return
        end

        window:Toggle()
    end)

    local function closeWindow()
        setWindowVisible(false)
    end

    window.Close = closeWindow

    local function beginDrag(input)
        if closed or resizing or not window.Visible then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local pointer = Vector2.new(input.Position.X, input.Position.Y)

        if pointInside(closeButton, pointer) or pointInside(minButton, pointer) then
            return
        end

        dragging = true
        dragInputType = input.UserInputType
        dragStart = pointer

        local absolutePosition = wrapper.AbsolutePosition
        local absoluteSize = wrapper.AbsoluteSize

        startCenter = Vector2.new(
            absolutePosition.X + absoluteSize.X / 2,
            absolutePosition.Y + absoluteSize.Y / 2
        )

        dragTargetPosition = nil
        stopRenderLoop()
    end

    local function beginResize(input)
        if closed or window.Minimized or not window.Visible then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        dragging = false
        resizing = true
        resizeInputType = input.UserInputType
        resizeStart = Vector2.new(input.Position.X, input.Position.Y)
        resizeStartSize = wrapper.AbsoluteSize
        resizeStartTopLeft = wrapper.AbsolutePosition
        dragTargetPosition = nil
        stopRenderLoop()
    end

    topBar.InputBegan:Connect(beginDrag)
    resizeHandle.InputBegan:Connect(beginResize)

    window._inputChangedConnection = UserInputService.InputChanged:Connect(function(input)
        if closed or not wrapper.Parent or not window.Visible then
            return
        end

        if resizing then
            local mouseMove = resizeInputType == Enum.UserInputType.MouseButton1
                and input.UserInputType == Enum.UserInputType.MouseMovement

            local touchMove = resizeInputType == Enum.UserInputType.Touch
                and input.UserInputType == Enum.UserInputType.Touch

            if not mouseMove and not touchMove then
                return
            end

            local pointer = Vector2.new(input.Position.X, input.Position.Y)
            local delta = pointer - resizeStart
            local view = getViewport()

            local minW = math.min(380, math.max(160, view.X - 24))
            local minH = math.min(280, math.max(140, view.Y - 24))
            local maxW = math.max(minW, view.X - resizeStartTopLeft.X - 8)
            local maxH = math.max(minH, view.Y - resizeStartTopLeft.Y - 8)

            local newWidth = clamp(resizeStartSize.X + delta.X, minW, maxW)
            local newHeight = clamp(resizeStartSize.Y + delta.Y, minH, maxH)

            wrapper.Size = UDim2.fromOffset(newWidth, newHeight)
            baseSize = UDim2.fromOffset(newWidth, newHeight)
            wrapper.Position = UDim2.fromOffset(
                resizeStartTopLeft.X + newWidth / 2,
                resizeStartTopLeft.Y + newHeight / 2
            )

            return
        end

        if not dragging then
            return
        end

        local mouseMove = dragInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement

        local touchMove = dragInputType == Enum.UserInputType.Touch
            and input.UserInputType == Enum.UserInputType.Touch

        if not mouseMove and not touchMove then
            return
        end

        local pointer = Vector2.new(input.Position.X, input.Position.Y)
        local delta = pointer - dragStart
        local x, y = clampWindowCenter(
            startCenter.X + delta.X,
            startCenter.Y + delta.Y
        )

        dragTargetPosition = UDim2.fromOffset(x, y)
        startRenderLoop()
    end)

    window._inputEndedConnection = UserInputService.InputEnded:Connect(function(input)
        if resizing and input.UserInputType == resizeInputType then
            resizing = false
            resizeInputType = nil
        end

        if dragging and input.UserInputType == dragInputType then
            dragging = false
            dragInputType = nil
        end
    end)

    function window:Minimize(state)
        if closed then
            return
        end

        state = state and true or false

        if self.Minimized == state then
            return
        end

        if state then
            resizing = false
            resizeInputType = nil
            resizeHandle.Visible = false
            minButton.Text = "+"
        else
            resizeHandle.Visible = true
            minButton.Text = "−"
        end

        self.Minimized = state

        local targetSize

        if state then
            targetSize = UDim2.fromOffset(baseSize.X.Offset, 55)
        else
            targetSize = baseSize
        end

        if self.Visible then
            playTween(wrapper, Ease.Normal, {
                Size = targetSize,
            })
        end
    end

    function window:SetSize(newWidth, newHeight)
        if closed then
            return
        end

        local view = getViewport()
        local minW = math.min(380, math.max(160, view.X - 24))
        local minH = math.min(280, math.max(140, view.Y - 24))
        local maxW = math.max(minW, view.X - 16)
        local maxH = math.max(minH, view.Y - 16)

        newWidth = clamp(tonumber(newWidth) or baseSize.X.Offset, minW, maxW)
        newHeight = clamp(tonumber(newHeight) or baseSize.Y.Offset, minH, maxH)

        baseSize = UDim2.fromOffset(newWidth, newHeight)

        if not self.Minimized and self.Visible then
            playTween(wrapper, Ease.Normal, {
                Size = baseSize,
            })
        end
    end

    minButton.Activated:Connect(function()
        window:Minimize(not window.Minimized)
    end)

    closeButton.Activated:Connect(closeWindow)

    toggleButton.Activated:Connect(function()
        window:Toggle()
    end)

    function window:SelectTab(target)
        if closed or not target or self.ActiveTab == target then
            return
        end

        local previous = self.ActiveTab

        if previous then
            playTween(previous.Button, Ease.Fast, {
                BackgroundTransparency = 1,
            })

            playTween(previous.Stroke, Ease.Fast, {
                Transparency = 1,
            })

            playTween(previous.Label, Ease.Fast, {
                TextColor3 = Theme.TextDim,
            })

            previous.AccentBar.BackgroundTransparency = 1
            previous.Page.Visible = false
        end

        self.ActiveTab = target

        playTween(target.Button, Ease.Fast, {
            BackgroundTransparency = 0,
        })

        playTween(target.Stroke, Ease.Fast, {
            Transparency = 0.4,
        })

        playTween(target.Label, Ease.Fast, {
            TextColor3 = Theme.Text,
        })

        target.AccentBar.BackgroundTransparency = 0
        target.Page.Position = UDim2.new(0, 8, 0, 0)
        target.Page.Visible = true

        playTween(target.Page, Ease.Fast, {
            Position = UDim2.new(0, 0, 0, 0),
        })
    end

    function window:CreateTab(name)
        if closed then
            return nil
        end

        name = name or "Tab"

        local tabButton = Instance.new("TextButton")
        tabButton.Name = "Tab_" .. tostring(name)
        tabButton.Size = UDim2.new(1, 0, 0, 34)
        tabButton.BackgroundColor3 = Theme.SurfaceAlt
        tabButton.BackgroundTransparency = 1
        tabButton.AutoButtonColor = false
        tabButton.Text = ""
        tabButton.LayoutOrder = #self.Tabs + 1
        tabButton.ZIndex = 3
        applyCorner(tabButton)
        local tabStroke = applyStroke(tabButton, Theme.Stroke, 1, 1)
        tabButton.Parent = sidebar

        local tabAccent = Instance.new("Frame")
        tabAccent.Size = UDim2.new(0, 3, 0, 16)
        tabAccent.Position = UDim2.new(0, 6, 0.5, -8)
        tabAccent.BackgroundColor3 = accent
        tabAccent.BackgroundTransparency = 1
        tabAccent.BorderSizePixel = 0
        tabAccent.ZIndex = 4
        applyCorner(tabAccent)
        tabAccent.Parent = tabButton

        local tabLabel = Instance.new("TextLabel")
        tabLabel.BackgroundTransparency = 1
        tabLabel.Size = UDim2.new(1, -22, 1, 0)
        tabLabel.Position = UDim2.new(0, 18, 0, 0)
        tabLabel.Font = Theme.Font
        tabLabel.TextSize = 13
        tabLabel.TextColor3 = Theme.TextDim
        tabLabel.TextXAlignment = Enum.TextXAlignment.Left
        tabLabel.Text = tostring(name)
        tabLabel.ZIndex = 4
        tabLabel.Parent = tabButton

        local page = Instance.new("ScrollingFrame")
        page.Name = "Page_" .. tostring(name)
        page.Size = UDim2.fromScale(1, 1)
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.ScrollBarThickness = 3
        page.ScrollBarImageColor3 = accent
        page.CanvasSize = UDim2.new(0, 0, 0, 0)
        page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        page.ScrollingDirection = Enum.ScrollingDirection.Y
        page.Visible = false
        page.ZIndex = 3
        applyPadding(page, 0, 6, 0, 0)
        applyList(page, 10, Enum.HorizontalAlignment.Left)
        page.Parent = content

        local tab = {
            Button = tabButton,
            Page = page,
            Name = name,
            Stroke = tabStroke,
            Label = tabLabel,
            AccentBar = tabAccent,
        }

        tabButton.MouseEnter:Connect(function()
            if window.ActiveTab == tab or closed then
                return
            end

            playTween(tabButton, Ease.Fast, {
                BackgroundTransparency = 0.6,
            })
        end)

        tabButton.MouseLeave:Connect(function()
            if window.ActiveTab == tab or closed then
                return
            end

            playTween(tabButton, Ease.Fast, {
                BackgroundTransparency = 1,
            })
        end)

        tabButton.Activated:Connect(function()
            if not closed then
                window:SelectTab(tab)
            end
        end)

        table.insert(self.Tabs, tab)

        if #self.Tabs == 1 then
            self:SelectTab(tab)
        end

        return page, tab
    end

    Shared.MikuLibInstance = window
    return window
end

