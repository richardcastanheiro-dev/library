    content.BackgroundTransparency = 1
    content.ZIndex = 2
    applyPadding(content, 14, 14, 14, 14)
    content.Parent = root

    local window = {
        Gui = gui,
        Wrapper = wrapper,
        Root = root,
        Sidebar = sidebar,
        Content = content,
        Accent = accent,
        Tabs = {},
        ActiveTab = nil,
        Minimized = false,
        Closed = false,
        _destroyed = false,
    }

    local closed = false
    local baseSize = size

    local function destroy()
        if window._destroyed then return end
        window._destroyed = true
        if window._cleanupDrag then window._cleanupDrag() end
        if _activeClose then
            pcall(_activeClose)
            _activeClose = nil
        end
        pcall(function() gui:Destroy() end)
    end

    window.Destroy = destroy

    local isLocked = function() return closed end

    window._cleanupDrag = Lib.newDraggable(wrapper, topBar, isLocked)

    local function closeWindow()
        if closed then return end
        closed = true
        window.Closed = true
        TweenService:Create(root, Ease.In, {BackgroundTransparency = 1}):Play()
        TweenService:Create(shadow, Ease.In, {BackgroundTransparency = 1}):Play()
        TweenService:Create(wrapper, Ease.In, {Size = UDim2.new(0, 0, 0, 0)}):Play()
        task.delay(0.22, function()
            gui.Enabled = false
            task.wait(0.03)
            destroy()
        end)
    end

    window.Close = closeWindow

    closeBtn.MouseButton1Click:Connect(closeWindow)

    function window:Minimize(state)
        if closed then return end
        if self.Minimized == state then return end
        self.Minimized = state
        local target
        if state then
            target = UDim2.new(baseSize.X.Scale, baseSize.X.Offset, 0, 55)
        else
            target = baseSize
        end
        TweenService:Create(wrapper, Ease.Normal, {Size = target}):Play()
    end

    minBtn.MouseButton1Click:Connect(function()
        window:Minimize(not window.Minimized)
    end)

    local startSize = UDim2.new(
        baseSize.X.Scale, math.floor(baseSize.X.Offset * 0.94),
        baseSize.Y.Scale, math.floor(baseSize.Y.Offset * 0.94)
    )
    wrapper.Size = startSize
    TweenService:Create(wrapper, Ease.Slow, {Size = baseSize}):Play()
    TweenService:Create(root, Ease.Normal, {BackgroundTransparency = 0}):Play()
    TweenService:Create(shadow, Ease.Normal, {BackgroundTransparency = 0.55}):Play()

    function window:SelectTab(target)
        if self.ActiveTab == target then return end
        local prev = self.ActiveTab
        if prev and prev.Button and alive(prev.Button) then
            TweenService:Create(prev.Button, Ease.Fast, {BackgroundTransparency = 1}):Play()
            if prev.Stroke then
                TweenService:Create(prev.Stroke, Ease.Fast, {Transparency = 1}):Play()
            end
            if prev.Label then
                TweenService:Create(prev.Label, Ease.Fast, {TextColor3 = Theme.TextDim}):Play()
            end
            if prev.AccentBar then
                prev.AccentBar.BackgroundTransparency = 1
            end
            if prev.Page then
                prev.Page.Visible = false
            end
        end
        self.ActiveTab = target
        TweenService:Create(target.Button, Ease.Fast, {BackgroundTransparency = 0}):Play()
        TweenService:Create(target.Stroke, Ease.Fast, {Transparency = 0.4}):Play()
        TweenService:Create(target.Label, Ease.Fast, {TextColor3 = Theme.Text}):Play()
        target.AccentBar.BackgroundTransparency = 0
        target.Page.Visible = true
        target.Page.Position = UDim2.new(0, 8, 0, 0)
        TweenService:Create(target.Page, Ease.Fast, {Position = UDim2.new(0, 0, 0, 0)}):Play()
    end

    function window:CreateTab(name)
        local tabBtn = Instance.new("TextButton")
        tabBtn.Size = UDim2.new(1, 0, 0, 34)
        tabBtn.BackgroundColor3 = Theme.SurfaceAlt
        tabBtn.BackgroundTransparency = 1
        tabBtn.AutoButtonColor = false
        tabBtn.Text = ""
        tabBtn.ZIndex = 3
        applyCorner(tabBtn, 8)
        local tabStroke = applyStroke(tabBtn, Theme.Stroke, 1, 1)
        tabBtn.Parent = sidebar

        local tabAccent = Instance.new("Frame")
        tabAccent.Size = UDim2.new(0, 3, 0, 16)
        tabAccent.Position = UDim2.new(0, 6, 0.5, -8)
        tabAccent.BackgroundColor3 = accent
        tabAccent.BackgroundTransparency = 1
        tabAccent.BorderSizePixel = 0
        tabAccent.ZIndex = 4
        applyCorner(tabAccent, 3)
        tabAccent.Parent = tabBtn

        local tabLabel = Instance.new("TextLabel")
        tabLabel.BackgroundTransparency = 1
        tabLabel.Size = UDim2.new(1, -22, 1, 0)
        tabLabel.Position = UDim2.new(0, 18, 0, 0)
        tabLabel.Font = Theme.Font
        tabLabel.TextSize = 13
        tabLabel.TextColor3 = Theme.TextDim
        tabLabel.TextXAlignment = Enum.TextXAlignment.Left
        tabLabel.Text = name
        tabLabel.ZIndex = 4
        tabLabel.Parent = tabBtn

        local page = Instance.new("ScrollingFrame")
        page.Size = UDim2.fromScale(1, 1)
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.ScrollBarThickness = 3
        page.ScrollBarImageColor3 = accent
        page.CanvasSize = UDim2.new(0, 0, 0, 0)
        page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        page.Visible = false
        page.ZIndex = 2
        applyPadding(page, 0, 6, 0, 0)
        applyList(page, 8)
        page.Parent = content

        local tab = {
            Button = tabBtn,
            Page = page,
            Name = name,
            Stroke = tabStroke,
            Label = tabLabel,
            AccentBar = tabAccent,
        }

        tabBtn.MouseEnter:Connect(function()
            if window.ActiveTab == tab then return end
            TweenService:Create(tabBtn, Ease.Fast, {BackgroundTransparency = 0.6}):Play()
        end)
        tabBtn.MouseLeave:Connect(function()
            if window.ActiveTab == tab then return end
            TweenService:Create(tabBtn, Ease.Fast, {BackgroundTransparency = 1}):Play()
        end)
        tabBtn.MouseButton1Click:Connect(function()
            if closed then return end
            window:SelectTab(tab)
        end)

        table.insert(self.Tabs, tab)
        if #self.Tabs == 1 then
            window:SelectTab(tab)
        end

        return tab.Page, tab
    end

    getgenv().MikuLibInstance = window
    return window
end

function Lib:CreateButton(parent, text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = Theme.SurfaceAlt
    btn.AutoButtonColor = false
    btn.Text = ""
    applyCorner(btn, 9)
    local stroke = applyStroke(btn, Theme.Stroke, 1, 0.4)
    btn.Parent = parent

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Theme.FontSemi
    label.TextSize = 14
    label.TextColor3 = Theme.Text
    label.Text = text
    label.Parent = btn

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, Ease.Fast, {BackgroundColor3 = Theme.SurfaceHi}):Play()
        TweenService:Create(stroke, Ease.Fast, {Color = Theme.Accent, Transparency = 0.1}):Play()
        TweenService:Create(label, Ease.Fast, {TextColor3 = Theme.AccentSoft}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, Ease.Fast, {BackgroundColor3 = Theme.SurfaceAlt}):Play()
        TweenService:Create(stroke, Ease.Fast, {Color = Theme.Stroke, Transparency = 0.4}):Play()
        TweenService:Create(label, Ease.Fast, {TextColor3 = Theme.Text}):Play()
    end)
    btn.MouseButton1Down:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.06), {BackgroundColor3 = Theme.Accent}):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        TweenService:Create(btn, Ease.Fast, {BackgroundColor3 = Theme.SurfaceHi}):Play()
    end)
    if callback then
        btn.MouseButton1Click:Connect(callback)
    end
    return btn
end

