		default = cfg.Default; cb = cfg.Callback end
	if type(default) == "function" and cb == nil then cb = default; default = nil end
	options = type(options) == "table" and options or {}

	local multi = cfg and cfg.Multi == true
	local searchable = cfg and cfg.Searchable == true
	local selected = {}
	if multi then
		if type(default) == "table" then for _, v in ipairs(default) do selected[v] = true end end
	else selected = default; if selected == nil then selected = options[1] end end

	local control, page = prepareControl(parent, 42, "Frame")
	local row = make("TextButton", { Size = UDim2.new(1, 0, 0, 42),
		BackgroundColor3 = Theme.SurfaceAlt, BackgroundTransparency = 0.25,
