			ZIndex = 3,
			LayoutOrder = #tabs + 1
		})
		corner(tabButton, 8)
		pad(tabButton, 0, 10, 0, 14)
		local indicator = make("Frame", {
			Name = "Indicator",
			Parent = tabButton,
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 4, 0.5, -9),
			Size = UDim2.fromOffset(3, 18),
			Visible = false,
			ZIndex = 4
		})
		corner(indicator, 2)
		local tab = {
			Name = tabName,
			Page = page,
			Button = tabButton,
			Indicator = indicator
		}
		tab.CreateButton = function(_, configArg, callbackArg)
			return createButtonControl(page, configArg, callbackArg)
		end
		tab.CreateToggle = function(_, configArg, defaultArg, callbackArg)
			return createToggleControl(page, configArg, defaultArg, callbackArg)
		end
		tab.CreateSlider = function(_, configArg, minArg, maxArg, defaultArg, callbackArg)
			return createSliderControl(page, configArg, minArg, maxArg, defaultArg, callbackArg)
		end
		tab.CreateTextBox = function(_, configArg, placeholderArg, callbackArg)
			return createTextBoxControl(page, configArg, placeholderArg, callbackArg)
		end
		tab.CreateLabel = function(_, configArg)
			return createLabelControl(page, configArg)
		end
		tab.CreateDivider = function(_, configArg)
			return createDividerControl(page, configArg)
		end
		tab.CreateSection = function(_, configArg)
			return createSectionControl(page, configArg)
		end
		tab.CreateDropdown = function(_, configArg, optionsArg, defaultArg, callbackArg)
