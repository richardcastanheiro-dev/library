function Lib:CreateWindow(config)
    config = config or {}
    local title    = config.Title or "Miku"
    local subtitle = config.Subtitle or "v" .. self.Version
    local size     = config.Size or UDim2.fromOffset(560, 400)
    local accent   = config.Accent or Theme.Accent

    local gui = Instance.new("ScreenGui")
    gui.Name = "MikuLib"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 9999
    gui.Parent = guiParent()

    ------------------------------------------------------------
    -- ★ Wrapper: transparente, segura tamanho e posição
    ------------------------------------------------------------
    local wrapper = Instance.new("Frame")
    wrapper.Name = "Wrapper"
    wrapper.Size = size
    wrapper.AnchorPoint = Vector2.new(0.5, 0.5)
    wrapper.Position = UDim2.new(0.5, 0, 0.5, 0)
    wrapper.BackgroundTransparency = 1
    wrapper.BorderSizePixel = 0
    wrapper.ClipsDescendants = false
    wrapper.Parent = gui

    ------------------------------------------------------------
    -- ★ Shadow: filha do wrapper (nunca mais ocupa a tela inteira)
    ------------------------------------------------------------
    local shadow = Instance.new("Frame")
    shadow.Name = "Shadow"
    shadow.AnchorPoint = Vector2.new(0.5, 0.5)
    shadow.Position = UDim2.new(0.5, 0, 0.5, 0)
    shadow.Size = UDim2.new(1, 26, 1, 26)      -- janela + 26 px
    shadow.BackgroundColor3 = Color3.new(0, 0, 0)
    shadow.BackgroundTransparency = 1
    shadow.BorderSizePixel = 0
    shadow.ZIndex = 0
    applyCorner(shadow, 18)
    shadow.Parent = wrapper

    ------------------------------------------------------------
    -- Root
    ------------------------------------------------------------
    local root = Instance.new("Frame")
    root.Name = "Root"
    root.Size = UDim2.new(1, 0, 1, 0)
    root.BackgroundColor3 = Theme.Surface
    root.BorderSizePixel = 0
    root.ClipsDescendants = false
    root.ZIndex = 1
    applyCorner(root, 14)
    applyStroke(root, Theme.Stroke, 1, 0.25)
    root.Parent = wrapper

    -- TopBar
    local topBar = Instance.new("Frame")
    topBar.Size = UDim2.new(1, 0, 0, 54)
    topBar.BackgroundTransparency = 1
    topBar.ZIndex = 2
    applyCorner(topBar, 14)
    topBar.Parent = root

    local accentBar = Instance.new("Frame")
    accentBar.Size = UDim2.new(0, 3, 0, 22)
    accentBar.Position = UDim2.new(0, 18, 0.5, -11)
    accentBar.BackgroundColor3 = accent
    accentBar.BorderSizePixel = 0
    accentBar.ZIndex = 3
    applyCorner(accentBar, 4)
    accentBar.Parent = topBar

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Size = UDim2.new(0, 300, 0, 20)
    titleLabel.Position = UDim2.new(0, 32, 0, 12)
    titleLabel.Font = Theme.FontBold; titleLabel.TextSize = 16
    titleLabel.TextColor3 = Theme.Text
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Text = title; titleLabel.ZIndex = 3
    titleLabel.Parent = topBar

    local subtitleLabel = Instance.new("TextLabel")
    subtitleLabel.BackgroundTransparency = 1
    subtitleLabel.Size = UDim2.new(0, 300, 0, 14)
    subtitleLabel.Position = UDim2.new(0, 32, 0, 30)
    subtitleLabel.Font = Theme.Font; subtitleLabel.TextSize = 12
    subtitleLabel.TextColor3 = Theme.TextDim
    subtitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    subtitleLabel.Text = subtitle; subtitleLabel.ZIndex = 3
    subtitleLabel.Parent = topBar

    -- Botão minimizar
    local minBtn = Instance.new("TextButton")
    minBtn.Size = UDim2.fromOffset(28, 28)
    minBtn.Position = UDim2.new(1, -72, 0.5, -14)
    minBtn.BackgroundColor3 = Theme.SurfaceAlt
    minBtn.AutoButtonColor = false
    minBtn.Text = "–"; minBtn.Font = Theme.FontBold
    minBtn.TextSize = 16; minBtn.TextColor3 = Theme.TextDim
    minBtn.ZIndex = 3
    applyCorner(minBtn, 8)
    applyStroke(minBtn, Theme.Stroke, 1, 0.4)
    minBtn.Parent = topBar

    -- Botão fechar
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.fromOffset(28, 28)
    closeBtn.Position = UDim2.new(1, -38, 0.5, -14)
    closeBtn.BackgroundColor3 = Theme.SurfaceAlt
    closeBtn.AutoButtonColor = false
    closeBtn.Text = "×"; closeBtn.Font = Theme.FontBold
    closeBtn.TextSize = 18; closeBtn.TextColor3 = Theme.TextDim
    closeBtn.ZIndex = 3
    applyCorner(closeBtn, 8)
    local closeStroke = applyStroke(closeBtn, Theme.Stroke, 1, 0.4)
    closeBtn.Parent = topBar

    closeBtn.MouseEnter:Connect(function()
        TweenService:Create(closeBtn, Ease.Fast, {BackgroundColor3 = Theme.Danger, TextColor3 = Theme.Text}):Play()
        TweenService:Create(closeStroke, Ease.Fast, {Color = Theme.Danger, Transparency = 0.1}):Play()
    end)
    closeBtn.MouseLeave:Connect(function()
        TweenService:Create(closeBtn, Ease.Fast, {BackgroundColor3 = Theme.SurfaceAlt, TextColor3 = Theme.TextDim}):Play()
        TweenService:Create(closeStroke, Ease.Fast, {Color = Theme.Stroke, Transparency = 0.4}):Play()
    end)
    minBtn.MouseEnter:Connect(function()
        TweenService:Create(minBtn, Ease.Fast, {BackgroundColor3 = Theme.SurfaceHi, TextColor3 = Theme.Text}):Play()
    end)
    minBtn.MouseLeave:Connect(function()
        TweenService:Create(minBtn, Ease.Fast, {BackgroundColor3 = Theme.SurfaceAlt, TextColor3 = Theme.TextDim}):Play()
    end)

    local divider = Instance.new("Frame")
    divider.Size = UDim2.new(1, -32, 0, 1)
    divider.Position = UDim2.new(0, 16, 0, 54)
    divider.BackgroundColor3 = Theme.Stroke
    divider.BackgroundTransparency = 0.5
    divider.BorderSizePixel = 0
    divider.ZIndex = 2
    divider.Parent = root

    -- Sidebar
    local sidebar = Instance.new("Frame")
    sidebar.Name = "Sidebar"
    sidebar.Size = UDim2.new(0, 150, 1, -55)
    sidebar.Position = UDim2.new(0, 0, 0, 55)
    sidebar.BackgroundTransparency = 1
    sidebar.BorderSizePixel = 0
    sidebar.ZIndex = 2
    applyPadding(sidebar, 8, 8, 10, 10)
    applyList(sidebar, 6)
    sidebar.Parent = root

    local sidebarDivider = Instance.new("Frame")
    sidebarDivider.Size = UDim2.new(0, 1, 1, -80)
    sidebarDivider.Position = UDim2.new(0, 150, 0, 55)
    sidebarDivider.BackgroundColor3 = Theme.Stroke
    sidebarDivider.BackgroundTransparency = 0.6
    sidebarDivider.BorderSizePixel = 0
    sidebarDivider.ZIndex = 2
    sidebarDivider.Parent = root

    -- Content
    local content = Instance.new("Frame")
    content.Name = "Content"
    content.Size = UDim2.new(1, -151, 1, -55)
    content.Position = UDim2.new(0, 151, 0, 55)
    content.BackgroundTransparency = 1
    content.ZIndex = 2
    applyPadding(content, 14, 14, 14, 14)
    content.Parent = root

    -- Objeto window
    local window = {
        Gui = gui, Wrapper = wrapper, Root = root,
        Sidebar = sidebar, Content = content, Accent = accent,
        Tabs = {}, ActiveTab = nil, Minimized = false,
    }

    function window:Destroy()
        pcall(function() gui:Destroy() end)
    end

    function window:Minimize(state)
        self.Minimized = state
        TweenService:Create(root, Ease.Normal, {
            Size = state and UDim2.new(1, 0, 0, 55) or UDim2.new(1, 0, 1, 0)
        }):Play()
    end

    minBtn.MouseButton1Click:Connect(function()
        window:Minimize(not window.Minimized)
    end)

    closeBtn.MouseButton1Click:Connect(function()
        if hasGroup(root) then
            TweenService:Create(root, Ease.In, {
                Size = UDim2.new(0.9, 0, 0.9, 0),
                GroupTransparency = 1,
            }):Play()
        else
            TweenService:Create(root, Ease.In, {
                Size = UDim2.new(0.9, 0, 0.9, 0),
                BackgroundTransparency = 1,
            }):Play()
            TweenService:Create(shadow, Ease.In, {BackgroundTransparency = 1}):Play()
        end
        task.wait(0.22)
        window:Destroy()
    end)

    Lib.newDraggable(wrapper, topBar)

    ------------------------------------------------------------
    -- ★ Animação de abertura (suave, SEM tela preta)
    ------------------------------------------------------------
    local grouped = hasGroup(root)
    root.BackgroundTransparency = 1
    shadow.BackgroundTransparency = 1
    wrapper.Size = UDim2.new(
        size.X.Scale, math.floor(size.X.Offset * 0.92),
        size.Y.Scale, math.floor(size.Y.Offset * 0.92)
    )
    if grouped then root.GroupTransparency = 1 end

    TweenService:Create(wrapper, Ease.Spring, {Size = size}):Play()
    TweenService:Create(root, Ease.Normal, {BackgroundTransparency = 0}):Play()
    TweenService:Create(shadow, Ease.Normal, {BackgroundTransparency = 0.55}):Play()
    if grouped then
        TweenService:Create(root, Ease.Normal, {GroupTransparency = 0}):Play()
    end

    ------------------------------------------------------------
    -- Tabs
    ------------------------------------------------------------
    function window:CreateTab(name)
        local tabBtn = Instance.new("TextButton")
        tabBtn.Size = UDim2.new(1, 0, 0, 34)
        tabBtn.BackgroundColor3 = Theme.SurfaceAlt
        tabBtn.BackgroundTransparency = 1
        tabBtn.AutoButtonColor = false
        tabBtn.Text = ""; tabBtn.ZIndex = 3
        applyCorner(tabBtn, 8)
        local tabStroke = applyStroke(tabBtn, Theme.Stroke, 1, 1)
        tabBtn.Parent = sidebar

        local tabAccent = Instance.new("Frame")
        tabAccent.Size = UDim2.new(0, 3, 0, 16)
        tabAccent.Position = UDim2.new(0, 6, 0.5, -8)
        tabAccent.BackgroundColor3 = accent
        tabAccent.BackgroundTransparency = 1
        tabAccent.BorderSizePixel = 0
        tabAccent.ZIndex = 4
        applyCorner(tabAccent, 3)
        tabAccent.Parent = tabBtn

        local tabLabel = Instance.new("TextLabel")
        tabLabel.BackgroundTransparency = 1
        tabLabel.Size = UDim2.new(1, -22, 1, 0)
        tabLabel.Position = UDim2.new(0, 18, 0, 0)
        tabLabel.Font = Theme.Font; tabLabel.TextSize = 13
        tabLabel.TextColor3 = Theme.TextDim
        tabLabel.TextXAlignment = Enum.TextXAlignment.Left
        tabLabel.Text = name; tabLabel.ZIndex = 4
        tabLabel.Parent = tabBtn

        local page = Instance.new("ScrollingFrame")
        page.Size = UDim2.fromScale(1, 1)
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.ScrollBarThickness = 3
        page.ScrollBarImageColor3 = accent
        page.CanvasSize = UDim2.new(0, 0, 0, 0)
        page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        page.Visible = false
        page.ZIndex = 2
        applyPadding(page, 0, 6, 0, 0)
        applyList(page, 8)
        page.Parent = content

        local tab = { Button = tabBtn, Page = page, Name = name }

        function window:SelectTab(target)
            if self.ActiveTab == target then return end
            if self.ActiveTab then
                local prev = self.ActiveTab
                TweenService:Create(prev.Button, Ease.Fast, {BackgroundTransparency = 1}):Play()
                TweenService:Create(prev.Button:FindFirstChildOfClass("UIStroke"), Ease.Fast, {Transparency = 1}):Play()
                TweenService:Create(prev.Button:FindFirstChildOfClass("TextLabel"), Ease.Fast, {TextColor3 = Theme.TextDim}):Play()
                prev.Button:FindFirstChild("Frame").BackgroundTransparency = 1
                prev.Page.Visible = false
            end
            self.ActiveTab = target
            TweenService:Create(target.Button, Ease.Fast, {BackgroundTransparency = 0}):Play()
            TweenService:Create(target.Button:FindFirstChildOfClass("UIStroke"), Ease.Fast, {Transparency = 0.4}):Play()
            TweenService:Create(target.Button:FindFirstChildOfClass("TextLabel"), Ease.Fast, {TextColor3 = Theme.Text}):Play()
            target.Button:FindFirstChild("Frame").BackgroundTransparency = 0
            target.Page.Visible = true
            target.Page.Position = UDim2.new(0, 8, 0, 0)
            TweenService:Create(target.Page, Ease.Fast, {Position = UDim2.new(0, 0, 0, 0)}):Play()
        end

        tabBtn.MouseEnter:Connect(function()
            if window.ActiveTab == tab then return end
            TweenService:Create(tabBtn, Ease.Fast, {BackgroundTransparency = 0.6}):Play()
        end)
        tabBtn.MouseLeave:Connect(function()
            if window.ActiveTab == tab then return end
            TweenService:Create(tabBtn, Ease.Fast, {BackgroundTransparency = 1}):Play()
        end)
        tabBtn.MouseButton1Click:Connect(function()
            window:SelectTab(tab)
        end)

        table.insert(self.Tabs, tab)
        if #self.Tabs == 1 then window:SelectTab(tab) end

        return tab.Page, tab
    end

    getgenv().MikuLibInstance = window
    return window
end

