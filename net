local function createSliderControl(parent, config, minValue, maxValue, defaultValue, callback)
	if type(config) == "string" then
		config = {
			Text = config,
			Min = minValue,
			Max = maxValue,
			Default = defaultValue,
			Callback = callback
		}
	end
	if type(config) ~= "table" then
		config = {}
	end
	local callbackValue = config.Callback or callback
	local min = tonumber(config.Min) or 0
	local max = tonumber(config.Max) or 100
	if max < min then
		min, max = max, min
	end
	if max == min then
		max = min + 1
	end
	local decimals = math.clamp(math.floor(tonumber(config.Decimals) or 0), 0, 8)
	local step = tonumber(config.Step)
	local suffix = tostring(config.Suffix or "")
	local initial = min
	if config.Default ~= nil then
		initial = tonumber(config.Default) or min
	elseif defaultValue ~= nil then
		initial = tonumber(defaultValue) or min
	end
	local row = make("Frame", {
		Name = "Slider",
		Parent = parent,
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 48),
		ZIndex = 2,
		LayoutOrder = nextOrder(parent)
	})
	corner(row, 8)
	stroke(row, Theme.Stroke, 1, 0.55)
	local label = make("TextLabel", {
		Name = "Label",
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -120, 0, 16),
		Text = tostring(config.Text or config.Title or config.Name or "Slider"),
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 3
	})
	local valueLabel = make("TextLabel", {
		Name = "Value",
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -90, 0, 5),
		Size = UDim2.fromOffset(78, 18),
		Text = "",
		Font = Theme.FontBold,
		TextSize = 11,
		TextColor3 = Theme.AccentSoft,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = 3
	})
	local track = make("Frame", {
		Name = "Track",
		Parent = row,
		BackgroundColor3 = Theme.SurfaceHi,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, 32),
		Size = UDim2.new(1, -24, 0, 4),
		ClipsDescendants = false,
		ZIndex = 3
	})
	corner(track, 2)
	local fill = make("Frame", {
		Name = "Fill",
		Parent = track,
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		ZIndex = 4
	})
	corner(fill, 2)
	local knob = make("Frame", {
		Name = "Knob",
		Parent = track,
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		ZIndex = 5
	})
	corner(knob, 6)
	stroke(knob, Theme.Bg, 1, 0.2)
	local hit = make("TextButton", {
		Name = "SliderHit",
		Parent = row,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(8, 22),
		Size = UDim2.new(1, -16, 0, 22),
		Text = "",
		AutoButtonColor = false,
		ZIndex = 6
	})
	local value = initial
	local slider = {
		Row = row,
		Fill = fill,
		Knob = knob,
		ValueLabel = valueLabel,
		Value = initial
	}
	local function formatValue(current)
		local formatted
		if decimals > 0 then
			formatted = string.format("%." .. decimals .. "f", current)
		else
			formatted = tostring(math.floor(current + 0.5))
		end
		if suffix ~= "" then
			return formatted .. " " .. suffix
		end
		return formatted
	end
	local function applyValue(newValue, silent)
		newValue = tonumber(newValue) or min
		newValue = math.clamp(newValue, min, max)
		if step and step > 0 then
			newValue = min + math.floor((newValue - min) / step + 0.5) * step
		end
		if decimals > 0 then
			local multiplier = 10 ^ decimals
			newValue = math.floor(newValue * multiplier + 0.5) / multiplier
		else
			newValue = math.floor(newValue + 0.5)
		end
		newValue = math.clamp(newValue, min, max)
		value = newValue
		slider.Value = value
		local ratio = (value - min) / (max - min)
		fill.Size = UDim2.fromScale(ratio, 1)
		knob.Position = UDim2.new(ratio, 0, 0.5, 0)
		valueLabel.Text = formatValue(value)
		if not silent and callbackValue then
			task.spawn(function()
				callbackValue(value)
			end)
		end
	end
	local function updateFromX(x)
		local trackPosition = track.AbsolutePosition
		local trackWidth = math.max(1, track.AbsoluteSize.X)
		local ratio = math.clamp((x - trackPosition.X) / trackWidth, 0, 1)
		applyValue(min + (max - min) * ratio, false)
	end
	slider.Set = function(a, b)
		local newValue
		if b ~= nil then
			newValue = b
		elseif a ~= slider then
			newValue = a
		end
		if newValue ~= nil then
			applyValue(newValue, false)
		end
	end
	slider.Get = function()
		return value
	end
	local sliding = false
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			updateFromX(input.Position.X)
		end
	end)
	local changedConnection = UserInputService.InputChanged:Connect(function(input)
		if not sliding then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			updateFromX(input.Position.X)
		end
	end)
	local endedConnection = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)
	row.Destroying:Connect(function()
		changedConnection:Disconnect()
		endedConnection:Disconnect()
	end)
	applyValue(initial, true)
	return slider
end

