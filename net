local function createSlider(parent, text, min, max, default, callback)
	local holder = make("Frame", {
		Name = "Slider",
		Size = UDim2.new(1, 0, 0, 48),
		BackgroundTransparency = 1
	}, parent)

	local label = createText(holder, text or "", 12, Theme.Text)
	label.Size = UDim2.new(1, -48, 0, 18)

	local valueLabel = createText(holder, tostring(default or min or 0), 12, Theme.TextDim)
	valueLabel.Position = UDim2.new(1, -44, 0, 0)
	valueLabel.Size = UDim2.fromOffset(44, 18)
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right

	local bar = make("Frame", {
		Name = "Bar",
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 5),
		BackgroundColor3 = Theme.SurfaceHi,
		BorderSizePixel = 0
	}, holder)

	corner(bar, 6)

	local fill = make("Frame", {
		Name = "Fill",
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0
	}, bar)

	corner(fill, 6)

	local knob = make("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0
	}, bar)

	corner(knob, 20)

	local low = tonumber(min) or 0
	local high = tonumber(max) or 100
	local value = math.clamp(tonumber(default) or low, low, high)

	local function set(newValue, silent)
		value = math.clamp(tonumber(newValue) or low, low, high)
		local alpha = high == low and 0 or (value - low) / (high - low)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		valueLabel.Text = tostring(math.floor(value * 100 + 0.5) / 100)
		if not silent then
			safeCall(callback, value)
		end
	end

	local dragging = false

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
			set(low + (high - low) * alpha)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
			set(low + (high - low) * alpha)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	set(value, true)

	return holder, function()
		return value
	end, set
end

local function createDropdown(parent, text, options, default, callback)
	local holder = make("Frame", {
		Name = "Dropdown",
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundTransparency = 1,
		ClipsDescendants = false
	}, parent)

	local label = createText(holder, text or "", 12, Theme.Text)
	label.Size = UDim2.new(1, 0, 0, 18)

	local button = make("TextButton", {
		Name = "Select",
		Position = UDim2.fromOffset(0, 21),
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = Theme.SurfaceAlt,
		BorderSizePixel = 0,
		Text = tostring(default or "Select"),
		TextColor3 = Theme.Text,
		TextSize = 12,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left
	}, holder)

	corner(button, 6)
	addPadding(button, 8, 8, 0, 0)

	local arrow = createText(button, "⌄", 15, Theme.TextDim)
	arrow.AnchorPoint = Vector2.new(1, 0.5)
	arrow.Position = UDim2.new(1, -5, 0.5, 0)
	arrow.Size = UDim2.fromOffset(16, 20)
	arrow.TextXAlignment = Enum.TextXAlignment.Center

	local list = make("Frame", {
		Name = "Options",
		Position = UDim2.new(0, 0, 1, 4),
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = Theme.Surface,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 20,
		ClipsDescendants = true
	}, holder)

	corner(list, 6)
	stroke(list, Theme.Stroke, 0.4)

	addPadding(list, 4, 4, 4, 4)
	local layout = addList(list, Enum.FillDirection.Vertical, 3)

	local selected = default
	local opened = false

	local function refresh()
		local count = #options
		local height = math.min(count * 27 + 8, 150)
		list.Size = UDim2.new(1, 0, 0, opened and height or 0)
	end

	local function set(value, silent)
		selected = value
		button.Text = tostring(value or "Select")
		if not silent then
			safeCall(callback, value)
		end
	end

	local function populate()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		for _, option in ipairs(options) do
			local item = make("TextButton", {
				Size = UDim2.new(1, 0, 0, 24),
				BackgroundColor3 = Theme.SurfaceAlt,
				BorderSizePixel = 0,
				Text = tostring(option),
				TextColor3 = Theme.Text,
				TextSize = 11,
				Font = Enum.Font.Gotham,
				AutoButtonColor = false,
				ZIndex = 21
			}, list)

			corner(item, 4)

			item.MouseButton1Click:Connect(function()
				set(option)
				opened = false
				list.Visible = false
				refresh()
			end)
		end

		refresh()
	end

	button.MouseButton1Click:Connect(function()
		opened = not opened
		list.Visible = opened
		refresh()
	end)

	populate()

	return holder, function()
		return selected
	end, set, function(newOptions)
		options = newOptions or {}
		populate()
	end
end
	function Window:SetProfile(profile)
    if self._destroyed then
        return
    end

    profile = type(profile) == "table" and profile or {}

    if profile.Hidden ~= nil then
        self._profileCard.Visible = not profile.Hidden
    end

    if profile.Name ~= nil then
        self._profileName.Text = tostring(profile.Name)
    end

    if profile.Tag ~= nil then
        self._profileTag.Text = tostring(profile.Tag)
    end

    if profile.Image ~= nil then
        self._avatar.Image = tostring(profile.Image)
    end
end


function Window:SelectTab(target)
	if type(target) == "table" and target._mikuPage then
		target = target._mikuPage
	end
	local entry
	if type(target) == "table" and target.Button and target.Page then
		entry = target
	else
		for _, item in ipairs(self._tabs) do
			if item == target or item.Name == target or item.Button == target or item.Page == target or item.Button.Name == target or item.Page.Name == target then
				entry = item
				break
			end
		end
		if not entry and type(target) == "number" then
			entry = self._tabs[target]
		end
	end
	if not entry then
		return
	end
	for _, item in ipairs(self._tabs) do
		local active = item == entry
		item.Active = active
		item.Page.Visible = active
		item.Indicator.Visible = active
		item.Label.TextColor3 = active and Theme.Text or Theme.TextDim
		item.Label.Font = active and Enum.Font.GothamSemibold or Enum.Font.GothamMedium
		item.Button.BackgroundColor3 = active and Theme.SurfaceHi or Theme.SurfaceAlt
		item.Button.BackgroundTransparency = active and 0.05 or 1
		local tabIcon = item.Button:FindFirstChild("TabIcon")
		if tabIcon then
			tabIcon.ImageColor3 = active and Theme.AccentSoft or Theme.TextDim
		end
	end
	self._activeTab = entry.Page
	refreshPage(entry.Page)
end

function Window:GetActiveTab()
	return self._activeTab
end

function Window:CreateTab(name, iconName)
	if self._destroyed then
		return
	end
	local config = type(name) == "table" and name or nil
	if config then
		iconName = config.icon or config.Icon or config.IconName or config.iconName
		name = config.name or config.Name or config.Title or "Tab"
	end
	name = tostring(name or "Tab")

	local page = make("ScrollingFrame", {
		Name = name .. "Page",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.fromOffset(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.None,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Accent,
		Visible = false
	}, self.Content)

	addPadding(page, 10, 10, 10, 10)
	local pageHolder = make("Frame", {
		Name = "Holder",
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1
	}, page)

	local holderLayout = addList(pageHolder, Enum.FillDirection.Vertical, 8)
	pageHolder.AutomaticSize = Enum.AutomaticSize.Y

	local function refresh()
		page.CanvasSize = UDim2.fromOffset(0, pageHolder.AbsoluteSize.Y + 20)
	end

	holderLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refresh)
	refresh()

	local button = make("TextButton", {
		Name = name .. "Tab",
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundColor3 = Theme.SurfaceAlt,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = #self._tabs + 1
	}, self.TabList)

	corner(button, 7)

	local indicator = make("Frame", {
		Name = "Indicator",
		Position = UDim2.fromOffset(0, 9),
		Size = UDim2.fromOffset(3, 20),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Visible = false
	}, button)

	corner(indicator, 4)

	local iconImage
	if iconName then
		iconImage = createIcon(button, iconName, 17, Theme.TextDim)
		if iconImage then
			iconImage.Name = "TabIcon"
			iconImage.Position = UDim2.fromOffset(11, 10)
		end
	end

	local label = createText(button, name, 12, Theme.TextDim, Enum.Font.GothamMedium)
	label.Position = UDim2.fromOffset(iconImage and 37 or 14, 0)
	label.Size = UDim2.new(1, iconImage and -42 or -20, 1, 0)

	local entry = {
		Name = name,
		Button = button,
		Page = page,
		Holder = pageHolder,
		Indicator = indicator,
		Label = label,
		Icon = iconImage,
		Active = false
	}

	table.insert(self._tabs, entry)

	button.MouseEnter:Connect(function()
		if not entry.Active then
			applyTween(button, Fast, {
				BackgroundTransparency = 0.35
			})
		end
	end)

	button.MouseLeave:Connect(function()
		if not entry.Active then
			applyTween(button, Fast, {
				BackgroundTransparency = 1
			})
		end
	end)

	button.MouseButton1Click:Connect(function()
		self:SelectTab(entry)
	end)

	if #self._tabs == 1 then
		self:SelectTab(entry)
	end

	return page
end

function Window:SetVisible(state)
	if self._destroyed then
		return
	end
	self.Main.Visible = state == true
end

function Window:Toggle()
	if self._destroyed then
		return
	end
	self.Main.Visible = not self.Main.Visible
end

function Window:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	for _, connection in ipairs(self._connections or {}) do
		disconnect(connection)
	end
	destroy(self.ScreenGui)
	for index, window in ipairs(Lib.Windows) do
		if window == self then
			table.remove(Lib.Windows, index)
			break
		end
	end
end

