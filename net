	local function clampWindowBounds()
		local currentViewport = getViewport()
		local currentSize = wrapper.AbsoluteSize
		local limitWidth = math.max(140, currentViewport.X - 16)
		local limitHeight = math.max(140, currentViewport.Y - 16)
		local targetWidth = math.min(currentSize.X, limitWidth)
		local targetHeight = math.min(currentSize.Y, limitHeight)
		if targetWidth ~= currentSize.X or targetHeight ~= currentSize.Y then
			wrapper.Size = UDim2.fromOffset(math.floor(targetWidth), math.floor(targetHeight))
		end
		local position = wrapper.Position
		local maxX = math.max(8, currentViewport.X - targetWidth - 8)
		local maxY = math.max(8, currentViewport.Y - targetHeight - 8)
		wrapper.Position = UDim2.fromOffset(
			math.clamp(position.X.Offset, 8, maxX),
			math.clamp(position.Y.Offset, 8, maxY)
		)
	end
	local windowVisible = true
	local visibilityTween = nil
	local slideOffset = 16
	local function setWindowVisible(visible)
		if destroyed then
			return
		end
		visible = visible == true
		if visible and windowVisible and wrapper.Visible and visibilityTween == nil and root.GroupTransparency <= 0.001 and root.Position.Y.Offset == 0 then
			return
		end
		if not visible and not windowVisible and not wrapper.Visible and visibilityTween == nil then
			return
		end
		windowVisible = visible
		window.Visible = visible
		context.closeAllDropdowns()
		if visibilityTween then
			visibilityTween:Cancel()
			visibilityTween = nil
		end
		if visible then
			wrapper.Visible = true
			if root.GroupTransparency >= 0.995 or root.Position.Y.Offset ~= 0 then
				if root.GroupTransparency >= 0.995 then
					root.GroupTransparency = 1
				end
				root.Position = UDim2.fromOffset(0, slideOffset)
			end
			local animation = TweenService:Create(
				root,
				TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
				{
					GroupTransparency = 0,
					Position = UDim2.fromOffset(0, 0)
				}
			)
			visibilityTween = animation
			animation.Completed:Connect(function(state)
				if state == Enum.PlaybackState.Completed and visibilityTween == animation then
					root.GroupTransparency = 0
					root.Position = UDim2.fromOffset(0, 0)
					visibilityTween = nil
				end
			end)
			animation:Play()
		else
			if not wrapper.Visible then
				root.GroupTransparency = 1
				root.Position = UDim2.fromOffset(0, slideOffset)
				visibilityTween = nil
				return
			end
			local animation = TweenService:Create(
				root,
				TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
				{
					GroupTransparency = 1,
					Position = UDim2.fromOffset(0, slideOffset)
				}
			)
			visibilityTween = animation
			animation.Completed:Connect(function(state)
				if state == Enum.PlaybackState.Completed and not windowVisible and visibilityTween == animation then
					wrapper.Visible = false
					root.GroupTransparency = 1
					root.Position = UDim2.fromOffset(0, slideOffset)
					visibilityTween = nil
				end
			end)
			animation:Play()
		end
	end
