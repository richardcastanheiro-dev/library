function Lib:CreateDropdown(parent, text, options, callback)
    local wrapper = parent:FindFirstAncestor("Wrapper")

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 36)
    row.BackgroundColor3 = Theme.SurfaceAlt
    row.BackgroundTransparency = 0.4
    row.BorderSizePixel = 0
    row.ClipsDescendants = false
    applyCorner(row, 9)
    applyStroke(row, Theme.Stroke, 1, 0.4)
    row.Parent = parent

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(0.5, -20, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.Font = Theme.FontSemi
    label.TextSize = 14
    label.TextColor3 = Theme.Text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = text
    label.Parent = row

    local val = Instance.new("TextLabel")
    val.BackgroundTransparency = 1
    val.Size = UDim2.new(0.5, -30, 1, 0)
    val.Position = UDim2.new(0.5, 0, 0, 0)
    val.Font = Theme.Font
    val.TextSize = 13
    val.TextColor3 = Theme.TextDim
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.Text = tostring(options[1] or "")
    val.Parent = row

    local list = Instance.new("ScrollingFrame")
    list.Name = "MikuDropdownList"
    list.Size = UDim2.fromOffset(100, 0)
    list.Position = UDim2.new(0, 0, 0, 0)
    list.BackgroundColor3 = Theme.Surface
    list.BorderSizePixel = 0
    list.ClipsDescendants = true
    list.CanvasSize = UDim2.new(0, 0, 0, 0)
    list.AutomaticCanvasSize = Enum.AutomaticSize.Y
    list.ScrollBarThickness = 3
    list.ScrollBarImageColor3 = Theme.Accent
    list.Visible = false
    list.ZIndex = 50
    applyCorner(list, 9)
    applyStroke(list, Theme.Stroke, 1, 0.2)
    applyPadding(list, 6, 6, 6, 6)
    applyList(list, 4)
    list.Parent = wrapper or guiParent()

    local click = Instance.new("TextButton")
    click.Size = UDim2.new(1, 0, 1, 0)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.ZIndex = 3
    click.Parent = row

    local openConn = nil
    local thisClose = nil

    local function closeList()
        if openConn then
            pcall(function() openConn:Disconnect() end)
            openConn = nil
        end
        if alive(list) then
            list.Visible = false
        end
        if _activeClose == thisClose then
            _activeClose = nil
        end
    end
    thisClose = closeList

    local function positionList()
        if not alive(row) then return end
        local anchor = wrapper or guiParent()
        if not alive(anchor) then return end
        local abs = row.AbsolutePosition
        local sz = row.AbsoluteSize
        local pAbs
        if anchor:IsA("ScreenGui") then
            pAbs = Vector2.new(0, 0)
        else
            pAbs = anchor.AbsolutePosition
        end
        local relX = abs.X - pAbs.X
        local relY = abs.Y - pAbs.Y + sz.Y + 4
        local listH = math.min(#options * 30 + 12, 150)
        local wBottom = anchor.AbsoluteSize.Y
        if wBottom > 0 and relY + listH > wBottom then
            relY = abs.Y - pAbs.Y - listH - 4
        end
        list.Position = UDim2.fromOffset(relX, relY)
        list.Size = UDim2.fromOffset(sz.X, listH)
    end

    local function populate()
        for _, c in ipairs(list:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for _, opt in ipairs(options) do
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, 0, 0, 26)
            b.BackgroundColor3 = Theme.SurfaceAlt
            b.BackgroundTransparency = (val.Text == tostring(opt)) and 0 or 1
            b.AutoButtonColor = false
            b.Font = Theme.Font
            b.TextSize = 13
            b.TextColor3 = (val.Text == tostring(opt)) and Theme.AccentSoft or Theme.Text
            b.Text = tostring(opt)
            b.ZIndex = 51
            applyCorner(b, 6)
            b.Parent = list
            b.MouseEnter:Connect(function()
                if val.Text == tostring(opt) then return end
                TweenService:Create(b, Ease.Fast, {BackgroundTransparency = 0.5}):Play()
            end)
            b.MouseLeave:Connect(function()
                if val.Text == tostring(opt) then return end
                TweenService:Create(b, Ease.Fast, {BackgroundTransparency = 1}):Play()
            end)
            b.MouseButton1Click:Connect(function()
                val.Text = tostring(opt)
                closeList()
                if callback then callback(opt) end
            end)
        end
    end

    click.MouseButton1Click:Connect(function()
        if list.Visible then
            closeList()
            return
        end
        if _activeClose and _activeClose ~= thisClose then
            _activeClose()
        end
        _activeClose = thisClose
        populate()
        positionList()
        list.Size = UDim2.fromOffset(list.Size.X.Offset, 0)
        list.Visible = true
        local targetH = math.min(#options * 30 + 12, 150)
        TweenService:Create(list, Ease.Fast, {Size = UDim2.fromOffset(list.Size.X.Offset, targetH)}):Play()
        task.defer(function()
            if not alive(list) or not alive(row) then return end
            openConn = UserInputService.InputBegan:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then return end
                if not alive(list) or not alive(row) then
                    if openConn then
                        pcall(function() openConn:Disconnect() end)
                        openConn = nil
                    end
                    return
                end
                local mx, my = input.Position.X, input.Position.Y
                local ax, ay = list.AbsolutePosition.X, list.AbsolutePosition.Y
                local sx, sy = list.AbsoluteSize.X, list.AbsoluteSize.Y
                if mx >= ax and mx <= ax + sx and my >= ay and my <= ay + sy then
                    return
                end
                local rx, ry = row.AbsolutePosition.X, row.AbsolutePosition.Y
                local rw, rh = row.AbsoluteSize.X, row.AbsoluteSize.Y
                if mx >= rx and mx <= rx + rw and my >= ry and my <= ry + rh then
                    return
                end
                closeList()
            end)
        end)
    end)

    return val
end

function Lib:Notify(config)
    config = config or {}
    local title = config.Title or "Miku"
    local text = config.Text or ""
    local dur = config.Duration or 3
    local color = config.Color or Theme.Accent

    local gui = Instance.new("ScreenGui")
    gui.Name = "MikuNotify"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 10000
    gui.Parent = guiParent()

    local wrapper = Instance.new("Frame")
    wrapper.Size = UDim2.fromOffset(300, 60)
    wrapper.Position = UDim2.new(1, 400, 1, -80)
    wrapper.BackgroundTransparency = 1
    wrapper.BorderSizePixel = 0
    wrapper.Parent = gui

    local shadow = Instance.new("Frame")
    shadow.AnchorPoint = Vector2.new(0.5, 0.5)
    shadow.Position = UDim2.new(0.5, 0, 0.5, 0)
    shadow.Size = UDim2.new(1, 14, 1, 14)
    shadow.BackgroundColor3 = Color3.new(0, 0, 0)
    shadow.BackgroundTransparency = 0.55
    shadow.BorderSizePixel = 0
    shadow.ZIndex = 0
    applyCorner(shadow, 12)
    shadow.Parent = wrapper

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 1, 0)
    holder.BackgroundColor3 = Theme.Surface
    holder.BorderSizePixel = 0
    holder.ZIndex = 1
    applyCorner(holder, 10)
    applyStroke(holder, Theme.Stroke, 1, 0.3)
    holder.Parent = wrapper

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 1, -16)
    bar.Position = UDim2.new(0, 10, 0, 8)
    bar.BackgroundColor3 = color
    bar.BorderSizePixel = 0
    bar.ZIndex = 2
    applyCorner(bar, 2)
    bar.Parent = holder

    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.Size = UDim2.new(1, -30, 0, 20)
    t.Position = UDim2.new(0, 22, 0, 10)
    t.Font = Theme.FontBold
    t.TextSize = 14
    t.TextColor3 = Theme.Text
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Text = title
    t.ZIndex = 2
    t.Parent = holder

    local d = Instance.new("TextLabel")
    d.BackgroundTransparency = 1
    d.Size = UDim2.new(1, -30, 0, 18)
    d.Position = UDim2.new(0, 22, 0, 30)
    d.Font = Theme.Font
    d.TextSize = 12
    d.TextColor3 = Theme.TextDim
    d.TextXAlignment = Enum.TextXAlignment.Left
    d.Text = text
    d.ZIndex = 2
    d.Parent = holder

    local prog = Instance.new("Frame")
    prog.Size = UDim2.new(1, -20, 0, 2)
    prog.Position = UDim2.new(0, 10, 1, -5)
    prog.BackgroundColor3 = color
    prog.BorderSizePixel = 0
    prog.ZIndex = 2
    applyCorner(prog, 1)
    prog.Parent = holder
    TweenService:Create(prog, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 0, 2),
    }):Play()

    local entry = { wrapper = wrapper, gui = gui }
    table.insert(_notifList, entry)

    local function reposition()
        for i, e in ipairs(_notifList) do
            if e.wrapper and alive(e.wrapper) then
                local y = -(80 + (i - 1) * 72)
                TweenService:Create(e.wrapper, Ease.Normal, {
                    Position = UDim2.new(1, -320, 1, y),
                }):Play()
            end
        end
    end

    reposition()

    task.delay(dur, function()
        for i, e in ipairs(_notifList) do
            if e == entry then
                table.remove(_notifList, i)
                break
            end
        end
        if alive(wrapper) then
            local p = wrapper.Position
            TweenService:Create(wrapper, Ease.Normal, {
                Position = UDim2.new(1, 400, p.Y.Scale, p.Y.Offset),
            }):Play()
        end
        task.wait(0.3)
        if alive(gui) then
            gui.Enabled = false
        end
        pcall(function() gui:Destroy() end)
        reposition()
    end)

    return gui
end

return Lib
