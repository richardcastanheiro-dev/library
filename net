local function getGuiParent()
	local success, result = pcall(function()
		return gethui()
	end)
	if success and result then
		return result
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local function cleanOld()
	local targets = {}
	local mainParent = getGuiParent()
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	table.insert(targets, mainParent)
	table.insert(targets, CoreGui)
	if playerGui then
		table.insert(targets, playerGui)
	end
	local seen = {}
	for _, target in ipairs(targets) do
		if target and not seen[target] then
			seen[target] = true
			pcall(function()
				for _, child in ipairs(target:GetChildren()) do
					if child:IsA("ScreenGui") and (child.Name == "MikuLib" or child.Name == "MikuLibMain" or child.Name == "MikuLibNotify") then
						child:Destroy()
					end
				end
			end)
		end
	end
end

if Shared ~= nil and Shared.MikuLibInstance then
	local previous = Shared.MikuLibInstance
	if type(previous) == "table" and previous.Destroy then
		pcall(function()
			previous:Destroy()
		end)
	end
	Shared.MikuLibInstance = nil
end

