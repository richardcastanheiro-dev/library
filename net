function Lib:CreateSlider(parent, text, minValue, maxValue, defaultValue, cb)
	if type(text) == "table" then local c = text; text = c.Title or c.Text or "Slider"
		minValue = c.Min or c.MinValue or 0; maxValue = c.Max or c.MaxValue or 100
		defaultValue = c.Default; cb = c.Callback end
	if type(defaultValue) == "function" and cb == nil then cb = defaultValue; defaultValue = minValue end

	local frame, page = prepareControl(parent, 52, "Frame")
	make("TextLabel", { Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, -60, 0, 18),
		BackgroundTransparency = 1, Text = tostring(text or "Slider"),
		Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left }, frame)
	local valueLabel = make("TextLabel", { Position = UDim2.new(1, -60, 0, 0),
		Size = UDim2.fromOffset(60, 18), BackgroundTransparency = 1, Text = "",
		Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Theme.AccentSoft,
		TextXAlignment = Enum.TextXAlignment.Right }, frame)
	local track = make("TextButton", { Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 8), BackgroundColor3 = Theme.SurfaceHi,
		Text = "", AutoButtonColor = false }, frame)
	corner(track, 4)
	local fill = make("Frame", { Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Accent }, track)
	corner(fill, 4)
	local knob = make("Frame", { Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.Text }, track)
	corner(knob, 7); stroke(knob, Theme.Stroke, 0.4)

	local minN = tonumber(minValue) or 0
	local maxN = tonumber(maxValue) or 100
	if maxN <= minN then maxN = minN + 1 end
	local value = math.clamp(tonumber(defaultValue) or minN, minN, maxN)
	local dragging, moveConn, endConn
	local listeners = {}
	local function notify(v) safeCall(cb, v); for _, fn in ipairs(listeners) do safeCall(fn, v) end end
	local function apply(v, fire)
		value = math.clamp(tonumber(v) or minN, minN, maxN)
		local frac = (value - minN) / (maxN - minN)
		fill.Size = UDim2.new(frac, 0, 1, 0)
		knob.Position = UDim2.new(frac, 0, 0.5, 0)
		valueLabel.Text = formatValue(value)
		if fire then notify(value) end
	end
	local function fromX(px) return minN + (maxN - minN) * math.clamp((px - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1) end
	local function stop() dragging = false; if moveConn then moveConn:Disconnect(); moveConn = nil end; if endConn then endConn:Disconnect(); endConn = nil end end
	track.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		stop(); dragging = true; apply(fromX(input.Position.X), true)
		moveConn = UserInputService.InputChanged:Connect(function(ch)
			if dragging and (ch.UserInputType == Enum.UserInputType.MouseMovement or ch.UserInputType == Enum.UserInputType.Touch) then apply(fromX(ch.Position.X), true) end
		end)
		endConn = UserInputService.InputEnded:Connect(function(ch)
			if ch.UserInputType == Enum.UserInputType.MouseButton1 or ch.UserInputType == Enum.UserInputType.Touch then stop() end
		end)
	end)
	apply(value, false)
	registerControl(frame, { SetValue = function(v) apply(v, true) end, GetValue = function() return value end,
		AddListener = function(fn) table.insert(listeners, fn) end })
	refreshPage(page)
	return frame
end

function Lib:CreateInput(parent, config)
	config = type(config) == "table" and config or { Title = tostring(config or "Input") }
	local title = config.Title or config.Name or config.Text or "Input"
	local default = tostring(config.Default or "")
	local placeholder = tostring(config.Placeholder or "Digite...")
	local numeric = config.Numeric == true
	local finished = config.Finished ~= false
	local cb = config.Callback or config.OnChanged
	local clearOnFocus = config.ClearOnFocus == true

	local frame, page = prepareControl(parent, 60, "Frame")
	make("TextLabel", { Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1, Text = title, Font = Enum.Font.Gotham, TextSize = 13,
		TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left }, frame)
	local box = make("TextBox", { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 28),
		BackgroundColor3 = Theme.SurfaceHi, BackgroundTransparency = 0.08, Text = default,
		PlaceholderText = placeholder, PlaceholderColor3 = Theme.TextDim, Font = Enum.Font.Gotham,
		TextSize = 13, TextColor3 = Theme.Text, ClearTextOnFocus = clearOnFocus,
		TextXAlignment = Enum.TextXAlignment.Left }, frame)
	corner(box, 8); stroke(box, Theme.Stroke, 0.4)
	make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, box)

	local listeners = {}
	local function fire()
		local v = box.Text
		if numeric then v = tonumber(v) or 0 end
		safeCall(cb, v)
		for _, fn in ipairs(listeners) do safeCall(fn, v) end
	end
	if numeric then
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local cleaned = box.Text:gsub("[^%d%.%-]", "")
			if cleaned ~= box.Text then box.Text = cleaned end
		end)
	end
	if not finished then box:GetPropertyChangedSignal("Text"):Connect(fire)
	else box.FocusLost:Connect(fire) end

	registerControl(frame, {
		SetValue = function(v) box.Text = tostring(v or ""); fire() end,
		GetValue = function() return numeric and (tonumber(box.Text) or 0) or box.Text end,
		AddListener = function(fn) table.insert(listeners, fn) end,
		SetDisabled = function(v) box.Active = not v; box.TextTransparency = v and 0.5 or 0 end,
	})
	refreshPage(page)
	return frame
end

