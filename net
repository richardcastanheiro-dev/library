local function createDropdownControl(parent, config, context, optionsArg, defaultArg, callbackArg)
	if type(config) == "string" then
		config = {
			Text = config,
			Options = optionsArg,
			Default = defaultArg,
			Callback = callbackArg
		}
	end
	if type(config) ~= "table" then
		config = {}
	end
	local callback = config.Callback or callbackArg
	local placeholder = tostring(config.Placeholder or "Selecionar")
	local source = config.Options or config.Items or optionsArg or {}
	local options = {}
	for _, option in ipairs(source) do
		table.insert(options, option)
	end
	local row = make("Frame", {
		Name = "Dropdown",
		Parent = parent,
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 38),
		ZIndex = 2,
		LayoutOrder = nextOrder(parent)
	})
	corner(row, 8)
	stroke(row, Theme.Stroke, 1, 0.55)
	make("TextLabel", {
		Name = "Label",
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(0.44, -12, 1, 0),
		Text = tostring(config.Text or config.Title or config.Name or "Dropdown"),
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 3
	})
	local selectedLabel = make("TextLabel", {
		Name = "Selected",
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.new(0.44, 0, 0, 0),
		Size = UDim2.new(0.56, -34, 1, 0),
		Text = placeholder,
		Font = Theme.Font,
		TextSize = 11,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 3
	})
	make("TextLabel", {
		Name = "Arrow",
		Parent = row,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(14, 18),
		Text = "▾",
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = 3
	})
	local hit = make("TextButton", {
		Name = "Hit",
		Parent = row,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		AutoButtonColor = false,
		ZIndex = 5
	})
	local menu = make("Frame", {
		Name = "DropdownMenu",
		Parent = context.wrapper,
		BackgroundColor3 = Theme.SurfaceHi,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(160, 34),
		Visible = false,
		ClipsDescendants = true,
		ZIndex = 400
	})
	corner(menu, 8)
	stroke(menu, Theme.Stroke, 1, 0.25)
	local menuScroll = make("ScrollingFrame", {
		Name = "Options",
		Parent = menu,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.new(1, -8, 1, -8),
		CanvasSize = UDim2.fromOffset(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.None,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Stroke,
		ScrollBarImageTransparency = 0.25,
		ClipsDescendants = true,
		ZIndex = 401
	})
	make("UIListLayout", {
		Parent = menuScroll,
		Padding = UDim.new(0, 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Left
	})
	local dropdown = {
		Row = row,
		Menu = menu,
		MenuScroll = menuScroll,
		Options = options,
		Value = nil
	}
	local currentValue = nil
	local renderOptions
	local function updateMenuSize()
		local contentHeight = math.max(#options * 26, 1)
		menuScroll.CanvasSize = UDim2.fromOffset(0, contentHeight)
		local menuHeight = math.min(math.max(contentHeight + 8, 34), 180)
		menu.Size = UDim2.fromOffset(math.max(120, row.AbsoluteSize.X), menuHeight)
	end
	local function positionMenu()
		local rowPosition = row.AbsolutePosition
		local wrapperPosition = context.wrapper.AbsolutePosition
		local wrapperSize = context.wrapper.AbsoluteSize
		local menuHeight = menu.Size.Y.Offset
		local x = rowPosition.X - wrapperPosition.X
		local y = rowPosition.Y - wrapperPosition.Y + row.AbsoluteSize.Y + 4
		if y + menuHeight > wrapperSize.Y - 4 then
			y = rowPosition.Y - wrapperPosition.Y - menuHeight - 4
		end
		local maxX = math.max(4, wrapperSize.X - row.AbsoluteSize.X - 4)
		x = math.clamp(x, 4, maxX)
		y = math.max(4, y)
		menu.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
	end
	local function setValue(newValue, silent)
		local found = nil
		for _, option in ipairs(options) do
			if option == newValue then
				found = option
				break
			end
		end
		if found == nil then
			return
		end
		local changed = currentValue ~= found
		currentValue = found
		dropdown.Value = found
		selectedLabel.Text = tostring(found)
		if renderOptions then
			renderOptions()
		end
		if changed and not silent and callback then
			task.spawn(function()
				callback(found)
			end)
		end
	end
	renderOptions = function()
		for _, child in ipairs(menuScroll:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		for index, option in ipairs(options) do
			local selected = option == currentValue
			local optionButton = make("TextButton", {
				Name = "Option",
				Parent = menuScroll,
				BackgroundColor3 = Theme.Accent,
				BackgroundTransparency = selected and 0.25 or 1,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 26),
				Text = tostring(option),
				Font = Theme.Font,
				TextSize = 11,
				TextColor3 = selected and Theme.Text or Theme.TextDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				AutoButtonColor = false,
				ZIndex = 402,
				LayoutOrder = index
			})
			corner(optionButton, 6)
			pad(optionButton, 0, 10, 0, 10)
			optionButton.MouseEnter:Connect(function()
				if selected then
					return
				end
				optionButton.BackgroundColor3 = Theme.Surface
				optionButton.BackgroundTransparency = 0
				optionButton.TextColor3 = Theme.Text
			end)
			optionButton.MouseLeave:Connect(function()
				if selected then
					return
				end
				optionButton.BackgroundTransparency = 1
				optionButton.TextColor3 = Theme.TextDim
			end)
			optionButton.MouseButton1Click:Connect(function()
				setValue(option, false)
				context.closeAllDropdowns()
			end)
		end
		updateMenuSize()
	end
	dropdown.Set = function(a, b)
		local newValue
		if b ~= nil then
			newValue = b
		elseif a ~= dropdown then
			newValue = a
		end
		if newValue ~= nil then
			setValue(newValue, false)
		end
	end
	dropdown.Get = function()
		return currentValue
	end
	dropdown.Refresh = function(a, b)
		local list = b
		if list == nil and type(a) == "table" and a ~= dropdown then
			list = a
		end
		if type(list) == "table" then
			options = {}
			for _, option in ipairs(list) do
				table.insert(options, option)
			end
			dropdown.Options = options
		end
		local exists = false
		for _, option in ipairs(options) do
			if option == currentValue then
				exists = true
				break
			end
		end
		if not exists then
			currentValue = options[1]
			dropdown.Value = currentValue
		end
		selectedLabel.Text = currentValue ~= nil and tostring(currentValue) or placeholder
		renderOptions()
	end
	table.insert(context.dropdownClosers, function()
		menu.Visible = false
	end)
	hit.MouseButton1Click:Connect(function()
		if menu.Visible then
			menu.Visible = false
			context.dismiss.Visible = false
		else
			context.closeAllDropdowns()
			updateMenuSize()
			menu.Visible = true
			context.dismiss.Visible = true
			positionMenu()
		end
	end)
	local initial = nil
	if config.Default ~= nil then
		for _, option in ipairs(options) do
			if option == config.Default then
				initial = option
				break
			end
		end
	end
	if initial == nil and config.Value ~= nil then
		for _, option in ipairs(options) do
			if option == config.Value then
				initial = option
				break
			end
		end
	end
	if initial == nil then
		initial = options[1]
	end
	currentValue = initial
	dropdown.Value = currentValue
	selectedLabel.Text = currentValue ~= nil and tostring(currentValue) or placeholder
	renderOptions()
	return dropdown
end

