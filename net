local function createToggle(parent, text, default, callback)
	local holder = make("Frame", {
		Name = "Toggle",
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1
	}, parent)

	local label = createText(holder, text, 13, Theme.Text)
	label.Size = UDim2.new(1, -48, 1, 0)

	local button = make("TextButton", {
		Name = "Switch",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(34, 18),
		BackgroundColor3 = default and Theme.Accent or Theme.SurfaceHi,
		BorderSizePixel = 0,
		Text = ""
	}, holder)

	corner(button, 20)

	local knob = make("Frame", {
		Name = "Knob",
		Size = UDim2.fromOffset(12, 12),
		Position = default and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0
	}, button)

	corner(knob, 20)

	local state = default == true
	local function set(value, silent)
		state = value == true
		applyTween(button, Fast, {
			BackgroundColor3 = state and Theme.Accent or Theme.SurfaceHi
		})
		applyTween(knob, Fast, {
			Position = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
		})
		if not silent then
			safeCall(callback, state)
		end
	end

	button.MouseButton1Click:Connect(function()
		set(not state)
	end)

	return holder, function()
		return state
	end, set
end

