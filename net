		Icon = config.Icon or config.TabIcon,
	})
	local box = tab:CreateBox({ Name = config.Section or config.BoxName or config.Title or "Main" })
	box.Window = window
	box.Tab = tab
	return box, window, tab
end


function Lib:SetTheme(value)
	if typeof(value) == "Color3" then
		Theme.Accent = value
		local h, s, v = value:ToHSV()
		Theme.AccentSoft = Color3.fromHSV(h, math.max(0, s - 0.2), math.min(1, v + 0.1))
		Theme.Stroke = Color3.fromHSV(h, 0.15, 0.25)
	elseif type(value) == "table" then
		for k, v in pairs(value) do Theme[k] = v end
	end
	return self
end
function Lib:GetWindow(nameOrIndex)
	if type(nameOrIndex) == "number" then return self.Windows[nameOrIndex] end
	for _, w in ipairs(self.Windows) do
		if w._titleLabel and w._titleLabel.Text == nameOrIndex then return w end
	end
	return nil
end
function Lib:GetWindows() return self.Windows end
function Lib:DestroyAll()
	local list = self.Windows; self.Windows = {}
	for i = #list, 1, -1 do
		local w = list[i]
		if w and w.Destroy then pcall(function() w:Destroy() end) end
	end
	for _, m in ipairs(self._watermarks) do pcall(function() m.Destroy() end) end
	self._watermarks = {}
	if self._notifyGui then pcall(function() self._notifyGui:Destroy() end); self._notifyGui = nil end
	if self._watermarkGui then pcall(function() self._watermarkGui:Destroy() end); self._watermarkGui = nil end
	local sh = getShared(false)
	if sh then sh.MikuLibInstance = nil end
end
Lib.CloseAll = Lib.DestroyAll
Lib.Destroy = Lib.DestroyAll

function Lib.new(a, b)
	if a == Lib then return Lib:CreateWindow(b) end
	return Lib:CreateWindow(a)
end

return Lib

