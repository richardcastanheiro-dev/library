local OldCreateTab = Window.CreateTab

function Window:CreateTab(config, iconName)
	local page = OldCreateTab(self, config, iconName)

	if not page then
		return nil
	end

	local left, right = setupTabGroupboxes(page)

	function page:AddLeftGroupbox(name, icon)
		return Lib:CreateGroupbox(left, {
			Name = tostring(name or "Groupbox"),
			Icon = icon
		})
	end

	function page:AddRightGroupbox(name, icon)
		return Lib:CreateGroupbox(right, {
			Name = tostring(name or "Groupbox"),
			Icon = icon
		})
	end

	function page:AddGroupbox(name, side)
		local target = string.lower(tostring(side or "left")) == "right" and right or left

		return Lib:CreateGroupbox(target, {
			Name = tostring(name or "Groupbox")
		})
	end

	return page
end
function Lib:GetValue(control)
	local data = Lib.Controls[control]

	if not data or type(data.Get) ~= "function" then
		return nil
	end

	return data.Get()
end

function Lib:SetValue(control, value)
	local data = Lib.Controls[control]

	if not data or type(data.Set) ~= "function" then
		return false
	end

	data.Set(value)
	return true
end

function Lib:DestroyAll()
	for _, window in ipairs(Lib.Windows) do
		if window and not window._destroyed then
			window:Destroy()
		end
	end

	for control, data in pairs(Lib.Controls) do
		if data.Connection then
			disconnect(data.Connection)
		end

		Lib.Controls[control] = nil
	end

	local shared = getShared(false)

	if shared then
		shared.Window = nil
	end
end

function Lib:Notify(config)
	config = type(config) == "table" and config or {}

	local title = tostring(config.Title or config.title or "MikuLib")
	local message = tostring(config.Content or config.content or config.Description or "")
	local duration = tonumber(config.Duration or config.duration) or 3

	local playerGui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return
	end

	local gui = playerGui:FindFirstChild("MikuNotifications")

	if not gui then
		gui = make("ScreenGui", {
			Name = "MikuNotifications",
			ResetOnSpawn = false,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		}, playerGui)
	end

	local notification = make("Frame", {
		Name = "Notification",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 320, 0, 20),
		Size = UDim2.fromOffset(280, 78),
		BackgroundColor3 = Theme.Surface,
		BorderSizePixel = 0
	}, gui)

	corner(notification, 8)
	stroke(notification, Theme.Stroke, 0.4)

	local heading = createText(notification, title, 13, Theme.Text, Enum.Font.GothamBold)
	heading.Position = UDim2.fromOffset(12, 8)
	heading.Size = UDim2.new(1, -24, 0, 20)

	local body = createText(notification, message, 11, Theme.TextDim)
	body.Position = UDim2.fromOffset(12, 31)
	body.Size = UDim2.new(1, -24, 0, 35)
	body.TextWrapped = true
	body.TextYAlignment = Enum.TextYAlignment.Top

	applyTween(notification, Normal, {
		Position = UDim2.new(1, -15, 0, 20)
	})

	task.delay(duration, function()
		if notification and notification.Parent then
			applyTween(notification, Normal, {
				Position = UDim2.new(1, 320, 0, 20)
			})

			task.wait(0.25)
			destroy(notification)
		end
	end)

	return notification
end

function Lib:Close()
