local function createIcon(parent, icon, size, color)
	if not icon then
		return nil
	end

	if type(icon) == "number" or tostring(icon):match("^%d+$") then
		return make("ImageLabel", {
			BackgroundTransparency = 1,
			Image = "rbxassetid://" .. tostring(icon),
			Size = UDim2.fromOffset(size or 18, size or 18),
			ImageColor3 = color or Theme.Text
		}, parent)
	end

	if Lib.Icons and type(Lib.Icons) == "table" then
		local iconData = Lib.Icons[icon] or Lib.Icons[string.lower(tostring(icon))]
		if iconData then
			local image = make("ImageLabel", {
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(size or 18, size or 18),
				ImageColor3 = color or Theme.Text
			}, parent)

			if type(iconData) == "string" then
				image.Image = iconData
			elseif type(iconData) == "table" then
				image.Image = iconData.Image or iconData.image or ""
			end

			return image
		end
	end

	return nil
end

local function normalizeTabConfig(config, iconName)
	if type(config) == "table" then
		return {
			name = config.name or config.Name or "Tab",
			icon = config.icon or config.Icon
		}
	end

	return {
		name = tostring(config or "Tab"),
		icon = iconName
	}
end

local function getTextConfig(config, fallback)
	if type(config) == "table" then
		return config.Text or config.text or config.Name or config.name or fallback or ""
	end
	return config or fallback or ""
end

local function getCallback(config)
	if type(config) ~= "table" then
		return nil
	end
	return config.Callback or config.callback or config.Func or config.func
end

local function getDefault(config, fallback)
	if type(config) ~= "table" then
		return fallback
	end
	if config.Default ~= nil then
		return config.Default
	end
	if config.default ~= nil then
		return config.default
	end
	return fallback
end

local function getControlName(config, fallback)
	if type(config) == "table" then
		return config.Name or config.name or fallback
	end
	return fallback
end

local function disconnect(connection)
	if connection then
		pcall(function()
			connection:Disconnect()
		end)
	end
end

local function destroy(object)
	if object then
		pcall(function()
			object:Destroy()
		end)
