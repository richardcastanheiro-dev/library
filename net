	local dragInputType
	local dragInputObject
	local dragStart
	local startCenter
	local dragChangedConnection
	local dragEndedConnection
	local visibilityTweens = {}
	local windowVisible = true

	local function clampCenter(x, y)
		local view = getViewport()
		local size = wrapper.AbsoluteSize
		local halfWidth = size.X / 2
		local halfHeight = size.Y / 2
		local minX = math.min(halfWidth + 8, view.X / 2)
		local maxX = math.max(view.X - halfWidth - 8, view.X / 2)
		local minY = math.min(halfHeight + 8, view.Y / 2)
		local maxY = math.max(view.Y - halfHeight - 8, view.Y / 2)
		return clamp(x, minX, maxX), clamp(y, minY, maxY)
	end

	local function stopDragging()
		dragging = false
		dragInputType = nil
		dragInputObject = nil
		if dragChangedConnection then
			dragChangedConnection:Disconnect()
			dragChangedConnection = nil
		end
		if dragEndedConnection then
			dragEndedConnection:Disconnect()
			dragEndedConnection = nil
		end
	end

	local function cancelVisibilityTweens()
		for index = #visibilityTweens, 1, -1 do
			local tween = visibilityTweens[index]
			if tween then
				pcall(function()
					tween:Cancel()
				end)
			end
			table.remove(visibilityTweens, index)
		end
	end

	local function applyRootSize()
		if window.Minimized then
			root.Size = UDim2.new(1, 0, 0, 55)
		else
			root.Size = UDim2.new(1, 0, 1, 0)
		end
	end

	local function setWindowVisible(state)
		if closed then
			return
		end
		state = state and true or false
		if windowVisible == state then
			return
		end

		windowVisible = state
		window.Visible = state
		stopDragging()

		if activeDropdownClose then
			pcall(activeDropdownClose)
		end

		cancelVisibilityTweens()

		if state then
			wrapper.Visible = true
			applyRootSize()
			rootScale.Scale = 0.94
			root.GroupTransparency = 1
			local fade = TweenService:Create(root, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				GroupTransparency = 0
			})
			local pop = TweenService:Create(rootScale, TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Scale = 1
			})
			table.insert(visibilityTweens, fade)
			table.insert(visibilityTweens, pop)
			fade:Play()
			pop:Play()
		else
			local fade = TweenService:Create(root, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				GroupTransparency = 1
			})
			local shrink = TweenService:Create(rootScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Scale = 0.92
			})
			table.insert(visibilityTweens, fade)
			table.insert(visibilityTweens, shrink)
			fade:Play()
			shrink:Play()
			shrink.Completed:Connect(function(playbackState)
				if playbackState == Enum.PlaybackState.Completed and not windowVisible and not closed then
					wrapper.Visible = false
					rootScale.Scale = 1
					root.GroupTransparency = 1
				end
			end)
		end
	end

	local function beginDrag(input)
		if closed or not windowVisible or not wrapper.Visible then
			return
		end
		if not isPointerInput(input) then
			return
		end
		if UserInputService:GetFocusedTextBox() then
			return
		end
		local pointer = Vector2.new(input.Position.X, input.Position.Y)
		if pointInside(closeButton, pointer) or pointInside(minButton, pointer) then
			return
		end

		stopDragging()

		dragging = true
		dragInputType = input.UserInputType
		dragInputObject = input
		dragStart = pointer

		local position = wrapper.AbsolutePosition
		local size = wrapper.AbsoluteSize
		startCenter = Vector2.new(position.X + size.X / 2, position.Y + size.Y / 2)

		dragChangedConnection = UserInputService.InputChanged:Connect(function(changed)
			if not dragging or closed or not wrapper.Parent then
				return
			end
			if not matchesPointerMove(dragInputType, dragInputObject, changed) then
				return
			end
			local current = Vector2.new(changed.Position.X, changed.Position.Y)
			local delta = current - dragStart
			local x, y = clampCenter(startCenter.X + delta.X, startCenter.Y + delta.Y)
			wrapper.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
		end)

		dragEndedConnection = UserInputService.InputEnded:Connect(function(ended)
			if dragging and matchesPointerEnd(dragInputType, dragInputObject, ended) then
				stopDragging()
			end
		end)
	end

	local topBarConnection = topBar.InputBegan:Connect(function(input)
		beginDrag(input)
	end)

	local keybindConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if closed or gameProcessed or not window.Keybind then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.Keyboard or input.KeyCode ~= window.Keybind then
			return
		end
		if UserInputService:GetFocusedTextBox() then
			return
		end
		setWindowVisible(not windowVisible)
	end)

	function window:SetVisible(state)
		setWindowVisible(state)
	end

	function window:Open()
		setWindowVisible(true)
	end

	function window:Close()
		setWindowVisible(false)
	end

	function window:Toggle()
		setWindowVisible(not windowVisible)
	end

	function window:GetVisible()
		return windowVisible
	end

	function window:SetKeybind(value)
		self.Keybind = normalizeKeybind(value, false)
		return self.Keybind
	end

	function window:GetKeybind()
		return self.Keybind
	end

	function window:SetTitle(text)
		titleLabel.Text = tostring(text or "")
	end

	function window:SetSubtitle(text)
		subtitleLabel.Text = tostring(text or "")
	end

	function window:SetProfile(profileConfig)
		if type(profileConfig) ~= "table" then
			return
		end
		if profileConfig.Name ~= nil then
			profileName.Text = tostring(profileConfig.Name)
		end
		if profileConfig.Tag ~= nil then
			profileTag.Text = tostring(profileConfig.Tag)
		end
		if profileConfig.Image ~= nil then
			avatarLabel.Image = tostring(profileConfig.Image)
		end
		if profileConfig.Hidden ~= nil then
			profileCard.Visible = not profileConfig.Hidden
		end
	end

	function window:Minimize(state)
		if closed then
			return
		end
		state = state and true or false
		if self.Minimized == state then
			return
		end
		self.Minimized = state
		stopDragging()
		minButton.Text = state and "+" or "−"
		applyRootSize()
	end

	function window:SetSize(newWidth, newHeight)
		if closed then
			return
		end
		local view = getViewport()
		newWidth = clamp(tonumber(newWidth) or baseWidth, 320, math.max(320, view.X - 16))
		newHeight = clamp(tonumber(newHeight) or baseHeight, 220, math.max(220, view.Y - 16))
		baseWidth = math.floor(newWidth)
		baseHeight = math.floor(newHeight)
		wrapper.Size = UDim2.fromOffset(baseWidth, baseHeight)
		local position = wrapper.AbsolutePosition
		local x, y = clampCenter(position.X + baseWidth / 2, position.Y + baseHeight / 2)
		wrapper.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
	end

	function window:SelectTab(target)
		if closed or not target or self.ActiveTab == target then
			return
		end
		local previous = self.ActiveTab
		if previous then
			previous.Page.Visible = false
			playTween(previous.Button, Ease.Fast, {
				BackgroundTransparency = 1
			})
			playTween(previous.Stroke, Ease.Fast, {
				Transparency = 1
			})
			playTween(previous.Label, Ease.Fast, {
				TextColor3 = Theme.TextDim
			})
			previous.AccentBar.BackgroundTransparency = 1
		end
		self.ActiveTab = target
		target.Page.Visible = true
		target.Page.CanvasPosition = Vector2.zero
		playTween(target.Button, Ease.Fast, {
			BackgroundTransparency = 0
		})
		playTween(target.Stroke, Ease.Fast, {
			Transparency = 0.45
		})
		playTween(target.Label, Ease.Fast, {
			TextColor3 = Theme.Text
		})
		target.AccentBar.BackgroundTransparency = 0
		if activeDropdownClose then
			pcall(activeDropdownClose)
		end
		updateCanvas(target.Page)
	end

	function window:CreateTab(name)
		if closed then
			return nil
		end

		local tabName = tostring(name or ("Tab " .. (#self.Tabs + 1)))

		local tabButton = Instance.new("TextButton")
		tabButton.Name = "Tab_" .. tabName
		tabButton.Size = UDim2.new(1, 0, 0, 42)
		tabButton.BackgroundColor3 = Theme.SurfaceAlt
		tabButton.BackgroundTransparency = 1
		tabButton.BorderSizePixel = 0
		tabButton.AutoButtonColor = false
		tabButton.Text = ""
		tabButton.LayoutOrder = #self.Tabs + 1
		tabButton.ZIndex = 3
		applyCorner(tabButton, 9)
		local tabStroke = applyStroke(tabButton, Theme.Stroke, 1, 1)
		tabButton.Parent = tabList

		local tabAccent = Instance.new("Frame")
		tabAccent.Size = UDim2.new(0, 3, 0, 20)
		tabAccent.Position = UDim2.new(0, 6, 0.5, -10)
		tabAccent.BackgroundColor3 = accent
		tabAccent.BackgroundTransparency = 1
		tabAccent.BorderSizePixel = 0
		tabAccent.ZIndex = 4
		applyCorner(tabAccent, 2)
		tabAccent.Parent = tabButton

		local tabLabel = Instance.new("TextLabel")
		tabLabel.BackgroundTransparency = 1
		tabLabel.Size = UDim2.new(1, -24, 1, 0)
		tabLabel.Position = UDim2.new(0, 20, 0, 0)
		tabLabel.Font = Theme.Font
		tabLabel.TextSize = 14
		tabLabel.TextColor3 = Theme.TextDim
		tabLabel.TextXAlignment = Enum.TextXAlignment.Left
		tabLabel.TextTruncate = Enum.TextTruncate.AtEnd
		tabLabel.Text = tabName
		tabLabel.ZIndex = 4
		tabLabel.Parent = tabButton

		local page = Instance.new("ScrollingFrame")
		page.Name = "Page_" .. tabName
		page.Size = UDim2.fromScale(1, 1)
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		page.ScrollBarThickness = 3
		page.ScrollBarImageColor3 = Theme.Stroke
		page.ScrollBarImageTransparency = 0.25
		page.CanvasSize = UDim2.fromOffset(0, 0)
		page.AutomaticCanvasSize = Enum.AutomaticSize.None
		page.ScrollingDirection = Enum.ScrollingDirection.Y
		page.ClipsDescendants = true
		page.Visible = false
		page.ZIndex = 3
		applyPadding(page, 0, 6, 0, 10)
		applyList(page, 9)
		page.Parent = content

		local layout = page:FindFirstChildOfClass("UIListLayout")
		if layout then
			layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
				updateCanvas(page)
			end)
		end
		page:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			updateCanvas(page)
		end)
		page.ChildAdded:Connect(function()
			task.defer(function()
				updateCanvas(page)
			end)
		end)
		page.ChildRemoved:Connect(function()
			task.defer(function()
				updateCanvas(page)
			end)
		end)

		local tab = {
			Button = tabButton,
			Page = page,
			Name = tabName,
			Stroke = tabStroke,
			Label = tabLabel,
			AccentBar = tabAccent
		}

		tabButton.MouseEnter:Connect(function()
			if window.ActiveTab == tab or closed then
				return
			end
			playTween(tabButton, Ease.Fast, {
				BackgroundTransparency = 0.55
			})
		end)

		tabButton.MouseLeave:Connect(function()
			if window.ActiveTab == tab or closed then
				return
			end
			playTween(tabButton, Ease.Fast, {
				BackgroundTransparency = 1
			})
		end)

		tabButton.Activated:Connect(function()
			if not closed then
				window:SelectTab(tab)
			end
		end)

		table.insert(self.Tabs, tab)

		if #self.Tabs == 1 then
			self:SelectTab(tab)
		end

		return page, tab
	end

	function window:GetActiveTab()
		return self.ActiveTab
	end

	function window:Notify(notifyConfig)
		return self.Gui and Lib:Notify(notifyConfig) or Lib:Notify(notifyConfig)
	end

	function window:CreateWatermark(watermarkConfig)
		return Lib:CreateWatermark(watermarkConfig)
	end

	function window:Destroy()
		if window._destroyed then
			return
		end
		window._destroyed = true
		closed = true
		windowVisible = false
		window.Visible = false

		cancelVisibilityTweens()
		stopDragging()

		if topBarConnection then
			topBarConnection:Disconnect()
			topBarConnection = nil
		end

		if keybindConnection then
			keybindConnection:Disconnect()
			keybindConnection = nil
		end

		if activeDropdownClose then
			pcall(activeDropdownClose)
		end

		removeTracked(trackedWindows, window)

		if Shared.MikuLibInstance == window then
			Shared.MikuLibInstance = nil
		end

		pcall(function()
			gui:Destroy()
		end)
	end

	closeButton.Activated:Connect(function()
		setWindowVisible(false)
	end)

	minButton.Activated:Connect(function()
		window:Minimize(not window.Minimized)
	end)

	table.insert(trackedWindows, window)
	Shared.MikuLibInstance = window

	return window
end

