local function make(class, properties, parent)
	local object = Instance.new(class)
	if properties then
		for key, value in pairs(properties) do
			object[key] = value
		end
	end
	if parent then
		object.Parent = parent
	end
	return object
end

local function corner(parent, radius)
	local item = Instance.new("UICorner")
	item.CornerRadius = UDim.new(0, radius)
	item.Parent = parent
	return item
end

local function stroke(parent, color, transparency)
	local item = Instance.new("UIStroke")
	item.Color = color or Theme.Stroke
	item.Transparency = transparency or 0
	item.Thickness = 1
	item.Parent = parent
	return item
end

local function getViewport()
	local camera = workspace.CurrentCamera
	if camera then
		return camera.ViewportSize
	end
	return Vector2.new(1280, 720)
end

local function safeCall(callback, ...)
	if type(callback) ~= "function" then
		return
	end
	local ok, err = pcall(callback, ...)
	if not ok then
		warn("[MikuLib] " .. tostring(err))
	end
end

local function getShared(create)
	local environment
	local ok, value = pcall(function()
		if getgenv then
			return getgenv()
		end
		return _G
	end)
	if ok then
		environment = value
	end
	if not environment then
		return nil
	end
	if create and not environment.MikuLib then
		environment.MikuLib = {}
	end
	return environment.MikuLib
end

local function applyTween(object, info, properties)
	if not object or not object.Parent then
		return
	end
	local tween = TweenService:Create(object, info or Fast, properties)
	tween:Play()
	return tween
end

