function Lib:CreateToggle(parent, cfg)
    cfg = cfg or {}
    if type(cfg) == "string" then cfg = { Name = cfg } end
    local state = cfg.Default == true
    local frame = mk("TextButton", {
        Name = cfg.Name or "Toggle",
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = Theme.SurfaceAlt,
        AutoButtonColor = false, Text = "", BorderSizePixel = 0,
    })
    corner(8, frame)
    local st = stroke(Theme.Stroke, 1, frame)
    bindTheme(frame, { { "BackgroundColor3", "SurfaceAlt" } })
    bindTheme(st, { { "Color", "Stroke" } })

    local title = mk("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(1, -90, 1, 0), Font = Enum.Font.Gotham,
        TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
        Text = cfg.Name or "Toggle", TextColor3 = Theme.Text,
    }, frame)
    bindTheme(title, { { "TextColor3", "Text" } })

    local track = mk("Frame", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(40, 20), BackgroundColor3 = Theme.SurfaceHi,
        BorderSizePixel = 0,
    }, frame)
    corner(10, track)
    bindTheme(track, { { "BackgroundColor3", "SurfaceHi" } })
    local knob = mk("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0),
        Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Theme.TextDim,
        BorderSizePixel = 0,
    }, track)
    corner(8, knob)

    local c = newControl(cfg.Name or "Toggle", "Toggle", frame)

    local function apply(v, silent)
        state = v and true or false
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = state and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {
            BackgroundColor3 = state and Theme.Accent or Theme.TextDim,
        }):Play()
        TweenService:Create(track, TweenInfo.new(0.15), {
            BackgroundColor3 = state and lerpColor(Theme.SurfaceHi, Theme.Accent, 0.4) or Theme.SurfaceHi,
        }):Play()
        if not silent then safeCall(cfg.Callback, state) end
    end

    frame.MouseButton1Click:Connect(function() if frame.Active then apply(not state) end end)
    function c:Get() return state end
    function c:Set(v) apply(v, true) end
    function c:SetValue(v) apply(v, true) end
    function c:OnChanged(fn) cfg.Callback = fn end
    apply(state, true)
    attach(parent, frame)
    return finish(c)
end

