    Bg         = Color3.fromRGB(12, 12, 16),
    Surface    = Color3.fromRGB(20, 20, 26),
    SurfaceAlt = Color3.fromRGB(30, 30, 38),
    SurfaceHi  = Color3.fromRGB(42, 42, 52),
    Stroke     = Color3.fromRGB(55, 55, 70),
    Accent     = Color3.fromRGB(139, 108, 255),
    AccentSoft = Color3.fromRGB(180, 160, 255),
    Text       = Color3.fromRGB(245, 245, 252),
    TextDim    = Color3.fromRGB(145, 145, 165),
    Success    = Color3.fromRGB(94, 226, 158),
    Danger     = Color3.fromRGB(244, 92, 116),
    Warning    = Color3.fromRGB(255, 200, 100),
    Info       = Color3.fromRGB(100, 160, 255),
}
Lib.Theme = Theme


local function mk(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then
            pcall(function() inst[k] = v end)
        end
    end
    if parent then inst.Parent = parent end
    return inst
end

local function corner(r, parent)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = parent
    return c
end

local function stroke(color, thickness, parent)
    local s = Instance.new("UIStroke")
    s.Color = color or Theme.Stroke
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function bindTheme(inst, map)
    if not inst then return end
    local entry = { inst = inst, map = map }
    table.insert(Lib._themed, entry)
    for _, m in ipairs(map) do
        pcall(function() inst[m[1]] = Theme[m[2]] end)
    end
    return entry
end

local function uiParent()
    if typeof(gethui) == "function" then
        local ok, h = pcall(gethui)
        if ok and typeof(h) == "Instance" then return h end
    end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function ensureGui(name, order, inset)
    local parent = uiParent()
    local sg = parent:FindFirstChild(name)
    if sg and not sg:IsA("ScreenGui") then sg:Destroy() sg = nil end
    if not sg then
        sg = mk("ScreenGui", {
            Name = name,
            ResetOnSpawn = false,
            IgnoreGuiInset = inset ~= false,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
            DisplayOrder = order or 9999,
        }, parent)
    end
    return sg
end

local function resolveHost(parent)
    if typeof(parent) == "Instance" then return parent end
    if type(parent) == "table" then
        local h = parent.Instance or parent.Page or parent.Frame or parent.Root
        if typeof(h) == "Instance" then return h end
    end
    error("[MikuLib] parent invalido", 2)
end

local function attach(parent, inst)
    local host = resolveHost(parent)
    inst.Parent = host
    inst.LayoutOrder = #host:GetChildren()
    return inst
end

local function safeCall(fn, ...)
    if type(fn) ~= "function" then return end
    local ok, err = pcall(fn, ...)
    if not ok then warn("[MikuLib] erro no callback: " .. tostring(err)) end
end

local function fmt(v)
    local t = typeof(v)
    if t == "EnumItem" then return v.Name end
    if t == "Color3" then
        return string.format("#%02X%02X%02X", math.floor(v.R*255+.5), math.floor(v.G*255+.5), math.floor(v.B*255+.5))
    end
    if t == "number" then
        if v % 1 == 0 then return tostring(v) end
        return string.format("%.2f", v)
    end
    if type(v) == "table" then
        local out = {}
        for _, x in ipairs(v) do table.insert(out, tostring(x)) end
        return #out > 0 and table.concat(out, ", ") or "Nenhum"
    end
    return tostring(v)
end

local function lerpColor(a, b, t) return a:Lerp(b, t) end

local function newControl(name, ctype, frame)
    local c = { Name = name, Type = ctype, Instance = frame }
    function c:SetVisible(v) frame.Visible = (v ~= false) end
    function c:GetVisible() return frame.Visible end
    function c:SetDisabled(v)
        v = v and true or false
        if frame:IsA("GuiButton") then frame.Active = not v end
        frame.BackgroundTransparency = v and 0.6 or 0
    end
    function c:Destroy()
        if frame and frame.Parent then frame:Destroy() end
    end
    return c
end

local function finish(c)
    if c.Get and not c.GetValue then c.GetValue = c.Get end
    if c.Set and not c.SetValue then c.SetValue = c.Set end
    table.insert(Lib.Controls, c)
    return c
end


