function Lib.newDraggable(gui, handle)
    handle = handle or gui
    local dragging, startInput, startPos
    local conns = {}
    table.insert(conns, handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInput = input.Position
            startPos = gui.Position
        end
    end))
    table.insert(conns, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - startInput
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    table.insert(conns, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
    return { Destroy = function() for _, c in ipairs(conns) do c:Disconnect() end end }
end

function Lib.newResize(gui, handle, minSize)
    minSize = minSize or Vector2.new(320, 220)
    local resizing, startInput, startSize
    local conns = {}
    table.insert(conns, handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            startInput = input.Position
            startSize = gui.AbsoluteSize
        end
    end))
    table.insert(conns, UserInputService.InputChanged:Connect(function(input)
        if not resizing then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - startInput
            local w = math.max(minSize.X, startSize.X + d.X)
            local h = math.max(minSize.Y, startSize.Y + d.Y)
            gui.Size = UDim2.fromOffset(w, h)
        end
    end))
    table.insert(conns, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            resizing = false
        end
    end))
    return { Destroy = function() for _, c in ipairs(conns) do c:Disconnect() end end }
end


