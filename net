local function removeTracked(list, target)
	for index = #list, 1, -1 do
		if list[index] == target then
			table.remove(list, index)
			return
		end
	end
end

local function getViewport()
	local camera = workspace.CurrentCamera
	if camera then
		return camera.ViewportSize
	end
	return Vector2.new(1280, 720)
end

local function attachGui(gui)
	local parent
	if LocalPlayer then
		local ok, hui = pcall(function()
			return gethui()
		end)
		if ok and hui then
			parent = hui
		else
			local okCore, core = pcall(function()
				return CoreGui
			end)
			if okCore and core then
				parent = core
			end
		end
	end
	if not parent then
		parent = LocalPlayer:WaitForChild("PlayerGui")
	end
	local ok = pcall(function()
		gui.Parent = parent
	end)
	if not ok or gui.Parent == nil then
		gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	end
	table.insert(trackedGuis, gui)
	gui.Destroying:Connect(function()
		removeTracked(trackedGuis, gui)
	end)
end

local function cleanLeftovers()
	local containers = {}
	table.insert(containers, CoreGui)
	local playerGui = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
	if playerGui then
		table.insert(containers, playerGui)
	end
	local ok, hui = pcall(function()
		return gethui()
	end)
	if ok and hui then
		table.insert(containers, hui)
	end
	local seen = {}
	for _, container in ipairs(containers) do
		if container and not seen[container] then
			seen[container] = true
			pcall(function()
				for _, child in ipairs(container:GetChildren()) do
					if child:IsA("ScreenGui") and (child.Name == "MikuLib" or child.Name == "MikuNotify") then
						child:Destroy()
					end
				end
			end)
		end
	end
end

