local function applyCorner(i, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 10)
    c.Parent = i
    return c
end

local function applyStroke(i, col, th, tr)
    local s = Instance.new("UIStroke")
    s.Color = col or Theme.Stroke
    s.Thickness = th or 1
    s.Transparency = tr or 0.35
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = i
    return s
end

local function applyPadding(i, l, r, t, b)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, l or 10)
    p.PaddingRight = UDim.new(0, r or 10)
    p.PaddingTop = UDim.new(0, t or 10)
    p.PaddingBottom = UDim.new(0, b or 10)
    p.Parent = i
    return p
end

local function applyList(i, pad, order)
    local l = Instance.new("UIListLayout")
    l.FillDirection = Enum.FillDirection.Vertical
    l.SortOrder = order or Enum.SortOrder.LayoutOrder
    l.Padding = UDim.new(0, pad or 8)
    l.HorizontalAlignment = Enum.HorizontalAlignment.Center
    l.Parent = i
    return l
end

local function clamp(v, a, b)
    if v < a then return a end
    if v > b then return b end
    return v
end

local function guiParent()
    if RunService:IsStudio() then
        return LocalPlayer:WaitForChild("PlayerGui")
    end
    return CoreGui
end

local function alive(obj)
    if not obj then return false end
    local ok, p = pcall(function() return obj.Parent end)
    return ok and p ~= nil
end

function Lib.newDraggable(target, handle, isLocked)
    handle = handle or target
    local dragging = false
    local dragStart, startPos

    local c1 = handle.InputBegan:Connect(function(input)
        if isLocked and isLocked() then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
        end
    end)

    local c2 = UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if not alive(target) then
            dragging = false
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - dragStart
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)

    local c3 = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return function()
        dragging = false
        pcall(function() c1:Disconnect() end)
        pcall(function() c2:Disconnect() end)
        pcall(function() c3:Disconnect() end)
    end
end

