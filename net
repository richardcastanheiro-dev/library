	local holder = make("Frame", {
		Name = "Keybind",
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1
	}, parent)

	local label = createText(holder, text, 12, Theme.Text)
	label.Size = UDim2.new(1, -90, 1, 0)

	local button = make("TextButton", {
		Name = "Key",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(82, 25),
		BackgroundColor3 = Theme.SurfaceAlt,
		BorderSizePixel = 0,
		Text = tostring(default or "None"),
		TextColor3 = Theme.Text,
		TextSize = 11,
		Font = Enum.Font.GothamMedium
	}, holder)

	corner(button, 5)

	local key = default
	local listening = false

	button.MouseButton1Click:Connect(function()
		listening = true
		button.Text = "..."
	end)

	local connection = UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end

		if listening and input.UserInputType == Enum.UserInputType.Keyboard then
			key = input.KeyCode
			button.Text = key.Name
			listening = false
			safeCall(callback, key)
		elseif not listening and key and input.KeyCode == key then
			safeCall(callback, key)
		end
	end)

	registerControl(holder, {
		Type = "Keybind",
		Get = function()
			return key
		end,
		Set = function(value)
			key = value
			button.Text = tostring(value)
		end,
		Connection = connection
	})

	return holder
end

