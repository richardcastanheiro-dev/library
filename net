    click.Size = UDim2.fromScale(1, 1)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.ZIndex = 5
    click.Parent = row

    local list = Instance.new("ScrollingFrame")
    list.Name = "MikuDropdownList"
    list.Size = UDim2.fromOffset(180, 0)
    list.BackgroundColor3 = Theme.Surface
    list.BorderSizePixel = 0
    list.ClipsDescendants = true
    list.CanvasSize = UDim2.new(0, 0, 0, 0)
    list.AutomaticCanvasSize = Enum.AutomaticSize.Y
    list.ScrollBarThickness = 3
    list.ScrollBarImageColor3 = accent
    list.Visible = false
    list.Active = true
    list.ZIndex = 500
    applyCorner(list)
    applyStroke(list, Theme.Stroke, 1, 0.2)
    applyPadding(list, 6, 6, 6, 6)
    applyList(list, 4, Enum.HorizontalAlignment.Left)

    if screenGui then
        list.Parent = screenGui
    else
        list.Parent = parent
    end

    local function closeList()
        listOpen = false

        if outsideConnection then
            outsideConnection:Disconnect()
            outsideConnection = nil
        end

        if positionConnection then
            positionConnection:Disconnect()
            positionConnection = nil
        end

        list.Visible = false
        arrow.Text = "▾"

        if activeDropdownClose == closeList then
            activeDropdownClose = nil
        end
    end

    local function positionList()
        if not row.Parent or not list.Parent then
            return
        end

        local viewportSize = getViewport()
        local rowPosition = row.AbsolutePosition
        local rowSize = row.AbsoluteSize
        local listHeight = math.min(math.max(#options * 30 + 12, 34), 180)
        local listWidth = math.min(rowSize.X, math.max(160, viewportSize.X - 12))

        local x = clamp(rowPosition.X, 6, math.max(6, viewportSize.X - listWidth - 6))
        local y = rowPosition.Y + rowSize.Y + 4

        if y + listHeight > viewportSize.Y - 6 then
            y = math.max(6, rowPosition.Y - listHeight - 4)
        end

        list.Position = UDim2.fromOffset(x, y)
        list.Size = UDim2.fromOffset(listWidth, listHeight)
    end

    local function populate()
        for _, button in ipairs(optionButtons) do
            pcall(function()
                button:Destroy()
            end)
        end

        table.clear(optionButtons)

        for _, option in ipairs(options) do
            local selected = currentValue == option

            local optionButton = Instance.new("TextButton")
            optionButton.Size = UDim2.new(1, 0, 0, 26)
            optionButton.BackgroundColor3 = selected and accent or Theme.SurfaceAlt
            optionButton.BackgroundTransparency = selected and 0.2 or 1
            optionButton.AutoButtonColor = false
            optionButton.Font = Theme.Font
            optionButton.TextSize = 13
            optionButton.TextColor3 = selected and Theme.AccentSoft or Theme.Text
            optionButton.TextXAlignment = Enum.TextXAlignment.Left
            optionButton.Text = "  " .. tostring(option)
            optionButton.ZIndex = 501
            applyCorner(optionButton)
            optionButton.Parent = list

            optionButton.MouseEnter:Connect(function()
                if currentValue ~= option then
                    playTween(optionButton, Ease.Fast, {
                        BackgroundTransparency = 0.5,
                    })
                end
            end)

            optionButton.MouseLeave:Connect(function()
                if currentValue ~= option then
                    playTween(optionButton, Ease.Fast, {
                        BackgroundTransparency = 1,
                    })
                end
            end)

            optionButton.Activated:Connect(function()
                currentValue = option
                valueLabel.Text = tostring(option)
                closeList()
                invoke(callback, option)
            end)

            table.insert(optionButtons, optionButton)
        end
    end

    local function insideListOrRow(point)
        return pointInside(list, point) or pointInside(row, point)
    end

    click.Activated:Connect(function()
        if listOpen then
            closeList()
            return
        end

        if activeDropdownClose and activeDropdownClose ~= closeList then
            activeDropdownClose()
        end

        activeDropdownClose = closeList
        listOpen = true
        arrow.Text = "▴"

        populate()
        positionList()
        list.Visible = true

        positionConnection = RunService.RenderStepped:Connect(positionList)

        outsideConnection = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            local point = Vector2.new(input.Position.X, input.Position.Y)

            if not insideListOrRow(point) then
                closeList()
            end
        end)
    end)

    row.Destroying:Connect(closeList)

    if screenGui then
        screenGui.Destroying:Connect(closeList)
    end

    local control = {}

    function control:Set(value, fireCallback)
        if not table.find(options, value) then
            return false
        end

        currentValue = value
        valueLabel.Text = tostring(value)

        if listOpen then
            populate()
            positionList()
        end

        if fireCallback ~= false then
            invoke(callback, value)
        end

        return true
    end

    function control:Get()
        return currentValue
    end

    function control:Refresh(newOptions)
        options = type(newOptions) == "table" and newOptions or {}

        if not table.find(options, currentValue) then
            currentValue = options[1]
        end

        valueLabel.Text = currentValue == nil and "..." or tostring(currentValue)

        if listOpen then
            populate()
            positionList()
        end
    end

    control.Row = row

    return control
end

local function repositionNotifications()
    for index, entry in ipairs(notificationEntries) do
        if entry.wrapper and entry.wrapper.Parent then
            local y = -80 - ((index - 1) * 72)

            playTween(entry.wrapper, Ease.Normal, {
                Position = UDim2.new(1, -320, 1, y),
            })
        end
    end
end

function Lib:Notify(config)
    config = config or {}

    local title = config.Title or "Miku"
    local text = config.Text or ""
    local duration = math.max(0.2, tonumber(config.Duration) or 3)
    local color = config.Color or Theme.Accent

    local gui = Instance.new("ScreenGui")
    gui.Name = "MikuNotify"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 10000
    attachGui(gui)

    local wrapper = Instance.new("Frame")
    wrapper.Name = "Notification"
    wrapper.Size = UDim2.fromOffset(300, 62)
    wrapper.Position = UDim2.new(1, 400, 1, -80)
    wrapper.BackgroundTransparency = 1
    wrapper.BorderSizePixel = 0
    wrapper.Parent = gui

    local shadow = Instance.new("Frame")
    shadow.AnchorPoint = Vector2.new(0.5, 0.5)
    shadow.Position = UDim2.fromScale(0.5, 0.5)
    shadow.Size = UDim2.new(1, 14, 1, 14)
    shadow.BackgroundColor3 = Color3.new(0, 0, 0)
    shadow.BackgroundTransparency = 1
    shadow.BorderSizePixel = 0
    shadow.ZIndex = 0
    applyCorner(shadow)
    shadow.Parent = wrapper

    local holder = Instance.new("Frame")
    holder.Size = UDim2.fromScale(1, 1)
    holder.BackgroundColor3 = Theme.Surface
    holder.BorderSizePixel = 0
    holder.ZIndex = 1
    applyCorner(holder)
    applyStroke(holder, Theme.Stroke, 1, 0.3)
    holder.Parent = wrapper

    local colorBar = Instance.new("Frame")
    colorBar.Size = UDim2.new(0, 3, 1, -18)
    colorBar.Position = UDim2.new(0, 10, 0, 8)
    colorBar.BackgroundColor3 = color
    colorBar.BorderSizePixel = 0
    colorBar.ZIndex = 2
    applyCorner(colorBar)
    colorBar.Parent = holder

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Size = UDim2.new(1, -38, 0, 20)
    titleLabel.Position = UDim2.new(0, 22, 0, 9)
    titleLabel.Font = Theme.FontBold
    titleLabel.TextSize = 14
    titleLabel.TextColor3 = Theme.Text
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Text = tostring(title)
    titleLabel.ZIndex = 2
    titleLabel.Parent = holder

    local description = Instance.new("TextLabel")
    description.BackgroundTransparency = 1
    description.Size = UDim2.new(1, -38, 0, 20)
    description.Position = UDim2.new(0, 22, 0, 29)
    description.Font = Theme.Font
    description.TextSize = 12
    description.TextColor3 = Theme.TextDim
    description.TextXAlignment = Enum.TextXAlignment.Left
    description.TextTruncate = Enum.TextTruncate.AtEnd
    description.Text = tostring(text)
    description.ZIndex = 2
    description.Parent = holder

    local progress = Instance.new("Frame")
    progress.Size = UDim2.new(1, -20, 0, 2)
    progress.Position = UDim2.new(0, 10, 1, -5)
    progress.BackgroundColor3 = color
    progress.BorderSizePixel = 0
    progress.ZIndex = 2
    applyCorner(progress)
    progress.Parent = holder

    local entry = {
        gui = gui,
        wrapper = wrapper,
        closed = false,
    }

    table.insert(notificationEntries, entry)
    repositionNotifications()

    playTween(progress, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 0, 2),
    })

    task.delay(duration, function()
        if entry.closed then
            return
        end

        entry.closed = true

        for index, current in ipairs(notificationEntries) do
            if current == entry then
                table.remove(notificationEntries, index)
                break
            end
        end

        if wrapper.Parent then
            playTween(wrapper, Ease.Normal, {
                Position = UDim2.new(1, 400, wrapper.Position.Y.Scale, wrapper.Position.Y.Offset),
            })
        end

        task.delay(0.25, function()
            pcall(function()
                gui:Destroy()
            end)

            repositionNotifications()
        end)
    end)

    return gui
end

function Lib:CreateWatermark(config)
    config = config or {}

    local accent = config.Accent or Theme.Accent

    local gui = Instance.new("ScreenGui")
    gui.Name = config.Name or "MikuWatermark"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = tonumber(config.DisplayOrder) or 10001
    gui:SetAttribute("MikuAccent", accent)
    attachGui(gui)

    local frame = Instance.new("Frame")
    frame.Name = "Watermark"

    if typeof(config.Size) == "UDim2" then
        frame.Size = config.Size
    else
        frame.Size = UDim2.fromOffset(
            math.max(120, tonumber(config.Width) or 230),
            math.max(26, tonumber(config.Height) or 34)
        )
    end

    frame.AnchorPoint = config.AnchorPoint or Vector2.new(0, 0)
    frame.Position = config.Position or UDim2.fromOffset(16, 16)
    frame.BackgroundColor3 = config.BackgroundColor or Theme.Surface
    frame.BackgroundTransparency = clamp(
        tonumber(config.BackgroundTransparency) or 0.08,
        0,
        1
    )
    frame.BorderSizePixel = 0
    frame.Active = config.Draggable == true
    frame.Parent = gui

    applyCorner(frame)
    local stroke = applyStroke(frame, accent, 1, 0.25)

    local accentBar = Instance.new("Frame")
    accentBar.Name = "Accent"
    accentBar.Size = UDim2.new(0, 3, 1, -14)
    accentBar.Position = UDim2.new(0, 8, 0, 7)
    accentBar.BackgroundColor3 = accent
    accentBar.BorderSizePixel = 0
    accentBar.ZIndex = 2
    applyCorner(accentBar)
    accentBar.Parent = frame

    local label = Instance.new("TextLabel")
    label.Name = "Text"
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 18, 0, 0)
    label.Size = UDim2.new(1, -26, 1, 0)
    label.Font = config.Font or Theme.FontBold
    label.TextSize = tonumber(config.TextSize) or 12
    label.TextColor3 = config.TextColor or Theme.Text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.Text = tostring(
        config.Text or ("Miku | " .. (LocalPlayer and LocalPlayer.Name or "Player"))
    )
    label.ZIndex = 2
    label.Parent = frame

    local dragCleanup

    if config.Draggable == true and type(self.newDraggable) == "function" then
        local ok, cleanup = pcall(function()
            return self.newDraggable(frame, frame)
        end)

        if ok and type(cleanup) == "function" then
            dragCleanup = cleanup
        end
    end

    local destroyed = false

    local function cleanupDrag()
        if dragCleanup then
            local cleanup = dragCleanup
            dragCleanup = nil
            pcall(cleanup)
        end
    end

    local watermark = {
        Gui = gui,
        Frame = frame,
        Label = label,
    }

    gui.Destroying:Connect(function()
        destroyed = true
        cleanupDrag()
    end)

    function watermark:SetText(text)
        if not destroyed then
            label.Text = tostring(text or "")
        end
    end

    function watermark:SetVisible(state)
        if not destroyed then
            gui.Enabled = state and true or false
        end
    end

    function watermark:SetAccent(color)
        if destroyed or typeof(color) ~= "Color3" then
            return
        end

        accentBar.BackgroundColor3 = color
        stroke.Color = color
        gui:SetAttribute("MikuAccent", color)
    end

    function watermark:Destroy()
        if destroyed then
            return
        end

        destroyed = true
        cleanupDrag()
        gui:Destroy()
    end

    return watermark
end

function Lib:DestroyAll()
    if activeDropdownClose then
        local closeDropdown = activeDropdownClose
        pcall(closeDropdown)
    end

    for _, entry in ipairs(table.clone(notificationEntries)) do
        entry.closed = true
    end

    table.clear(notificationEntries)

    for _, window in ipairs(table.clone(trackedWindows)) do
        if window and type(window.Destroy) == "function" then
            pcall(function()
                window:Destroy()
            end)
        end
    end

    for _, gui in ipairs(table.clone(trackedGuis)) do
        if gui then
            pcall(function()
                gui:Destroy()
            end)
        end
    end

    table.clear(trackedWindows)
    table.clear(trackedGuis)
end

Lib.CloseAll = Lib.DestroyAll
Lib.Destroy = Lib.DestroyAll

return Lib
