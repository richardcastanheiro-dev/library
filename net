		Visible = true
	}
	local destroyed = false
	local tabs = {}
	local activePage = nil
	local activeTab = nil
	local selectTab
	local createTab
	selectTab = function(identifier)
		local found = nil
		if type(identifier) == "number" then
			found = tabs[identifier]
		elseif type(identifier) == "string" then
			for _, tab in ipairs(tabs) do
				if tab.Name == identifier then
					found = tab
					break
				end
			end
		else
			for _, tab in ipairs(tabs) do
				if tab == identifier or tab.Page == identifier or tab.Button == identifier then
					found = tab
					break
				end
			end
		end
		if not found then
			found = tabs[1]
		end
		if not found then
			activePage = nil
			activeTab = nil
			return nil
		end
		for _, tab in ipairs(tabs) do
			local selected = tab == found
			tab.Page.Visible = selected
			tab.Button.BackgroundColor3 = selected and Theme.SurfaceAlt or Theme.Surface
			tab.Button.BackgroundTransparency = selected and 0 or 1
			tab.Button.TextColor3 = selected and Theme.Text or Theme.TextDim
			tab.Indicator.Visible = selected
		end
		activePage = found.Page
		activeTab = found
		context.closeAllDropdowns()
		updatePageCanvas(found.Page)
		return found
	end
