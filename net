local function make(className, properties)
	local instance = Instance.new(className)
	for key, value in pairs(properties or {}) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	if properties and properties.Parent then
		instance.Parent = properties.Parent
	end
	return instance
end

local function corner(instance, radius)
	return make("UICorner", {
		Parent = instance,
		CornerRadius = UDim.new(0, radius)
	})
end

local function stroke(instance, color, thickness, transparency)
	return make("UIStroke", {
		Parent = instance,
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	})
end

local function pad(instance, top, right, bottom, left)
	return make("UIPadding", {
		Parent = instance,
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		PaddingLeft = UDim.new(0, left or 0)
	})
end

local function tween(instance, properties, duration, style, direction)
	local animation = TweenService:Create(
		instance,
		TweenInfo.new(
			duration or 0.2,
			style or Enum.EasingStyle.Quart,
			direction or Enum.EasingDirection.Out
		),
		properties
	)
	animation:Play()
	return animation
end

local function getViewport()
	local camera = workspace.CurrentCamera
	if camera then
		return camera.ViewportSize
	end
	return Vector2.new(1280, 720)
end

local function nextOrder(parent)
	local highest = 0
	for _, child in ipairs(parent:GetChildren()) do
		if child:IsA("GuiObject") and child.LayoutOrder > highest then
			highest = child.LayoutOrder
		end
	end
	return highest + 1
end

local function updatePageCanvas(page)
	local pageLayout = page:FindFirstChildOfClass("UIListLayout")
	if not pageLayout then
		return
	end
	local contentHeight = pageLayout.AbsoluteContentSize.Y + 28
	local viewportHeight = page.AbsoluteSize.Y
	page.CanvasSize = UDim2.fromOffset(0, math.max(math.ceil(contentHeight), math.ceil(viewportHeight)))
	local maxScroll = math.max(0, page.CanvasSize.Y.Offset - viewportHeight)
	if page.CanvasPosition.Y > maxScroll then
		page.CanvasPosition = Vector2.new(0, maxScroll)
	end
end

function Lib.newDraggable(target, handle, isLocked)
	if not target or not handle then
		return
	end
	local dragging = false
	local dragStartPointer = Vector2.zero
	local dragStartPosition = Vector2.zero
	local beginConnection = handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local locked = false
			if type(isLocked) == "function" then
				local success, result = pcall(isLocked)
				locked = success and result == true
			else
				locked = isLocked == true
			end
			if locked then
				return
			end
			dragging = true
			dragStartPointer = Vector2.new(input.Position.X, input.Position.Y)
			dragStartPosition = target.AbsolutePosition
		end
	end)
	local changedConnection = UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local pointer = Vector2.new(input.Position.X, input.Position.Y)
		local delta = pointer - dragStartPointer
		local viewport = getViewport()
		local size = target.AbsoluteSize
		local maxX = math.max(0, viewport.X - size.X)
		local maxY = math.max(0, viewport.Y - size.Y)
		local newX = math.clamp(dragStartPosition.X + delta.X, 0, maxX)
		local newY = math.clamp(dragStartPosition.Y + delta.Y, 0, maxY)
		target.Position = UDim2.fromOffset(math.floor(newX), math.floor(newY))
	end)
	local endedConnection = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	return function()
		beginConnection:Disconnect()
		changedConnection:Disconnect()
		endedConnection:Disconnect()
	end
end

