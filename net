local function removeTracked(list, target)
    for index = #list, 1, -1 do
        if list[index] == target then
            table.remove(list, index)
            return
        end
    end
end

local function getViewport()
    local camera = workspace.CurrentCamera
    if camera then
        return camera.ViewportSize
    end

    return Vector2.new(1280, 720)
end

local function attachGui(gui)
    local parent

    if RunService:IsStudio() then
        parent = LocalPlayer:WaitForChild("PlayerGui")
    else
        local ok, hui = pcall(function()
            return gethui()
        end)

        if ok and hui then
            parent = hui
        else
            parent = CoreGui
        end
    end

    local ok = pcall(function()
        gui.Parent = parent
    end)

    if not ok or gui.Parent == nil then
        gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end

    table.insert(trackedGuis, gui)

    gui.Destroying:Connect(function()
        removeTracked(trackedGuis, gui)
    end)
end

local function applyCorner(instance)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = instance
    return corner
end

local function applyStroke(instance, color, thickness, transparency)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Theme.Stroke
    stroke.Thickness = thickness or 1
    stroke.Transparency = transparency or 0.35
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = instance
    return stroke
end

local function applyPadding(instance, left, right, top, bottom)
    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, left or 10)
    padding.PaddingRight = UDim.new(0, right or 10)
    padding.PaddingTop = UDim.new(0, top or 10)
    padding.PaddingBottom = UDim.new(0, bottom or 10)
    padding.Parent = instance
    return padding
end

local function applyList(instance, spacing, horizontalAlignment)
    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Vertical
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, spacing or 8)
    layout.HorizontalAlignment = horizontalAlignment or Enum.HorizontalAlignment.Left
    layout.Parent = instance
    return layout
end

local function playTween(instance, tweenInfo, properties)
    if not instance then
        return nil
    end

    local ok, tween = pcall(function()
        return TweenService:Create(instance, tweenInfo, properties)
    end)

    if ok and tween then
        tween:Play()
        return tween
    end

    return nil
end

local function invoke(callback, ...)
    if type(callback) ~= "function" then
        return
    end

    local ok, err = pcall(callback, ...)
    if not ok then
        warn("[MikuLib] " .. tostring(err))
    end
end

local function clamp(value, minimum, maximum)
    if value < minimum then
        return minimum
    end

    if value > maximum then
        return maximum
    end

    return value
end

local function normalizeKeybind(value, useDefault)
    if value == nil then
        return useDefault and Enum.KeyCode.RightControl or nil
    end

    if value == false then
        return nil
    end

    if typeof(value) == "EnumItem" then
        if value.EnumType == Enum.KeyCode and value ~= Enum.KeyCode.Unknown then
            return value
        end

        return nil
    end

    if type(value) == "string" then
        local keyName = value:gsub("^Enum%.KeyCode%.", "")
        local ok, key = pcall(function()
            return Enum.KeyCode[keyName]
        end)

        if ok and key and key ~= Enum.KeyCode.Unknown then
            return key
        end
    end

    return nil
end

local function lerpUDim2(startValue, endValue, alpha)
    return UDim2.new(
        startValue.X.Scale + (endValue.X.Scale - startValue.X.Scale) * alpha,
        startValue.X.Offset + (endValue.X.Offset - startValue.X.Offset) * alpha,
        startValue.Y.Scale + (endValue.Y.Scale - startValue.Y.Scale) * alpha,
        startValue.Y.Offset + (endValue.Y.Offset - startValue.Y.Offset) * alpha
    )
end

local function findScreenGui(instance)
    local current = instance

    while current do
        if current:IsA("ScreenGui") then
            return current
        end

        current = current.Parent
    end

    return nil
end

local function getAccent(instance)
    local current = instance

    while current do
        if current:IsA("ScreenGui") then
            local accent = current:GetAttribute("MikuAccent")
            if typeof(accent) == "Color3" then
                return accent
            end
        end

        current = current.Parent
    end

    return Theme.Accent
end

local function pointInside(instance, point)
    if not instance or not instance.Parent then
        return false
    end

    local position = instance.AbsolutePosition
    local size = instance.AbsoluteSize

    return point.X >= position.X
        and point.X <= position.X + size.X
        and point.Y >= position.Y
        and point.Y <= position.Y + size.Y
end

function Lib.newDraggable(target, handle, isLocked)
    handle = handle or target

    if not target or not handle then
        return function() end
    end

    local dragging = false
    local inputType
    local dragStart
    local startPosition
    local targetPosition

    local beginConnection
    local changedConnection
    local endedConnection
    local renderConnection
    local targetDestroyConnection
    local handleDestroyConnection

    local cleaned = false
    local cleanup

    local function stopRender()
        if renderConnection then
            local connection = renderConnection
            renderConnection = nil
            connection:Disconnect()
        end
    end

    local function startRender()
        if cleaned or renderConnection then
            return
        end

        renderConnection = RunService.RenderStepped:Connect(function(deltaTime)
            if cleaned then
                stopRender()
                return
            end

            if not target.Parent then
                cleanup()
                return
            end

            if not targetPosition then
                stopRender()
                return
            end

            local alpha = 1 - math.exp(-deltaTime * 24)
            target.Position = lerpUDim2(target.Position, targetPosition, alpha)

            local position = target.Position
            local closeEnough = math.abs(position.X.Offset - targetPosition.X.Offset) < 0.5
                and math.abs(position.Y.Offset - targetPosition.Y.Offset) < 0.5

            if closeEnough then
                target.Position = targetPosition
                targetPosition = nil
                stopRender()
            end
        end)
    end

    cleanup = function()
        if cleaned then
            return
        end

        cleaned = true
        dragging = false
        inputType = nil
        targetPosition = nil

        stopRender()

        if beginConnection then
            beginConnection:Disconnect()
            beginConnection = nil
        end

        if changedConnection then
            changedConnection:Disconnect()
            changedConnection = nil
        end

        if endedConnection then
            endedConnection:Disconnect()
            endedConnection = nil
        end

        if targetDestroyConnection then
            targetDestroyConnection:Disconnect()
            targetDestroyConnection = nil
        end

        if handleDestroyConnection then
            handleDestroyConnection:Disconnect()
            handleDestroyConnection = nil
        end
    end

    beginConnection = handle.InputBegan:Connect(function(input)
        if cleaned then
            return
        end

        if type(isLocked) == "function" and isLocked() then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        stopRender()

        dragging = true
        inputType = input.UserInputType
        dragStart = Vector2.new(input.Position.X, input.Position.Y)
        startPosition = target.Position
        targetPosition = nil
    end)

    changedConnection = UserInputService.InputChanged:Connect(function(input)
        if cleaned or not dragging or not target.Parent then
            return
        end

        local mouseMove = inputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement

        local touchMove = inputType == Enum.UserInputType.Touch
            and input.UserInputType == Enum.UserInputType.Touch

        if not mouseMove and not touchMove then
            return
        end

        local position = Vector2.new(input.Position.X, input.Position.Y)
        local delta = position - dragStart

        targetPosition = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )

        startRender()
    end)

    endedConnection = UserInputService.InputEnded:Connect(function(input)
        if dragging and input.UserInputType == inputType then
            dragging = false
            inputType = nil
        end
    end)

    targetDestroyConnection = target.Destroying:Connect(cleanup)

    if handle ~= target then
        handleDestroyConnection = handle.Destroying:Connect(cleanup)
    end

    return cleanup
end

