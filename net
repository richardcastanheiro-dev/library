	slider(12, hue, function(v) hue = v end)
	slider(42, sat, function(v) sat = v end)
	slider(72, val, function(v) val = v end)
	button.MouseButton1Click:Connect(function()
		popup.Visible = not popup.Visible
		TweenService:Create(popup, Normal, { Size = UDim2.fromOffset(190, popup.Visible and 112 or 0) }):Play()
	end)
	registerControl(frame, {
		SetValue = function(v) if typeof(v) == "Color3" then color = v; hue, sat, val = v:ToHSV(); updateColor(true) end end,
		GetValue = function() return color end,
		AddListener = function(fn) table.insert(listeners, fn) end,
	})
	updateColor(false)
	refreshPage(page)
	return frame
end

