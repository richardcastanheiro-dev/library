	window.SetSize = function(_, value, heightValue)
		local currentViewport = getViewport()
		local newWidth
		local newHeight
		if typeof(value) == "UDim2" then
			newWidth = value.X.Offset + value.X.Scale * currentViewport.X
			newHeight = value.Y.Offset + value.Y.Scale * currentViewport.Y
		elseif type(value) == "number" then
			newWidth = value
			newHeight = heightValue or wrapper.AbsoluteSize.Y
		end
		if not newWidth or not newHeight then
			return
		end
		local maxSetWidth = math.max(160, currentViewport.X - 16)
		local maxSetHeight = math.max(160, currentViewport.Y - 16)
		local minSetWidth = math.min(380, maxSetWidth)
		local minSetHeight = math.min(280, maxSetHeight)
		newWidth = math.clamp(newWidth, minSetWidth, maxSetWidth)
		newHeight = math.clamp(newHeight, minSetHeight, maxSetHeight)
