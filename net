    }, head)
    corner(5, swatch)
    local swStroke = stroke(Color3.fromRGB(255, 255, 255), 1, swatch)
    swStroke.Transparency = 0.7

    local body = mk("Frame", {
        Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = Theme.Surface, BorderSizePixel = 0,
        Visible = false, ClipsDescendants = true,
    }, frame)
    corner(8, body)
    stroke(Theme.Stroke, 1, body)
    mk("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }, body)

    local sliders = {}
    local function makeChannel(name, idx, order)
        local holder = mk("Frame", { Size = UDim2.new(1, -16, 0, 32), Position = UDim2.fromOffset(8, 0), BackgroundTransparency = 1 })
        holder.LayoutOrder = order
        local lbl = mk("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.fromOffset(20, 32), Font = Enum.Font.Gotham,
            TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Text = name, TextColor3 = Theme.TextDim,
        }, holder)
        local track = mk("Frame", {
            Position = UDim2.fromOffset(22, 14), Size = UDim2.new(1, -80, 0, 4),
            BackgroundColor3 = Theme.SurfaceHi, BorderSizePixel = 0,
        }, holder)
        corner(2, track)
        local fill = mk("Frame", { Size = UDim2.fromScale(color[idx], 1), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0 }, track)
        corner(2, fill)
        local num = mk("TextLabel", {
            BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, 0, 0, 8), Size = UDim2.fromOffset(52, 16),
            Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right,
            Text = tostring(math.floor(color[idx] * 255 + 0.5)), TextColor3 = Theme.TextDim,
        }, holder)

        local dragging = false
        local function setFromX(x)
            local a = track.AbsolutePosition
            local w = math.max(track.AbsoluteSize.X, 1)
            local t = math.clamp((x - a.X) / w, 0, 1)
            color = Color3.new(
                idx == 1 and t or color.R,
                idx == 2 and t or color.G,
                idx == 3 and t or color.B
            )
            fill.Size = UDim2.fromScale(color[idx], 1)
            num.Text = tostring(math.floor(color[idx] * 255 + 0.5))
            swatch.BackgroundColor3 = color
            safeCall(cfg.Callback, color)
        end
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                setFromX(input.Position.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                setFromX(input.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end)
        holder.Parent = body
        table.insert(sliders, holder)
        return holder
    end

    makeChannel("R", 1, 1)
    makeChannel("G", 2, 2)
    makeChannel("B", 3, 3)

    head.MouseButton1Click:Connect(function()
        open = not open
        body.Visible = open
        local h = open and 112 or 0
        body.Size = UDim2.new(1, 0, 0, h)
        frame.Size = UDim2.new(1, 0, 0, 36 + (open and (h + 4) or 0))
    end)

    local c = newControl(cfg.Name or "ColorPicker", "ColorPicker", frame)
    function c:Get() return color end
    function c:Set(v)
        if typeof(v) == "Color3" then
            color = v
            swatch.BackgroundColor3 = v
            for i, h in ipairs(sliders) do
                local t = h:FindFirstChildOfClass("Frame")
                local f = t and t:FindFirstChildOfClass("Frame")
                local n = h:FindFirstChildOfClass("TextLabel")
                if f then f.Size = UDim2.fromScale(v[i], 1) end
                if n then n.Text = tostring(math.floor(v[i] * 255 + 0.5)) end
            end
        end
    end
    function c:OnChanged(fn) cfg.Callback = fn end

    attach(parent, frame)
    return finish(c)
end


