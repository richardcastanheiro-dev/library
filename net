function Lib:CreateKeybind(parent, cfg)
    cfg = cfg or {}
    if type(cfg) == "string" then cfg = { Name = cfg } end
    local key = cfg.Default or Enum.KeyCode.RightShift
    local listening = false

    local frame = mk("TextButton", {
        Name = cfg.Name or "Keybind", Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Theme.SurfaceAlt, AutoButtonColor = false, Text = "", BorderSizePixel = 0,
    })
    corner(8, frame)
    local st = stroke(Theme.Stroke, 1, frame)
    bindTheme(frame, { { "BackgroundColor3", "SurfaceAlt" } })
    bindTheme(st, { { "Color", "Stroke" } })

    local title = mk("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(1, -100, 1, 0), Font = Enum.Font.Gotham, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = cfg.Name or "Keybind", TextColor3 = Theme.Text,
    }, frame)
    bindTheme(title, { { "TextColor3", "Text" } })

    local badge = mk("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(72, 22), BackgroundColor3 = Theme.SurfaceHi,
        AutoButtonColor = false, Text = key and key.Name or "Nenhum",
        Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Theme.Text,
    }, frame)
    corner(6, badge)
    bindTheme(badge, { { "BackgroundColor3", "SurfaceHi" } })

    local c = newControl(cfg.Name or "Keybind", "Keybind", frame)

    local function render()
        badge.Text = listening and "..." or (key and key.Name or "Nenhum")
        badge.TextColor3 = listening and Theme.Accent or Theme.Text
    end

    badge.MouseButton1Click:Connect(function()
        listening = true
        render()
    end)

    UserInputService.InputBegan:Connect(function(input, processed)
        if not frame.Parent then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if listening then
            listening = false
            if input.KeyCode == Enum.KeyCode.Escape then
                render()
                return
            elseif input.KeyCode == Enum.KeyCode.Backspace then
                key = nil
            else
                key = input.KeyCode
            end
            render()
            safeCall(cfg.Callback, key)
            return
        end
        if processed then return end
        if frame:IsDescendantOf(game:GetService("CoreGui")) or frame.Parent then
            if key and input.KeyCode == key and frame.Active then
                safeCall(cfg.Callback, key)
            end
        end
    end)

    function c:Get() return key end
    function c:Set(v)
        if typeof(v) == "EnumItem" or v == nil then key = v else key = Enum.KeyCode[tostring(v)] end
        render()
    end
    function c:SetKey(v) c:Set(v) end
    function c:OnChanged(fn) cfg.Callback = fn end
    render()
    attach(parent, frame)
    return finish(c)
end


