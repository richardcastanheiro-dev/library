    root.BackgroundTransparency = 1
    TweenService:Create(root, Ease.Slow, {
        Size = size,
        BackgroundTransparency = 0,
    }):Play()

    function window:CreateTab(name)
        local tabBtn = Instance.new("TextButton")
        tabBtn.Size = UDim2.new(1, 0, 0, 34)
        tabBtn.BackgroundColor3 = Theme.SurfaceAlt
        tabBtn.BackgroundTransparency = 1
        tabBtn.AutoButtonColor = false
        tabBtn.Text = ""
        tabBtn.Parent = sidebar
        applyCorner(tabBtn, 8)

        local tabStroke = applyStroke(tabBtn, Theme.Stroke, 1, 1)

        local tabAccent = Instance.new("Frame")
        tabAccent.Size = UDim2.new(0, 3, 0, 16)
        tabAccent.Position = UDim2.new(0, 6, 0.5, -8)
        tabAccent.BackgroundColor3 = accent
        tabAccent.BackgroundTransparency = 1
        tabAccent.BorderSizePixel = 0
        tabAccent.Parent = tabBtn
        applyCorner(tabAccent, 3)

        local tabLabel = Instance.new("TextLabel")
        tabLabel.BackgroundTransparency = 1
        tabLabel.Size = UDim2.new(1, -22, 1, 0)
        tabLabel.Position = UDim2.new(0, 18, 0, 0)
        tabLabel.Font = Theme.Font
        tabLabel.TextSize = 13
        tabLabel.TextColor3 = Theme.TextDim
        tabLabel.TextXAlignment = Enum.TextXAlignment.Left
        tabLabel.Text = name
        tabLabel.Parent = tabBtn

        local page = Instance.new("ScrollingFrame")
        page.Size = UDim2.fromScale(1, 1)
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.ScrollBarThickness = 3
        page.ScrollBarImageColor3 = accent
        page.CanvasSize = UDim2.new(0, 0, 0, 0)
        page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        page.Visible = false
        page.Parent = content
        applyPadding(page, 0, 6, 0, 0)
        applyList(page, 8)

        local tab = { Button = tabBtn, Page = page, Name = name }

        function window:SelectTab(target)
            if self.ActiveTab == target then return end
            if self.ActiveTab then
                local prev = self.ActiveTab
                TweenService:Create(prev.Button, Ease.Fast, { BackgroundTransparency = 1 }):Play()
                TweenService:Create(prev.Button:FindFirstChildOfClass("UIStroke"), Ease.Fast, { Transparency = 1 }):Play()
                TweenService:Create(prev.Button:FindFirstChild("TextLabel"), Ease.Fast, { TextColor3 = Theme.TextDim }):Play()
                prev.Button:FindFirstChild("Frame").BackgroundTransparency = 1
                prev.Page.Visible = false
            end
            self.ActiveTab = target
            TweenService:Create(target.Button, Ease.Fast, { BackgroundTransparency = 0 }):Play()
            TweenService:Create(target.Button:FindFirstChildOfClass("UIStroke"), Ease.Fast, { Transparency = 0.4 }):Play()
            TweenService:Create(target.Button:FindFirstChild("TextLabel"), Ease.Fast, { TextColor3 = Theme.Text }):Play()
            target.Button:FindFirstChild("Frame").BackgroundTransparency = 0
            target.Page.Visible = true
            target.Page.Position = UDim2.new(0, 8, 0, 0)
            TweenService:Create(target.Page, Ease.Fast, { Position = UDim2.new(0, 0, 0, 0) }):Play()
        end

        tabBtn.MouseEnter:Connect(function()
            if self.ActiveTab == tab then return end
            TweenService:Create(tabBtn, Ease.Fast, { BackgroundTransparency = 0.6 }):Play()
        end)
        tabBtn.MouseLeave:Connect(function()
            if self.ActiveTab == tab then return end
            TweenService:Create(tabBtn, Ease.Fast, { BackgroundTransparency = 1 }):Play()
        end)
        tabBtn.MouseButton1Click:Connect(function()
            window:SelectTab(tab)
        end)

        table.insert(self.Tabs, tab)
        if #self.Tabs == 1 then
            window:SelectTab(tab)
        end

        return tab.Page, tab
    end

    getgenv().MikuLibInstance = window
    return window
end

function Lib:CreateButton(parent, text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = Theme.SurfaceAlt
    btn.AutoButtonColor = false
    btn.Text = ""
    btn.Parent = parent
    applyCorner(btn, 9)
    local stroke = applyStroke(btn, Theme.Stroke, 1, 0.4)

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Theme.FontSemi
    label.TextSize = 14
    label.TextColor3 = Theme.Text
    label.Text = text
    label.Parent = btn

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, Ease.Fast, { BackgroundColor3 = Theme.SurfaceHi }):Play()
        TweenService:Create(stroke, Ease.Fast, { Color = Theme.Accent, Transparency = 0.1 }):Play()
        TweenService:Create(label, Ease.Fast, { TextColor3 = Theme.AccentSoft }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, Ease.Fast, { BackgroundColor3 = Theme.SurfaceAlt }):Play()
        TweenService:Create(stroke, Ease.Fast, { Color = Theme.Stroke, Transparency = 0.4 }):Play()
        TweenService:Create(label, Ease.Fast, { TextColor3 = Theme.Text }):Play()
    end)
    btn.MouseButton1Down:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.06), { BackgroundColor3 = Theme.Accent }):Play()
        TweenService:Create(label, TweenInfo.new(0.06), { TextColor3 = Theme.Text }):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        TweenService:Create(btn, Ease.Fast, { BackgroundColor3 = Theme.SurfaceHi }):Play()
        TweenService:Create(label, Ease.Fast, { TextColor3 = Theme.AccentSoft }):Play()
    end)
    if callback then
        btn.MouseButton1Click:Connect(callback)
    end

    return btn
end

function Lib:CreateToggle(parent, text, default, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 34)
    row.BackgroundColor3 = Theme.SurfaceAlt
    row.BackgroundTransparency = 0.4
    row.BorderSizePixel = 0
    row.Parent = parent
    applyCorner(row, 9)
    applyPadding(row, 12, 10, 0, 0)

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, -50, 1, 0)
    label.Font = Theme.FontSemi
    label.TextSize = 14
    label.TextColor3 = Theme.Text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = text
    label.Parent = row

    local track = Instance.new("Frame")
    track.Size = UDim2.fromOffset(38, 20)
    track.Position = UDim2.new(1, -38, 0.5, -10)
    track.BackgroundColor3 = Theme.SurfaceHi
    track.BorderSizePixel = 0
    track.Parent = row
    applyCorner(track, 10)
    local trackStroke = applyStroke(track, Theme.Stroke, 1, 0.4)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(14, 14)
    knob.Position = UDim2.new(0, 3, 0.5, -7)
    knob.BackgroundColor3 = Theme.TextDim
    knob.BorderSizePixel = 0
    knob.Parent = track
    applyCorner(knob, 7)

    local state = default and true or false

    local click = Instance.new("TextButton")
    click.Size = UDim2.fromScale(1, 1)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.Parent = row

    local function render()
        TweenService:Create(knob, Ease.Fast, {
            Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
            BackgroundColor3 = state and Theme.Text or Theme.TextDim,
        }):Play()
        TweenService:Create(track, Ease.Fast, {
            BackgroundColor3 = state and Theme.Accent or Theme.SurfaceHi,
        }):Play()
        TweenService:Create(trackStroke, Ease.Fast, {
            Color = state and Theme.Accent or Theme.Stroke,
            Transparency = state and 0.1 or 0.4,
        }):Play()
    end

    render()

    click.MouseButton1Click:Connect(function()
        state = not state
        render()
        if callback then callback(state) end
    end)

    return {
        Set = function(_, v) state = v and true or false; render() end,
        Get = function() return state end,
    }
end

function Lib:CreateSlider(parent, text, min, max, default, callback)
    min = min or 0
    max = max or 100
    default = default or min

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 52)
    row.BackgroundColor3 = Theme.SurfaceAlt
    row.BackgroundTransparency = 0.4
    row.BorderSizePixel = 0
    row.Parent = parent
    applyCorner(row, 9)
    applyPadding(row, 12, 12, 8, 8)

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, -50, 0, 16)
    label.Position = UDim2.new(0, 0, 0, 0)
    label.Font = Theme.FontSemi
    label.TextSize = 13
    label.TextColor3 = Theme.Text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = text
    label.Parent = row

    local valueLabel = Instance.new("TextLabel")
    valueLabel.BackgroundTransparency = 1
    valueLabel.Size = UDim2.fromOffset(50, 16)
    valueLabel.Position = UDim2.new(1, -50, 0, 0)
    valueLabel.Font = Theme.FontBold
    valueLabel.TextSize = 13
    valueLabel.TextColor3 = Theme.AccentSoft
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Text = tostring(default)
    valueLabel.Parent = row

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 0, 30)
    track.BackgroundColor3 = Theme.SurfaceHi
    track.BorderSizePixel = 0
    track.Parent = row
    applyCorner(track, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Theme.Accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    applyCorner(fill, 3)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(14, 14)
    knob.Position = UDim2.new(0, 0, 0.5, -7)
    knob.BackgroundColor3 = Theme.Text
    knob.BorderSizePixel = 0
    knob.Parent = track
    applyCorner(knob, 7)
    applyStroke(knob, Theme.Accent, 2, 0)

    local click = Instance.new("TextButton")
    click.Size = UDim2.new(1, 0, 0, 20)
    click.Position = UDim2.new(0, 0, 0, 22)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.Parent = row

    local dragging = false
    local value = default

    local function clamp(v, a, b)
        if v < a then return a end
        if v > b then return b end
        return v
    end

    local function render()
        local alpha = (value - min) / (max - min)
        TweenService:Create(fill, Ease.Fast, { Size = UDim2.new(alpha, 0, 1, 0) }):Play()
        TweenService:Create(knob, Ease.Fast, { Position = UDim2.new(alpha, -7, 0.5, -7) }):Play()
        valueLabel.Text = tostring(math.floor(value + 0.5))
    end

    local function updateFromX(x)
        local rel = (x - track.AbsolutePosition.X) / track.AbsoluteSize.X
        rel = clamp(rel, 0, 1)
        value = min + (max - min) * rel
        render()
        if callback then callback(value) end
    end

    click.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    render()

    return {
        Set = function(_, v) value = clamp(v, min, max); render() end,
        Get = function() return value end,
    }
end

function Lib:CreateTextBox(parent, placeholder, callback)
    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, 0, 0, 36)
    box.BackgroundColor3 = Theme.SurfaceAlt
    box.BackgroundTransparency = 0.4
    box.BorderSizePixel = 0
    box.Parent = parent
    applyCorner(box, 9)
    local stroke = applyStroke(box, Theme.Stroke, 1, 0.4)

    local input = Instance.new("TextBox")
    input.BackgroundTransparency = 1
    input.Size = UDim2.fromScale(1, 1)
    input.Position = UDim2.fromScale(0, 0)
    input.Font = Theme.FontSemi
    input.TextSize = 14
    input.TextColor3 = Theme.Text
    input.PlaceholderText = placeholder or ""
    input.PlaceholderColor3 = Theme.TextDim
    input.Text = ""
    input.TextXAlignment = Enum.TextXAlignment.Left
    input.ClearTextOnFocus = false
    input.Parent = box
    applyPadding(input, 12, 12, 0, 0)

    input.Focused:Connect(function()
        TweenService:Create(stroke, Ease.Fast, { Color = Theme.Accent, Transparency = 0 }):Play()
        TweenService:Create(box, Ease.Fast, { BackgroundTransparency = 0.2 }):Play()
    end)
    input.FocusLost:Connect(function(enterPressed)
        TweenService:Create(stroke, Ease.Fast, { Color = Theme.Stroke, Transparency = 0.4 }):Play()
        TweenService:Create(box, Ease.Fast, { BackgroundTransparency = 0.4 }):Play()
        if callback then callback(input.Text, enterPressed) end
    end)

    return input
end

