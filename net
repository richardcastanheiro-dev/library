	local valueLabel = make("TextLabel", { Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(0.5, -30, 1, 0), BackgroundTransparency = 1, Text = "",
		Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Theme.AccentSoft,
		TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd }, row)
	local arrow = make("TextLabel", { Position = UDim2.new(1, -22, 0, 0),
		Size = UDim2.fromOffset(14, 42), BackgroundTransparency = 1, Text = "⌄",
		Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Theme.TextDim }, row)

	local list = make("Frame", { Position = UDim2.fromOffset(0, 47), Size = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = Theme.Surface, ClipsDescendants = true, Visible = false, ZIndex = 20 }, control)
	corner(list, 9); stroke(list, Theme.Stroke, 0.35)

	local searchBox
	if searchable then
		searchBox = make("TextBox", { Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 0, 30),
			BackgroundColor3 = Theme.SurfaceAlt, Text = "", PlaceholderText = "Pesquisar...",
			PlaceholderColor3 = Theme.TextDim, TextColor3 = Theme.Text, Font = Enum.Font.Gotham,
			TextSize = 12, ClearTextOnFocus = false, ZIndex = 22 }, list)
		corner(searchBox, 6)
	end

	local optionsHolder = make("ScrollingFrame", { Position = UDim2.fromOffset(4, searchable and 42 or 4),
		Size = UDim2.new(1, -8, 1, searchable and -46 or -8), BackgroundTransparency = 1,
		ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Accent, ZIndex = 21 }, list)
	local layout = make("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, optionsHolder)
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		optionsHolder.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 5)
	end)

	local opened, disabled = false, false
	local optionButtons, listeners, setOpen = {}, {}, nil
	local function notify(...) safeCall(cb, ...); for _, fn in ipairs(listeners) do safeCall(fn, ...) end end
	local function getText()
		if multi then
			local vals = {}
			for _, o in ipairs(options) do if selected[o] then table.insert(vals, tostring(o)) end end
			return #vals > 0 and table.concat(vals, ", ") or "Nenhum"
		end
		return selected ~= nil and tostring(selected) or "Nenhum"
	end
	local function updateOptions()
		for _, c in ipairs(optionsHolder:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
		optionButtons = {}
		for i, o in ipairs(options) do
			local isSel = multi and selected[o] or selected == o
			local ob = make("TextButton", { Size = UDim2.new(1, -4, 0, 30),
				BackgroundColor3 = isSel and Theme.SurfaceHi or Theme.Surface,
				BackgroundTransparency = isSel and 0.1 or 1, Text = tostring(o),
				Font = Enum.Font.Gotham, TextSize = 12,
				TextColor3 = isSel and Theme.AccentSoft or Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
				LayoutOrder = i, ZIndex = 22 }, optionsHolder)
			make("UIPadding", { PaddingLeft = UDim.new(0, 9) }, ob); corner(ob, 6)
			ob.MouseButton1Click:Connect(function()
				if disabled then return end
				if multi then
					selected[o] = not selected[o] or nil
					updateOptions()
					local vals = {}
					for _, it in ipairs(options) do if selected[it] then table.insert(vals, it) end end
					notify(vals)
				else
					selected = o; updateOptions(); setOpen(false); notify(o)
				end
			end)
			ob.MouseEnter:Connect(function() TweenService:Create(ob, Fast, { BackgroundTransparency = 0.2 }):Play() end)
			ob.MouseLeave:Connect(function()
				local a = multi and selected[o] or selected == o
				TweenService:Create(ob, Fast, { BackgroundTransparency = a and 0.1 or 1 }):Play()
			end)
			optionButtons[#optionButtons + 1] = ob
		end
		valueLabel.Text = getText()
	end

	setOpen = function(v)
		opened = v; list.Visible = true
		local h = opened and math.min(#options * 33 + 10 + (searchable and 42 or 0), 190) or 0
		TweenService:Create(list, Normal, { Size = UDim2.new(1, 0, 0, h) }):Play()
		TweenService:Create(arrow, Fast, { Rotation = opened and 180 or 0 }):Play()
		if not opened then task.delay(0.21, function() if not opened and list.Parent then list.Visible = false end end) end
		control.Size = UDim2.new(1, 0, 0, opened and 48 + h or 42)
		refreshPage(page)
	end
	row.MouseButton1Click:Connect(function() if not disabled then setOpen(not opened) end end)
	if searchBox then
		searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			local q = searchBox.Text:lower()
			for _, b in ipairs(optionButtons) do b.Visible = q == "" or b.Text:lower():find(q, 1, true) ~= nil end
		end)
	end
	updateOptions()

	registerControl(control, {
		SetValue = function(v)
			if multi then
				selected = {}
				if type(v) == "table" then for _, it in ipairs(v) do for _, o in ipairs(options) do if o == it then selected[it] = true end end end end
			else for _, o in ipairs(options) do if o == v then selected = v; break end end end
			updateOptions()
			if multi then
				local vals = {}
				for _, o in ipairs(options) do if selected[o] then table.insert(vals, o) end end
				notify(vals)
			else notify(selected) end
		end,
		GetValue = function()
			if multi then
				local vals = {}
				for _, o in ipairs(options) do if selected[o] then table.insert(vals, o) end end
				return vals
			end
			return selected
		end,
		SetDisabled = function(v) disabled = v; row.Active = not v; row.BackgroundTransparency = v and 0.65 or 0.25 end,
		AddListener = function(fn) table.insert(listeners, fn) end,
	})
	refreshPage(page)
	return control
end

function Lib:CreateKeybind(parent, text, defaultKey, cb)
	local cfg = type(text) == "table" and text or nil
	if cfg then text = cfg.Text or cfg.Title or cfg.Name; defaultKey = cfg.Default; cb = cfg.Callback end
	local frame, page = prepareControl(parent, 42, "Frame")
	make("TextLabel", { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -120, 1, 0),
		BackgroundTransparency = 1, Text = tostring(text or "Keybind"), Font = Enum.Font.Gotham,
		TextSize = 13, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left }, frame)
	local button = make("TextButton", { Position = UDim2.new(1, -105, 0.5, -14),
		Size = UDim2.fromOffset(93, 28), BackgroundColor3 = Theme.SurfaceHi, Text = "",
		Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Theme.AccentSoft,
		AutoButtonColor = false }, frame)
	corner(button, 7); stroke(button, Theme.Stroke, 0.4)

	local currentKey = defaultKey or Enum.KeyCode.RightShift
	local listening, disabled = false, false
	local listeners = {}
	local function update() button.Text = currentKey and currentKey.Name or "None"; button.TextColor3 = Theme.AccentSoft end
	update()
	button.MouseButton1Click:Connect(function()
		if disabled then return end
		listening = true; button.Text = "Pressione..."; button.TextColor3 = Theme.Success
	end)
	local conn = UserInputService.InputBegan:Connect(function(input, processed)
		if listening then
			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			listening = false
			if input.KeyCode == Enum.KeyCode.Escape then update(); return end
			if input.KeyCode == Enum.KeyCode.Backspace then currentKey = nil; update(); return end
			currentKey = input.KeyCode; update(); return
		end
		if disabled or processed or UserInputService:GetFocusedTextBox() then return end
		if currentKey and input.KeyCode == currentKey then
			safeCall(cb, currentKey)
			for _, fn in ipairs(listeners) do safeCall(fn, currentKey) end
		end
	end)
	registerControl(frame, {
		SetValue = function(k) if typeof(k) == "EnumItem" and k.EnumType == Enum.KeyCode then currentKey = k; update() end end,
		GetValue = function() return currentKey end,
		SetDisabled = function(v) disabled = v; button.TextTransparency = v and 0.5 or 0 end,
		AddListener = function(fn) table.insert(listeners, fn) end,
	})
	frame.Destroying:Connect(function() conn:Disconnect() end)
	refreshPage(page)
	return frame
end

