		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BorderSizePixel = 0
	}, row)
	local button = make("TextButton", {
		Name = "Bind",
		Position = UDim2.new(1, -100, 0, 7),
		Size = UDim2.fromOffset(100, 28),
		BackgroundColor3 = Theme.SurfaceHi,
		BackgroundTransparency = 0.08,
		Text = keyToString(config.CurrentKeybind or "None"),
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = Theme.AccentSoft,
		AutoButtonColor = false,
		BorderSizePixel = 0
	}, row)
	corner(button, 8)
	stroke(button, Theme.Stroke, 0.4)

	local object = {
		Type = "Keybind",
		Instance = row,
		CurrentKeybind = keyToString(config.CurrentKeybind or "None")
	}

	local listening = false
	local holding = false

	button.MouseButton1Click:Connect(function()
		listening = true
		button.Text = "..."
	end)

	local beganConnection = UserInputService.InputBegan:Connect(function(input, processed)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				object.CurrentKeybind = input.KeyCode.Name
				button.Text = object.CurrentKeybind
				if config.Flag then
					Rayfield.Flags[config.Flag] = object.CurrentKeybind
				end
				safeCall(config.ChangedCallback, object.CurrentKeybind)
				SaveConfiguration()
			end
			return
		end
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == object.CurrentKeybind then
			if config.HoldToInteract then
				holding = true
				safeCall(config.Callback, true)
			else
				safeCall(config.Callback, object.CurrentKeybind)
			end
		end
	end)

	local endedConnection = UserInputService.InputEnded:Connect(function(input)
		if config.HoldToInteract and holding and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == object.CurrentKeybind then
			holding = false
			safeCall(config.Callback, false)
		end
	end)

	function object:Set(value)
		object.CurrentKeybind = keyToString(value)
		button.Text = object.CurrentKeybind
		if config.Flag then
			Rayfield.Flags[config.Flag] = object.CurrentKeybind
		end
		safeCall(config.ChangedCallback, object.CurrentKeybind)
		SaveConfiguration()
	end
	function object:Destroy()
		if beganConnection then
			beganConnection:Disconnect()
		end
		if endedConnection then
			endedConnection:Disconnect()
		end
		if config.Flag then
			Rayfield.Flags[config.Flag] = nil
			Rayfield._controls[config.Flag] = nil
		end
		row:Destroy()
		refreshPage(page)
	end

	refreshPage(page)
	if config.Flag then
		Rayfield._controls[config.Flag] = object
		Rayfield.Flags[config.Flag] = object.CurrentKeybind
	end
	table.insert(self._controls, object)
	return object
end

local function createChannelSlider(parent, title, order, default, onChanged)
	local holder = make("Frame", {
		Name = title,
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		ZIndex = 21,
