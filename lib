function Window:SetToggleKeybind(key)
	if self._keybindConnection then
		self._keybindConnection:Disconnect()
		self._keybindConnection = nil
	end
	if key == nil or key == false then
		self._keybind = false
		return
	end
	local resolved = keyFromValue(key)
	self._keybind = resolved or key
	if not resolved then
		return
	end
	self._keybindConnection = UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == resolved and not UserInputService:GetFocusedTextBox() then
			self:Toggle()
		end
	end)
end

function Window:SetKeybind(key)
	self:SetToggleKeybind(key)
end

function Window:GetKeybind()
	return self._keybind
end

function Window:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	self._visible = false
	if self._resizeApi then
		pcall(function()
			self._resizeApi.Destroy()
		end)
		self._resizeApi = nil
	end
	if self._dragApi then
		pcall(function()
			self._dragApi.Destroy()
		end)
		self._dragApi = nil
	end
	if self._keybindConnection then
		self._keybindConnection:Disconnect()
		self._keybindConnection = nil
	end
	self:_cancelTweens()
	for _, entry in ipairs(self._tabs) do
		if entry.Object and type(entry.Object.Destroy) == "function" then
			pcall(function()
				entry.Object:Destroy()
			end)
		end
	end
	for index = #Rayfield.Windows, 1, -1 do
		if Rayfield.Windows[index] == self then
			table.remove(Rayfield.Windows, index)
		end
	end
	local sharedTable = getShared(false)
	if sharedTable and sharedTable.RayfieldInstance == self then
		sharedTable.RayfieldInstance = nil
	end
	if self._screenGui then
		self._screenGui:Destroy()
		self._screenGui = nil
	end
end

