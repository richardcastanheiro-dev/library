function Rayfield:LoadConfiguration()
	if not ConfigurationSettings.Enabled then
		ConfigurationLoaded = true
		return
	end
	if not fileSupport() then
		ConfigurationLoaded = true
		return
	end
	local path = configurationPath()
	if not path or not isfile(path) then
		ConfigurationLoaded = true
		return
	end
	local ok, raw = pcall(function()
		return readfile(path)
	end)
	if not ok or not raw then
		ConfigurationLoaded = true
		return
	end
	local decoded
	local decodeOk, result = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if decodeOk then
		decoded = result
	end
	if type(decoded) == "table" then
		for flagName, flagValue in pairs(decoded) do
			local control = Rayfield._controls[flagName]
			if control and type(control.Set) == "function" then
				task.spawn(function()
					if control.Type == "ColorPicker" then
						control:Set(unpackColor(flagValue))
					else
						control:Set(flagValue)
					end
				end)
			end
		end
	end
	ConfigurationLoaded = true
end

function Rayfield:SaveConfiguration()
	SaveConfiguration()
end

function Rayfield:SetVisibility(value)
	for _, window in ipairs(self.Windows) do
		window:SetVisible(value == true)
	end
end

function Rayfield:IsVisible()
	for _, window in ipairs(self.Windows) do
		if window:GetVisible() then
			return true
		end
	end
	return false
end

function Rayfield:DestroyAll()
	local windows = self.Windows
	self.Windows = {}
	for index = #windows, 1, -1 do
		local window = windows[index]
		if window and type(window.Destroy) == "function" then
			pcall(function()
				window:Destroy()
			end)
		end
	end
	local watermarks = self._watermarks
	self._watermarks = {}
	for index = #watermarks, 1, -1 do
		local watermark = watermarks[index]
		if watermark and type(watermark.Destroy) == "function" then
			pcall(function()
				watermark:Destroy()
			end)
		end
	end
	if self._notifyGui then
		pcall(function()
			self._notifyGui:Destroy()
		end)
	end
	self._notifyGui = nil
	self._notifyStack = nil
	if self._watermarkGui then
		pcall(function()
			self._watermarkGui:Destroy()
		end)
	end
	self._watermarkGui = nil
	self.Flags = {}
	self._controls = {}
	ConfigurationLoaded = false
	local sharedTable = getShared(false)
	if sharedTable then
		sharedTable.RayfieldInstance = nil
	end
end

function Rayfield:CloseAll()
	self:DestroyAll()
end

function Rayfield:Destroy()
	self:DestroyAll()
end

function Rayfield.new(a, b)
	if a == Rayfield then
		return Rayfield:CreateWindow(b)
	end
	return Rayfield:CreateWindow(a)
end

return Rayfield
