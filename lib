		Type = "Dropdown",
		Instance = control,
		CurrentOption = current,
		Options = options
	}

	local isOpen = false
	local buttons = {}
	local optionHeight = 28

	local function isSelected(option)
		for _, value in ipairs(object.CurrentOption) do
			if value == option then
				return true
			end
		end
		return false
	end

	local function updateDisplay()
		if #object.CurrentOption == 0 then
			valueLabel.Text = "None"
		else
			valueLabel.Text = table.concat(object.CurrentOption, ", ")
		end
		control:SetAttribute("RayfieldValue", valueLabel.Text)
		for option, button in pairs(buttons) do
			local selected = isSelected(option)
			button.TextColor3 = selected and Theme.AccentSoft or Theme.Text
			button.Font = selected and Enum.Font.GothamBold or Enum.Font.Gotham
		end
		if config.Flag then
			Rayfield.Flags[config.Flag] = object.CurrentOption
		end
	end

	local function listHeight()
		local count = #object.Options
		local raw = 8 + count * optionHeight + math.max(0, count - 1) * 4
		return math.min(raw, 160)
	end

	local function setOpen(value)
		isOpen = value
		list.Visible = isOpen
		local height = listHeight()
		list.Size = UDim2.new(1, 0, 0, height)
		list.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 8)
		control.Size = UDim2.new(1, 0, 0, isOpen and (46 + height) or 42)
		arrow.Text = isOpen and "^" or "v"
		refreshPage(page)
	end

	local function rebuild()
		for _, button in pairs(buttons) do
			button:Destroy()
		end
		buttons = {}
		for index, option in ipairs(object.Options) do
			local optionButton = make("TextButton", {
				Name = option,
				Size = UDim2.new(1, -4, 0, optionHeight),
				BackgroundColor3 = Theme.SurfaceAlt,
				BackgroundTransparency = 1,
				Text = option,
				Font = Enum.Font.Gotham,
				TextSize = 13,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				AutoButtonColor = false,
				BorderSizePixel = 0,
				LayoutOrder = index,
				ZIndex = 21
			}, list)
			corner(optionButton, 7)
			make("UIPadding", {
				PaddingLeft = UDim.new(0, 8),
				PaddingRight = UDim.new(0, 8)
			}, optionButton)
			optionButton.MouseEnter:Connect(function()
				TweenService:Create(optionButton, Fast, {
					BackgroundTransparency = 0.7
				}):Play()
			end)
			optionButton.MouseLeave:Connect(function()
				TweenService:Create(optionButton, Fast, {
					BackgroundTransparency = 1
				}):Play()
			end)
			optionButton.MouseButton1Click:Connect(function()
				if multiple then
					if isSelected(option) then
						for index2 = #object.CurrentOption, 1, -1 do
							if object.CurrentOption[index2] == option then
								table.remove(object.CurrentOption, index2)
							end
						end
					else
						table.insert(object.CurrentOption, option)
					end
					updateDisplay()
					safeCall(config.Callback, object.CurrentOption)
					SaveConfiguration()
				else
					object.CurrentOption = { option }
					updateDisplay()
					setOpen(false)
					safeCall(config.Callback, object.CurrentOption)
					SaveConfiguration()
				end
			end)
			buttons[option] = optionButton
		end
		updateDisplay()
	end

	row.MouseButton1Click:Connect(function()
		setOpen(not isOpen)
	end)

	function object:Set(value)
		local selection = {}
		if type(value) == "table" then
			for _, item in ipairs(value) do
				table.insert(selection, tostring(item))
			end
		elseif value ~= nil then
			selection = { tostring(value) }
		end
		object.CurrentOption = selection
		updateDisplay()
		safeCall(config.Callback, object.CurrentOption)
		SaveConfiguration()
	end

	function object:Refresh(newOptions, keepCurrent)
		local list2 = {}
		if type(newOptions) == "table" then
			for _, item in ipairs(newOptions) do
				table.insert(list2, tostring(item))
			end
		end
		object.Options = list2
		if not keepCurrent then
			object.CurrentOption = {}
		end
		rebuild()
		if isOpen then
			setOpen(true)
		end
	end

	function object:Destroy()
		if config.Flag then
			Rayfield.Flags[config.Flag] = nil
			Rayfield._controls[config.Flag] = nil
		end
		control:Destroy()
		refreshPage(page)
	end

	rebuild()
	refreshPage(page)
	if config.Flag then
		Rayfield._controls[config.Flag] = object
		Rayfield.Flags[config.Flag] = object.CurrentOption
	end
	table.insert(self._controls, object)
	return object
end

function Tab:CreateKeybind(config)
	config = type(config) == "table" and config or {}
	local row, page = prepareControl(self.Page, 42, "Frame")
	make("TextLabel", {
		Name = "Label",
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, -110, 1, 0),
