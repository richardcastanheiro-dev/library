function Tab:CreateSlider(config)
	config = type(config) == "table" and config or {}
	local range = type(config.Range) == "table" and config.Range or {0, 100}
	local minNumber = tonumber(range[1]) or 0
	local maxNumber = tonumber(range[2]) or 100
	if maxNumber <= minNumber then
		maxNumber = minNumber + 1
	end
	local increment = tonumber(config.Increment) or 1
	if increment <= 0 then
		increment = 1
	end
	local suffix = tostring(config.Suffix or "")

	local frame, page = prepareControl(self.Page, 52, "Frame")
	make("TextLabel", {
		Name = "Label",
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, -90, 0, 18),
		BackgroundTransparency = 1,
		Text = tostring(config.Name or "Slider"),
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BorderSizePixel = 0
	}, frame)
	local valueLabel = make("TextLabel", {
		Name = "Value",
		Position = UDim2.new(1, -90, 0, 0),
		Size = UDim2.fromOffset(90, 18),
		BackgroundTransparency = 1,
		Text = "",
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = Theme.AccentSoft,
		TextXAlignment = Enum.TextXAlignment.Right,
		BorderSizePixel = 0
	}, frame)
	local track = make("TextButton", {
		Name = "Track",
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = Theme.SurfaceHi,
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0
	}, frame)
	corner(track, 4)
	local fill = make("Frame", {
		Name = "Fill",
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Active = false
	}, track)
	corner(fill, 4)
	local knob = make("Frame", {
		Name = "Knob",
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
		Active = false
	}, track)
	corner(knob, 7)
	stroke(knob, Theme.Stroke, 0.4)

	local object = {
		Type = "Slider",
		Instance = frame,
		CurrentValue = math.clamp(tonumber(config.CurrentValue) or minNumber, minNumber, maxNumber)
	}

	local dragging = false
	local moveConnection
	local endConnection

	local function apply(nextValue, fire)
		local value = math.clamp(tonumber(nextValue) or minNumber, minNumber, maxNumber)
		value = minNumber + math.floor((value - minNumber) / increment + 0.5) * increment
		value = math.clamp(value, minNumber, maxNumber)
		object.CurrentValue = value
		local fraction = (value - minNumber) / (maxNumber - minNumber)
		fill.Size = UDim2.new(fraction, 0, 1, 0)
		knob.Position = UDim2.new(fraction, 0, 0.5, 0)
		valueLabel.Text = formatValue(value) .. (suffix ~= "" and (" " .. suffix) or "")
		frame:SetAttribute("RayfieldValue", value)
		if config.Flag then
			Rayfield.Flags[config.Flag] = value
		end
		if fire then
			safeCall(config.Callback, value)
			SaveConfiguration()
		end
	end

	local function stop()
		dragging = false
		if moveConnection then
			moveConnection:Disconnect()
			moveConnection = nil
		end
		if endConnection then
			endConnection:Disconnect()
			endConnection = nil
		end
	end

	local function fromX(positionX)
		local relative = math.clamp((positionX - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		return minNumber + (maxNumber - minNumber) * relative
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		stop()
		dragging = true
		apply(fromX(input.Position.X), true)
		moveConnection = UserInputService.InputChanged:Connect(function(changed)
			if dragging and (changed.UserInputType == Enum.UserInputType.MouseMovement or changed.UserInputType == Enum.UserInputType.Touch) then
				apply(fromX(changed.Position.X), true)
			end
		end)
		endConnection = UserInputService.InputEnded:Connect(function(changed)
			if changed.UserInputType == Enum.UserInputType.MouseButton1 or changed.UserInputType == Enum.UserInputType.Touch then
				stop()
			end
		end)
	end)

	function object:Set(value)
		apply(value, true)
	end
	function object:Destroy()
		stop()
		if config.Flag then
			Rayfield.Flags[config.Flag] = nil
			Rayfield._controls[config.Flag] = nil
		end
		frame:Destroy()
		refreshPage(page)
	end

	apply(object.CurrentValue, false)
	refreshPage(page)
	if config.Flag then
		Rayfield._controls[config.Flag] = object
		Rayfield.Flags[config.Flag] = object.CurrentValue
	end
	table.insert(self._controls, object)
	return object
end

