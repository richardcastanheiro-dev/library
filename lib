		BackgroundTransparency = 1,
		Text = title,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		ZIndex = 21,
		BorderSizePixel = 0
	}, holder)
	local valueLabel = make("TextLabel", {
		Name = "Value",
		Position = UDim2.new(1, -36, 0, 0),
		Size = UDim2.fromOffset(36, 30),
		BackgroundTransparency = 1,
		Text = "0",
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = Theme.AccentSoft,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 21,
		BorderSizePixel = 0
	}, holder)
	local track = make("TextButton", {
		Name = "Track",
		Position = UDim2.fromOffset(22, 12),
		Size = UDim2.new(1, -64, 0, 6),
		BackgroundColor3 = Theme.SurfaceHi,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 21,
		BorderSizePixel = 0
	}, holder)
	corner(track, 3)
	local fill = make("Frame", {
		Name = "Fill",
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		ZIndex = 22,
		BorderSizePixel = 0
	}, track)
	corner(fill, 3)

	local value = default
	local dragging = false
	local moveConnection
	local endConnection

	local function setValue(amount, fire)
		value = math.clamp(math.floor(amount + 0.5), 0, 255)
		fill.Size = UDim2.new(value / 255, 0, 1, 0)
		valueLabel.Text = tostring(value)
		if fire then
			onChanged(value)
		end
	end

	local function stop()
		dragging = false
		if moveConnection then
			moveConnection:Disconnect()
			moveConnection = nil
		end
		if endConnection then
			endConnection:Disconnect()
			endConnection = nil
		end
	end

	local function fromX(positionX)
		local relative = math.clamp((positionX - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		return relative * 255
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		stop()
		dragging = true
		setValue(fromX(input.Position.X), true)
		moveConnection = UserInputService.InputChanged:Connect(function(changed)
			if dragging and (changed.UserInputType == Enum.UserInputType.MouseMovement or changed.UserInputType == Enum.UserInputType.Touch) then
				setValue(fromX(changed.Position.X), true)
			end
		end)
		endConnection = UserInputService.InputEnded:Connect(function(changed)
			if changed.UserInputType == Enum.UserInputType.MouseButton1 or changed.UserInputType == Enum.UserInputType.Touch then
				stop()
			end
		end)
	end)

	setValue(default, false)
	return setValue
end

