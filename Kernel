function Window:AddTab(name, icon)
	local btn = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 36),
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0,
		LayoutOrder = #self.Tabs + 1,
		Parent = self.TabList,
	}, { BackgroundColor3 = "SurfaceAlt" })
	corner(btn, 7)

	local bar = new("Frame", {
		Size = UDim2.fromOffset(3, 18),
		Position = UDim2.new(0, 0, 0.5, -9),
		BorderSizePixel = 0,
		Parent = btn,
	}, { BackgroundColor3 = "Accent" })
	corner(bar, 2)

	if icon then
		new("ImageLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(16, 16),
			Position = UDim2.new(0, 10, 0.5, -8),
			Image = icon,
			Parent = btn,
		}, { ImageColor3 = "Text" })
	end

	local txt = label(btn, name or "Tab", {
		Size = UDim2.new(1, -36, 1, 0),
		Position = UDim2.fromOffset(icon and 34 or 14, 0),
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, false)

	local page = new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ScrollBarThickness = 3,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = self.Content,
	}, { ScrollBarImageColor3 = "Accent" })

	new("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 14),
		Parent = page,
	})
	new("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = page,
	})

	local tab = setmetatable({
		Window = self,
		Frame = page,
		Button = btn,
		Name = name,
		Active = false,
	}, Container)
	tab.Tab = tab

	local function render(animate)
		local t = TH()
		apply(btn, animate, {
			BackgroundColor3 = tab.Active and t.AccentSoft or t.SurfaceAlt,
			BackgroundTransparency = tab.Active and 0 or 1,
		})
		apply(bar, animate, {
			BackgroundTransparency = tab.Active and 0 or 1,
		})
		apply(txt, animate, {
			TextColor3 = tab.Active and t.Text or t.SubText,
		})
	end

	tab._render = render
	hook(btn, render)

	btn.MouseEnter:Connect(function()
		if not tab.Active then
			tween(btn, 0.12, {
				BackgroundColor3 = TH().Hover,
				BackgroundTransparency = 0.45,
			})
		end
	end)
	btn.MouseLeave:Connect(function()
		if not tab.Active then
			tween(btn, 0.12, {
				BackgroundColor3 = TH().SurfaceAlt,
				BackgroundTransparency = 1,
			})
		end
	end)

	btn.MouseButton1Click:Connect(function()
		self:SelectTab(tab)
	end)

	table.insert(self.Tabs, tab)
	if #self.Tabs == 1 then
		self:SelectTab(tab, true)
	end
	return tab
end

function Window:SelectTab(tab, instant)
	for _, t in ipairs(self.Tabs) do
		if t ~= tab and t.Active then
			t.Active = false
			t.Frame.Visible = false
			t._render(true)
		end
	end

	if tab.Active then
		return
	end

	tab.Active = true
	tab.Frame.Visible = true
	tab._render(not instant)

	if not instant then
		tab.Frame.Position = UDim2.fromOffset(0, 12)
		tween(tab.Frame, 0.22, { Position = UDim2.fromOffset(0, 0) })
	end

	self.CurrentTab = tab
end

function Window:Toggle(state)
	if state == nil then
		state = not self.Open
	end

	if state == self.Open then
		return
	end

	self.Open = state
	local target = self._targetScale()

	if state then
		self.Main.Visible = true
		self.Scale.Scale = target * 0.92
		tween(self.Scale, 0.22, { Scale = target }, Enum.EasingStyle.Back)
	else
		tween(
			self.Scale,
			0.15,
			{ Scale = target * 0.92 },
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.In
		)
		task.delay(0.15, function()
			if not self.Open and self.Main.Parent then
				self.Main.Visible = false
			end
		end)
	end
end

function Window:SetScale(n)
	self.UserScale = n
	tween(self.Scale, 0.15, { Scale = self._targetScale() })
end

function Window:Notify(o)
	return Lib:Notify(o)
end

function Window:Destroy()
	for _, c in ipairs(self._conns) do
		c:Disconnect()
	end
	self._conns = {}

	if self.Gui then
		self.Gui:Destroy()
	end

	for i, w in ipairs(Lib.Windows) do
		if w == self then
			table.remove(Lib.Windows, i)
			break
		end
	end
end

function Window:AddSettingsTab()
	local tab = self:AddTab("Settings")

	local look = tab:AddSection("Appearance")
	local accentPicker

	look:AddDropdown({
		Name = "Theme",
		Options = Lib.ThemeOrder,
		Default = Lib.CurrentTheme,
		Callback = function(v)
			Lib:SetTheme(v)
			if accentPicker then
				accentPicker:Set(Lib:GetAccent(), true)
			end
		end,
	})

	accentPicker = look:AddColorPicker({
		Name = "Accent color",
		Default = Lib:GetAccent(),
		Callback = function(c)
			Lib:SetAccent(c)
		end,
	})

	look:AddButton({
		Name = "Reset accent color",
		Callback = function()
			Lib:ResetAccent()
			accentPicker:Set(Lib:GetAccent(), true)
		end,
	})

	look:AddToggle({
		Name = "Rainbow top bar",
		Default = Lib.Rainbow,
		Callback = function(v)
			Lib:SetRainbow(v)
		end,
	})

	look:AddSlider({
		Name = "Rainbow speed",
		Min = 0.05,
		Max = 1,
		Default = Lib.RainbowSpeed,
		Increment = 0.05,
		Callback = function(v)
			Lib.RainbowSpeed = v
		end,
	})

	local ui = tab:AddSection("Interface")
	ui:AddSlider({
		Name = "UI scale",
		Min = 0.7,
		Max = 1.3,
		Default = 1,
		Increment = 0.05,
		Callback = function(v)
			self:SetScale(v)
		end,
	})

	ui:AddKeybind({
		Name = "Menu key",
		Default = self.ToggleKey,
		OnChange = function(k)
			if k then
				self.ToggleKey = k
			end
		end,
	})

	ui:AddToggle({
		Name = "Watermark",
		Default = Lib._wm ~= nil and Lib._wm.Visible,
		Callback = function(v)
			Lib:SetWatermarkVisible(v)
		end,
	})

	local sys = tab:AddSection("System")
	sys:AddButton({
		Name = "Test notification",
		Callback = function()
			Lib:Notify({
				Title = "Notification",
				Content = "Everything is working as expected.",
				Type = "Success",
			})
		end,
	})
	sys:AddButton({
		Name = "Unload UI",
		Callback = function()
			Lib:Unload()
		end,
	})
	return tab
end

function Lib:CreateWindow(o)
	o = o or {}

	if o.Theme then
		Lib:SetTheme(o.Theme, true)
	end
	if o.Accent then
		Lib:SetAccent(o.Accent)
	end
	if o.Rainbow ~= nil then
		Lib:SetRainbow(o.Rainbow)
	end

	local win = setmetatable({
		_conns = {},
		Tabs = {},
		Open = true,
		ToggleKey = o.ToggleKey or Enum.KeyCode.RightShift,
		UserScale = 1,
		Rebinding = false,
	}, Window)

	local W, H = 640, 440

	if o.Size then
		W = math.max(440, o.Size.X.Offset > 0 and o.Size.X.Offset or W)
		H = math.max(320, o.Size.Y.Offset > 0 and o.Size.Y.Offset or H)
	end

	local gui = makeGui("Main_" .. tostring(o.Title or "Window"), 100)
	win.Gui = gui

	local function targetScale()
		local cam = workspace.CurrentCamera
		local vs = cam and cam.ViewportSize or Vector2.new(1280, 720)
		return math.min(1, vs.X / (W + 30), vs.Y / (H + 70)) * win.UserScale
	end
	win._targetScale = targetScale

	local main = new("Frame", {
		Name = "Main",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(W, H),
		BorderSizePixel = 0,
		Active = true,
		ClipsDescendants = true,
		Parent = gui,
	}, { BackgroundColor3 = "Background" })
	corner(main, 10)
	stroke(main)

	local scale = new("UIScale", {
		Scale = targetScale() * 0.92,
		Parent = main,
	})
	tween(scale, 0.3, { Scale = targetScale() }, Enum.EasingStyle.Back)
	win.Main, win.Scale = main, scale

	-- Top bar
	local TOP_H = 46
	local top = new("Frame", {
		Size = UDim2.new(1, 0, 0, TOP_H),
		BorderSizePixel = 0,
		Parent = main,
	}, { BackgroundColor3 = "Surface" })
	makeBar(top, UDim2.new(1, 0, 0, 2), true)

	new("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		Position = UDim2.new(0, 0, 1, -1),
		BorderSizePixel = 0,
		Parent = top,
	}, { BackgroundColor3 = "Stroke" })

	local brand = new("Frame", {
		Size = UDim2.fromOffset(26, 26),
		Position = UDim2.new(0, 14, 0.5, -13),
		BorderSizePixel = 0,
		Parent = top,
	}, { BackgroundColor3 = "Accent" })
	corner(brand, 7)

	label(brand, "K", {
		Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, "OnAccent")

	local titleBox = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(0.55, 0, 1, 0),
		Position = UDim2.fromOffset(50, 0),
		Parent = top,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 8),
		Parent = titleBox,
	})

	label(titleBox, string.upper(o.Title or "KERNEL"), {
		Size = UDim2.new(0, 0, 0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
	})

	local versionPill = new("Frame", {
		Size = UDim2.fromOffset(50, 18),
		BorderSizePixel = 0,
		Parent = titleBox,
	}, { BackgroundColor3 = "AccentSoft" })
	corner(versionPill, 9)
	stroke(versionPill, "Accent", 1, 0.8)

	label(versionPill, o.SubTitle or ("v" .. Lib.Version), {
		Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.Code,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, "Accent")

	local function topBtn(txt, x, hoverToken)
		local b = new("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Size = UDim2.fromOffset(30, 26),
			Position = UDim2.new(1, x, 0.5, 0),
			Text = txt,
			Font = Enum.Font.GothamBold,
			TextSize = 15,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = top,
		}, { TextColor3 = "SubText" })
		corner(b, 6)

		b.MouseEnter:Connect(function()
			tween(b, 0.12, {
				BackgroundColor3 = TH().Hover,
				BackgroundTransparency = 0,
				TextColor3 = TH()[hoverToken],
			})
		end)
		b.MouseLeave:Connect(function()
			tween(b, 0.12, {
				BackgroundTransparency = 1,
				TextColor3 = TH().SubText,
			})
		end)
		return b
	end

	local closeBtn = topBtn("×", -10, "Error")
	local minBtn = topBtn("–", -44, "Text")

	closeBtn.MouseButton1Click:Connect(function()
		win:Destroy()
	end)

	local minimized = false
	minBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		tween(main, 0.25, {
			Size = UDim2.fromOffset(W, minimized and TOP_H or H),
		})
	end)

	draggable(main, top)

	-- Body
	local body = new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, TOP_H),
		Size = UDim2.new(1, 0, 1, -TOP_H),
		Parent = main,
	})

	local SIDEBAR_W = 160
	local side = new("Frame", {
		Size = UDim2.new(0, SIDEBAR_W, 1, 0),
		BorderSizePixel = 0,
		Parent = body,
	}, { BackgroundColor3 = "Surface" })
	new("Frame", {
		Size = UDim2.new(0, 1, 1, 0),
		Position = UDim2.new(1, -1, 0, 0),
		BorderSizePixel = 0,
		Parent = side,
	}, { BackgroundColor3 = "Stroke" })

	local tabList = new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.new(1, -20, 1, -84),
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = side,
	})
	new("UIListLayout", {
		Padding = UDim.new(0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = tabList,
	})

	local card = new("Frame", {
		Size = UDim2.new(1, -20, 0, 56),
		Position = UDim2.new(0, 10, 1, -66),
		BorderSizePixel = 0,
		Parent = side,
	}, { BackgroundColor3 = "SurfaceAlt" })
	corner(card, 8)
	stroke(card)

	local face = new("ImageLabel", {
		Size = UDim2.fromOffset(34, 34),
		Position = UDim2.fromOffset(8, 8),
		BorderSizePixel = 0,
		Parent = card,
	}, { BackgroundColor3 = "Background" })
	corner(face, 17)

	local online = new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 2, 1, 2),
		Size = UDim2.fromOffset(10, 10),
		BorderSizePixel = 0,
		Parent = face,
	}, { BackgroundColor3 = "Success" })
	corner(online, 5)
	stroke(online, "Surface", 1, 0)

	label(card, LocalPlayer.DisplayName, {
		Size = UDim2.new(1, -58, 0, 16),
		Position = UDim2.fromOffset(50, 9),
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	label(card, "@" .. LocalPlayer.Name, {
		Size = UDim2.new(1, -58, 0, 14),
		Position = UDim2.fromOffset(50, 27),
		Font = Enum.Font.Code,
		TextSize = 10,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, "SubText")

	task.spawn(function()
		local ok, img = pcall(function()
			return Players:GetUserThumbnailAsync(
				LocalPlayer.UserId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size48x48
			)
		end)
		if ok and face.Parent then
			face.Image = img
		end
	end)

	win.TabList = tabList
	win.Content = new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(SIDEBAR_W, 0),
		Size = UDim2.new(1, -SIDEBAR_W, 1, 0),
		ClipsDescendants = true,
		Parent = body,
	})

	-- Keyboard toggle
	win:_conn(UserInputService.InputBegan, function(input, gp)
		if gp or win.Rebinding then
			return
		end
		if input.KeyCode == win.ToggleKey then
			win:Toggle()
		end
	end)

	-- Fit to viewport
	local cam = workspace.CurrentCamera
	if cam then
		win:_conn(cam:GetPropertyChangedSignal("ViewportSize"), function()
			if win.Open then
				scale.Scale = targetScale()
			end
		end)
	end

	-- Mobile floating button
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		local tb = new("TextButton", {
			Size = UDim2.fromOffset(46, 46),
			Position = UDim2.new(0, 12, 0.5, -23),
			Text = "≡",
			Font = Enum.Font.GothamBold,
			TextSize = 23,
			AutoButtonColor = false,
			BorderSizePixel = 0,
			Parent = gui,
		}, { BackgroundColor3 = "Surface", TextColor3 = "Accent" })
		corner(tb, 11)
		stroke(tb, "Accent")

		draggable(tb, tb)
		tb.MouseButton1Click:Connect(function()
			win:Toggle()
		end)
	end

	if o.Watermark ~= false then
		Lib:CreateWatermark({
			Title = o.WatermarkTitle or string.upper(o.Title or "KERNEL"),
		})
	end

	table.insert(Lib.Windows, win)
	return win
end

function Lib:Unload()
	for i = #Lib.Windows, 1, -1 do
		Lib.Windows[i]:Destroy()
	end

	if Lib._wm then
		Lib._wm:Destroy()
	end

	if Lib._notifGui then
		Lib._notifGui:Destroy()
		Lib._notifGui, Lib._notifHolder = nil, nil
	end

	if Lib._step then
		Lib._step:Disconnect()
		Lib._step = nil
	end
end

return Lib
