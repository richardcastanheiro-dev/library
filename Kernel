function Lib:CreateWatermark(o)
	o = o or {}
	if Lib._wm then
		Lib._wm:Destroy()
	end

	local gui = makeGui("Watermark", 500, true)
	local frame = new("Frame", {
		Name = "Watermark",
		Position = o.Position or UDim2.fromOffset(120, 8),
		Size = UDim2.fromOffset(126, 28),
		BorderSizePixel = 0,
		Active = true,
		ClipsDescendants = true,
		Parent = gui,
	}, { BackgroundColor3 = "Surface" })
	corner(frame, 7)
	stroke(frame)
	makeBar(frame, UDim2.new(1, 0, 0, 2), false)

	local txt = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.fromOffset(0, 1),
		Font = Enum.Font.Code,
		TextSize = 13,
		RichText = true,
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = frame,
	}, { TextColor3 = "Text" })

	txt:GetPropertyChangedSignal("TextBounds"):Connect(function()
		frame.Size = UDim2.fromOffset(math.ceil(txt.TextBounds.X) + 24, 28)
	end)
	draggable(frame, frame)

	local wm = { Visible = true, Gui = gui }
	local opts = {
		Title = o.Title or "KERNEL",
		ShowUser = o.ShowUser ~= false,
		ShowFPS = o.ShowFPS ~= false,
		ShowPing = o.ShowPing ~= false,
		UseDisplayName = o.UseDisplayName == true,
	}

	function wm:_update()
		local th = TH()
		local sep = string.format('<font color="#%s">  |  </font>', th.SubText:ToHex())
		local parts = {
			string.format('<font color="#%s"><b>%s</b></font>', th.Accent:ToHex(), opts.Title),
		}

		if opts.ShowUser then
			table.insert(parts, opts.UseDisplayName and LocalPlayer.DisplayName or LocalPlayer.Name)
		end

		if opts.ShowFPS then
			local c = th.Error
			if Lib.FPS >= 55 then
				c = th.Success
			elseif Lib.FPS >= 30 then
				c = th.Warning
			end
			table.insert(parts, string.format('<font color="#%s">%d</font> fps', c:ToHex(), Lib.FPS))
		end

		if opts.ShowPing then
			local c = th.Error
			if Lib.Ping <= 80 then
				c = th.Success
			elseif Lib.Ping <= 150 then
				c = th.Warning
			end
			table.insert(parts, string.format('<font color="#%s">%d</font> ms', c:ToHex(), Lib.Ping))
		end

		txt.Text = table.concat(parts, sep)
	end

	function wm:SetVisible(v)
		wm.Visible = v and true or false
		gui.Enabled = wm.Visible
	end

	function wm:SetTitle(t)
		opts.Title = t
		wm:_update()
	end

	function wm:SetPosition(pos)
		frame.Position = pos
	end

	function wm:Destroy()
		if Lib._wm == wm then
			Lib._wm = nil
		end
		gui:Destroy()
	end

	hook(frame, function()
		wm:_update()
	end)

	Lib._wm = wm
	return wm
end

function Lib:SetWatermarkVisible(v)
	if not Lib._wm then
		if v then
			Lib:CreateWatermark()
		end
		return
	end
	Lib._wm:SetVisible(v)
end

---------------------------------------------------------------------------
-- NOTIFICATIONS
---------------------------------------------------------------------------
local notifOrder = 0
local TYPE_TOKEN = {
	Info = "Accent",
	Success = "Success",
	Warning = "Warning",
	Error = "Error",
}

local function ensureHolder()
	if Lib._notifHolder and Lib._notifHolder.Parent then
		return Lib._notifHolder
	end

	local gui = makeGui("Notifications", 1000)
	local holder = new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 320, 1, -32),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	new("UIListLayout", {
		Padding = UDim.new(0, 9),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Parent = holder,
	})

	Lib._notifGui = gui
	Lib._notifHolder = holder
	return holder
end

function Lib:Notify(o)
	o = o or {}
	local holder = ensureHolder()
	local token = TYPE_TOKEN[o.Type or "Info"] or "Accent"
	local title = o.Title or "Notice"
	local text = o.Content or ""
	local dur = o.Duration or 4

	local width = 300
	local textH = TextService:GetTextSize(
		text,
		12,
		Enum.Font.Gotham,
		Vector2.new(width - 38, 1000)
	).Y
	local height = 42 + math.max(textH, 0) + 8

	notifOrder = notifOrder + 1
	local wrap = new("Frame", {
		Size = UDim2.fromOffset(width, height),
		BackgroundTransparency = 1,
		LayoutOrder = notifOrder,
		Parent = holder,
	})

	local card = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.new(1, 32, 0, 0),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = wrap,
	}, { BackgroundColor3 = "Surface" })
	corner(card, 8)
	stroke(card)

	new("Frame", {
		Size = UDim2.new(0, 4, 1, 0),
		BorderSizePixel = 0,
		Parent = card,
	}, { BackgroundColor3 = token })

	label(card, title, {
		Size = UDim2.new(1, -58, 0, 18),
		Position = UDim2.fromOffset(16, 10),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	label(card, text, {
		Size = UDim2.new(1, -34, 0, math.max(textH, 0)),
		Position = UDim2.fromOffset(16, 32),
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, "SubText")

	local progress = new("Frame", {
		Size = UDim2.new(1, 0, 0, 3),
		Position = UDim2.new(0, 0, 1, -3),
		BorderSizePixel = 0,
		Parent = card,
	}, { BackgroundColor3 = token })

	tween(card, 0.35, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Quint)
	if dur > 0 then
		tween(progress, dur, { Size = UDim2.new(0, 0, 0, 3) }, Enum.EasingStyle.Linear)
	end

	local dead = false
	local function close()
		if dead then
			return
		end
		dead = true
		tween(
			card,
			0.25,
			{ Position = UDim2.new(1, 32, 0, 0) },
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		)
		task.delay(0.25, function()
			if wrap.Parent then
				tween(wrap, 0.2, { Size = UDim2.fromOffset(width, 0) })
				task.delay(0.2, function()
					wrap:Destroy()
				end)
			end
		end)
	end

	local closeBtn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0, 19),
		Size = UDim2.fromOffset(20, 20),
		Text = "×",
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Parent = card,
	}, { TextColor3 = "SubText" })
	closeBtn.MouseEnter:Connect(function()
		tween(closeBtn, 0.12, { TextColor3 = TH().Error })
	end)
	closeBtn.MouseLeave:Connect(function()
		tween(closeBtn, 0.12, { TextColor3 = TH().SubText })
	end)
	closeBtn.MouseButton1Click:Connect(close)

	card.InputBegan:Connect(function(i)
		if isDown(i) then
			close()
		end
	end)

	if dur > 0 then
		task.delay(dur, close)
	end

	return { Close = close }
end

---------------------------------------------------------------------------
-- CONTAINER (Tab and Section)
---------------------------------------------------------------------------
local Container = {}
Container.__index = Container

local function nextOrder(self)
	self._order = (self._order or 0) + 1
	return self._order
end

local function rowFrame(self, h)
	local f = new("Frame", {
		Size = UDim2.new(1, 0, 0, h or 38),
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(self),
		Parent = self.Frame,
	}, { BackgroundColor3 = "SurfaceAlt" })
	corner(f, 6)
	stroke(f)
	hoverRow(f)
	return f
end

function Container:AddSection(name)
	local box = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(self),
		Parent = self.Frame,
	}, { BackgroundColor3 = "Surface" })
	corner(box, 8)
	stroke(box)

	new("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		Parent = box,
