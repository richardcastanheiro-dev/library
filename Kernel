-- UTILITIES
---------------------------------------------------------------------------
local function safe(fn, ...)
	if type(fn) == "function" then
		local ok, err = pcall(fn, ...)
		if not ok then
			warn("[KernelUI] " .. tostring(err))
		end
	end
end

local function new(class, props, theme)
	local o = Instance.new(class)
	local parent = nil
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			o[k] = v
		end
	end
	if theme then
		for p, token in pairs(theme) do
			bind(o, p, token)
		end
	end
	o.Parent = parent
	return o
end

local function corner(p, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 4), Parent = p })
end

local function stroke(p, token, thick, transparency)
	return new("UIStroke", {
		Thickness = thick or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = p,
	}, { Color = token or "Stroke" })
end

local function label(parent, text, props, token)
	props = props or {}
	props.BackgroundTransparency = 1
	props.BorderSizePixel = 0
	props.Text = text
	props.Font = props.Font or Enum.Font.GothamMedium
	props.TextSize = props.TextSize or 13
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.Parent = parent

	local themed = nil
	if token ~= false then
		themed = { TextColor3 = token or "Text" }
	end
	return new("TextLabel", props, themed)
end

local function tween(o, t, goal, style, dir)
	local tw = TweenService:Create(
		o,
		TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		goal
	)
	tw:Play()
	return tw
end

local function apply(inst, animate, goal)
	if animate then
		tween(inst, 0.15, goal)
	else
		for k, v in pairs(goal) do
			inst[k] = v
		end
	end
end

local function isDown(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch
end

local function isMove(i)
	return i.UserInputType == Enum.UserInputType.MouseMovement
		or i.UserInputType == Enum.UserInputType.Touch
end

local function draggable(frame, handle)
	handle.InputBegan:Connect(function(input)
		if not isDown(input) then
			return
		end

		local startPos = input.Position
		local startFrame = frame.Position
		local move, up

		move = UserInputService.InputChanged:Connect(function(i)
			if isMove(i) then
				local d = i.Position - startPos
				frame.Position = UDim2.new(
					startFrame.X.Scale,
					startFrame.X.Offset + d.X,
					startFrame.Y.Scale,
					startFrame.Y.Offset + d.Y
				)
			end
		end)

		up = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				if move then
					move:Disconnect()
				end
				if up then
					up:Disconnect()
				end
			end
		end)
	end)
end

local function alphaDrag(frame, fn)
	local function applyInput(input)
		local p, s = frame.AbsolutePosition, frame.AbsoluteSize
		fn(
			math.clamp((input.Position.X - p.X) / math.max(s.X, 1), 0, 1),
			math.clamp((input.Position.Y - p.Y) / math.max(s.Y, 1), 0, 1)
		)
	end

	frame.InputBegan:Connect(function(input)
		if not isDown(input) then
			return
		end

		applyInput(input)
		local move, up

		move = UserInputService.InputChanged:Connect(function(i)
			if isMove(i) then
				applyInput(i)
			end
		end)

		up = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				if move then
					move:Disconnect()
				end
				if up then
					up:Disconnect()
				end
			end
		end)
	end)
end

local function makeGui(name, order, ignoreInset)
	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
	local full = "KernelUI_" .. name
	local old = playerGui:FindFirstChild(full)
	if old then
		old:Destroy()
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = full
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = order or 10
	gui.IgnoreGuiInset = ignoreInset == true
	gui.Parent = playerGui
	return gui
end

local function hoverRow(f)
	f.MouseEnter:Connect(function()
		tween(f, 0.12, { BackgroundColor3 = TH().Hover })
	end)
	f.MouseLeave:Connect(function()
		tween(f, 0.12, { BackgroundColor3 = TH().SurfaceAlt })
	end)
end

---------------------------------------------------------------------------
-- FPS / PING
---------------------------------------------------------------------------
local function getPing()
	local ok, v = pcall(function()
		return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	if ok and type(v) == "number" then
		return math.floor(v + 0.5)
	end
	return 0
end

local bars = {}
Lib.Rainbow = false
Lib.RainbowSpeed = 0.25
local hue = 0

local function rainbowSequence(h)
	local pts = {}
	for i = 0, 7 do
		table.insert(
			pts,
			ColorSequenceKeypoint.new(
				i / 7,
				Color3.fromHSV((h + (i / 7) * 0.6) % 1, 0.8, 1)
			)
		)
	end
	return ColorSequence.new(pts)
end

local function paintBar(bar)
	local t = TH()
	if Lib.Rainbow then
		bar.Frame.BackgroundColor3 = Color3.new(1, 1, 1)
		bar.Grad.Enabled = true
		bar.Grad.Color = rainbowSequence(hue)
	elseif bar.Fancy then
		bar.Frame.BackgroundColor3 = Color3.new(1, 1, 1)
		bar.Grad.Enabled = true
		bar.Grad.Color = ColorSequence.new(t.Accent, t.AccentDark)
	else
		bar.Frame.BackgroundColor3 = t.Accent
		bar.Grad.Enabled = false
	end
end

local function makeBar(parent, size, fancy)
	local f = new("Frame", {
		Size = size,
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = parent,
	})
	local g = Instance.new("UIGradient")
	g.Parent = f

	local bar = { Frame = f, Grad = g, Fancy = fancy }
	table.insert(bars, bar)
	hook(f, function()
		paintBar(bar)
	end)
	return f
end

function Lib:SetRainbow(on, speed)
	Lib.Rainbow = on == true
	if speed then
		Lib.RainbowSpeed = speed
	end
	for _, bar in ipairs(bars) do
		paintBar(bar)
	end
end

do
	local frames, acc, purgeT = 0, 0, 0
	Lib._step = RunService.RenderStepped:Connect(function(dt)
		frames = frames + 1
		acc = acc + dt

		if Lib.Rainbow and #bars > 0 then
			hue = (hue + dt * Lib.RainbowSpeed) % 1
			local seq = rainbowSequence(hue)
			for _, bar in ipairs(bars) do
				bar.Grad.Color = seq
			end
		end

		if acc >= 0.5 then
			Lib.FPS = math.floor(frames / acc + 0.5)
			Lib.Ping = getPing()

			purgeT = purgeT + acc
			frames, acc = 0, 0

			if Lib._wm then
				Lib._wm:_update()
			end

			if purgeT >= 5 then
				purgeT = 0
				purge()
				for i = #bars, 1, -1 do
					if not bars[i].Frame:IsDescendantOf(game) then
						table.remove(bars, i)
					end
				end
			end
		end
	end)
end

