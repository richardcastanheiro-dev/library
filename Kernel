local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local MikuUI = {}
MikuUI.Version = "1.0.0"
MikuUI.Controls = {}

local Theme = {
	Bg = Color3.fromRGB(12, 12, 16),
	Surface = Color3.fromRGB(20, 20, 26),
	SurfaceAlt = Color3.fromRGB(30, 30, 38),
	SurfaceHi = Color3.fromRGB(42, 42, 52),
	Stroke = Color3.fromRGB(55, 55, 70),
	Accent = Color3.fromRGB(139, 108, 255),
	AccentSoft = Color3.fromRGB(180, 160, 255),
	Text = Color3.fromRGB(245, 245, 252),
	TextDim = Color3.fromRGB(145, 145, 165),
	Success = Color3.fromRGB(94, 226, 158),
	Danger = Color3.fromRGB(244, 92, 116)
}

local Fast = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local Normal = TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

MikuUI.Theme = Theme
MikuUI.Tween = { Fast = Fast, Normal = Normal }

local function make(class, properties, parent)
	local object = Instance.new(class)
	if properties then
		for key, value in pairs(properties) do
			object[key] = value
		end
	end
	if parent then
		object.Parent = parent
	end
	return object
end

local function corner(parent, radius)
	local item = Instance.new("UICorner")
	item.CornerRadius = UDim.new(0, radius)
	item.Parent = parent
	return item
end

local function stroke(parent, color, transparency)
	local item = Instance.new("UIStroke")
	item.Color = color or Theme.Stroke
	item.Transparency = transparency or 0
	item.Thickness = 1
	item.Parent = parent
	return item
end

local function safeCall(callback, ...)
	if type(callback) ~= "function" then
		return
	end
	local ok, err = pcall(callback, ...)
	if not ok then
		warn("[MikuUI] " .. tostring(err))
	end
end

local function resolveHost(parent)
	if not parent then
		return nil
	end
	if parent:IsA("ScrollingFrame") then
		return parent:FindFirstChild("Holder") or parent
	end
	return parent
end

local function getScrollingAncestor(object)
	local current = object
	while current do
		if current:IsA("ScrollingFrame") then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function updateCanvas(page)
	if not page or not page.Parent then
		return
	end
	local holder = page:FindFirstChild("Holder") or page
	local layout = holder:FindFirstChildOfClass("UIListLayout")
	local size = layout and layout.AbsoluteContentSize.Y or 0
	page.CanvasSize = UDim2.fromOffset(0, math.max(size + 32, page.AbsoluteSize.Y))
end

local function refreshPage(object)
	local page = getScrollingAncestor(object)
	if page then
		updateCanvas(page)
	end
end

local function nextOrder(host)
	if not host then
		return 0
	end
	local order = (host:GetAttribute("MikuLayoutOrder") or 0) + 1
	host:SetAttribute("MikuLayoutOrder", order)
	return order
end

local function prepare(parent, height, class)
	local host = resolveHost(parent)
	local object = make(class or "Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(host)
	}, host)
	refreshPage(object)
	return object, host
end

local function formatValue(value)
	if value == math.floor(value) then
		return tostring(math.floor(value))
	end
	return string.format("%.2f", value)
end

local function register(instance, setters)
	MikuUI.Controls[instance] = setters
	return instance
end

function MikuUI:CreateSection(parent, text)
	local section = prepare(parent, 26, "Frame")
	make("TextLabel", {
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
		Text = tostring(text or "Seção"),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = Theme.AccentSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BorderSizePixel = 0
	}, section)
	make("Frame", {
		Name = "Line",
		Position = UDim2.new(0, 0, 1, -1),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Stroke,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0
	}, section)
	refreshPage(section)
	return section
end

function MikuUI:CreateLabel(parent, text)
	local label = prepare(parent, 20, "TextLabel")
	label.Text = tostring(text or "")
	label.Font = Enum.Font.Gotham
	label.TextSize = 13
	label.TextColor3 = Theme.Text
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.Size = UDim2.new(1, 0, 0, 20)
	refreshPage(label)
	return label
end

function MikuUI:CreateDivider(parent)
	local divider = prepare(parent, 1, "Frame")
	divider.BackgroundColor3 = Theme.Stroke
	divider.BackgroundTransparency = 0.25
	refreshPage(divider)
	return divider
end

function MikuUI:CreateButton(parent, text, callback)
	local button = prepare(parent, 38, "TextButton")
	button.BackgroundColor3 = Theme.SurfaceAlt
	button.BackgroundTransparency = 0.25
	button.Text = tostring(text or "Botão")
	button.Font = Enum.Font.GothamMedium
	button.TextSize = 14
	button.TextColor3 = Theme.Text
	button.AutoButtonColor = false
	corner(button, 9)
	stroke(button, Theme.Stroke, 0.4)
	button.MouseEnter:Connect(function()
		TweenService:Create(button, Fast, {
			BackgroundColor3 = Theme.SurfaceHi,
			BackgroundTransparency = 0.12
		}):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, Fast, {
			BackgroundColor3 = Theme.SurfaceAlt,
			BackgroundTransparency = 0.25
		}):Play()
	end)
	button.MouseButton1Click:Connect(function()
		safeCall(callback)
	end)
	refreshPage(button)
	return button
end

function MikuUI:CreateTextBox(parent, text, placeholder, defaultValue, callback)
	if type(defaultValue) == "function" and callback == nil then
		callback = defaultValue
		defaultValue = ""
	end
	if type(placeholder) == "function" and callback == nil then
		callback = placeholder
		placeholder = "Digite"
	end
	local frame = prepare(parent, 42, "Frame")
	make("TextLabel", {
		Name = "Label",
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(0.42, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = tostring(text or "TextBox"),
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BorderSizePixel = 0
	}, frame)
	local box = make("TextBox", {
		Name = "Input",
		Position = UDim2.new(0.42, 0, 0, 7),
		Size = UDim2.new(0.58, 0, 0, 28),
		BackgroundColor3 = Theme.SurfaceHi,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		Text = tostring(defaultValue or ""),
		PlaceholderText = tostring(placeholder or "Digite"),
		PlaceholderColor3 = Theme.TextDim,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = Theme.Text,
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd
	}, frame)
	corner(box, 8)
	stroke(box, Theme.Stroke, 0.4)
	make("UIPadding", {
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8)
	}, box)
	box.FocusLost:Connect(function()
		safeCall(callback, box.Text)
	end)
	register(box, {
		SetValue = function(v)
			box.Text = tostring(v or "")
			safeCall(callback, box.Text)
		end,
		GetValue = function()
			return box.Text
		end,
		SetDisabled = function(v)
			box.TextEditable = not v
			box.TextTransparency = v and 0.5 or 0
		end
	})
	refreshPage(frame)
	return box
end

function MikuUI:CreateToggle(parent, text, default, callback)
	if type(text) == "table" then
		local config = text
		text = config.Text or config.Name or "Toggle"
		default = config.Default
		callback = config.Callback
	end
	if type(default) == "function" and callback == nil then
		callback = default
		default = false
	end
	local row = prepare(parent, 42, "TextButton")
	row.BackgroundColor3 = Theme.SurfaceAlt
	row.BackgroundTransparency = 1
	row.Text = ""
	row.AutoButtonColor = false
	corner(row, 9)
	make("TextLabel", {
		Name = "Label",
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -82, 1, 0),
		BackgroundTransparency = 1,
		Text = tostring(text or "Toggle"),
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd
	}, row)
	local track = make("Frame", {
		Name = "Track",
		Position = UDim2.new(1, -52, 0.5, -11),
		Size = UDim2.fromOffset(40, 22),
		BackgroundColor3 = Theme.SurfaceHi,
		BorderSizePixel = 0
	}, row)
	corner(track, 11)
	stroke(track, Theme.Stroke, 0.5)
	local knob = make("Frame", {
		Name = "Knob",
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0
	}, track)
	corner(knob, 8)
	local active = default == true
	local disabled = false
	local function apply(state, fire)
		active = state == true
		row:SetAttribute("MikuValue", active)
		TweenService:Create(track, Fast, {
			BackgroundColor3 = active and Theme.Accent or Theme.SurfaceHi
		}):Play()
		TweenService:Create(knob, Normal, {
			Position = active and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
		}):Play()
		if fire then
			safeCall(callback, active)
		end
	end
	row.MouseEnter:Connect(function()
		if not disabled then
			TweenService:Create(row, Fast, { BackgroundTransparency = 0.82 }):Play()
		end
	end)
	row.MouseLeave:Connect(function()
		TweenService:Create(row, Fast, { BackgroundTransparency = 1 }):Play()
	end)
	row.MouseButton1Click:Connect(function()
		if not disabled then
			apply(not active, true)
		end
	end)
	apply(active, false)
	register(row, {
		SetValue = function(v) apply(v, true) end,
		GetValue = function() return active end,
		SetDisabled = function(v)
			disabled = v
			row.Active = not v
			row.TextTransparency = v and 0.5 or 0
		end
	})
	refreshPage(row)
	return row
end

function MikuUI:CreateCheckbox(parent, text, default, callback)
	if type(default) == "function" and callback == nil then
		callback = default
		default = false
	end
	local row = prepare(parent, 38, "TextButton")
	row.BackgroundTransparency = 1
	row.Text = ""
	row.AutoButtonColor = false
	make("TextLabel", {
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -48, 1, 0),
		BackgroundTransparency = 1,
		Text = tostring(text or "Checkbox"),
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left
	}, row)
	local box = make("Frame", {
		Position = UDim2.new(1, -32, 0.5, -10),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = Theme.SurfaceHi,
		BorderSizePixel = 0
	}, row)
	corner(box, 5)
	stroke(box, Theme.Stroke, 0.35)
	local mark = make("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "✓",
		TextColor3 = Theme.Text,
		TextSize = 14,
		Font = Enum.Font.GothamBold,
		Visible = default == true
	}, box)
	local value = default == true
