	local options = o.Options or {}
	local selected = {}
	local single = nil

	if multi then
		for _, v in ipairs(o.Default or {}) do
			selected[v] = true
		end
	else
		single = o.Default
	end

	local root = new("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		ClipsDescendants = true,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(self),
		Parent = self.Frame,
	}, { BackgroundColor3 = "SurfaceAlt" })
