		table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1)))
	end
	new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(keys),
		Parent = hueBar,
	})

	local hueCursor = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(1, 4, 0, 4),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = hueBar,
	})
	new("UIStroke", {
		Color = Color3.new(1, 1, 1),
		Thickness = 2,
		Parent = hueCursor,
	})

	local function update(silent)
		color = Color3.fromHSV(h, s, v)
		swatch.BackgroundColor3 = color
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCursor.Position = UDim2.fromScale(s, 1 - v)
		hueCursor.Position = UDim2.fromScale(0.5, h)

		if o.Flag then
			Lib.Flags[o.Flag] = color
		end
		if not silent then
			safe(o.Callback, color)
		end
	end

	update(true)

	alphaDrag(sv, function(ax, ay)
		s = ax
		v = 1 - ay
		update()
	end)
	alphaDrag(hueBar, function(_, ay)
		h = math.clamp(ay, 0, 0.999)
		update()
	end)

	local open = false
	head.MouseButton1Click:Connect(function()
		open = not open
		tween(root, 0.22, {
			Size = UDim2.new(1, 0, 0, open and 178 or 40),
		})
	end)

	local obj = {}
	function obj:Set(c, silent)
		h, s, v = c:ToHSV()
		update(silent)
	end
	function obj:Get()
		return color
	end
	return obj
end

function Container:AddGraph(o)
	o = o or {}
	local height = o.Height or 110
	local maxPts = o.Points or 60
	local kind = o.Type or "Line"
	local fixedMin, fixedMax = o.Min, o.Max
	local suffix = o.Suffix or ""

	local r = rowFrame(self, height + 46)

	label(r, o.Name or "Graph", {
		Size = UDim2.new(0.6, -12, 0, 18),
		Position = UDim2.fromOffset(12, 8),
		TextSize = 12,
	})

	local valLbl = label(r, "--", {
		Size = UDim2.new(0.4, -12, 0, 18),
		Position = UDim2.new(0.6, 0, 0, 8),
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = Enum.Font.Code,
		TextSize = 12,
	}, "Accent")

	local canvas = new("Frame", {
		Position = UDim2.fromOffset(10, 32),
		Size = UDim2.new(1, -20, 0, height),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = r,
	}, { BackgroundColor3 = "Background" })
	corner(canvas, 6)
	stroke(canvas)

	for i = 1, 3 do
		new("Frame", {
			Size = UDim2.new(1, 0, 0, 1),
			Position = UDim2.new(0, 0, i / 4, 0),
			BorderSizePixel = 0,
			BackgroundTransparency = 0.65,
			Parent = canvas,
		}, { BackgroundColor3 = "Stroke" })
	end

	local rangeHi = label(canvas, "", {
		Size = UDim2.fromOffset(60, 12),
		Position = UDim2.fromOffset(5, 3),
		TextSize = 9,
		Font = Enum.Font.Code,
	}, "SubText")

	local rangeLo = label(canvas, "", {
		Size = UDim2.fromOffset(60, 12),
		Position = UDim2.new(0, 5, 1, -15),
		TextSize = 9,
		Font = Enum.Font.Code,
	}, "SubText")

	local data, items = {}, {}

	local function item(i)
		local it = items[i]
		if not it then
			it = new("Frame", {
				BorderSizePixel = 0,
				AnchorPoint = (kind == "Bar") and Vector2.new(0, 1) or Vector2.new(0.5, 0.5),
				Parent = canvas,
			})

			if o.Color then
				it.BackgroundColor3 = o.Color
			else
				bind(it, "BackgroundColor3", "Accent")
			end

			if kind == "Bar" then
				it.BackgroundTransparency = 0.15
				corner(it, 2)
			end

			items[i] = it
		end
		return it
	end

	local function render()
		local n = #data
		local w, hgt = canvas.AbsoluteSize.X, canvas.AbsoluteSize.Y
		if n == 0 or w <= 0 or hgt <= 0 then
			return
		end

		local lo, hi = fixedMin, fixedMax
		if lo == nil or hi == nil then
			local mn, mx = math.huge, -math.huge
			for _, x in ipairs(data) do
				mn = math.min(mn, x)
				mx = math.max(mx, x)
			end
			if mx - mn < 1e-6 then
				mx = mn + 1
			end
			local padv = (mx - mn) * 0.1
			lo = fixedMin or (mn - padv)
			hi = fixedMax or (mx + padv)
		end

		if hi - lo < 1e-6 then
			hi = lo + 1
		end

		rangeHi.Text = string.format("%.0f", hi)
		rangeLo.Text = string.format("%.0f", lo)

		local function yOf(x)
			return hgt - math.clamp((x - lo) / (hi - lo), 0, 1) * hgt
		end

		local offset = maxPts - n

		if kind == "Bar" then
			local slot = w / maxPts
			local bw = math.max(1, slot - 1)
			for i = 1, n do
				local it = item(i)
				local top = yOf(data[i])
				it.Visible = true
				it.Size = UDim2.fromOffset(bw, hgt - top)
				it.Position = UDim2.fromOffset((offset + i - 1) * slot, hgt)
			end
			for i = n + 1, #items do
				items[i].Visible = false
			end
		else
			local step = w / (maxPts - 1)
			for i = 1, n - 1 do
				local x1, y1 = (offset + i - 1) * step, yOf(data[i])
				local x2, y2 = (offset + i) * step, yOf(data[i + 1])
				local dx, dy = x2 - x1, y2 - y1
				local it = item(i)
				it.Visible = true
				it.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + 1, 2)
				it.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
				it.Rotation = math.deg(math.atan2(dy, dx))
			end
			for i = math.max(n, 1), #items do
				items[i].Visible = false
			end
		end
	end

	canvas:GetPropertyChangedSignal("AbsoluteSize"):Connect(render)

	local obj = {}
	function obj:Push(x)
		table.insert(data, x)
		if #data > maxPts then
			table.remove(data, 1)
		end
		valLbl.Text = string.format("%.1f", x) .. suffix
		render()
	end
	function obj:SetData(t)
		data = {}
		for _, x in ipairs(t or {}) do
			table.insert(data, x)
		end
		while #data > maxPts do
			table.remove(data, 1)
		end
		for _, it in ipairs(items) do
			it.Visible = false
		end
		if #data > 0 then
			valLbl.Text = string.format("%.1f", data[#data]) .. suffix
		end
		render()
	end
	function obj:Clear()
		data = {}
		for _, it in ipairs(items) do
			it.Visible = false
		end
		valLbl.Text = "--"
	end
	return obj
end

