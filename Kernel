	stroke(root)

	local head = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = root,
	})

	label(head, o.Name or "Dropdown", {
		Size = UDim2.new(0.55, -12, 1, 0),
		Position = UDim2.fromOffset(12, 0),
	})

	local valLbl = label(head, "", {
		Size = UDim2.new(0.45, -46, 1, 0),
		Position = UDim2.new(0.55, 0, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = Enum.Font.Code,
		TextSize = 11,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, "SubText")

	local arrow = label(head, "▾", {
		Size = UDim2.fromOffset(24, 40),
		Position = UDim2.new(1, -28, 0, 0),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, "Accent")

	local list = new("ScrollingFrame", {
		Position = UDim2.fromOffset(8, 44),
		Size = UDim2.new(1, -16, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = root,
	}, { ScrollBarImageColor3 = "Accent" })
	new("UIListLayout", {
		Padding = UDim.new(0, 2),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})

	local open = false
	local buttons = {}

	local function isSel(opt)
		if multi then
			return selected[opt] == true
		end
		return single == opt
	end

	local function current()
		if multi then
			local t = {}
			for _, opt in ipairs(options) do
				if selected[opt] then
					table.insert(t, opt)
				end
			end
			return t
		end
		return single
	end

	local function summary()
		if multi then
			local t = {}
			for _, opt in ipairs(options) do
				if selected[opt] then
					table.insert(t, tostring(opt))
				end
			end
			return #t > 0 and table.concat(t, ", ") or "None"
		end
		return single ~= nil and tostring(single) or "None"
	end

	local function render()
		local t = TH()
		valLbl.Text = summary()

		for opt, b in pairs(buttons) do
			local sel = isSel(opt)
			b.TextColor3 = sel and t.Accent or t.SubText
			b.BackgroundColor3 = sel and t.AccentSoft or t.Hover
			b.BackgroundTransparency = sel and 0 or 1
		end
	end

	local function listHeight()
		return math.min(#options, 5) * 30
	end

	local function setOpen(v)
		open = v
		tween(arrow, 0.2, { Rotation = v and 180 or 0 })

		local lh = listHeight()
		list.Size = UDim2.new(1, -16, 0, lh)
		tween(root, 0.22, {
			Size = UDim2.new(1, 0, 0, v and (40 + lh + 8) or 40),
		})
	end

	local function fire()
		if o.Flag then
			Lib.Flags[o.Flag] = current()
		end
		safe(o.Callback, current())
	end

	local function build()
		for _, b in pairs(buttons) do
			b:Destroy()
		end
		buttons = {}

		for i, opt in ipairs(options) do
			local b = new("TextButton", {
				Size = UDim2.new(1, -4, 0, 28),
				Text = tostring(opt),
				Font = Enum.Font.Gotham,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				AutoButtonColor = false,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				LayoutOrder = i,
				Parent = list,
			})
			corner(b, 4)
			new("UIPadding", { PaddingLeft = UDim.new(0, 10), Parent = b })

			b.MouseEnter:Connect(function()
				if not isSel(opt) then
					tween(b, 0.12, { BackgroundTransparency = 0 })
				end
			end)
			b.MouseLeave:Connect(function()
				if not isSel(opt) then
					tween(b, 0.12, { BackgroundTransparency = 1 })
				end
			end)
			b.MouseButton1Click:Connect(function()
				if multi then
					selected[opt] = (not selected[opt]) or nil
				else
					single = opt
					setOpen(false)
				end
				render()
				fire()
			end)

			buttons[opt] = b
		end
		render()
	end

	build()
	hook(root, function()
		render()
	end)

	head.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)

	if o.Flag then
		Lib.Flags[o.Flag] = current()
	end

	local obj = {}
	function obj:Set(v, silent)
		if multi then
			selected = {}
			for _, x in ipairs(v or {}) do
				selected[x] = true
			end
		else
			single = v
		end
		render()
		if not silent then
			fire()
		end
	end
	function obj:Get()
		return current()
	end
	function obj:Refresh(newOptions)
		options = newOptions or {}
		build()
		if open then
			setOpen(true)
		end
	end
	return obj
end

