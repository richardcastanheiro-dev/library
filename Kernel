local BODY_PARTS = {
	Head = true,
	UpperTorso = true,
	LowerTorso = true,
	LeftUpperArm = true,
	LeftLowerArm = true,
	LeftHand = true,
	RightUpperArm = true,
	RightLowerArm = true,
	RightHand = true,
	LeftUpperLeg = true,
	LeftLowerLeg = true,
	LeftFoot = true,
	RightUpperLeg = true,
	RightLowerLeg = true,
	RightFoot = true,
	Torso = true,
	["Left Arm"] = true,
	["Right Arm"] = true,
	["Left Leg"] = true,
	["Right Leg"] = true,
}

local function removeClutter(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Tool")
			or d:IsA("LuaSourceContainer")
			or d:IsA("BillboardGui")
			or d:IsA("Sound")
			or d:IsA("ForceField")
			or d:IsA("Highlight")
		then
			d:Destroy()
		end
	end
end

local function bodyBounds(model)
	local mn = Vector3.new(math.huge, math.huge, math.huge)
	local mx = Vector3.new(-math.huge, -math.huge, -math.huge)
	local found = false

	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") and BODY_PARTS[d.Name] then
			found = true
			local cf, half = d.CFrame, d.Size / 2
			for x = -1, 1, 2 do
				for y = -1, 1, 2 do
					for z = -1, 1, 2 do
						local p = cf:PointToWorldSpace(Vector3.new(half.X * x, half.Y * y, half.Z * z))
						mn = Vector3.new(math.min(mn.X, p.X), math.min(mn.Y, p.Y), math.min(mn.Z, p.Z))
						mx = Vector3.new(math.max(mx.X, p.X), math.max(mx.Y, p.Y), math.max(mx.Z, p.Z))
					end
				end
			end
		end
	end

	if not found then
		local cf, size = model:GetBoundingBox()
		return cf.Position, size
	end

	return (mn + mx) / 2, mx - mn
end

function Container:AddAvatar(o)
	o = o or {}
	local height = o.Height or 240
	local win = self.Window
	local tab = self.Tab
	local useCharacter = o.UseCharacter == true
	local showAccessories = o.Accessories ~= false

	local r = new("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		LayoutOrder = nextOrder(self),
		Parent = self.Frame,
	}, { BackgroundColor3 = "SurfaceAlt" })
	corner(r, 8)
	stroke(r)

	local vp = new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -38),
		Ambient = Color3.fromRGB(170, 170, 185),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.5, -1, -0.8),
		Parent = r,
	})

	local cam = Instance.new("Camera")
	cam.FieldOfView = 32
	cam.Parent = vp
	vp.CurrentCamera = cam

	local world = Instance.new("WorldModel")
	world.Parent = vp

	local status = label(r, "loading avatar...", {
		Size = UDim2.new(1, 0, 1, -38),
		Font = Enum.Font.Code,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, "SubText")

	local bottom = new("Frame", {
		Size = UDim2.new(1, 0, 0, 38),
		Position = UDim2.new(0, 0, 1, -38),
		BorderSizePixel = 0,
		Parent = r,
	}, { BackgroundColor3 = "Surface" })
	new("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BorderSizePixel = 0,
		Parent = bottom,
	}, { BackgroundColor3 = "Stroke" })

	local nameLbl = label(bottom, "", {
		Size = UDim2.new(1, -210, 0, 18),
		Position = UDim2.fromOffset(12, 10),
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	label(bottom, "drag to rotate / scroll to zoom", {
		Size = UDim2.fromOffset(190, 18),
		Position = UDim2.new(1, -202, 0, 10),
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = Enum.Font.Code,
		TextSize = 10,
	}, "SubText")

	local model, accessories = nil, {}
	local center, size = Vector3.new(), Vector3.new(4, 6, 2)
	local yaw, dist, zoom = math.pi, 10, 1
	local auto = o.AutoRotate ~= false
	local speed = o.Speed or 0.7
	local token = 0
	local currentWho = nil

	local function placeCamera()
		if not model then
			return
		end
		local pos = center
			+ Vector3.new(math.sin(yaw) * dist * zoom, size.Y * 0.04, math.cos(yaw) * dist * zoom)
		cam.CFrame = CFrame.lookAt(pos, center)
	end

	local function frameCamera()
		local fov = math.rad(cam.FieldOfView)
		local aspect = math.max(vp.AbsoluteSize.X, 1) / math.max(vp.AbsoluteSize.Y, 1)
		local wide = math.max(size.X, size.Z)
		local distH = (math.max(size.Y, 1) * 1.28 / 2) / math.tan(fov / 2)
		local distW = (wide * 1.3 / 2) / (math.tan(fov / 2) * aspect)
		dist = math.max(distH, distW) + wide / 2
	end

	local function clearModel()
		if model then
			model:Destroy()
		end
		model, accessories = nil, {}
	end

	local function applyAccessories()
		for _, acc in ipairs(accessories) do
			acc.Parent = showAccessories and model or nil
		end
	end

	local function cloneCharacter()
		local ch = LocalPlayer.Character
		if not ch or not ch:FindFirstChild("HumanoidRootPart") then
			return nil
		end
		local was = ch.Archivable
		ch.Archivable = true
		local ok, c = pcall(function()
			return ch:Clone()
		end)
		ch.Archivable = was
		return ok and c or nil
	end

	local function buildFromDescription(userId)
		local okD, desc = pcall(function()
			return Players:GetHumanoidDescriptionFromUserId(userId)
		end)
		if not (okD and desc) then
			return nil
		end
		local okM, built = pcall(function()
			return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
		end)
		return okM and built or nil
	end

	local function load(who)
		token = token + 1
		local my = token
		currentWho = who

		status.Visible = true
		status.Text = "loading avatar..."
		nameLbl.Text = ""
		vp.Visible = false
		clearModel()

		task.spawn(function()
			local userId = who
			if type(userId) == "string" then
				local ok, id = pcall(function()
					return Players:GetUserIdFromNameAsync(who)
				end)
				userId = ok and id or nil
			end

			if not userId then
				if my == token then
					status.Text = "user not found"
				end
				return
			end

			local caption
			if userId == LocalPlayer.UserId then
				caption = LocalPlayer.DisplayName .. "  (@" .. LocalPlayer.Name .. ")"
			else
				local okN, uname = pcall(function()
					return Players:GetNameFromUserIdAsync(userId)
				end)
				caption = okN and ("@" .. uname) or tostring(userId)
			end

			local own = userId == LocalPlayer.UserId
			local m = nil

			if useCharacter and own then
				m = cloneCharacter()
			end
			if not m then
				m = buildFromDescription(userId)
			end
			if not m and own then
				m = cloneCharacter()
			end

			if my ~= token or not r.Parent then
				if m then
					m:Destroy()
				end
				return
			end
			if not m then
				status.Text = "avatar unavailable"
				return
			end

			removeClutter(m)

			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("Motor6D") then
					pcall(function()
						d.Transform = CFrame.new()
					end)
				end
			end

			local hrp = m:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.Anchored = true
			end

			pcall(function()
				m:PivotTo(CFrame.new(0, 0, 0))
			end)
			m.Parent = world

			for _ = 1, 2 do
				RunService.Heartbeat:Wait()
				pcall(function()
					world:StepPhysics(1 / 30, { m })
				end)
			end

			if my ~= token or not r.Parent then
				m:Destroy()
				return
			end

			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
				end
			end

			local hum = m:FindFirstChildOfClass("Humanoid")
			if hum then
				pcall(function()
					hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				end)
			end

			model = m
			accessories = {}
			for _, c in ipairs(m:GetChildren()) do
				if c:IsA("Accessory") then
					table.insert(accessories, c)
				end
			end

			applyAccessories()
			center, size = bodyBounds(m)
			frameCamera()

			status.Visible = false
			vp.Visible = true
			nameLbl.Text = caption
			placeCamera()
		end)
	end

	load(o.Username or LocalPlayer.UserId)

	local hover, dragging = false, false
	r.MouseEnter:Connect(function()
		hover = true
		tab.Frame.ScrollingEnabled = false
	end)
	r.MouseLeave:Connect(function()
		hover = false
		tab.Frame.ScrollingEnabled = true
	end)

	vp.InputBegan:Connect(function(input)
		if isDown(input) then
			dragging = true
			local c
			c = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					c:Disconnect()
				end
			end)
		end
	end)

	win:_conn(UserInputService.InputChanged, function(input)
		if dragging and isMove(input) then
			yaw = yaw - input.Delta.X * 0.012
			placeCamera()
		elseif hover and input.UserInputType == Enum.UserInputType.MouseWheel then
			zoom = math.clamp(zoom - input.Position.Z * 0.08, 0.55, 1.6)
			placeCamera()
		end
	end)

	win:_conn(RunService.RenderStepped, function(dt)
		if auto and not dragging and model and win.Open and tab.Active then
			yaw = yaw + dt * speed
			placeCamera()
		end
	end)

	local obj = {}
	function obj:SetUser(who)
		load(who)
	end
	function obj:SetAutoRotate(b)
		auto = b and true or false
	end
	function obj:SetSpeed(x)
		speed = x
	end
	function obj:SetAccessories(b)
		showAccessories = b and true or false
		applyAccessories()
	end
	function obj:SetUseCharacter(b)
		useCharacter = b and true or false
		load(currentWho)
	end
	function obj:ResetView()
		yaw, zoom = math.pi, 1
		placeCamera()
	end
	return obj
end

