local function TH()
	return Lib.Active
end

local function buildActive()
	local base = Lib.Themes[Lib.CurrentTheme]
	local t = {}
	for k, v in pairs(base) do
		t[k] = v
	end

	if Lib.AccentOverride then
		t.Accent = Lib.AccentOverride
		if base.IsLight then
			t.AccentDark = Lib.AccentOverride:Lerp(Color3.new(1, 1, 1), 0.55)
		else
			t.AccentDark = Lib.AccentOverride:Lerp(Color3.new(0, 0, 0), 0.5)
		end
	end

	-- computed colors
	if base.IsLight then
		t.AccentSoft = t.Accent:Lerp(Color3.new(1, 1, 1), 0.84)
		t.SurfaceElevated = t.SurfaceAlt:Lerp(Color3.new(1, 1, 1), 0.55)
	else
		t.AccentSoft = t.Accent:Lerp(t.Background, 0.82)
		t.SurfaceElevated = t.SurfaceAlt:Lerp(Color3.new(1, 1, 1), 0.035)
	end

	t.Shadow = t.Shadow or Color3.new(0, 0, 0)
	Lib.Active = t
end
buildActive()

-- Instances bound to theme tokens.
local bound = {}
local hooks = {}

local function purge()
	for inst in pairs(bound) do
		if not inst:IsDescendantOf(game) then
			bound[inst] = nil
		end
	end
	for inst in pairs(hooks) do
		if not inst:IsDescendantOf(game) then
			hooks[inst] = nil
		end
	end
end

local function bind(inst, prop, token)
	local value = TH()[token]
	if value ~= nil then
		inst[prop] = value
	end
	local b = bound[inst]
	if not b then
		b = {}
		bound[inst] = b
	end
	b[prop] = token
end

local function hook(inst, fn)
	hooks[inst] = fn
	fn(false)
end

local function refresh(instant)
	purge()
	local theme = TH()
	local info = TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	for inst, props in pairs(bound) do
		local goal = {}
		for prop, token in pairs(props) do
			local v = theme[token]
			if v ~= nil then
				goal[prop] = v
			end
		end
		if next(goal) then
			if instant then
				for p, v in pairs(goal) do
					inst[p] = v
				end
			else
				TweenService:Create(inst, info, goal):Play()
			end
		end
	end

	for _, fn in pairs(hooks) do
		pcall(fn, not instant)
	end
end

function Lib:SetTheme(name, instant)
	if not Lib.Themes[name] then
		return false
	end
	Lib.CurrentTheme = name
	Lib.AccentOverride = nil
	buildActive()
	refresh(instant)
	return true
end

function Lib:RegisterTheme(name, overrides, base)
	local t = {}
	for k, v in pairs(Lib.Themes[base or "Dark+"]) do
		t[k] = v
	end
	for k, v in pairs(overrides or {}) do
		t[k] = v
	end
	Lib.Themes[name] = t
	for _, n in ipairs(Lib.ThemeOrder) do
		if n == name then
			return
		end
	end
	table.insert(Lib.ThemeOrder, name)
end

function Lib:SetAccent(color, animated)
	Lib.AccentOverride = color
	buildActive()
	refresh(animated ~= true)
end

function Lib:ResetAccent()
	Lib.AccentOverride = nil
	buildActive()
	refresh(false)
end

function Lib:GetAccent()
	return TH().Accent
end

