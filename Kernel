function Container:AddKeybind(o)
	o = o or {}
	local win = self.Window
	local key = o.Default
	local mode = o.Mode or "Press"
	local state = false
	local listening = false

	local r = rowFrame(self, 38)

	label(r, o.Name or "Keybind", {
		Size = UDim2.new(1, -126, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local btn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(104, 24),
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Font = Enum.Font.Code,
		TextSize = 12,
		Parent = r,
	}, { BackgroundColor3 = "Background", TextColor3 = "Accent" })
	corner(btn, 5)
	stroke(btn)

	local function show()
		if listening then
			btn.Text = "..."
		else
			btn.Text = key and key.Name or "None"
		end
	end
	show()

	btn.MouseButton1Click:Connect(function()
		listening = true
		win.Rebinding = true
		show()
	end)

	win:_conn(UserInputService.InputBegan, function(input, gp)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				win.Rebinding = false
				if input.KeyCode == Enum.KeyCode.Backspace then
					key = nil
				elseif input.KeyCode ~= Enum.KeyCode.Escape then
					key = input.KeyCode
				end
				show()
				safe(o.OnChange, key)
			end
			return
		end

		if gp or not key or input.KeyCode ~= key then
			return
		end

		if mode == "Hold" then
			state = true
			safe(o.Callback, true)
		elseif mode == "Toggle" then
			state = not state
			safe(o.Callback, state)
		else
			safe(o.Callback)
		end
	end)

	win:_conn(UserInputService.InputEnded, function(input)
		if mode == "Hold" and state and key and input.KeyCode == key then
			state = false
			safe(o.Callback, false)
		end
	end)

	local obj = {}
	function obj:Set(k)
		key = k
		show()
	end
	function obj:Get()
		return key
	end
	return obj
end

