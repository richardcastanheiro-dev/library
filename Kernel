function Container:AddSlider(o)
	o = o or {}
	local min, max = o.Min or 0, o.Max or 100
	local inc = o.Increment or 1
	local dec = #((tostring(inc)):match("%.(%d+)") or "")
	local suffix = o.Suffix or ""
	local value = math.clamp(o.Default or min, min, max)

	local r = rowFrame(self, 58)

	label(r, o.Name or "Slider", {
		Size = UDim2.new(1, -104, 0, 18),
		Position = UDim2.fromOffset(12, 8),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local pill = new("Frame", {
		Size = UDim2.fromOffset(72, 20),
		Position = UDim2.new(1, -84, 0, 7),
		BorderSizePixel = 0,
		Parent = r,
	}, { BackgroundColor3 = "AccentSoft" })
	corner(pill, 10)
	stroke(pill, "Accent", 1, 0.78)

	local val = label(pill, "", {
		Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.Code,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, "Accent")

	local hit = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -24, 0, 18),
		Position = UDim2.fromOffset(12, 32),
		Parent = r,
	})

	local bar = new("Frame", {
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 0.5, -3),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = hit,
	}, { BackgroundColor3 = "Background" })
	corner(bar, 3)
	stroke(bar, "Stroke", 1, 0.65)

	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BorderSizePixel = 0,
		Parent = bar,
	}, { BackgroundColor3 = "Accent" })
	corner(fill, 3)

	new("UIGradient", {
		Rotation = 0,
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(218, 230, 255)),
		Parent = fill,
	})

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BorderSizePixel = 0,
		Parent = hit,
	}, { BackgroundColor3 = "Accent" })
	corner(knob, 7)
	stroke(knob, "Surface", 1, 0.15)

	local function fmt(v)
		return string.format("%." .. dec .. "f", v) .. suffix
	end

	local function setValue(v, silent, instant)
		v = math.clamp(math.floor((v - min) / inc + 0.5) * inc + min, min, max)
		v = tonumber(string.format("%." .. dec .. "f", v))

		local changed = v ~= value
		value = v
		local a = (max == min) and 0 or (v - min) / (max - min)

		if instant then
			fill.Size = UDim2.fromScale(a, 1)
			knob.Position = UDim2.new(a, 0, 0.5, 0)
		else
			tween(fill, 0.08, { Size = UDim2.fromScale(a, 1) })
			tween(knob, 0.08, { Position = UDim2.new(a, 0, 0.5, 0) })
		end

		val.Text = fmt(v)

		if o.Flag then
			Lib.Flags[o.Flag] = v
		end
		if changed and not silent then
			safe(o.Callback, v)
		end
	end

	setValue(value, true, true)
	alphaDrag(hit, function(ax)
		setValue(min + (max - min) * ax)
	end)

	local obj = {}
	function obj:Set(v, silent)
		setValue(v, silent)
	end
	function obj:Get()
		return value
	end
	return obj
end

function Container:AddDropdown(o)
	o = o or {}
