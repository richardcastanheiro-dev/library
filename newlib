function Window:SetKeybind(key)
    if self._keybindConnection then
        self._keybindConnection:Disconnect()
        self._keybindConnection = nil
    end
    if key == nil or key == false then
        self._keybind = false
        return
    end
    self._keybind = key
    self._keybindConnection = UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == self._keybind and not UserInputService:GetFocusedTextBox() then
            self:Toggle()
        end
    end)
end

function Window:GetKeybind()
    return self._keybind
end

function Window:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    self._visible = false
    if self._resizeApi then pcall(function() self._resizeApi.Destroy() end) self._resizeApi = nil end
    if self._dragApi then pcall(function() self._dragApi.Destroy() end) self._dragApi = nil end
    if self._keybindConnection then self._keybindConnection:Disconnect() self._keybindConnection = nil end
    self:_cancelTweens()
    for i = #Lib.Windows, 1, -1 do
        if Lib.Windows[i] == self then table.remove(Lib.Windows, i) end
    end
    if self._screenGui then self._screenGui:Destroy() self._screenGui = nil end
end

function Lib:CreateWindow(config)
    config = type(config) == "table" and config or {}
    local self = setmetatable({}, Window)
    self._tweens = {}
    self._tabs = {}
