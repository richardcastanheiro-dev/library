                        }, optionsFrame)

                        Corner(optionButton, 4)

                        optionButton.MouseButton1Click:Connect(function()
                            selected = option
                            dropdownText.Text = tostring(selected) .. "  v"
                            optionsFrame.Visible = false
                            optionsFrame.Size = UDim2.new(1, 0, 0, 0)
                            if configDropdown.Callback then
                                configDropdown.Callback(selected)
                            end
                        end)
                    end
                end

                Refresh()

                dropdownButton.MouseButton1Click:Connect(function()
                    optionsFrame.Visible = not optionsFrame.Visible
                    optionsFrame.Size = optionsFrame.Visible and UDim2.new(1, 0, 0, math.min(#options * 29 + 4, 145)) or UDim2.new(1, 0, 0, 0)
