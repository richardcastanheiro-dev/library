            function box:AddSlider(id, configSlider)
                if type(id) == "table" then
                    configSlider = id
                    id = configSlider.Text or configSlider.Id or "Slider"
                end

                configSlider = configSlider or {}

                local minimum = tonumber(configSlider.Min or configSlider.Minimum) or 0
                local maximum = tonumber(configSlider.Max or configSlider.Maximum) or 100

                if maximum <= minimum then
                    maximum = minimum + 1
                end

                local rounding = configSlider.Rounding

                if rounding == nil then
                    rounding = 0
                end

                local suffix = tostring(configSlider.Suffix or "")
                local value = math.clamp(tonumber(configSlider.Default) or minimum, minimum, maximum)

                local row = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 52),
                    BackgroundTransparency = 1,
                    LayoutOrder = nextOrder()
                }, holder)

                local label = MakeText(row, configSlider.Text or tostring(id or "Slider"), 12, Theme.Text)
                label.Size = UDim2.new(1, -60, 0, 18)

                local valueLabel = MakeText(row, "", 11, Theme.Accent, true, Enum.TextXAlignment.Right)
                valueLabel.Size = UDim2.new(0, 56, 0, 18)
                valueLabel.Position = UDim2.new(1, -56, 0, 0)

                local bar = Create("TextButton", {
                    Position = UDim2.fromOffset(0, 26),
                    Size = UDim2.new(1, 0, 0, 7),
                    BackgroundColor3 = Theme.Element,
                    Text = "",
                    AutoButtonColor = false,
                    BorderSizePixel = 0
                }, row)

                Corner(bar, 6)
                AddStroke(bar, Theme.Border, 1, 0.6)

                local fill = Create("Frame", {
                    Size = UDim2.new(0, 0, 1, 0),
                    BackgroundColor3 = Theme.Accent,
                    BorderSizePixel = 0
                }, bar)

                Corner(fill, 6)
                Create("UIGradient", {
                    Color = ColorSequence.new(Theme.Accent, Theme.Accent2),
                    Rotation = 0
                }, fill)

                local knob = Create("Frame", {
                    Size = UDim2.fromOffset(14, 14),
                    Position = UDim2.new(0, 0, 0.5, -7),
                    BackgroundColor3 = Theme.Text,
                    BorderSizePixel = 0,
                    ZIndex = 2
                }, bar)

                Corner(knob, 10)
                AddStroke(knob, Theme.Accent, 2, 0)

                local function formatValue(v)
                    local factor = 10 ^ rounding
                    v = math.floor(v * factor + 0.5) / factor
                    return v
                end

                local function update(newValue, silent)
                    value = math.clamp(tonumber(newValue) or minimum, minimum, maximum)
                    value = formatValue(value)

                    local percent = (value - minimum) / math.max(maximum - minimum, 0.0001)

                    fill.Size = UDim2.new(percent, 0, 1, 0)
                    knob.Position = UDim2.new(percent, -7, 0.5, -7)
                    valueLabel.Text = tostring(value) .. suffix

                    if not silent and type(configSlider.Callback) == "function" then
                        task.spawn(function()
                            pcall(configSlider.Callback, value)
                        end)
                    end
                end

                local function updateFromInput(input)
                    if not bar.Parent then
                        return
                    end

                    local percent = math.clamp(
                        (input.Position.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1),
                        0,
                        1
                    )

                    update(minimum + (maximum - minimum) * percent, false)
                end

                local dragging = false
                local c1
                local c2
                local c3

                c1 = bar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        updateFromInput(input)
                    end
                end)

                c2 = UIS.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        updateFromInput(input)
                    end
                end)

                c3 = UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                row.AncestryChanged:Connect(function()
                    if not row.Parent then
                        if c1 then
                            c1:Disconnect()
                        end

                        if c2 then
                            c2:Disconnect()
                        end

                        if c3 then
                            c3:Disconnect()
                        end
                    end
                end)

                update(value, true)

                local control = {}

                function control:SetValue(newValue)
                    update(newValue, false)
                end

                function control:GetValue()
                    return value
                end

                return control
            end

