                            updateFromInput(input)
                        end
                    end)

                    c3 = UIS.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = false
                        end
                    end)

                    row.AncestryChanged:Connect(function()
                        if not row.Parent then
                            if c1 then
                                c1:Disconnect()
                            end

                            if c2 then
                                c2:Disconnect()
                            end

                            if c3 then
                                c3:Disconnect()
                            end
                        end
                    end)

                    return {
                        SetValue = function(_, v)
                            set(v, true)
                        end,
                        GetValue = function()
                            return value
                        end
                    }
                end

                local rControl = createMiniSlider("R", rValue, 2, function(v)
                    rValue = v
                    applyColor(false)
                end)

                local gControl = createMiniSlider("G", gValue, 3, function(v)
                    gValue = v
                    applyColor(false)
                end)

                local bControl = createMiniSlider("B", bValue, 4, function(v)
                    bValue = v
                    applyColor(false)
                end)

                local open = false

                local function setOpen(valueOpen)
                    open = valueOpen
                    panel.Visible = open

                    if open then
                        panel.Size = UDim2.new(1, 0, 0, 142)
                    else
                        panel.Size = UDim2.new(1, 0, 0, 0)
                    end
                end

                head.MouseButton1Click:Connect(function()
                    setOpen(not open)
                end)

                head.MouseEnter:Connect(function()
                    TweenService:Create(headStroke, TweenInfo.new(0.15), {
                        Color = Theme.Accent,
                        Transparency = 0.35
                    }):Play()
                end)

                head.MouseLeave:Connect(function()
                    TweenService:Create(headStroke, TweenInfo.new(0.15), {
                        Color = Theme.Border,
                        Transparency = 0.55
                    }):Play()
                end)

                local control = {}

                function control:SetValue(newColor)
                    color = newColor or color
                    rValue = math.floor(color.R * 255 + 0.5)
                    gValue = math.floor(color.G * 255 + 0.5)
                    bValue = math.floor(color.B * 255 + 0.5)

                    rControl:SetValue(rValue)
                    gControl:SetValue(gValue)
                    bControl:SetValue(bValue)

                    swatch.BackgroundColor3 = color
                    preview.BackgroundColor3 = color

                    if type(configColor.Callback) == "function" then
                        task.spawn(function()
                            pcall(configColor.Callback, color)
                        end)
                    end
                end

                function control:GetValue()
                    return color
                end

                return control
            end

            box.AddTextbox = box.AddInput
            box.AddSeparator = box.AddDivider
            box.AddSwitch = box.AddToggle
            box.AddColor = box.AddColorPicker

            return box
        end

        function tab:AddLeftGroupbox(groupName)
            return tab:AddGroupbox(groupName)
        end

        function tab:AddRightGroupbox(groupName)
            return tab:AddGroupbox(groupName)
        end

        function tab:AddGroup(groupName)
            return tab:AddGroupbox(groupName)
        end

        table.insert(self.Tabs, tab)

        if #self.Tabs == 1 then
            selectTab()
        end

        return tab, tabButton
    end

    function self:AddTab(name, icon)
        return self:CreateTab(name, icon)
    end

    function self:SelectTab(name)
        for _, tab in ipairs(self.Tabs) do
            if tab.Name == name then
                tab.Select()
                return tab
            end
        end
    end

    function self:CreateTabbox()
        return nil
    end

    return self
end

Library.new = function(self, config)
    if self ~= Library then
        config = self
    end

    return Library:CreateWindow(config)
end

return Library
