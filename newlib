        Size = UDim2.fromOffset(100, 28),
        BackgroundColor3 = Theme.SurfaceHi,
        BorderSizePixel = 0,
        Text = "",
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = Theme.AccentSoft,
        AutoButtonColor = false
    }, frame)
    corner(button, 7)
    local btnStroke = stroke(button, Theme.Stroke, 0.4)

    local currentKey = defaultKey or Enum.KeyCode.RightShift
    local listening = false
    local disabled = false

    local function update()
        button.Text = currentKey and currentKey.Name or "None"
        button.TextColor3 = Theme.AccentSoft
        frame:SetAttribute("LibKeybind", button.Text)
    end

    update()

    button.MouseButton1Click:Connect(function()
        if disabled then return end
        listening = true
        button.Text = "Pressione..."
        button.TextColor3 = Theme.Success
        TweenService:Create(btnStroke, Fast, {Color = Theme.Success, Transparency = 0}):Play()
    end)

    button.MouseEnter:Connect(function()
        if not listening then
            TweenService:Create(button, Fast, {BackgroundColor3 = Theme.SurfaceHover}):Play()
            TweenService:Create(btnStroke, Fast, {Color = Theme.Accent, Transparency = 0.35}):Play()
        end
    end)
    button.MouseLeave:Connect(function()
        if not listening then
            TweenService:Create(button, Fast, {BackgroundColor3 = Theme.SurfaceHi}):Play()
            TweenService:Create(btnStroke, Fast, {Color = Theme.Stroke, Transparency = 0.4}):Play()
        end
    end)

    local connection = UserInputService.InputBegan:Connect(function(input, processed)
        if listening then
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            listening = false
            TweenService:Create(btnStroke, Fast, {Color = Theme.Stroke, Transparency = 0.4}):Play()
            if input.KeyCode == Enum.KeyCode.Escape then update() return end
            if input.KeyCode == Enum.KeyCode.Backspace then currentKey = nil update() return end
            currentKey = input.KeyCode
            update()
            return
        end
        if disabled or processed or UserInputService:GetFocusedTextBox() then return end
        if currentKey and input.KeyCode == currentKey then
            safeCall(callback, currentKey)
        end
    end)

    registerControl(frame, {
        SetValue = function(key)
            if typeof(key) == "EnumItem" and key.EnumType == Enum.KeyCode then
                currentKey = key
                update()
            end
        end,
        GetValue = function() return currentKey end,
        SetDisabled = function(v)
            disabled = v
            button.TextTransparency = v and 0.5 or 0
        end
    })

    frame.Destroying:Connect(function() connection:Disconnect() end)
    refreshPage(page)
    return frame
end

