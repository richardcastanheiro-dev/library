        Name = "Track",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.fromOffset(42, 22),
        BackgroundColor3 = Theme.SurfaceHi,
        BorderSizePixel = 0
    }, row)
    corner(track, 11)
    local trackStroke = stroke(track, Theme.Stroke, 0.5)

    local knob = make("Frame", {
        Name = "Knob",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0
    }, track)
    corner(knob, 8)

    local active = default == true
    local disabled = false

    local function apply(state, fire)
        active = state == true
        row:SetAttribute("LibValue", active)
        TweenService:Create(track, Fast, {BackgroundColor3 = active and Theme.Accent or Theme.SurfaceHi}):Play()
        TweenService:Create(trackStroke, Fast, {Transparency = active and 0.1 or 0.5, Color = active and Theme.AccentSoft or Theme.Stroke}):Play()
        TweenService:Create(knob, Spring, {Position = active and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)}):Play()
        if fire then safeCall(callback, active) end
    end

    row.MouseEnter:Connect(function()
        if not disabled then
            TweenService:Create(row, Fast, {BackgroundColor3 = Theme.SurfaceHi, BackgroundTransparency = 0.05}):Play()
            TweenService:Create(rowStroke, Fast, {Color = Theme.Accent, Transparency = 0.35}):Play()
        end
    end)

    row.MouseLeave:Connect(function()
        if not disabled then
            TweenService:Create(row, Fast, {BackgroundColor3 = Theme.SurfaceAlt, BackgroundTransparency = 0.15}):Play()
            TweenService:Create(rowStroke, Fast, {Color = Theme.StrokeSoft, Transparency = 0.4}):Play()
        end
    end)

    row.MouseButton1Click:Connect(function()
        if not disabled then apply(not active, true) end
    end)

    apply(active, false)

    registerControl(row, {
        SetValue = function(v) apply(v, true) end,
        GetValue = function() return active end,
        SetDisabled = function(v)
            disabled = v
            row.Active = not v
            row.TextTransparency = v and 0.5 or 0
        end
    })

    refreshPage(page)
    return row
end

