local function Create(class, props, parent)
    local object = Instance.new(class)
    for key, value in pairs(props or {}) do
        object[key] = value
    end
    object.Parent = parent
    return object
end

local function Corner(parent, radius)
    return Create("UICorner", {
        CornerRadius = UDim.new(0, radius or 8)
    }, parent)
end

local function AddStroke(parent, color, thickness, transparency)
    return Create("UIStroke", {
        Color = color or Theme.Border,
        Thickness = thickness or 1,
        Transparency = transparency or 0.45,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, parent)
end

local function MakeText(parent, value, size, color, bold, alignment)
    return Create("TextLabel", {
        BackgroundTransparency = 1,
        Text = tostring(value or ""),
        TextColor3 = color or Theme.Text,
        TextSize = size or 13,
        Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextXAlignment = alignment or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = UDim2.new(1, 0, 1, 0)
    }, parent)
end

local function AddClickFx(button)
    button.ClipsDescendants = true
    local scale = Create("UIScale", {
        Scale = 1
    }, button)

    local function down()
        TweenService:Create(scale, TweenInfo.new(0.08), {
            Scale = 0.97
        }):Play()
    end

    local function up()
        TweenService:Create(scale, TweenInfo.new(0.12), {
            Scale = 1
        }):Play()
    end

    button.MouseButton1Down:Connect(function(x, y)
        down()

        local circle = Create("Frame", {
            Size = UDim2.fromOffset(0, 0),
            Position = UDim2.fromOffset(x, y),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 0.72,
            BorderSizePixel = 0,
            ZIndex = button.ZIndex + 1
        }, button)

        Corner(circle, 999)

        local size = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2

        TweenService:Create(circle, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(size, size),
            Position = UDim2.fromOffset(x - size / 2, y - size / 2),
            BackgroundTransparency = 1
        }):Play()

        task.delay(0.5, function()
            if circle then
                circle:Destroy()
            end
        end)
    end)

    button.MouseButton1Up:Connect(up)
    button.MouseLeave:Connect(function()
        if scale.Scale ~= 1 then
            up()
        end
    end)
end

local function BindHover(button, normalColor, hoverColor, normalTransparency, hoverTransparency)
    local c1 = button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), {
            BackgroundColor3 = hoverColor,
            BackgroundTransparency = hoverTransparency or 0
        }):Play()
    end)

    local c2 = button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), {
            BackgroundColor3 = normalColor,
            BackgroundTransparency = normalTransparency or 0
        }):Play()
    end)

    return function()
        c1:Disconnect()
        c2:Disconnect()
    end
end

local function MakeDraggable(frame, handle)
    local dragging = false
    local dragStart
    local startPosition
    local connections = {}

    local function add(connection)
        table.insert(connections, connection)
        return connection
    end

    add(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = frame.Position
        end
    end))

    add(UIS.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end))

    add(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    return function()
        for _, connection in ipairs(connections) do
            if connection then
                connection:Disconnect()
            end
        end
    end
end

local function AddShadow(gui, frame, radius, transparency)
    local shadow = Create("Frame", {
        Name = "Shadow",
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = transparency or 0.5,
        BorderSizePixel = 0,
        ZIndex = frame.ZIndex - 1
    }, gui)

    Corner(shadow, (radius or 12) + 4)

    local function sync()
        shadow.Size = UDim2.new(
            frame.Size.X.Scale,
            frame.Size.X.Offset + 24,
            frame.Size.Y.Scale,
            frame.Size.Y.Offset + 24
        )

        shadow.Position = UDim2.new(
            frame.Position.X.Scale,
            frame.Position.X.Offset - 12,
            frame.Position.Y.Scale,
            frame.Position.Y.Offset - 12
        )

        shadow.Visible = frame.Visible
        shadow.ZIndex = frame.ZIndex - 1
    end

    local c1 = frame:GetPropertyChangedSignal("Position"):Connect(sync)
    local c2 = frame:GetPropertyChangedSignal("Size"):Connect(sync)
    local c3 = frame:GetPropertyChangedSignal("Visible"):Connect(sync)
    local c4 = frame:GetPropertyChangedSignal("ZIndex"):Connect(sync)

    sync()

    return shadow, function()
        c1:Disconnect()
        c2:Disconnect()
        c3:Disconnect()
        c4:Disconnect()
    end
end

function Library:CreateWindow(config)
