        BackgroundColor3 = Theme.Surface,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        GroupTransparency = 1,
        ClipsDescendants = true,
        LayoutOrder = Lib._notifyCount
    }, stack)
    corner(card, 12)
    stroke(card, Theme.StrokeSoft, 0.3)

    local scale = make("UIScale", {Name = "Scale", Scale = 0.95}, card)

    local accent = make("Frame", {
        Name = "Accent",
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0
    }, card)
    corner(accent, 4)

    make("TextLabel", {
        Name = "Title",
        Position = UDim2.fromOffset(16, 10),
        Size = UDim2.new(1, -30, 0, 18),
        BackgroundTransparency = 1,
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    }, card)

    make("TextLabel", {
        Name = "Text",
        Position = UDim2.fromOffset(16, 30),
        Size = UDim2.new(1, -30, 0, 28),
        BackgroundTransparency = 1,
        Text = text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true
    }, card)

    local progressBg = make("Frame", {
        Name = "ProgressBg",
        Position = UDim2.new(0, 0, 1, -3),
        Size = UDim2.new(1, 0, 0, 3),
        BackgroundColor3 = Theme.SurfaceHi,
        BorderSizePixel = 0
    }, card)
    local progress = make("Frame", {
        Name = "Progress",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0
    }, progressBg)
    make("UIGradient", {
        Color = ColorSequence.new(Theme.Accent, Theme.AccentSoft),
        Rotation = 0
    }, progress)

    TweenService:Create(card, Normal, {GroupTransparency = 0}):Play()
    TweenService:Create(scale, Spring, {Scale = 1}):Play()
    TweenService:Create(progress, TweenInfo.new(math.max(0.1, duration), Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 1, 0)}):Play()

    task.delay(math.max(0.1, duration), function()
        if not card.Parent then return end
        local fade = TweenService:Create(card, In, {GroupTransparency = 1})
        fade:Play()
        fade.Completed:Connect(function()
            if card.Parent then card:Destroy() end
        end)
    end)

    return card
end

local function ensureWatermarkGui()
    if Lib._watermarkGui and Lib._watermarkGui.Parent then
        return Lib._watermarkGui
    end
    local old = PlayerGui:FindFirstChild("LibWatermark")
    if old then old:Destroy() end
    local gui = make("ScreenGui", {
        Name = "LibWatermark",
        DisplayOrder = 10001,
        IgnoreGuiInset = true,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, PlayerGui)
    Lib._watermarkGui = gui
    return gui
end

function Lib:CreateWatermark(config)
    if type(config) ~= "table" then
        config = {Text = tostring(config or "Interface")}
    end

    local gui = ensureWatermarkGui()
    local old = gui:FindFirstChild("Watermark")
    if old then old:Destroy() end

    local frame = make("CanvasGroup", {
        Name = "Watermark",
        Position = config.Position or UDim2.fromOffset(16, 16),
        Size = UDim2.fromOffset(220, 34),
        BackgroundColor3 = Theme.Surface,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        GroupTransparency = 0
    }, gui)
    corner(frame, 9)
    stroke(frame, Theme.StrokeSoft, 0.3)

    local accent = make("Frame", {
        Name = "Accent",
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0
    }, frame)
    corner(accent, 4)

    local label = make("TextLabel", {
        Name = "Text",
        Position = UDim2.fromOffset(14, 0),
        Size = UDim2.new(1, -26, 1, 0),
        BackgroundTransparency = 1,
        Text = tostring(config.Text or "Interface"),
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    }, frame)

    local drag
    if config.Draggable == true then
        local ok, result = pcall(function()
            return Lib.newDraggable(frame, frame, false)
        end)
        if ok then drag = result end
    end

    local api = {}
    local destroyed = false

    function api.SetText(selfOrValue, maybeValue)
        if destroyed then return end
        local value = maybeValue
        if value == nil then value = selfOrValue end
        label.Text = tostring(value or "")
    end

    function api.SetVisible(selfOrValue, maybeValue)
        if destroyed then return end
        local value = maybeValue
        if value == nil then value = selfOrValue end
        frame.Visible = value == true
    end

    function api.Destroy()
        if destroyed then return end
        destroyed = true
        if drag then
            pcall(function()
                if type(drag) == "table" and type(drag.Destroy) == "function" then
                    drag:Destroy()
                end
            end)
        end
        for i = #Lib._watermarks, 1, -1 do
            if Lib._watermarks[i] == api then table.remove(Lib._watermarks, i) end
        end
        if frame.Parent then frame:Destroy() end
    end

    table.insert(Lib._watermarks, api)
    return api
end

function Lib:Watermark(config)
    return self:CreateWatermark(config)
end

function Lib:DestroyAll()
    local windows = self.Windows
    self.Windows = {}
    for i = #windows, 1, -1 do
        local window = windows[i]
        if window and type(window.Destroy) == "function" then
            pcall(function() window:Destroy() end)
        end
    end
    local watermarks = self._watermarks
    self._watermarks = {}
    for i = #watermarks, 1, -1 do
        local wm = watermarks[i]
        if wm and type(wm.Destroy) == "function" then
            pcall(function() wm:Destroy() end)
        end
    end
    if self._notifyGui then
        pcall(function() self._notifyGui:Destroy() end)
    end
    self._notifyGui = nil
    self._notifyStack = nil
    if self._watermarkGui then
        pcall(function() self._watermarkGui:Destroy() end)
    end
    self._watermarkGui = nil
end

function Lib:Destroy()
    self:DestroyAll()
end

function Lib.new(a, b)
    if a == Lib then return Lib:CreateWindow(b) end
    return Lib:CreateWindow(a)
end

return Lib
