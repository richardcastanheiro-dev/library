local function make(class, props, parent)
    local obj = Instance.new(class)
    if props then
        for key, value in pairs(props) do
            obj[key] = value
        end
    end
    if parent then
        obj.Parent = parent
    end
    return obj
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function stroke(parent, color, transparency, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Theme.Stroke
    s.Transparency = transparency or 0
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function pad(parent, t, b, l, r)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, t or 0)
    p.PaddingBottom = UDim.new(0, b or t or 0)
    p.PaddingLeft = UDim.new(0, l or t or 0)
    p.PaddingRight = UDim.new(0, r or l or t or 0)
    p.Parent = parent
    return p
end

local function getViewport()
    local cam = workspace.CurrentCamera
    if cam then return cam.ViewportSize end
    return Vector2.new(1280, 720)
end

local function safeCall(cb, ...)
    if type(cb) ~= "function" then return end
    local ok, err = pcall(cb, ...)
    if not ok then warn("[UI] " .. tostring(err)) end
end

local function formatValue(value)
    if value == math.floor(value) then
        return tostring(math.floor(value))
    end
    return string.format("%.2f", value)
end

local function ripple(button, color)
    button.ClipsDescendants = true
    local targetColor = color or Theme.AccentSoft
    button.MouseButton1Down:Connect(function(mx, my)
        local circle = make("Frame", {
            BackgroundColor3 = targetColor,
            BackgroundTransparency = 0.72,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(mx, my),
            Size = UDim2.fromOffset(0, 0),
            ZIndex = button.ZIndex + 5
        }, button)
        corner(circle, 999)
        local maxSize = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2
        local tw = TweenService:Create(circle, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.fromOffset(mx - maxSize / 2, my - maxSize / 2),
            Size = UDim2.fromOffset(maxSize, maxSize),
            BackgroundTransparency = 1
        })
        tw:Play()
        tw.Completed:Connect(function()
            if circle.Parent then circle:Destroy() end
        end)
    end)
end

local function pressFx(button)
    local scale = make("UIScale", {Scale = 1}, button)
    button.MouseButton1Down:Connect(function()
        TweenService:Create(scale, TweenInfo.new(0.08), {Scale = 0.96}):Play()
    end)
    button.MouseButton1Up:Connect(function()
        TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
    end)
    button.MouseLeave:Connect(function()
        if scale.Scale ~= 1 then
            TweenService:Create(scale, Fast, {Scale = 1}):Play()
        end
    end)
end

function Lib.newDraggable(target, handle, isLocked)
    local dragging = false
    local startMouse, startX, startY
    local moveConn, endConn

    local function stop()
        dragging = false
        if moveConn then moveConn:Disconnect() moveConn = nil end
        if endConn then endConn:Disconnect() endConn = nil end
    end

    local handleConn = handle.InputBegan:Connect(function(input)
        if type(isLocked) == "function" then
            if isLocked() then return end
        elseif isLocked == true then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = true
        startMouse = UserInputService:GetMouseLocation()
        startX = target.Position.X.Offset
        startY = target.Position.Y.Offset

        moveConn = UserInputService.InputChanged:Connect(function(changed)
            if not dragging then return end
            if changed.UserInputType ~= Enum.UserInputType.MouseMovement and changed.UserInputType ~= Enum.UserInputType.Touch then return end
            local mouse = UserInputService:GetMouseLocation()
            local vp = getViewport()
            local size = target.AbsoluteSize
            local maxX = math.max(0, vp.X - size.X)
            local maxY = math.max(0, vp.Y - size.Y)
            local nx = math.clamp(startX + mouse.X - startMouse.X, 0, maxX)
            local ny = math.clamp(startY + mouse.Y - startMouse.Y, 0, maxY)
            target.Position = UDim2.fromOffset(nx, ny)
        end)

        endConn = UserInputService.InputEnded:Connect(function(changed)
            if changed.UserInputType == Enum.UserInputType.MouseButton1 or changed.UserInputType == Enum.UserInputType.Touch then
                stop()
            end
        end)
    end)

    return {
        Destroy = function()
            if handleConn then handleConn:Disconnect() end
            stop()
        end
    }
end

function Lib.newResize(target, callback)
    local dragging = false
    local startMouse, startSize
    local moveConn, endConn

    local handle = make("TextButton", {
        Name = "ResizeHandle",
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -4, 1, -4),
        Size = UDim2.fromOffset(24, 24),
        BackgroundColor3 = Theme.Surface,
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 999
    }, target)
    corner(handle, 6)

    local lines = make("Frame", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -3, 1, -3),
        Size = UDim2.fromOffset(11, 11),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 1000
    }, handle)

    for i = 1, 3 do
        make("Frame", {
            Size = UDim2.fromOffset(i * 3, 1),
            Position = UDim2.new(1, -(i * 3) - 1, 1, -(i * 3) - 1),
            BackgroundColor3 = Theme.TextDim,
            BorderSizePixel = 0,
            ZIndex = 1000
        }, lines)
    end

    local function stop()
        dragging = false
        if moveConn then moveConn:Disconnect() moveConn = nil end
        if endConn then endConn:Disconnect() endConn = nil end
    end

    handle.MouseEnter:Connect(function()
        TweenService:Create(handle, Fast, {BackgroundTransparency = 0, BackgroundColor3 = Theme.Accent}):Play()
    end)

    handle.MouseLeave:Connect(function()
        if not dragging then
            TweenService:Create(handle, Fast, {BackgroundTransparency = 0.4, BackgroundColor3 = Theme.Surface}):Play()
        end
    end)

    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        stop()
        dragging = true
        startMouse = UserInputService:GetMouseLocation()
        startSize = target.AbsoluteSize

        moveConn = UserInputService.InputChanged:Connect(function(changed)
            if not dragging then return end
            if changed.UserInputType ~= Enum.UserInputType.MouseMovement and changed.UserInputType ~= Enum.UserInputType.Touch then return end
            local mouse = UserInputService:GetMouseLocation()
            local delta = mouse - startMouse
            local vp = getViewport()
            local maxW = math.max(320, vp.X - 40)
            local maxH = math.max(240, vp.Y - 40)
            local minW = math.min(400, maxW)
            local minH = math.min(280, maxH)
            local w = math.clamp(startSize.X + delta.X, minW, maxW)
            local h = math.clamp(startSize.Y + delta.Y, minH, maxH)
            target.Size = UDim2.fromOffset(w, h)
            if callback then callback(w, h) end
        end)

        endConn = UserInputService.InputEnded:Connect(function(changed)
            if changed.UserInputType == Enum.UserInputType.MouseButton1 or changed.UserInputType == Enum.UserInputType.Touch then
                stop()
            end
        end)
    end)

    return {
        Destroy = function()
            stop()
            handle:Destroy()
        end
    }
end

function Lib:GetIcon(name)
    if not self.Icons or type(name) ~= "string" then return nil end
    local ok, icon = pcall(function() return self.Icons.GetAsset(name) end)
    if ok then return icon end
    return nil
end

function Lib:GetCustomIcon(value)
    if value == nil then return nil end
    if type(value) == "number" or tonumber(value) then
        value = "rbxassetid://" .. tostring(value)
    end
    value = tostring(value)
    if value:match("^rbxasset") or value:match("^https?://") then
        return {Url = value, ImageRectOffset = Vector2.zero, ImageRectSize = Vector2.zero, Custom = true}
    end
    return self:GetIcon(value)
end

local function getPageFrom(object)
    local current = object
    while current do
        if current:IsA("ScrollingFrame") and current:GetAttribute("LibPage") then
            return current
        end
        current = current.Parent
    end
    return nil
end

local function updateCanvas(page)
    if not page or not page.Parent then return end
    local holder = page:FindFirstChild("Holder")
    local layout = holder and holder:FindFirstChildOfClass("UIListLayout")
    local contentHeight = layout and layout.AbsoluteContentSize.Y or 0
    local height = math.max(contentHeight + 32, page.AbsoluteSize.Y)
    page.CanvasSize = UDim2.fromOffset(0, height)
end

local function refreshPage(page)
    if not page then return end
    updateCanvas(page)
    task.defer(function()
        if page and page.Parent then
            updateCanvas(page)
        end
    end)
end

local function resolveHost(parent)
    if not parent then return nil end
    if parent:IsA("ScrollingFrame") then
        return parent:FindFirstChild("Holder") or parent
    end
    return parent
end

local function nextLayoutOrder(host)
    local order = (host:GetAttribute("LibLayoutOrder") or 0) + 1
    host:SetAttribute("LibLayoutOrder", order)
    return order
end

local function prepareControl(parent, height, class)
    local host = resolveHost(parent)
    local page = getPageFrom(host)
    local object = make(class or "Frame", {
        Size = UDim2.new(1, 0, 0, height),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = nextLayoutOrder(host)
    }, host)
    return object, page, host
end

function Lib:GetValue(control)
    local data = self.Controls[control]
    if data and data.GetValue then
        return data.GetValue()
    end
end

function Lib:SetValue(control, value)
    local data = self.Controls[control]
    if data and data.SetValue then
        data.SetValue(value)
    end
end

function Lib:SetVisible(control, visible)
    if control and control.Parent then
        control.Visible = visible == true
        refreshPage(getPageFrom(control))
    end
end

function Lib:SetDisabled(control, disabled)
    local data = self.Controls[control]
    if data and data.SetDisabled then
        data.SetDisabled(disabled == true)
    end
end

local function registerControl(instance, setters)
    Lib.Controls[instance] = setters
    return instance
end

local Window = {}
Window.__index = Window

function Window:_cancelTweens()
    for _, tw in ipairs(self._tweens) do
        if tw then
            pcall(function() tw:Cancel() end)
        end
    end
    self._tweens = {}
end

function Window:ClampPosition()
    if not self._wrapper then return end
    local vp = getViewport()
    local size = self._wrapper.AbsoluteSize
    if size.X < 1 or size.Y < 1 then
        size = Vector2.new(self._wrapper.Size.X.Offset, self._wrapper.Size.Y.Offset)
    end
    local maxX = math.max(0, vp.X - size.X)
    local maxY = math.max(0, vp.Y - size.Y)
    local x = math.clamp(self._wrapper.Position.X.Offset, 0, maxX)
    local y = math.clamp(self._wrapper.Position.Y.Offset, 0, maxY)
    self._wrapper.Position = UDim2.fromOffset(x, y)
end

function Window:Open()
    if self._destroyed or self._visible then return end
    self._visible = true
    self._wrapper.Visible = true
    self:_cancelTweens()
    self._animToken = self._animToken + 1
    self._rootScale.Scale = 0.94
    self._root.GroupTransparency = 1
    local scaleTw = TweenService:Create(self._rootScale, TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})
    local fadeTw = TweenService:Create(self._root, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 0})
    self._tweens = {scaleTw, fadeTw}
    scaleTw:Play()
    fadeTw:Play()
    self:ClampPosition()
    for _, entry in ipairs(self._tabs) do
        if entry.Page.Visible then refreshPage(entry.Page) end
    end
end

function Window:Close()
    if self._destroyed then return end
    if not self._visible and not self._wrapper.Visible then return end
    self._visible = false
    self:_cancelTweens()
    self._animToken = self._animToken + 1
    local token = self._animToken
    local fadeTw = TweenService:Create(self._root, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {GroupTransparency = 1})
    local scaleTw = TweenService:Create(self._rootScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.92})
    self._tweens = {fadeTw, scaleTw}
    fadeTw:Play()
    scaleTw:Play()
    scaleTw.Completed:Connect(function()
        if self._destroyed then return end
        if self._animToken == token and not self._visible then
            self._wrapper.Visible = false
            self._rootScale.Scale = 1
            self._root.GroupTransparency = 1
        end
    end)
end

function Window:SetVisible(value)
    if value then self:Open() else self:Close() end
end

function Window:Toggle()
    if self._visible then self:Close() else self:Open() end
end

function Window:GetVisible()
    return self._visible and self._wrapper.Visible
end

function Window:Minimize()
    if self._destroyed then return end
    self._minimized = not self._minimized
    local target = self._minimized and UDim2.new(1, 0, 0, 52) or UDim2.fromScale(1, 1)
    TweenService:Create(self._root, Normal, {Size = target}):Play()
end

function Window:SetSize(width, height)
    if self._destroyed then return end
    local nextWidth, nextHeight
    if typeof(width) == "UDim2" then
        nextWidth = width.X.Offset
        nextHeight = width.Y.Offset
    elseif typeof(width) == "Vector2" then
        nextWidth = width.X
        nextHeight = width.Y
    elseif type(width) == "number" then
        nextWidth = width
        nextHeight = height or self._baseSize.Y
    else
        return
    end
    local vp = getViewport()
    local maxW = math.max(320, vp.X - 40)
    local minW = math.min(380, maxW)
    local maxH = math.max(240, vp.Y - 40)
    local minH = math.min(260, maxH)
    nextWidth = math.clamp(nextWidth, minW, maxW)
    nextHeight = math.clamp(nextHeight, minH, maxH)
    self._baseSize = Vector2.new(nextWidth, nextHeight)
    self._wrapper.Size = UDim2.fromOffset(nextWidth, nextHeight)
    self:ClampPosition()
end

function Window:SetTitle(title, subtitle)
    if title ~= nil then self._titleLabel.Text = tostring(title) end
    if subtitle ~= nil then self._subtitleLabel.Text = tostring(subtitle) end
end

function Window:SetSubtitle(subtitle)
