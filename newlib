function Window:SetProfile(profile)
    if self._destroyed then return end
    profile = type(profile) == "table" and profile or {}
    if profile.Hidden ~= nil then self._profileCard.Visible = not profile.Hidden end
    if profile.Name ~= nil then self._profileName.Text = tostring(profile.Name) end
    if profile.Tag ~= nil then self._profileTag.Text = tostring(profile.Tag) end
    if profile.Image ~= nil then self._avatar.Image = tostring(profile.Image) end
end

function Window:SelectTab(target)
    local entry
    if type(target) == "table" and target.Button and target.Page then
        entry = target
    else
        for _, item in ipairs(self._tabs) do
            if item == target or item.Name == target or item.Button == target or item.Page == target or item.Button.Name == target or item.Page.Name == target then
                entry = item
                break
            end
        end
        if not entry and type(target) == "number" then
            entry = self._tabs[target]
        end
    end
    if not entry then return end
    for _, item in ipairs(self._tabs) do
        local active = item == entry
        item.Active = active
        item.Page.Visible = active
        item.Indicator.Visible = active
        item.Label.TextColor3 = active and Theme.Text or Theme.TextDim
        item.Label.Font = active and Enum.Font.GothamBold or Enum.Font.GothamMedium
        TweenService:Create(item.Button, Fast, {
            BackgroundColor3 = active and Theme.Accent or Theme.SurfaceAlt,
            BackgroundTransparency = active and 0.82 or 0.55
        }):Play()
        local itemStroke = item.Button:FindFirstChildOfClass("UIStroke")
        if itemStroke then
            TweenService:Create(itemStroke, Fast, {
                Color = active and Theme.Accent or Theme.Stroke,
                Transparency = active and 0.35 or 0.45
            }):Play()
        end
        if item.Icon then
            item.Icon.ImageColor3 = active and Theme.AccentSoft or Theme.TextDim
        end
    end
    self._activeTab = entry.Page
    refreshPage(entry.Page)
end

function Window:GetActiveTab()
    return self._activeTab
end

function Window:CreateTab(name, iconName)
    if self._destroyed then return end
    local config = type(name) == "table" and name or nil
    if config then
        iconName = config.Icon or config.IconName
        name = config.Name or config.Title or "Tab"
    end
    name = tostring(name or "Tab")

    local page = make("ScrollingFrame", {
        Name = name .. "Page",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.fromOffset(0, 0),
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        ScrollBarImageTransparency = 0.2,
        Visible = false,
        ClipsDescendants = true
    }, self._content)
    page:SetAttribute("LibPage", true)

    local holder = make("Frame", {
        Name = "Holder",
        Position = UDim2.fromOffset(18, 16),
        Size = UDim2.new(1, -36, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0
    }, page)
    make("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        VerticalAlignment = Enum.VerticalAlignment.Top
    }, holder)

    local tabButton = make("TextButton", {
        Name = name .. "Tab",
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = Theme.SurfaceAlt,
        BackgroundTransparency = 0.55,
        AutoButtonColor = false,
        Text = "",
        BorderSizePixel = 0
    }, self._tabList)
    corner(tabButton, 9)
    stroke(tabButton, Theme.Stroke, 0.45)

    local indicator = make("Frame", {
        Name = "Indicator",
        Size = UDim2.fromOffset(3, 20),
        Position = UDim2.fromOffset(0, 11),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Visible = false
    }, tabButton)
    corner(indicator, 2)

    local label = make("TextLabel", {
        Name = "Label",
        Position = UDim2.fromOffset(20, 0),
        Size = UDim2.new(1, -28, 1, 0),
        BackgroundTransparency = 1,
        Text = name,
        Font = Enum.Font.GothamMedium,
        TextSize = 14,
        TextColor3 = Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        BorderSizePixel = 0
    }, tabButton)

    local iconObj
    if iconName then
        local icon = Lib:GetCustomIcon(iconName)
        if icon then
            iconObj = make("ImageLabel", {
                Name = "TabIcon",
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 10, 0.5, 0),
                Size = UDim2.fromOffset(18, 18),
                BackgroundTransparency = 1,
                ScaleType = Enum.ScaleType.Fit,
                Image = icon.Url or "",
                ImageColor3 = Theme.TextDim,
                ImageRectOffset = icon.ImageRectOffset or Vector2.zero,
                ImageRectSize = icon.ImageRectSize or Vector2.zero
            }, tabButton)
            label.Position = UDim2.fromOffset(36, 0)
            label.Size = UDim2.new(1, -42, 1, 0)
        end
    end

    local entry = {
        Name = name,
        Button = tabButton,
        Page = page,
        Indicator = indicator,
        Label = label,
        Icon = iconObj,
        Active = false
    }
    table.insert(self._tabs, entry)

    tabButton.MouseEnter:Connect(function()
        if not entry.Active then
            TweenService:Create(tabButton, Fast, {
                BackgroundColor3 = Theme.SurfaceHi,
                BackgroundTransparency = 0.42
            }):Play()
        end
    end)
    tabButton.MouseLeave:Connect(function()
        if not entry.Active then
            TweenService:Create(tabButton, Fast, {
                BackgroundColor3 = Theme.SurfaceAlt,
                BackgroundTransparency = 0.55
            }):Play()
        end
    end)
    tabButton.MouseButton1Click:Connect(function()
        if not self._destroyed then self:SelectTab(entry) end
    end)

    if not self._activeTab then
        self:SelectTab(entry)
    end
    refreshPage(page)
    return page, tabButton
end

