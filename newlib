            Position = UDim2.fromOffset(6, 6),
            Size = UDim2.new(1, -12, 0, 30),
            BackgroundColor3 = Theme.SurfaceAlt,
            BackgroundTransparency = 0.1,
            BorderSizePixel = 0,
            Text = "",
            PlaceholderText = "Pesquisar...",
            PlaceholderColor3 = Theme.TextDim,
            TextColor3 = Theme.Text,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            ClearTextOnFocus = false,
            ZIndex = 22
        }, list)
        corner(searchBox, 6)
        pad(searchBox, 0, 0, 10, 10)
    end

    local optionsHolder = make("ScrollingFrame", {
        Name = "OptionsHolder",
        Position = UDim2.fromOffset(4, searchable and 42 or 4),
        Size = UDim2.new(1, -8, 1, searchable and -46 or -8),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.fromOffset(0, 0),
        ZIndex = 21
    }, list)

    local optionLayout = make("UIListLayout", {
        Padding = UDim.new(0, 3),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, optionsHolder)

    optionLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        optionsHolder.CanvasSize = UDim2.fromOffset(0, optionLayout.AbsoluteContentSize.Y + 5)
    end)

    local opened = false
    local disabled = false
    local optionButtons = {}
    local setOpen

    local function getText()
        if multi then
            local values = {}
            for _, option in ipairs(options) do
                if selected[option] then table.insert(values, tostring(option)) end
            end
            return #values > 0 and table.concat(values, ", ") or "Nenhum"
        end
        return selected ~= nil and tostring(selected) or "Nenhum"
    end

    local function updateLabel() valueLabel.Text = getText() end

    local function updateOptions()
        for _, child in ipairs(optionsHolder:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        optionButtons = {}
        for index, option in ipairs(options) do
            local isSelected = multi and selected[option] or selected == option
            local optBtn = make("TextButton", {
                Name = "Option_" .. index,
                Size = UDim2.new(1, -4, 0, 30),
                BackgroundColor3 = isSelected and Theme.SurfaceHi or Theme.Surface,
                BackgroundTransparency = isSelected and 0.1 or 1,
                BorderSizePixel = 0,
                Text = tostring(option),
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextColor3 = isSelected and Theme.AccentSoft or Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
                LayoutOrder = index,
                ZIndex = 22
            }, optionsHolder)
            pad(optBtn, 0, 0, 10, 6)
            corner(optBtn, 6)

            optBtn.MouseButton1Click:Connect(function()
                if disabled then return end
                if multi then
                    if selected[option] then
                        selected[option] = nil
                    else
                        selected[option] = true
                    end
                    updateLabel()
                    updateOptions()
                    local values = {}
                    for _, item in ipairs(options) do
                        if selected[item] then table.insert(values, item) end
                    end
                    control:SetAttribute("LibValue", #values)
                    safeCall(callback, values)
                else
                    selected = option
                    updateLabel()
                    setOpen(false)
                    updateOptions()
                    safeCall(callback, option)
                end
            end)

            optBtn.MouseEnter:Connect(function()
                TweenService:Create(optBtn, Fast, {BackgroundTransparency = 0.2}):Play()
            end)
            optBtn.MouseLeave:Connect(function()
                local active = multi and selected[option] or selected == option
                TweenService:Create(optBtn, Fast, {BackgroundTransparency = active and 0.1 or 1}):Play()
            end)

            table.insert(optionButtons, optBtn)
        end
        updateLabel()
    end

    setOpen = function(value)
        opened = value
        list.Visible = true
        local count = #options
        local height = opened and math.min(count * 33 + 10 + (searchable and 42 or 0), 190) or 0
        TweenService:Create(list, Normal, {Size = UDim2.new(1, 0, 0, height)}):Play()
        TweenService:Create(arrow, Fast, {Rotation = opened and 180 or 0}):Play()
        if not opened then
            task.delay(0.21, function()
                if not opened and list.Parent then list.Visible = false end
            end)
        end
        control.Size = UDim2.new(1, 0, 0, opened and 50 + height or 44)
        refreshPage(page)
    end

    row.MouseButton1Click:Connect(function()
        if not disabled then setOpen(not opened) end
    end)

    row.MouseEnter:Connect(function()
        if not disabled then
            TweenService:Create(row, Fast, {BackgroundColor3 = Theme.SurfaceHi, BackgroundTransparency = 0.05}):Play()
            TweenService:Create(rowStroke, Fast, {Color = Theme.Accent, Transparency = 0.35}):Play()
        end
    end)
    row.MouseLeave:Connect(function()
        if not disabled then
            TweenService:Create(row, Fast, {BackgroundColor3 = Theme.SurfaceAlt, BackgroundTransparency = 0.15}):Play()
            TweenService:Create(rowStroke, Fast, {Color = Theme.StrokeSoft, Transparency = 0.4}):Play()
        end
    end)

    if searchBox then
        searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            local query = searchBox.Text:lower()
            for _, btn in ipairs(optionButtons) do
                btn.Visible = query == "" or btn.Text:lower():find(query, 1, true) ~= nil
            end
        end)
    end

    updateOptions()

    local function setValue(value, fire)
        if multi then
            selected = {}
            if type(value) == "table" then
                for _, item in ipairs(value) do
                    for _, option in ipairs(options) do
                        if option == item then selected[item] = true end
                    end
                end
            end
        else
            for _, option in ipairs(options) do
                if option == value then selected = value break end
            end
        end
        updateOptions()
        if fire then
            if multi then
                local values = {}
                for _, option in ipairs(options) do
                    if selected[option] then table.insert(values, option) end
                end
                safeCall(callback, values)
            else
                safeCall(callback, selected)
            end
        end
    end

    registerControl(control, {
        SetValue = function(v) setValue(v, true) end,
        GetValue = function()
            if multi then
                local values = {}
                for _, option in ipairs(options) do
                    if selected[option] then table.insert(values, option) end
                end
                return values
            end
            return selected
        end,
        SetDisabled = function(v)
            disabled = v
            row.Active = not v
            row.BackgroundTransparency = v and 0.65 or 0.15
        end
    })

    control.SetOptions = function(_, newOptions)
        options = type(newOptions) == "table" and newOptions or {}
        updateOptions()
        refreshPage(page)
    end
    control.GetOptions = function() return options end

    refreshPage(page)
    return control
end

