                local label = Text(row, configInput.Text or id or "Input", 12, Theme.Text)
                label.Size = UDim2.new(1, 0, 0, 20)

                local input = Create("TextBox", {
                    Position = UDim2.fromOffset(0, 22),
                    Size = UDim2.new(1, 0, 0, 29),
                    BackgroundColor3 = Theme.Secondary,
                    TextColor3 = Theme.Text,
                    PlaceholderColor3 = Theme.Muted,
                    PlaceholderText = configInput.Placeholder or "Digite aqui...",
                    Text = tostring(configInput.Default or ""),
                    TextSize = 11,
                    Font = Enum.Font.Gotham,
                    ClearTextOnFocus = false,
                    BorderSizePixel = 0
                }, row)

                Corner(input, 5)

                input.FocusLost:Connect(function()
                    if configInput.Callback then
                        configInput.Callback(input.Text)
                    end
                end)

                return {
                    SetValue = function(_, value)
                        input.Text = tostring(value)
                    end,
                    GetValue = function()
                        return input.Text
                    end
                }
            end

            function box:AddKeyPicker(id, configKey)
                if type(id) == "table" then
                    configKey = id
                    id = configKey.Text
                end

                configKey = configKey or {}
                local current = configKey.Default or Enum.KeyCode.Unknown

                local row, label = Button(holder, (configKey.Text or id or "Keybind") .. "  [" .. tostring(current):gsub("Enum.KeyCode.", "") .. "]", 31)
                local listening = false

                row.MouseButton1Click:Connect(function()
                    listening = true
                    label.Text = (configKey.Text or id or "Keybind") .. "  [...]"
                end)

                local connection = UIS.InputBegan:Connect(function(input, processed)
                    if processed or not listening then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        current = input.KeyCode
                        listening = false
                        label.Text = (configKey.Text or id or "Keybind") .. "  [" .. current.Name .. "]"
                        if configKey.Callback then configKey.Callback(current) end
                    end
                end)

                return {
                    SetValue = function(_, value)
                        current = value
                        label.Text = (configKey.Text or id or "Keybind") .. "  [" .. tostring(value):gsub("Enum.KeyCode.", "") .. "]"
                    end,
                    GetValue = function()
                        return current
                    end,
                    Disconnect = function()
                        connection:Disconnect()
                    end
                }
            end

            function box:AddColorPicker(id, configColor)
                if type(id) == "table" then
                    configColor = id
                    id = configColor.Text
                end

                configColor = configColor or {}
                local color = configColor.Default or Color3.new(1, 0, 0)

                local row, label = Button(holder, configColor.Text or id or "Color", 31)
                local swatch = Create("Frame", {
                    Size = UDim2.fromOffset(20, 20),
                    Position = UDim2.new(1, -27, 0.5, -10),
                    BackgroundColor3 = color,
                    BorderSizePixel = 0
                }, row)

                Corner(swatch, 4)

                local hue = 0
                local sat = 1
                local val = 1

                row.MouseButton1Click:Connect(function()
                    hue = (hue + 0.08) % 1
                    color = Color3.fromHSV(hue, sat, val)
                    swatch.BackgroundColor3 = color
                    if configColor.Callback then configColor.Callback(color) end
                end)

                return {
                    SetValue = function(_, newColor)
                        color = newColor
                        swatch.BackgroundColor3 = color
                        if configColor.Callback then configColor.Callback(color) end
                    end,
                    GetValue = function()
                        return color
                    end
                }
            end

            return box
        end

        table.insert(self.Tabs, tab)

        if #self.Tabs == 1 then
            Select()
        end

        return tab, tabButton
    end

    function self:AddTab(name, icon)
        return self:CreateTab(name, icon)
    end

    function self:Notify(titleText, message, duration)
        local notification = Create("Frame", {
            Size = UDim2.fromOffset(260, 72),
            Position = UDim2.new(1, 280, 1, -90),
            BackgroundColor3 = Theme.Main,
            BorderSizePixel = 0
        }, gui)

        Corner(notification, 7)
        Stroke(notification, Theme.Accent)

        local heading = Text(notification, titleText or "Vortex", 13, Theme.Text, true)
        heading.Position = UDim2.fromOffset(12, 7)
        heading.Size = UDim2.new(1, -24, 0, 20)

        local body = Text(notification, message or "", 11, Theme.Muted)
        body.Position = UDim2.fromOffset(12, 29)
        body.Size = UDim2.new(1, -24, 0, 32)
        body.TextWrapped = true

        TweenService:Create(notification, TweenInfo.new(0.25), {
            Position = UDim2.new(1, -275, 1, -90)
        }):Play()

        task.delay(duration or 3, function()
            if notification.Parent then
                TweenService:Create(notification, TweenInfo.new(0.25), {
                    Position = UDim2.new(1, 280, 1, -90)
                }):Play()
                task.wait(0.3)
                notification:Destroy()
            end
        end)
    end

    function self:CreateWatermark(configWatermark)
        if type(configWatermark) == "string" then
            configWatermark = {Text = configWatermark}
        end

        configWatermark = configWatermark or {}

        local watermark = Create("TextLabel", {
            Size = UDim2.fromOffset(250, 28),
            Position = UDim2.fromOffset(15, 15),
            BackgroundColor3 = Theme.Main,
            Text = configWatermark.Text or "VORTEX",
            TextColor3 = Theme.Text,
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            BorderSizePixel = 0
        }, gui)

        Corner(watermark, 6)
        Stroke(watermark, Theme.Accent)

        if configWatermark.Draggable then
            MakeDraggable(watermark, watermark)
        end

        return {
            SetText = function(_, value)
                watermark.Text = tostring(value)
            end,
            SetVisible = function(_, value)
                watermark.Visible = value
            end,
            Destroy = function()
                watermark:Destroy()
            end
        }
    end

    function self:CreateTabbox()
        return nil
    end

    function self:SelectTab(name)
        for _, tab in ipairs(self.Tabs) do
            if tab.Name == name then
                tab.Select()
                return tab
            end
        end
    end

    return self
end

Library.new = function(self, config)
    if self ~= Library then
        config = self
    end
    return Library:CreateWindow(config)
end

Library.Notify = function(self, ...)
    if self == Library then
        return
    end
end

return Library
