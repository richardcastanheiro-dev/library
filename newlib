    Create("UIGradient", {
        Color = ColorSequence.new(Theme.Main, Theme.Background),
        Rotation = 90
    }, main)

    local shadow, shadowCleanup = AddShadow(gui, main, 14, 0.45)
    table.insert(self.Cleanups, shadowCleanup)

    local top = Create("Frame", {
        Name = "Top",
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = Theme.Main,
        BorderSizePixel = 0,
        ZIndex = 3
    }, main)

    Create("UIGradient", {
        Color = ColorSequence.new(Theme.Main, Theme.Secondary),
        Rotation = 90
    }, top)

    local titleLabel = MakeText(top, config.Title or "Obsidian", 16, Theme.Text, true)
    titleLabel.Position = UDim2.fromOffset(20, 9)
    titleLabel.Size = UDim2.new(1, -100, 0, 24)
    titleLabel.ZIndex = 4

    local subtitleLabel = MakeText(top, config.Footer or config.Subtitle or "Interface", 11, Theme.Muted)
    subtitleLabel.Position = UDim2.fromOffset(20, 30)
    subtitleLabel.Size = UDim2.new(1, -100, 0, 18)
    subtitleLabel.ZIndex = 4

    local closeButton = Create("TextButton", {
        Size = UDim2.fromOffset(28, 28),
        Position = UDim2.new(1, -42, 0, 14),
        BackgroundColor3 = Theme.Secondary,
        Text = "×",
        TextColor3 = Theme.Muted,
        TextSize = 18,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 5
    }, top)

    Corner(closeButton, 7)
    AddClickFx(closeButton)
    BindHover(closeButton, Theme.Secondary, Theme.Danger, 0, 0)

    closeButton.MouseButton1Click:Connect(function()
        self:Close()
    end)

    local dragCleanup = MakeDraggable(main, top)
    table.insert(self.Cleanups, dragCleanup)

    local sidebar = Create("Frame", {
        Name = "Sidebar",
        Position = UDim2.fromOffset(0, 56),
        Size = UDim2.new(0, 180, 1, -56),
        BackgroundColor3 = Theme.Main,
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        ZIndex = 3
    }, main)

    local divider = Create("Frame", {
        Name = "Divider",
        Position = UDim2.new(0, 180, 0, 56),
        Size = UDim2.new(0, 1, 1, -56),
        BackgroundColor3 = Theme.Border,
        BorderSizePixel = 0,
        ZIndex = 3
    }, main)

    local content = Create("Frame", {
        Name = "Content",
        Position = UDim2.new(0, 180, 0, 56),
        Size = UDim2.new(1, -180, 1, -56),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 3
    }, main)

    local tabList = Create("ScrollingFrame", {
        Name = "TabList",
        Position = UDim2.fromOffset(12, 16),
        Size = UDim2.new(1, -24, 1, -32),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.fromOffset(0, 0),
        ScrollingDirection = Enum.ScrollingDirection.Y
    }, sidebar)

    local tabListLayout = Create("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, tabList)

    tabListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tabList.CanvasSize = UDim2.fromOffset(0, tabListLayout.AbsoluteContentSize.Y + 6)
    end)

    function self:SetVisible(value)
        self.Visible = value == true
        main.Visible = self.Visible
    end

    function self:Toggle()
        self:SetVisible(not self.Visible)
    end

    function self:Open()
        self:SetVisible(true)
    end

    function self:Close()
        self:SetVisible(false)
    end

    function self:GetVisible()
        return self.Visible
    end

    function self:SetTitle(value)
        titleLabel.Text = tostring(value)
    end

    function self:SetSubtitle(value)
        subtitleLabel.Text = tostring(value)
    end

    function self:SetKeybind(key)
        self.Keybind = key
    end

    function self:Destroy()
        for _, connection in ipairs(self.Connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        for _, cleanup in ipairs(self.Cleanups) do
            pcall(cleanup)
        end

        gui:Destroy()
    end

    local inputConnection = UIS.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end

        local key = self.Keybind
        local keyCode

        if typeof(key) == "EnumItem" then
            keyCode = key
        elseif type(key) == "string" then
            local ok, result = pcall(function()
                return Enum.KeyCode[key]
            end)

            if ok then
                keyCode = result
            end
        end

        if keyCode and input.KeyCode == keyCode then
            self:Toggle()
        end
    end)

    table.insert(self.Connections, inputConnection)

    local function layoutNotifications()
        for index, data in ipairs(self.Notifications) do
            local target = UDim2.new(
                1,
                -data.Width - 16,
                1,
                -16 - data.Height - (index - 1) * (data.Height + 8)
            )

            TweenService:Create(data.Frame, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = target
            }):Play()
        end
    end

    function self:Notify(titleText, message, duration)
        duration = duration or 3

        local notifWidth = 300
        local notifHeight = 72

        local frame = Create("Frame", {
            Size = UDim2.fromOffset(notifWidth, notifHeight),
            Position = UDim2.new(1, 20, 1, -16 - notifHeight),
            BackgroundColor3 = Theme.Main,
            BackgroundTransparency = 0.02,
            BorderSizePixel = 0,
            ZIndex = 50
        }, gui)

        Corner(frame, 10)
        local stroke = AddStroke(frame, Theme.Border, 1, 0.25)

        local accent = Create("Frame", {
            Size = UDim2.fromOffset(4, 42),
            Position = UDim2.fromOffset(0, 15),
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0,
            ZIndex = 51
        }, frame)

        Corner(accent, 4)

        local glow = Create("Frame", {
            Size = UDim2.fromOffset(90, 90),
            Position = UDim2.new(0, -40, 0, -30),
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 0.9,
            BorderSizePixel = 0,
            ZIndex = 50
        }, frame)

        Corner(glow, 60)

        local heading = MakeText(frame, titleText or "Obsidian", 13, Theme.Text, true)
        heading.Position = UDim2.fromOffset(16, 10)
        heading.Size = UDim2.new(1, -28, 0, 20)
        heading.ZIndex = 52

        local body = MakeText(frame, message or "", 11, Theme.Muted)
        body.Position = UDim2.fromOffset(16, 32)
        body.Size = UDim2.new(1, -28, 0, 30)
        body.TextWrapped = true
        body.ZIndex = 52

        local data = {
            Frame = frame,
            Width = notifWidth,
            Height = notifHeight,
            Duration = duration
        }

        table.insert(self.Notifications, data)
        layoutNotifications()

        task.delay(duration, function()
            local index = table.find(self.Notifications, data)

            if not index then
                return
            end

            table.remove(self.Notifications, index)

            local tween = TweenService:Create(frame, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = UDim2.new(1, notifWidth + 24, frame.Position.Y.Scale, frame.Position.Y.Offset),
                BackgroundTransparency = 1
            })

            tween:Play()

            TweenService:Create(stroke, TweenInfo.new(0.22), {
                Transparency = 1
            }):Play()

            tween.Completed:Connect(function()
                if frame.Parent then
                    frame:Destroy()
                end
            end)

            layoutNotifications()
        end)

        return data
    end

    function self:CreateWatermark(configWatermark)
        if type(configWatermark) == "string" then
            configWatermark = {
                Text = configWatermark
            }
        end

        configWatermark = configWatermark or {}

        local watermark = Create("Frame", {
            Name = "Watermark",
            Size = UDim2.fromOffset(240, 32),
            Position = UDim2.fromOffset(16, 16),
            BackgroundColor3 = Theme.Main,
            BackgroundTransparency = 0.03,
            BorderSizePixel = 0,
            ZIndex = 20
        }, gui)

        Corner(watermark, 8)
        AddStroke(watermark, Theme.Border, 1, 0.35)

        local accent = Create("Frame", {
            Size = UDim2.fromOffset(4, 32),
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0
        }, watermark)

        Corner(accent, 8)

        local label = MakeText(watermark, configWatermark.Text or "OBSIDIAN", 12, Theme.Text, true)
        label.Position = UDim2.fromOffset(14, 0)
        label.Size = UDim2.new(1, -18, 1, 0)

        local cleanup

        if configWatermark.Draggable then
            cleanup = MakeDraggable(watermark, watermark)
            table.insert(self.Cleanups, cleanup)
        end

        return {
            SetText = function(_, value)
                label.Text = tostring(value)
            end,
            SetVisible = function(_, value)
                watermark.Visible = value == true
            end,
            Destroy = function()
                if cleanup then
                    pcall(cleanup)
                end

                watermark:Destroy()
            end
        }
    end

    function self:CreateTab(name, icon)
        name = tostring(name or "Tab")

        local page = Create("ScrollingFrame", {
            Name = name .. "Page",
            Size = UDim2.new(1, -32, 1, -32),
            Position = UDim2.fromOffset(16, 16),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Accent,
            CanvasSize = UDim2.fromOffset(0, 0),
            Visible = false,
            ZIndex = 3,
            ScrollingDirection = Enum.ScrollingDirection.Y
        }, content)

        local pageLayout = Create("UIListLayout", {
            Padding = UDim.new(0, 10),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, page)

        pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            page.CanvasSize = UDim2.fromOffset(0, pageLayout.AbsoluteContentSize.Y + 8)
        end)

        local tabButton = Create("TextButton", {
            Name = name .. "Tab",
            Size = UDim2.new(1, 0, 0, 42),
            BackgroundColor3 = Theme.Secondary,
            BackgroundTransparency = 0.45,
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0,
            LayoutOrder = #self.Tabs + 1,
            ZIndex = 4
        }, tabList)

        Corner(tabButton, 8)
        local tabStroke = AddStroke(tabButton, Theme.Border, 1, 0.65)

        local indicator = Create("Frame", {
            Size = UDim2.fromOffset(3, 22),
            Position = UDim2.fromOffset(0, 10),
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0,
            Visible = false,
            ZIndex = 5
        }, tabButton)

        Corner(indicator, 2)

        local iconElement
        local labelX = 18

        if icon ~= nil and tostring(icon) ~= "" then
            local iconText = tostring(icon)

            if iconText:match("rbxassetid://") then
                iconElement = Create("ImageLabel", {
                    Size = UDim2.fromOffset(18, 18),
                    Position = UDim2.fromOffset(10, 12),
                    BackgroundTransparency = 1,
                    Image = iconText,
                    ImageColor3 = Theme.Muted,
                    ZIndex = 5
                }, tabButton)
            else
                iconElement = MakeText(tabButton, iconText, 14, Theme.Muted, false, Enum.TextXAlignment.Center)
                iconElement.Position = UDim2.fromOffset(8, 0)
                iconElement.Size = UDim2.fromOffset(22, 42)
                iconElement.ZIndex = 5
            end

            labelX = 40
        end

        local tabText = MakeText(tabButton, name, 13, Theme.Muted, false)
        tabText.Position = UDim2.fromOffset(labelX, 0)
        tabText.Size = UDim2.new(1, -labelX - 8, 1, 0)
        tabText.ZIndex = 5

        local tab = {
            Page = page,
            Button = tabButton,
            Label = tabText,
            Indicator = indicator,
            Icon = iconElement,
            Stroke = tabStroke,
            Name = name,
            Active = false,
            GroupOrder = 0
        }

        local function selectTab()
            for _, other in ipairs(self.Tabs) do
                local active = other == tab

                other.Active = active
                other.Page.Visible = active
                other.Indicator.Visible = active

                TweenService:Create(other.Button, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    BackgroundColor3 = active and Theme.Accent or Theme.Secondary,
                    BackgroundTransparency = active and 0.82 or 0.45
                }):Play()

                TweenService:Create(other.Label, TweenInfo.new(0.18), {
                    TextColor3 = active and Theme.Text or Theme.Muted
                }):Play()

                other.Label.Font = active and Enum.Font.GothamBold or Enum.Font.Gotham

                if other.Icon and other.Icon:IsA("ImageLabel") then
                    TweenService:Create(other.Icon, TweenInfo.new(0.18), {
                        ImageColor3 = active and Theme.Text or Theme.Muted
                    }):Play()
                elseif other.Icon and other.Icon:IsA("TextLabel") then
                    TweenService:Create(other.Icon, TweenInfo.new(0.18), {
                        TextColor3 = active and Theme.Text or Theme.Muted
                    }):Play()
                end

                if other.Stroke then
                    TweenService:Create(other.Stroke, TweenInfo.new(0.18), {
                        Color = active and Theme.Accent or Theme.Border,
                        Transparency = active and 0.35 or 0.65
                    }):Play()
                end
            end

            self.ActiveTab = tab
        end

        tab.Select = selectTab

        AddClickFx(tabButton)

        tabButton.MouseEnter:Connect(function()
            if not tab.Active then
                TweenService:Create(tabButton, TweenInfo.new(0.15), {
                    BackgroundColor3 = Theme.Element,
                    BackgroundTransparency = 0.32
                }):Play()
            end
        end)

        tabButton.MouseLeave:Connect(function()
            if not tab.Active then
                TweenService:Create(tabButton, TweenInfo.new(0.15), {
                    BackgroundColor3 = Theme.Secondary,
                    BackgroundTransparency = 0.45
                }):Play()
            end
        end)

        tabButton.MouseButton1Click:Connect(selectTab)

