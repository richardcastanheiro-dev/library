            self.GroupOrder = (self.GroupOrder or 0) + 1

            local boxFrame = Create("Frame", {
                Name = tostring(groupName or "Groupbox"),
                Size = UDim2.new(1, -4, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Theme.Secondary,
                BackgroundTransparency = 0.08,
                BorderSizePixel = 0,
                LayoutOrder = self.GroupOrder,
                ZIndex = 3
            }, page)

            Corner(boxFrame, 10)
            AddStroke(boxFrame, Theme.Border, 1, 0.5)

            Create("UIPadding", {
                PaddingTop = UDim.new(0, 12),
                PaddingBottom = UDim.new(0, 12),
                PaddingLeft = UDim.new(0, 12),
                PaddingRight = UDim.new(0, 12)
            }, boxFrame)

            local titleRow = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 22),
                BackgroundTransparency = 1
            }, boxFrame)

            local titleAccent = Create("Frame", {
                Size = UDim2.fromOffset(3, 14),
                Position = UDim2.fromOffset(0, 4),
                BackgroundColor3 = Theme.Accent,
                BorderSizePixel = 0
            }, titleRow)

            Corner(titleAccent, 2)

            local boxTitle = MakeText(titleRow, tostring(groupName or "Groupbox"), 13, Theme.Text, true)
            boxTitle.Position = UDim2.fromOffset(10, 0)
            boxTitle.Size = UDim2.new(1, -10, 1, 0)

            local holder = Create("Frame", {
                Position = UDim2.fromOffset(0, 30),
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1
            }, boxFrame)

            local holderLayout = Create("UIListLayout", {
                Padding = UDim.new(0, 8),
                SortOrder = Enum.SortOrder.LayoutOrder
            }, holder)

            local controlOrder = 0

            local function nextOrder()
                controlOrder = controlOrder + 1
                return controlOrder
            end

            local box = {
                Frame = boxFrame,
                Container = holder
            }

            function box:AddButton(configButton, callback)
                local textValue = "Button"
                local func = callback

                if type(configButton) == "table" then
                    textValue = configButton.Text or configButton.Name or textValue
                    func = callback or configButton.Callback or configButton.Func
                elseif configButton ~= nil then
                    textValue = tostring(configButton)
                end

                local button = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundColor3 = Theme.Element,
                    BackgroundTransparency = 0.05,
                    Text = "",
                    AutoButtonColor = false,
                    BorderSizePixel = 0,
                    LayoutOrder = nextOrder()
                }, holder)

